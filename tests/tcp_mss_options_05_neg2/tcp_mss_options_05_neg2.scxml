<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.9 TCP_MSS_OPTIONS_05 negative (iteration 2) — lwIP egress-fault
  self-validation of the positive's unanswered-probe guard, the twin of the _NEG.
  The fault (kIcmpFaultEchoIdWrong, which flips the identifier of the DUT's Echo
  Reply) is armed BETWEEN the two iterations, after the DUT has answered the first
  liveness Echo, so only the second probe goes unanswered in the positive's sense and
  its `fail_dut_unresponsive_after_ilen5` final becomes reachable.
  Pass = a DUT Echo Reply for probe 2 that does not carry the probe's identifier;
  fail_compliant = the DUT answered probe 2 with the identifier despite the flavor
  (fault inert). A wrong-identifier reply to probe 1 means the fault landed before the
  first iteration was over, and a missing reply to either probe means the DUT is not
  running: both are inconclusive here, not this case's fail. lwIP-only
  (capability-gated on kCapEgressFault).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_mss_options_05_neg2"
       sce:transition-table="emit"
       datamodel="null"
       initial="awaiting_phase1_reply">

  <sce:context id="captured"
               cpp:type="tc8::TcpLivenessCaptured"
               cpp:include="sce_integration/tcp_case_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="awaiting_phase1_reply">
    <onentry>
      <send event="phase1_reply_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="dut_echo_reply"
                cond="cpp:captured.liveness_echo_seq == 1U"
                target="awaiting_corrupted_reply"/>
    <transition event="dut_echo_reply_wrong_id"
                cond="cpp:captured.liveness_echo_seq == 1U"
                target="inconclusive_fault_landed_early"/>
    <transition event="phase1_reply_window_elapsed" target="inconclusive_no_phase1_reply"/>
  </state>

  <state id="awaiting_corrupted_reply">
    <onentry>
      <send event="corrupted_reply_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="dut_echo_reply_wrong_id"
                cond="cpp:captured.liveness_echo_seq == 2U"
                target="pass"/>
    <transition event="dut_echo_reply"
                cond="cpp:captured.liveness_echo_seq == 2U"
                target="fail_compliant"/>
    <transition event="corrupted_reply_window_elapsed" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_echoed_probe_id_despite_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_fault_landed_early">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"fault_corrupted_the_first_echo_reply","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_phase1_reply">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_echo_reply_to_the_first_probe","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_echo_reply_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
