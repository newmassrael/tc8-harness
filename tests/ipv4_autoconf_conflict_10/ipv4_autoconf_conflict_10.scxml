<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.4 IPv4_AUTOCONF_CONFLICT_10: receiving a conflicting
  ARP packet (RFC 3927 §2.5 MAY-immediate-cease). Tester injects a
  single ARP Reply with sender_ip == target_ip == DUT's committed
  LL; the test exercises the immediate-cease branch (RFC 3927 §2.5
  method 1). Pass criterion: fresh DUT Probe whose target ≠
  original LL lands within the post_claim deadline.

  Trait wiring (see ipv4_autoconf_conflict_10.h):
    scheduleDefenderCeaseConflicts(opcode1=Reply, opcode2=0)
    on listening_post_claim entry — single-shot, no second emit.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_conflict_10"
       datamodel="null"
       initial="listening_pre_claim">
  <sce:use template="../_templates/ipv4_linklocal_defender_cease.sce-template.xml"/>
</scxml>
