<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_088: SD_Answer_multiple_subscribes_together.

  Tester sends a single SD message carrying three Type 2
  SubscribeEventgroup entries (eventgroups 0x02, 0x05, 0x06) all
  pointing at the same tester IPv4 endpoint option. Per
  PRS_SOMEIPSD_00263 / SIP_SD_65 / SIP_SD_836 the DUT must walk
  the entries one at a time and emit a SubscribeEventgroupAck for
  each entry.

  vsomeip bundles the 3 Acks into a single SD response message
  whose entries array carries 3 Type 0x07 entries in request order
  (verified against the wire pcap: session 2 SD response at
  172.16.0.2:30490 → 172.16.0.1:30490 carries EntriesLen=0x30 with
  eg 0x02 / 0x05 / 0x06 in that order). Phase 2 therefore checks
  the bundled response in a single transition.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1
            with sd_ipv4_endpoint_count >= 1.
    Phase 2 (listening_phase2): SD response with sd_entry_count >= 3,
            each of indices 0/1/2 a Type 0x07 entry on eg
            0x02 / 0x05 / 0x06 with ttl > 0 -> pass. Deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_088"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_ipv4_endpoint_count >= 1"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer_with_endpoint"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 3 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == 0x0002 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[1].type == 0x07 and captured.sd_entries[1].eventgroup_id == 0x0005 and captured.sd_entries[1].ttl &gt; 0 and captured.sd_entries[2].type == 0x07 and captured.sd_entries[2].eventgroup_id == 0x0006 and captured.sd_entries[2].ttl &gt; 0"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_three_acks"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer_with_endpoint">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_with_ipv4_endpoint_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_three_acks">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_bundled_subscribe_ack_for_eg_0x02_0x05_0x06","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
