<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_087: Eventgroup_EventsAndFieldsUnreliable_5.

  Tester subscribes to eventgroup 0x05 on SERVICE-ID-1; DUT must reply
  with SubscribeEventgroupAck (Type 2 entry, type=0x07, ttl > 0) and
  send every initial event the procedure lists for eventgroup 0x05:
  Interface Version 0x8005, TestFieldUINT8 0x8006 and TestFieldUINT8Array
  0x8007, all unreliable. The order is not specified, so each event has
  its own region of a <parallel> (as in ETS_086) and the case passes once
  all three regions are done.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1
            with sd_ipv4_endpoint_count >= 1.
    Phase 2 (listening_phase2): SubscribeEventgroupAck for eventgroup
            0x0005 (Type 2 entry, ttl > 0). ttl == 0 -> Nack -> fail.
    Phase 3 (listening_phase3_initial_events): one Notification
            (message type 0x02) on SERVICE-ID-1 for each of 0x8005, 0x8006
            and 0x8007. A window that closes with any of them unseen is
            property_unobserved; the states trace names the region that
            did not finish.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_087"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_ipv4_endpoint_count >= 1"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer_with_endpoint"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="listening_phase3_initial_events"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0"
                target="fail_phase2_subscribe_nacked"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_subscribe_ack"/>
  </state>

  <parallel id="listening_phase3_initial_events">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="done.state.listening_phase3_initial_events" target="pass"/>
    <transition event="phase3_deadline_exceeded" target="inconclusive_phase3_initial_events_missing"/>

    <state id="initial_8005" initial="awaiting_8005">
      <state id="awaiting_8005">
        <transition event="someip_notification"
                    cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x02 and captured.method_id == 0x8005"
                    target="seen_8005"/>
      </state>
      <final id="seen_8005"/>
    </state>

    <state id="initial_8006" initial="awaiting_8006">
      <state id="awaiting_8006">
        <transition event="someip_notification"
                    cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x02 and captured.method_id == 0x8006"
                    target="seen_8006"/>
      </state>
      <final id="seen_8006"/>
    </state>

    <state id="initial_8007" initial="awaiting_8007">
      <state id="awaiting_8007">
        <transition event="someip_notification"
                    cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x02 and captured.method_id == 0x8007"
                    target="seen_8007"/>
      </state>
      <final id="seen_8007"/>
    </state>
  </parallel>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer_with_endpoint">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_with_ipv4_endpoint_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"subscribe_eventgroup_nacked_ttl_zero","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_subscribe_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_subscribe_ack_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase3_initial_events_missing">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"not_every_initial_event_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
