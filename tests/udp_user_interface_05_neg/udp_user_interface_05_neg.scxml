<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.5 UDP_USER_INTERFACE_05 negative — lwIP egress self-validation of the
  positive _05 "DUT-emitted UDP carries the caller-specified source port (20025)"
  guard. The trait arms kUdpFaultSrcPortWrong, so the netif link-output hook rewrites
  the DUT-emitted datagram's source port off 20025.
  Pass = the captured egress UDP's source port is NOT 20025 (src_port != 20025, the
  injected violation observed); fail_compliant = the DUT emitted 20025 despite the
  flavor (fault inert — what a conformant DUT does). lwIP-only (kCapEgressFault).
  Envelope: udp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_user_interface_05_neg"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="!(captured.src_port == 20025)"
           fail_state="fail_compliant"
           fail_reason="dut_emitted_correct_src_port_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
