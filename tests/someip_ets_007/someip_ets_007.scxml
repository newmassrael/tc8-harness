<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_007: echoBitfields.

  Tester sends echoBitfields (METHOD-ID 0x0041) with 3 integer args
  packed back-to-back in the payload (UInt8 + UInt16 BE + UInt32 BE,
  CommonAPI default deployment, no alignment padding):
    Request payload  (7 bytes): 0x80 0x40 0x01 0x12 0x34 0x56 0x78
                                ^^^^ ^^^^^^^^^ ^^^^^^^^^^^^^^^^^^^^
                                UInt8 UInt16 BE   UInt32 BE
    Response payload (7 bytes): 0x01 0x80 0x02 0x1E 0x6A 0x2C 0x48
                                ^^^^ ^^^^^^^^^ ^^^^^^^^^^^^^^^^^^^^
                                rev8  rev16 BE     rev32 BE

  Each Response arg is the bit-reversed value of the matching Request
  arg (PRS_SOMEIP_00191 + PRS_SOMEIP_00300 + PRS_SOMEIP_003001):
    reverseBits8 (0x80)       = 0x01
    reverseBits16(0x4001)     = 0x8002
    reverseBits32(0x12345678) = 0x1E6A2C48

  Pass criterion pins all 7 response bytes individually so a regression
  that echoes the request unchanged or only reverses one of the three
  args lands on fail_phase2_bitfield_echo_mismatch instead of pass.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Method Response (msg_type 0x80,
            return_code 0x00) on method_id 0x0041 with payload_len == 7
            and bytes [0x01, 0x80, 0x02, 0x1E, 0x6A, 0x2C, 0x48] -> pass.
            Any other Response shape on the same method_id -> fail.
            No Response within the deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_007"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0041 and captured.return_code == 0x00 and captured.payload_len == 7 and captured.payload_snapshot[0] == 0x01 and captured.payload_snapshot[1] == 0x80 and captured.payload_snapshot[2] == 0x02 and captured.payload_snapshot[3] == 0x1E and captured.payload_snapshot[4] == 0x6A and captured.payload_snapshot[5] == 0x2C and captured.payload_snapshot[6] == 0x48"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0041 and captured.message_type == 0x80 and (captured.payload_len != 7 or captured.payload_snapshot[0] != 0x01 or captured.payload_snapshot[1] != 0x80 or captured.payload_snapshot[2] != 0x02 or captured.payload_snapshot[3] != 0x1E or captured.payload_snapshot[4] != 0x6A or captured.payload_snapshot[5] != 0x2C or captured.payload_snapshot[6] != 0x48)"
                target="fail_phase2_bitfield_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_bitfield_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_bitfields_response_did_not_match_reversed_request","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
