<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.18 TCP_ACKNOWLEDGEMENT_04: DUT receives a pure ACK (no
  piggybacking, Length=0) and MUST NOT RST; the connection ends
  cleanly when requested. Derived from RFC 793 §3.9.

  v3.0 Test Procedure (p402):
    1. TESTER: Bring DUT to ESTABLISHED state.
    2. TESTER: Send sendTCPPacket to request a TCP packet from DUT.
    3. DUT:    Sends a TCP packet.
    4. TESTER: Send an ACK with the expected Ack Number, Length=0.
    5. DUT:    Sends no RST and ends the connection correctly when
               requested.

  Mechanism (active OPEN to ESTABLISHED + DUT data send + pure ACK +
  clean CLOSE):
    1. Drive the DUT through an active OPEN to ESTABLISHED on
       (kBasicsActiveLocalPort+131, kBasicsActiveRemotePort+131);
       accept the kernel-completed tester connection.
    2. Tester causes the DUT to SEND a 4 B payload; the DUT emits the
       DATA segment and the tester kernel auto-ACKs with a pure ACK
       (Length=0) — the spec-prescribed step 4 stimulus.
    3. ~3 s exposure window while SCXML watches for any DUT RST.
    4. The DUT application issues CLOSE; the DUT emits FIN+ACK,
       observed to confirm a clean close.

  Two-state SCXML chain:
    * listening_handshake_ack — observe DUT 3rd-leg pure ACK on the
      active-OPEN port quad.
    * listening_close_path — single 8 s window covering both the
      pure-ACK exposure (~3 s) and the post-close FIN observation.
      is_dut_rst(...) on the case 4-tuple lands on
      fail_dut_rst_after_pure_ack; is_dut_fin_ack(...) lands on
      pass; the DUT data segment naturally fails both predicates
      (RST clear, FIN clear) and is absorbed.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  is_pure_dut_ack(...)'s src_ip conjunct unreachable; case lands on
  inconclusive_no_handshake_ack via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_acknowledgement_04"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpAck04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpAck04LocalOffset)"
                target="listening_close_path"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_close_path">
    <onentry>
      <send event="deadline_close_path" delay="8s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpAck04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpAck04LocalOffset)"
                target="fail_dut_rst_after_pure_ack"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpAck04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpAck04LocalOffset)"
                target="pass"/>
    <transition event="deadline_close_path" target="inconclusive_no_dut_fin"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_dut_rst_after_pure_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_rst_after_pure_ack","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_fin_after_close_request","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
