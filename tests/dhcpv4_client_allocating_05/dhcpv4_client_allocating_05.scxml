<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_05: DHCPREQUEST is sent to
  the same IP broadcast address as the DHCPDISCOVER (RFC 2131 §3.1).

  Case shape:
    both DUT-side messages of the initial exchange have to go to the
    broadcast address: the DISCOVER, because the client knows no
    server yet, and the REQUEST that answers <SERVER-1>'s offer,
    because the other servers need to hear it was not their offer that
    was taken.

  Reuses the §4.7 lifecycle pattern; the DISCOVER-side dst-broadcast
  invariant is already covered by ALLOCATING_01 so this case scopes
  the assertion to the REQUEST-side leg only.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_05"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.dst_ip_is_broadcast()"
           fail_state="fail_request_dst_ip_not_broadcast"
           fail_reason="dut_dhcp_request_dst_ip_not_broadcast"
           fail_role="observed_violation"/>
</scxml>
