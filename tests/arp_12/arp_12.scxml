<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_12: ARP request Operation Code field shall carry
  OPERATION_REQUEST (1) per RFC 826 — the field-level phrasing of ARP_07.
  UT 0x02 egress provocation forces the DUT Request — see arp_07.scxml.
  Envelope: arp_field_check (opcode case: filter gates on sender_hw only).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_12"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.opcode == 1"
           fail_state="fail_opcode"
           fail_reason="opcode_not_request"
           fail_role="observed_violation"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
