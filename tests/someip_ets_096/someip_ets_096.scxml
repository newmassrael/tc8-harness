<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_096: SD_Check_TCP_Connection_before_SubscribeEventgroup.

  Tester emits a unicast SubscribeEventgroup for eg 0x0002 whose IPv4
  Endpoint Option declares L4 protocol 0x06 (TCP) without
  pre-establishing the corresponding TCP connection. Per
  PRS_SOMEIPSD_00362 the DUT must reject the request with a
  SubscribeEventgroupNack — Type 0x07 entry, ttl == 0 — rather than
  Ack the eventgroup.

    Phase 1 (listening_phase1, 6 s): OfferService observation on
            SERVICE-ID-1 with sd_ipv4_endpoint_count >= 1. Mirrors
            ETS_092's gate so the NEG row's service_id flip lands the
            same with-endpoint failure reason.
    Phase 2 (listening_phase2, 5 s): observe a Type 0x07 entry on
            eg 0x0002 with ttl == 0 (Nack). ttl > 0 (DUT erroneously
            Acked the TCP-option Subscribe) -> fail. Deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_096"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_ipv4_endpoint_count &gt;= 1"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer_with_endpoint"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == 0x0002 and captured.sd_entries[0].ttl == 0"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == 0x0002 and captured.sd_entries[0].ttl &gt; 0"
                target="fail_phase2_dut_acked_tcp_subscribe_without_connection"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_subscribe_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer_with_endpoint">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_with_ipv4_endpoint_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_acked_tcp_subscribe_without_connection">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_acked_tcp_subscribe_without_pre_established_connection"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_subscribe_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_subscribe_response_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
