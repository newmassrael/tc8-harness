<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_053: echoUTF8FIXED.

  Tester sends echoUTF8FIXED (METHOD-ID 0x0013) Method Request whose
  CommonAPI-serialised payload is exactly 64 raw bytes — NO length
  prefix on the wire because ets.fdepl pins
  `SomeIpStringLengthWidth = 0` + `SomeIpStringLength = 64` (per
  spec p401-420 echoUTF8FIXED row "UTF8Fixed = 64 bytes of string
  including BOM"). Layout: BOM (3 B) + 'h' (1 B) + 'i' (1 B) +
  trailing null (1 B) + 58 B zero padding. DUT echoes the same
  64-byte payload back unchanged.

  Wire layout (64-byte payload, first 16 bytes pinned via
  SomeIpCaptured.payload_bytes[16] cap):
    [EF BB BF]                                    UTF-8 BOM
    [68]                                          'h'
    [69]                                          'i'
    [00]                                          trailing null
    [00 00 00 00 00 00 00 00 00 00]               10 B padding

  Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
  Phase 2 (listening_phase2): Method Response (msg_type 0x80,
          return_code 0x00) on method_id 0x0013 with payload_len == 64
          and observable payload bytes matching the request -> pass.
          Any other Response shape on the same method_id -> fail.
          No Response within the deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_053"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0013 and captured.return_code == 0x00 and captured.payload_len == 64 and captured.payload_bytes[0] == 0xEF and captured.payload_bytes[1] == 0xBB and captured.payload_bytes[2] == 0xBF and captured.payload_bytes[3] == 0x68 and captured.payload_bytes[4] == 0x69 and captured.payload_bytes[5] == 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0013 and captured.message_type == 0x80 and (captured.payload_len != 64 or captured.payload_bytes[0] != 0xEF or captured.payload_bytes[1] != 0xBB or captured.payload_bytes[2] != 0xBF or captured.payload_bytes[3] != 0x68 or captured.payload_bytes[4] != 0x69)"
                target="fail_phase2_utf8_fixed_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_utf8_fixed_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_utf8_fixed_response_did_not_match_request"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_method_response_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
