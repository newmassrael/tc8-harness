<?xml version="1.0" encoding="UTF-8"?>
<!--
  §4.2.4.2 Phase 3b Group C sub-shape 2 body: ARP cache merge under two
  successive tester injections with sender_proto_ip = HOST-1-IP. RFC 826
  translation-table update requires the second frame to overwrite the
  first's entry. Follow-up Subscribe provokes DUT UDP egress; pass =
  eth_dst == MAC2 (second-injection dominance).

  Shared body for ARP_32 / ARP_33 / ARP_34 / ARP_35 (Req/Req, Rsp/Rsp,
  Req/Rsp, Rsp/Req injection pairs). Call sites differ only in the
  per-case top XML comment narrative and the <scxml name="..."> attribute
  — both live on the thin-shell side. See tests/arp_32/arp_32.scxml
  for an example consumer.
-->
<sce:template xmlns:sce="http://sce.dev/ext"
              xmlns="http://www.w3.org/2005/07/scxml"
              xmlns:cpp="urn:sce:cpp"
              name="arp_group_c_cache_merge_second_mac">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="udp_observed"
                cond="cpp:captured.observed_udp_dst_ip == expected.tester_ip and captured.observed_udp_eth_dst == expected.tester_mac2"
                target="pass"/>
    <transition event="udp_observed"
                cond="cpp:captured.observed_udp_dst_ip == expected.tester_ip and captured.observed_udp_eth_dst == expected.tester_mac"
                target="fail_used_mac1"/>
    <transition event="udp_observed"
                cond="cpp:captured.observed_udp_dst_ip == expected.tester_ip and captured.observed_udp_eth_dst != expected.tester_mac and captured.observed_udp_eth_dst != expected.tester_mac2"
                target="fail_unknown_mac"/>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
                target="fail_dut_arp_request"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_used_mac1">
    <donedata>
      <content>{"verdict":"fail","reason":"udp_eth_dst_is_mac1_not_mac2"}</content>
    </donedata>
  </final>

  <final id="fail_unknown_mac">
    <donedata>
      <content>{"verdict":"fail","reason":"udp_eth_dst_neither_mac1_nor_mac2"}</content>
    </donedata>
  </final>

  <final id="fail_dut_arp_request">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_arp_request_after_double_injection"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_udp_from_dut_within_listen_window"}</content>
    </donedata>
  </final>
</sce:template>
