<?xml version="1.0" encoding="UTF-8"?>
<!--
  §4.6 UDP field-check shape: TESTER causes DUT to emit a UDP datagram
  (via §4.8.5 OpTriggerSendUdp) and observes one or more fields of the
  resulting wire frame.

  Conformance verdict model (ISO/IEC 9646 / TTCN-3, same as SOMEIP_ETS_152).
  The verdict is SOUND: it FAILs only on an observed field violation, never
  because the environment failed to drive the DUT into the precondition.

    Phase 1 (listening_phase1, 6 s deadline) — liveness + early match:
      A DUT-egress UDP datagram (src_ip == dut_iface_ip, dst_ip == tester_ip,
      not the UT Confirmation) resolves directly: pass when `{$pass_expr}`
      holds, else `{$fail_state}` (observed violation). Otherwise the DUT's UT
      Confirmation (`captured.has_ut_response`, the RPC reply to the
      TriggerSendUdp request) proves the DUT and its UT path are live and
      advances to Phase 2.
        * deadline -> error (error_no_dut_udp): no DUT-originated UDP at all
          (neither egress nor UT Confirmation) — the DUT/UT path did not come
          up, a precondition fault, not a field defect. Does not red the gate.

    Phase 2 (listening_phase2, 5 s deadline) — liveness confirmed:
      Same DUT-egress pass / `{$fail_state}` branches.
        * deadline -> inconclusive (inconclusive_no_egress): the DUT
          acknowledged the trigger (UT Confirmation seen) but never emitted
          the spec-mandated egress UDP, so the field property could not be
          evaluated. The DUT was NOT shown to violate anything.

  Single-param `pass_expr` design — the fail-branch reads `!({$pass_expr})`
  so post-template SCXML never carries a raw `<` inside an attribute value
  (see ipv4_field_check comment). The src_ip filter
  (`captured.src_ip == expected.dut_iface_ip`) is bundled into the
  conjunction so the template excludes the tester's own UT request and the
  DUT's UT Confirmation (src_port == ut::kPort = 30600) from the field
  branches. Consumers asserting only ut::kPort-based filters can pass
  `pass_expr` that overrides — but every §4.6.5.4 egress consumer wants
  src_ip == dut_iface_ip + a per-case field predicate.

  BPF: consumers use `BpfGroup::Udp` so vsomeip SD multicast (UDP 30490)
  also reaches the pipeline. The src_ip + dst_ip(tester) + custom field
  conjunction filters those out at the cond level — SD frames originate from
  the DUT but match neither the spec-mandated dst nor the per-case predicate.

  UT-confirmation gate (`!captured.has_ut_response`): the DUT's UT RPC server
  replies to every TriggerSendUdp request with a Confirmation datagram
  (src_port=30600, dst_ip=tester_ip). Without an explicit gate that response
  would race the DUT-egress UDP this template observes — and since it carries
  the wrong src_port (30600 != per-case spec port), it would land on the fail
  branch first, masking the actual DUT egress that arrives microseconds later.
  The UT-confirmation conjunct excludes those frames from the field branches;
  the Phase 1 liveness transition reuses the same signal as proof-of-life.
-->
<sce:template xmlns:sce="http://sce.dev/ext"
              xmlns="http://www.w3.org/2005/07/scxml"
              xmlns:cpp="urn:sce:cpp"
              name="udp_field_check">

  <sce:param name="pass_expr"   required="true"/>
  <sce:param name="fail_state"  required="true"/>
  <sce:param name="fail_reason" required="true"/>

  <sce:context id="captured"
               cpp:type="tc8::UdpCaptured"
               cpp:include="sce_integration/udp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and ({$pass_expr})"
                target="pass"/>
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and !({$pass_expr})"
                target="{$fail_state}"/>
    <transition event="udp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.has_ut_response"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="error_no_dut_udp"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and ({$pass_expr})"
                target="pass"/>
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and !({$pass_expr})"
                target="{$fail_state}"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_no_egress"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="{$fail_state}">
    <donedata>
      <content>{"verdict":"fail","reason":"{$fail_reason}"}</content>
    </donedata>
  </final>

  <final id="error_no_dut_udp">
    <donedata>
      <content>{"verdict":"error","reason":"no_dut_originated_udp_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_egress">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_egress_after_ut_confirmation"}</content>
    </donedata>
  </final>
</sce:template>
