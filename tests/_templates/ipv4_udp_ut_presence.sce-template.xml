<?xml version="1.0" encoding="UTF-8"?>
<!--
  §4.4.4.5 UDP-receipt presence/absence shape driven by the DUT's answer to
  the receive question the case put through the Tier-2 seam
  (IUdpReceiveControl::receiveUdp). Shared body for IPv4_ADDRESSING_01
  (positive, limited broadcast, expected_received=1) and IPv4_ADDRESSING_02
  (negative, directed broadcast, expected_received=0).

  The stimulus records the answer in the captured context (receive_answered,
  ut_received) and the runner's stimulus-settled hook raises
  `receive_answered` once, so the machine grades the DUT's own answer and not a
  wire frame that happened to carry it (on the opcode backend, the §4.8.5 Upper
  Tester Confirmation; the §4.4 IPv4 pilot graded that frame before the seam). `receive_answered` is true only for an
  answer the verdict may rest on: the probe was delivered, or its discard was
  proven (the DUT said received=0, or a sentinel datagram sent after the probe
  was delivered and the probe was not). A silence, a refusal and a lost request
  record no answer.

    * pass — the DUT's application layer {$observed_desc}, matching the
      spec-prescribed outcome.
    * fail_wrong_receipt — the DUT answered the opposite.
    * inconclusive_timeout — no answer within 5 s: the DUT's control path is
      absent, the question never reached it, or the window observed nothing it
      could call a discard.
-->
<sce:template xmlns:sce="http://sce.dev/ext"
              xmlns="http://www.w3.org/2005/07/scxml"
              xmlns:cpp="urn:sce:cpp"
              name="ipv4_udp_ut_presence">

  <sce:param name="expected_received"          required="true"/>
  <sce:param name="fail_reason_wrong_receipt"  required="true"/>
  <sce:param name="fail_reason_timeout"        required="true"/>
  <!-- Verdict role for the wrong-receipt fail-final. Positives bind
       observed_violation (the DUT received/dropped against the spec). The
       §4.6.5.4 acceptance `_NEG` siblings bind fault_injection_inert: with the
       ingress accept-fault armed, the wrong-receipt branch fires only when a
       conformant DUT still dropped the datagram (the fault was inert), not an
       IUT violation. Mirrors the udp_field_check fail_role param. -->
  <sce:param name="fail_role"                  required="true"/>

  <sce:context id="captured"
               cpp:type="tc8::UdpCaptured"
               cpp:include="sce_integration/udp_captured.h"/>

  <!--
    Declared for SCE's uniform two-arg state-machine constructor even
    though the guard chain above reads only captured.* fields. The
    UT Confirmation carries the "DUT received?" truth without a
    per-case expected value; the ADDRESSING_01/02 polarity flip is
    baked into the {$expected_received} template parameter instead.
  -->
  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="receive_answered"
                cond="cpp:captured.receive_answered and captured.ut_received == {$expected_received}"
                target="pass"/>
    <transition event="receive_answered"
                cond="cpp:captured.receive_answered and captured.ut_received != {$expected_received}"
                target="fail_wrong_receipt"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_wrong_receipt">
    <donedata>
      <content>{"verdict":"fail","reason":"{$fail_reason_wrong_receipt}","role":"{$fail_role}"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"{$fail_reason_timeout}","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</sce:template>
