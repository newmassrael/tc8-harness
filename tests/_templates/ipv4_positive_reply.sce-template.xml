<?xml version="1.0" encoding="UTF-8"?>
<!--
  §4.4 IPv4 2-state positive-reply shape: TESTER sends an ICMPv4 Echo
  Request (possibly with a field override that the spec says the DUT
  MUST accept), the DUT replies, the SCXML asserts any DUT-originated
  ICMPv4 frame arrives within the listen window.

  Verdicts (docs/verdict_policy.md Section 2.1):

    * pass — DUT-originated Ipv4Frame observed (src_addr ==
      expected.dut_iface_ip).
    * deadline -> fail_no_dut_ipv4_packet: no DUT IPv4 packet with the
      expected source address arrived within the window. The procedure
      states no listen time, so the DUT is granted <ParamListenTime>; a
      window that elapses without the Reply is the DUT's silence where it
      must answer — observed_quiescence, judged against that bound (H3).
      The window is ParamListenTime plus <ParamToleranceTime> (10 s + 1 s
      at the defaults). Whether the silence stands as a fail is the CLI's
      call on the run's hypotheses: an incomplete capture or an unanswered
      liveness anchor makes it inconclusive.

  Shared body for ipv4_header_03 / ipv4_version_01. These are the §4.4
  rows whose pass criterion is simply "DUT: Send ICMP Echo Reply" with
  no extra field observation — the field being observed IS the src_addr
  in HEADER_03, and the spec row's effective assertion in VERSION_01 is
  that the DUT accepts (replies to) the stimulus.

  The BPF group (`BpfGroup::Icmpv4`) restricts the pipeline to ICMP
  packets so the DUT's SOME/IP SD UDP multicast does not trip the
  pass guard — see ipv4_header_01.h for the extended rationale.
-->
<sce:template xmlns:sce="http://sce.dev/ext"
              xmlns="http://www.w3.org/2005/07/scxml"
              xmlns:cpp="urn:sce:cpp"
              name="ipv4_positive_reply">

  <sce:context id="captured"
               cpp:type="tc8::Ipv4Captured"
               cpp:include="sce_integration/ipv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="ipv4_observed"
                cond="cpp:captured.src_addr == expected.dut_iface_ip"
                target="pass"/>
    <transition event="deadline_exceeded" target="fail_no_dut_ipv4_packet"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_dut_ipv4_packet">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ipv4_packet_with_expected_source_address","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</sce:template>
