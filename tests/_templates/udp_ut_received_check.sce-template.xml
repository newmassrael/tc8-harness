<?xml version="1.0" encoding="UTF-8"?>
<!--
  §4.6.5.5 UDP_USER_INTERFACE field-check shape on the DUT's receive answer:
  TESTER injects one UDP probe at the DUT's data port inside a receive window
  (IUdpReceiveControl::receiveUdp), whose answer carries the DUT's observed
  src_ip / src_port / payload bytes back to the harness in-process. The
  stimulus records it in the captured context and the runner's stimulus-settled
  hook raises `receive_answered` once for the machine to grade.

  Conformance verdict model (ISO/IEC 9646 / TTCN-3, same as SOMEIP_ETS_152).
  The verdict is SOUND: it FAILs only on an observed field violation, never
  because the environment failed to drive the DUT into the precondition.

    * pass — the DUT answered (receive_answered), ut_received == 1, AND
      {$pass_expr} (per-case predicate over the `ut_recv_*` fields).
    * fail_field_mismatch (fail) — the DUT answered that it received the
      datagram but {$pass_expr} evaluates false: the harness's view of an
      asserted field disagrees — an observed violation.
    * no_receipt_state — the DUT answered with ut_received == 0: its answer is
      that it did not receive the datagram, proven as a discard (its own
      received=0, or a sentinel delivered after the probe while the probe was
      not). That is a DUT report, not a failed observation vehicle, so it never
      shares the deadline's reason. What it means is
      the consumer's to bind, and there are exactly two coherent bindings:
        - a positive injects a datagram the DUT is REQUIRED to receive, so
          the report is an observed violation: fail_no_receipt / fail /
          observed_violation.
        - a report-fault `_neg` corrupts a field of a RECEIVED datagram, so
          a report of no receipt means the fault never had anything to act
          on: the testable state was not reached, and the fault is neither
          demonstrated nor shown inert: inconclusive_no_receipt /
          inconclusive / precondition_unmet. A `_neg` carries exactly one
          fail final (negative_coverage_audit.py), and it is fail_compliant.
    * deadline -> inconclusive (inconclusive_no_ut_confirmation): no answer
      the verdict may rest on within the 5 s window, so the DUT's reception
      report — the sole observation vehicle — never materialised: the DUT's
      control path produced no result, or the window saw neither the probe
      nor a sentinel (a silence is not a discard). A precondition fault, not
      a field defect. Does not red the conformance gate. It means only
      that: no answer, whatever it would have said, lands here.

  Distinct from `ipv4_udp_ut_presence` whose single hinge is
  `ut_received == {$expected_received}`. UDP_USER_INTERFACE_02/_03/_04
  need both `ut_received == 1` AND a second-axis assertion on the
  payload / src_port / src_ip the DUT reported for the delivered datagram.

  The machine reacts to the stimulus-settled event only, not to wire
  frames, so no frame on the capture (SD multicast included) can drive a
  transition.
-->
<sce:template xmlns:sce="http://sce.dev/ext"
              xmlns="http://www.w3.org/2005/07/scxml"
              xmlns:cpp="urn:sce:cpp"
              name="udp_ut_received_check">

  <sce:param name="pass_expr"               required="true"/>
  <sce:param name="fail_reason_field"       required="true"/>
  <!-- Dual-use (positive + lwIP report-fault `_neg`, mirroring the egress field-check
       templates): the positive passes fail_state="fail_field_mismatch" /
       fail_role="observed_violation"; a `_neg` arms an OpSetAppFlavor report corruption,
       passes pass_expr = the corruption predicate, fail_state="fail_compliant" /
       fail_role="fault_injection_inert" (the DUT reported correctly despite the flavor). -->
  <sce:param name="fail_state"              required="true"/>
  <sce:param name="fail_role"               required="true"/>
  <!-- The ut_received == 0 answer (see the header): a positive binds
       fail_no_receipt / fail / observed_violation, a report-fault `_neg` binds
       inconclusive_no_receipt / inconclusive / precondition_unmet.
       verdict_drift_audit.py holds the verdict to the role. -->
  <sce:param name="no_receipt_state"        required="true"/>
  <sce:param name="no_receipt_verdict"      required="true"/>
  <sce:param name="no_receipt_role"         required="true"/>

  <sce:context id="captured"
               cpp:type="tc8::UdpCaptured"
               cpp:include="sce_integration/udp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="receive_answered"
                cond="cpp:captured.receive_answered and captured.ut_received == 1 and ({$pass_expr})"
                target="pass"/>
    <transition event="receive_answered"
                cond="cpp:captured.receive_answered and captured.ut_received == 1 and !({$pass_expr})"
                target="{$fail_state}"/>
    <transition event="receive_answered"
                cond="cpp:captured.receive_answered and captured.ut_received == 0"
                target="{$no_receipt_state}"/>
    <transition event="deadline_exceeded" target="inconclusive_no_ut_confirmation"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="{$fail_state}">
    <donedata>
      <content>{"verdict":"fail","reason":"{$fail_reason_field}","role":"{$fail_role}"}</content>
    </donedata>
  </final>

  <final id="{$no_receipt_state}">
    <donedata>
      <content>{"verdict":"{$no_receipt_verdict}","reason":"dut_reported_no_receipt","role":"{$no_receipt_role}"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_ut_confirmation">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_ut_confirmation_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</sce:template>
