<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_06, iteration 2 of 2: a DUT in SYN-SENT MUST drop a segment
  with neither SYN nor RST flag set and remain in the same state, even if the ACK number is
  acceptable. Derived from RFC 793 §3.9 p68 Event Processing (MUST).

  A case of its own beside tcp_flags_invalid_06_it1, which holds the shared description and
  the pass criterion; the two differ in whether the segment carries data, and in their port
  quads.

  This iteration: <stp> = data (an ACK with a 4-byte payload), with an acceptable ACK (= ISN_d
  + 1 in SYN-SENT) and neither SYN nor RST set. The payload is dropped along with the segment
  because the DUT only buffers data once the connection is established.

  The DUT-SYN window sets up the state the probe tests, so it stays inconclusive when the DUT
  never opens: the DUT's wire behaviour is not under test until it is in SYN-SENT.

  ## Port-quad selection — kBasicsActiveLocalPort + 25

  Cross-case isolation as in the first iteration; +25 is clear of 15 and
  FLAGS_INVALID_03/04/05 and of the first iteration's +24.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_06_it2"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_dut_syn">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <!-- ACK with payload on (kBasicsActiveLocalPort + 1, kBasicsActiveRemotePort + 1) -->
  <state id="listening_dut_syn">
    <onentry>
      <send event="deadline_dut_syn" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid06Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid06Phase2LocalOffset)"
                target="listening_absence"/>
    <transition event="deadline_dut_syn" target="inconclusive_no_dut_syn"/>
  </state>

  <state id="listening_absence">
    <onentry>
      <send event="deadline_absence" delay="3s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid06Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid06Phase2LocalOffset) or captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid06Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid06Phase2LocalOffset)"
                target="fail_unexpected_response"/>
    <transition event="deadline_absence" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_syn">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_syn_ack_with_payload","role":"precondition_unmet"}</content>
    </donedata>
  </final>
  <final id="fail_unexpected_response">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_response_to_ack_with_payload_acceptable_ack","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
