<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.4 TCP_CALL_RECEIVE_04: For RECEIVE call in ESTABLISHED /
  FIN-WAIT-1 / FIN-WAIT-2 state, TCP MUST reassemble queued incoming
  segments and return them to the application. Derived from
  RFC 793 §3.9 p58 Event Processing (MUST).

  v3.0 Test Procedure (p322):
    1. TESTER: Cause the DUT to move on to the <wst> state
    2. TESTER: Send <nss> small <ssz> data segments
    3. TESTER: Cause RECEIVE call with buffer > <nss>*<ssz>
    4. DUT:    Issues a RECEIVE call
    5. TESTER: Verify reassembled data is returned

  Iterations: <wst> ∈ {ESTABLISHED, FIN-WAIT-1, FIN-WAIT-2}.

  Mechanism (3 phases × distinct port quads):
    * Phase 1 EST (+95): drive the DUT through an active OPEN to
      ESTABLISHED → inject 4 × 32 B → DUT application RECEIVE drains
      128 B → match → captured.ut_received_payload_len_p1=128.
    * Phase 2 FW1 (+96): with the tester auto-ACK withheld, the DUT
      application half-closes its write side → DUT FIN → inject
      4 × 32 B with a non-acking ack (= rcv_nxt-1 = SND.UNA, in
      [snd.una, snd.nxt) acceptable, doesn't ack the DUT FIN) → DUT
      application RECEIVE drains 128 B → match →
      ut_received_payload_len_p2=128.
    * Phase 3 FW2 (+97): the DUT application half-closes its write
      side → tester auto-ACK drives DUT FW1→FW2 (auto-ACK NOT
      withheld here) → inject 4 × 32 B (ack=rcv_nxt already acks the
      DUT FIN) → DUT application RECEIVE drains 128 B → match →
      ut_received_payload_len_p3=128.

  Phase 1 stimulus runs INLINE; phases 2 + 3 are deferred to the
  matching SCXML observation state so the per-phase wire events
  arrive AFTER SCXML has armed the corresponding listening
  transitions. Mirrors TCP_FLAGS_PROCESSING_02 /
  IPv4_FRAGMENTS_01..04 phasing.

  SCXML chain (8 listening states + 8 fail terminals + pass):
    p1_handshake_ack → p1_complete →
    p2_handshake_ack → p2_dut_fin → p2_complete →
    p3_handshake_ack → p3_dut_fin → p3_complete → pass

  Per-phase complete state: 5 s deadline; transition's conjunct
  checks ut_received_payload_len_pN == 128U on deadline. Sentinel
  0xFFFFU otherwise routes to fail_pN_no_proper_data. The state
  intentionally has NO tcp_observed transition — DUT's data-ACK(s)
  during the recv window are absorbed without affecting verdict;
  the data ACK is implicit in "UT recv returned the bytes".

  Negative IP-flip path: src_ip-conjunct on listening_p1_handshake_ack
  unreachable → inconclusive_p1_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_call_receive_04"
       datamodel="null"
       initial="listening_p1_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake_ack">
    <onentry><send event="deadline_p1_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallReceive04Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallReceive04Phase1LocalOffset)"
                target="listening_p1_complete"/>
    <transition event="deadline_p1_handshake_ack" target="inconclusive_p1_no_handshake_ack"/>
  </state>

  <state id="listening_p1_complete">
    <onentry><send event="deadline_p1_complete" delay="5s"/></onentry>
    <transition event="deadline_p1_complete"
                cond="cpp:captured.ut_received_payload_len_p1 == 128U"
                target="listening_p2_handshake_ack"/>
    <transition event="deadline_p1_complete" target="inconclusive_p1_no_proper_data"/>
  </state>

  <state id="listening_p2_handshake_ack">
    <onentry><send event="deadline_p2_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallReceive04Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallReceive04Phase2LocalOffset)"
                target="listening_p2_dut_fin"/>
    <transition event="deadline_p2_handshake_ack" target="inconclusive_p2_no_handshake_ack"/>
  </state>

  <state id="listening_p2_dut_fin">
    <onentry><send event="deadline_p2_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallReceive04Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallReceive04Phase2LocalOffset)"
                target="listening_p2_complete"/>
    <transition event="deadline_p2_dut_fin" target="inconclusive_p2_no_dut_fin"/>
  </state>

  <state id="listening_p2_complete">
    <onentry><send event="deadline_p2_complete" delay="5s"/></onentry>
    <transition event="deadline_p2_complete"
                cond="cpp:captured.ut_received_payload_len_p2 == 128U"
                target="listening_p3_handshake_ack"/>
    <transition event="deadline_p2_complete" target="inconclusive_p2_no_proper_data"/>
  </state>

  <state id="listening_p3_handshake_ack">
    <onentry><send event="deadline_p3_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallReceive04Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallReceive04Phase3LocalOffset)"
                target="listening_p3_dut_fin"/>
    <transition event="deadline_p3_handshake_ack" target="inconclusive_p3_no_handshake_ack"/>
  </state>

  <state id="listening_p3_dut_fin">
    <onentry><send event="deadline_p3_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallReceive04Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallReceive04Phase3LocalOffset)"
                target="listening_p3_complete"/>
    <transition event="deadline_p3_dut_fin" target="inconclusive_p3_no_dut_fin"/>
  </state>

  <state id="listening_p3_complete">
    <onentry><send event="deadline_p3_complete" delay="5s"/></onentry>
    <transition event="deadline_p3_complete"
                cond="cpp:captured.ut_received_payload_len_p3 == 128U"
                target="pass"/>
    <transition event="deadline_p3_complete" target="inconclusive_p3_no_proper_data"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_p1_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase1_est","role":"precondition_unmet"}</content></donedata>
  </final>

  <final id="inconclusive_p1_no_proper_data">
    <donedata><content>{"verdict":"inconclusive","reason":"dut_did_not_receive_proper_data_phase1_est","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p2_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase2_fw1","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p2_no_dut_fin">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase2_fw1","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p2_no_proper_data">
    <donedata><content>{"verdict":"inconclusive","reason":"dut_did_not_receive_proper_data_phase2_fw1","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p3_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase3_fw2","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p3_no_dut_fin">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase3_fw2","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p3_no_proper_data">
    <donedata><content>{"verdict":"inconclusive","reason":"dut_did_not_receive_proper_data_phase3_fw2","role":"property_unobserved"}</content></donedata>
  </final>
</scxml>
