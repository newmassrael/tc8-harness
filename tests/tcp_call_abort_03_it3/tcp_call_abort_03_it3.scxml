<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.5 TCP_CALL_ABORT_03, iteration 3 of 3: a DUT in TIME-WAIT whose application
  aborts the connection MUST report success to that application and end up CLOSED. Derived
  from RFC 793 §3.9 p62 Event Processing (MUST).

  The iteration is a case of its own: the TC8 case is the ordered set of its iterations
  and its verdict their conjunction (case_iteration.h). The first parks the DUT in CLOSING
  (tcp_call_abort_03_it1) and the second in LAST-ACK (tcp_call_abort_03_it2); they share the
  closing abort and the verify-probe (_tcp_call_abort_03_common.h) and differ in the
  procedure that reaches the state, and in their port quads.

  Case shape:
    the tester walks the DUT into TIME-WAIT and has the DUT-side application abort. Two things
    must follow: the abort call reports success back to that application, and the connection
    ends up CLOSED.

  Mechanism (port quad +93): the DUT application half-closes its write side -> DUT FIN ->
  tester auto-ACK -> DUT FW1->FW2. Tester half-close -> tester FIN -> DUT FW2->TIME-WAIT (DUT
  pure ACK). DUT application ABORT on the TIME-WAIT socket. Linux's TIME-WAIT bucket may not
  emit RST on close, so the verify-probe ACK is the wire-observable pass criterion.

  The iteration ends with a verify-probe ACK injected on the killed 4-tuple as
  listening_verify_rst is entered. The DUT-side socket is gone, so the DUT emits a closed-port
  RST, which satisfies "DUT moves to CLOSED" even though the ABORT itself is silent here.

  SCXML chain (3 listening states + 2 fail/inconclusive terminals + pass):
    handshake_ack -> settle (5 s absorb prelude+abort egress) ->
    verify_rst (11 s; verify-probe ACK fired on entry, observe DUT closed-port RST) -> pass

  Negative IP-flip path: src_ip-conjunct on listening_handshake_ack unreachable ->
  inconclusive_no_handshake_ack.

  The closed-port RST is the case's evidence for Pass Criteria #5 (the RFC 793 §3.9
  CLOSED-state reset), and the TCP chapter states no time for it, so a verify_rst window that
  elapses without it is the DUT's silence where it must emit: observed_quiescence, judged
  against <ParamListenTime> (docs/verdict_policy.md Section 2.1, H3). The window is
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the defaults). The handshake ACK
  sets up the TIME-WAIT state, so its silence is precondition_unmet: nothing earlier in this
  case has shown the DUT able to complete a handshake.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_call_abort_03_it3"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset)"
                target="listening_settle"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_settle">
    <onentry><send event="deadline_settle" delay="5s"/></onentry>
    <transition event="deadline_settle" target="listening_verify_rst"/>
  </state>

  <state id="listening_verify_rst">
    <onentry><send event="deadline_verify_rst" delay="11s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset)"
                target="pass"/>
    <transition event="deadline_verify_rst" target="fail_no_close"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_time_wait","role":"precondition_unmet"}</content></donedata>
  </final>

  <final id="fail_no_close">
    <donedata><content>{"verdict":"fail","reason":"dut_did_not_close_after_abort_in_time_wait","role":"observed_quiescence","bound":"ParamListenTime"}</content></donedata>
  </final>
</scxml>
