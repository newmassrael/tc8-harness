<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.4 IPv4_AUTOCONF_CONFLICT_11 negative — closes the
  self-reference trap on the positive CONFLICT_11 case. tc8-dut runs
  the LL claim via OpStartLLAutoconfBuggy(flavor=ReplyEthDstUnicast):
  its defending ARP Reply is sent to the asker's unicast MAC instead
  of the Ethernet broadcast, violating RFC 3927 §2.5 last MUST (any
  ARP packet whose sender_proto_ip is in 169.254/16 MUST be broadcast).

  Same two-phase wiring as the positive CONFLICT_11: pre_claim →
  post_claim on the first DUT Announce; the shared
  scheduleClaimConditionTesterRequest observer queries the committed
  LL, snapshots it into expected_responder_sender_ip_be, and emits the
  AIFACE-LL claim-condition ARP Request. The DUT responder then emits
  the (buggy) Reply — sender_proto_ip is still the committed LL (only
  the L2 dst is mutated), so the reply is identified by the full
  correct L3 fields and the violation is the non-broadcast eth_dst.

  Pass = the unicast eth_dst is detected. fail_compliant_emit =
  tc8-dut ignored the flavor and emitted a broadcast Reply, so the
  harness would have silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_conflict_11_neg"
       datamodel="null"
       initial="listening_pre_claim">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening_pre_claim">
    <onentry>
      <send event="claim_deadline" delay="6s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_announce()"
                target="listening_post_claim"/>
    <transition event="claim_deadline" target="inconclusive_no_claim_observed"/>
  </state>

  <state id="listening_post_claim">
    <onentry>
      <send event="reply_deadline" delay="3s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply() and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip == captured.expected_responder_sender_ip_be and captured.target_proto_ip == expected.tester_linklocal_ip and captured.expected_responder_sender_ip_be != 0 and !captured.is_eth_broadcast()"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply() and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip == captured.expected_responder_sender_ip_be and captured.target_proto_ip == expected.tester_linklocal_ip and captured.expected_responder_sender_ip_be != 0 and captured.is_eth_broadcast()"
                target="fail_compliant_emit"/>
    <transition event="reply_deadline" target="inconclusive_no_responder_reply"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_claim_observed">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_announce_committed_link_local_address","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_responder_reply">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_emit_arp_reply_for_claim_address","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_emit">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_broadcast_reply_despite_reply_eth_dst_unicast_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
