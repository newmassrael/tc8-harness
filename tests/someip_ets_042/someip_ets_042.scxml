<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_042: echoUTF16DYNAMIC_length_too_short_for_String.

  Tester sends echoUTF16DYNAMIC (METHOD-ID 0x0016) Method Request whose
  SOME/IP Length header undershoots the actual UDP payload. Stimulus
  carries the ETS_039 12-byte UTF-16 BE baseline ("hi" + BOM + null),
  but length_override = 0x0A claims only 10 bytes follow Length (= 8
  Request-ID-tail + 2 payload), well short of the 20 actually
  delivered. Spec wording is strict ("DUT: returns Error Message
  MALFORMED_MESSAGE", PRS_SOMEIP_00372), but the lenient ETS_001/_002
  verdict pattern accepts Error Response, non-zero return_code, OR
  silent ignore — vsomeip's length-mismatch path may drop the frame
  before dispatch.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Error Response, Method Response with
            non-zero return_code, or deadline -> pass. Method Response
            with return_code 0x00 -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_042"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0016 and captured.message_type == 0x81"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0016 and captured.message_type == 0x80 and captured.return_code != 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0016 and captured.message_type == 0x80 and captured.return_code == 0x00"
                target="fail_phase2_dut_accepted_malformed"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_accepted_malformed">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_returned_ok_response_for_undersized_length_field"}</content>
    </donedata>
  </final>
</scxml>
