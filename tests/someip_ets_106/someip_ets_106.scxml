<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_106: SD_ClientServiceSubscribeEventgroup.

  Per spec: Client Mode is activated on the DUT and it must subscribe to
  the Tester. Stimulus chain matches ETS_082's pattern (UDP variant) but
  without the simulated server reboot:
    1. emitFindServiceBoot — SERVICE-ID-1 server warm-up.
    2. clientServiceActivate (Method 0x2F).
    3. clientServiceSubscribeEventgroup (Method 0x32) — wires up Subscribe.
    4. OfferServiceMulticastWithEndpoint(ets3 0xF4E9, UDP, port=30510).
    5. DUT-side proxy emits SubscribeEventgroup carrying a UDP IPv4
       Endpoint Option.

  Per PRS_SOMEIPSD_00386 / 00387 / 00391 the DUT shall emit one
  SubscribeEventgroup once both the activate trigger and the matching
  Offer arrive.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): DUT-emitted Type 0x06 SubscribeEventgroup
            for ets3 0xF4E9 with at least one UDP IPv4 Endpoint Option.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_106"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="12s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x06 and captured.sd_entries[0].service_id == 0xF4E9 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_option_count >= 1 and captured.sd_options[0].type == 0x04 and captured.sd_options[0].l4_proto == 0x11"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_dut_subscribe"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_dut_subscribe">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_emit_subscribe_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
