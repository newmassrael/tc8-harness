<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_003: Array_Length_too_short_strips_Payload.

  Tester sends an echoUINT8 Method Request with NO payload bytes (empty
  body) — Length header = 8, UDP datagram carries only the 16-byte
  SOME/IP header. CommonAPI's UInt8 deserializer cannot satisfy the
  echoUINT8 input parameter; per PRS_SOMEIP_00099 the DUT must respond
  with a Method Response carrying a stripped (empty) payload.

    Phase 1: OfferService observation.
    Phase 2: Method Response (msg_type 0x80) on method_id 0x0008 with
             payload_len == 0 → pass. An Error Response (msg_type 0x81
             / return_code != 0x00) also passes — both behaviors prevent
             the DUT from propagating malformed input back to the
             caller, satisfying the spec's underlying invariant.
             A normal echo (payload_len > 0 with non-zero data) → fail.
             No response within the deadline → fail (this case has no
             "ignore = pass" relaxation in the spec Notes).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_003"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0008 and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.payload_len == 0"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0008 and captured.message_type == 0x81"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0008 and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.payload_len > 0"
                target="fail_phase2_payload_not_stripped"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_payload_not_stripped">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_response_payload_was_not_stripped_for_short_array_length","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
