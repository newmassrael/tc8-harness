<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_07: TCP, in SYN-RCVD state, MUST send
  an ACK with next expected SEQ number after receiving any segment
  (without RST) with OTW SEQ number and remain in the same state.
  Derived from RFC 793 §3.9 p69 Event Processing (MUST).

  v3.0 Test Procedure (p332) lists 5 iterations (RST=0 across all):
    * CASE 1: flag set = SYN
    * CASE 2: flag set = SYN, ACK
    * CASE 3: flag set = ACK
    * CASE 4: flag set = FIN
    * CASE 5: flag set = Data segment

  Per phase the stimulus drives DUT into SYN-RCVD via passive open +
  raw-injected SYN (port quad = listen_port+N ↔ tester_port+N for
  N in 0..4) so the spec-targeted "remains in SYN-RCVD" hold is
  per-phase and probes cannot cross-contaminate. ISN_d is learned
  via TcpFrameSnippet on the DUT-emitted SYN+ACK so the probe's
  ack_num = ISN_d + 1 (acceptable per RFC 793 §3.4) — the OTW SEQ
  is the only "bad" attribute, isolating Linux's `tcp_check_req`
  challenge-ACK path. Each phase is observed via a single listening
  state matching the DUT-emitted pure ACK on its port quad — the
  earlier SYN+ACK from the same phase carries SYN bit set and is
  filtered out of `is_pure_dut_ack`.

  Per-phase fail terminals split the chain by case so smoke-test
  triage identifies exactly which CASE flag set the DUT failed to
  acknowledge — useful for documenting Linux deviations
  case-by-case as we have done for FLAGS_INVALID_12 / UNACCEPTABLE
  CASE 2 silent-drop patterns. CASE 4 = FIN+ACK (not bare FIN):
  Linux's tcp_v4_rcv drops bare FIN before reaching tcp_check_req's
  OTW-SEQ branch, mirroring the 08~13 cluster convention. CASE 2
  (SYN+ACK) is the empirical-risk case in this state: Linux's
  tcp_check_req has a special handling path for SYN+ACK arriving on
  a request_sock; if this case's probe_ack times out empirically,
  the case will be reduced to 4 phases (CASE 1/3/4/5) with this
  preamble updated to document the deviation.

  Negative smoke (ipv4.dut_iface_ip flip): pass guard's
  `captured.src_ip == expected.dut_iface_ip` becomes unreachable on
  phase 1's listening state, so the negative path lands on
  fail_p1_no_probe_ack with the harness watchdog cap absorbing the
  5 s SCXML deadline + ~2 s passive-open + raw-inject stimulus.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_07"
       datamodel="null"
       initial="listening_p1_probe_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_probe_ack">
    <onentry>
      <send event="deadline_p1_probe_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsListenPort, ::tc8::sce::tcp::kBasicsTesterPort) and captured.ack_num == captured.expected_ack_num"
                target="listening_p2_probe_ack"/>
    <transition event="deadline_p1_probe_ack" target="fail_p1_no_probe_ack"/>
  </state>

  <state id="listening_p2_probe_ack">
    <onentry>
      <send event="deadline_p2_probe_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsListenPort + 1U, ::tc8::sce::tcp::kBasicsTesterPort + 1U) and captured.ack_num == captured.expected_ack_num"
                target="listening_p3_probe_ack"/>
    <transition event="deadline_p2_probe_ack" target="fail_p2_no_probe_ack"/>
  </state>

  <state id="listening_p3_probe_ack">
    <onentry>
      <send event="deadline_p3_probe_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsListenPort + 2U, ::tc8::sce::tcp::kBasicsTesterPort + 2U) and captured.ack_num == captured.expected_ack_num"
                target="listening_p4_probe_ack"/>
    <transition event="deadline_p3_probe_ack" target="fail_p3_no_probe_ack"/>
  </state>

  <state id="listening_p4_probe_ack">
    <onentry>
      <send event="deadline_p4_probe_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsListenPort + 3U, ::tc8::sce::tcp::kBasicsTesterPort + 3U) and captured.ack_num == captured.expected_ack_num"
                target="listening_p5_probe_ack"/>
    <transition event="deadline_p4_probe_ack" target="fail_p4_no_probe_ack"/>
  </state>

  <state id="listening_p5_probe_ack">
    <onentry>
      <send event="deadline_p5_probe_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsListenPort + 4U, ::tc8::sce::tcp::kBasicsTesterPort + 4U) and captured.ack_num == captured.expected_ack_num"
                target="pass"/>
    <transition event="deadline_p5_probe_ack" target="fail_p5_no_probe_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_p1_no_probe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_syn_in_syn_recv"}</content>
    </donedata>
  </final>

  <final id="fail_p2_no_probe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_synack_in_syn_recv"}</content>
    </donedata>
  </final>

  <final id="fail_p3_no_probe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_ack_in_syn_recv"}</content>
    </donedata>
  </final>

  <final id="fail_p4_no_probe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_fin_in_syn_recv"}</content>
    </donedata>
  </final>

  <final id="fail_p5_no_probe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_data_in_syn_recv"}</content>
    </donedata>
  </final>
</scxml>
