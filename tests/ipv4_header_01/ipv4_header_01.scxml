<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.1 IPv4_HEADER_01: the DUT's IPv4 packet carries a Total
  Length >= 20 (RFC 791 minimum header size).

  Body shared with IPv4_VERSION_03 / IPv4_TTL_01 via sce:template
  (see tests/_templates/ipv4_field_check.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_header_01"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_field_check.sce-template.xml"
           pass_expr="captured.total_length &gt;= 20"
           fail_state="fail_total_length"
           fail_reason="total_length_below_rfc791_minimum"/>
</scxml>
