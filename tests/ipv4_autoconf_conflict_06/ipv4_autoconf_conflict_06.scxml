<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.4 IPv4_AUTOCONF_CONFLICT_06: usage cease condition - I
  (RFC 3927 §2.5 MUST). Tester injects two ARP Request frames whose
  sender_ip == target_ip == DUT's committed LL within
  DEFEND_INTERVAL/2; the always-cease branch (RFC 3927 §2.5
  method 1) requires the DUT to abandon the LL on the first
  conflict and re-enter Phase 1. Pass criterion: a fresh DUT Probe
  whose target ≠ original LL lands within the post_claim deadline.

  Trait wiring (see ipv4_autoconf_conflict_06.h):
    scheduleDefenderCeaseConflicts(opcode1=Request, opcode2=Request)
    on listening_post_claim entry.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_conflict_06"
       datamodel="null"
       initial="listening_pre_claim">
  <sce:use template="../_templates/ipv4_linklocal_defender_cease.sce-template.xml"/>
</scxml>
