<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_100: SD_ClientServiceActivate_no_FindServices_
  in_Main_Phase.

  After clientServiceActivate, the DUT must emit FindService during the
  Start-Up Phase ONLY; the Main Phase must carry no FindService for the
  client-side target service. Per PRS_SOMEIPSD_00351 — the spec separates
  the SD client lifecycle into a Repetition Phase (small number of bursts
  with exponentially-doubling delay) and a Main Phase (cyclic OfferService
  by the server, no client-side FindService).

  The DUT firmware's `ClientModeRunner` (client_mode.cpp) implements this
  by emitting kRepetitionsMax+1 = 4 FindService bursts (50 ms, then
  +200/+400/+800 ms doublings ≈ 1.5 s wall-clock), then idling. The
  test verifies both halves of the assertion in two windows:

  Conformance verdict model (ISO/IEC 9646 / TTCN-3, same as SOMEIP_ETS_152).
  The verdict is SOUND: it FAILs only on an observed Main-Phase FindService
  (phase 4), never because the environment failed to drive the DUT into the
  observable precondition.

    Phase 1 (listening_phase1): SD warm-up — OfferService for SERVICE-ID-1.
            Deadline → inconclusive (inconclusive_no_offer): the SD stack never reached
            the wire (precondition fault, e.g. heavy-stack startup), not a
            FindService defect.
    Phase 2 (listening_phase2_first_find): observe first FindService on
            SERVICE-ID-2 → advance into burst-absorption. Deadline →
            inconclusive (inconclusive_no_findservice): the DUT was proven
            live by its phase-1 offer, but the transient Start-Up-Phase
            burst (~1.5 s) was not captured in window, so the Main-Phase-
            absence assertion could not be reached. Not a FAIL.
    Phase 3 (listening_phase3_burst_window): wait 3 s, swallowing further
            FindService events (the Repetition Phase is allowed to fire
            multiple bursts). Deadline → advance to absence window.
    Phase 4 (listening_phase4_main_phase_absence): 4 s absence window.
            Any FindService for SERVICE-ID-2 = fail (Main-Phase emit, the
            sole observed violation). Deadline = pass.

  Reference: PRS_SOMEIPSD_00351.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_100"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.is_offer_service_for(expected.service_id)"
                target="listening_phase2_first_find"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_no_offer"/>
  </state>

  <state id="listening_phase2_first_find">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x00 and captured.sd_entries[0].service_id == 0xF4E8"
                target="listening_phase3_burst_window"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_no_findservice"/>
  </state>

  <state id="listening_phase3_burst_window">
    <onentry>
      <send event="phase3_burst_window_done" delay="3s"/>
    </onentry>
    <!-- Swallow further FindService events during the Repetition Phase
         absorption window. No matching `someip_notification` transition
         means SCXML drops the event; we stay in this state until the
         3 s deadline elapses. -->
    <transition event="phase3_burst_window_done" target="listening_phase4_main_phase_absence"/>
  </state>

  <state id="listening_phase4_main_phase_absence">
    <onentry>
      <send event="phase4_absence_window_done" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x00 and captured.sd_entries[0].service_id == 0xF4E8"
                target="fail_phase4_findservice_in_main_phase"/>
    <transition event="phase4_absence_window_done" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_findservice">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_findservice_during_start_phase","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_phase4_findservice_in_main_phase">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_findservice_observed_during_main_phase","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
