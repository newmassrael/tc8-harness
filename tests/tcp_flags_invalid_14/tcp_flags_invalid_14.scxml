<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_14: TCP, in TIME-WAIT state, MUST
  send an ACK with next expected SEQ number after receiving any
  segment with OTW SEQ number and remain in the same state. Derived
  from RFC 793 §3.9 p69 Event Processing (MUST).

  v3.0 Test Procedure (p321-p340.txt:707), two iterations:
    * CASE 1: flag set = FIN.
    * CASE 2: flag set = Data segment.

  Both iterations carry an OTW SEQ value. Linux's
  tcp_timewait_state_process responds with an empty ACK regardless
  of the segment's flag (FIN / data); the connection's TIME-WAIT
  socket structure remains in the kernel until 2*MSL expires.

  See tests/_templates/tcp_time_wait_dual_phase_otw_probe.sce-template.xml
  for the shared 8-state observation chain. Per-case thin-shell
  binds the two probe-state fail reason strings — FLAGS_INVALID_14
  distinguishes phase 1 (FIN with OTW SEQ) from phase 2 (data with
  OTW SEQ); the wire-level shape is identical to UNACCEPTABLE_13's
  per-phase probe ACK observation.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_14"
       datamodel="null"
       initial="listening_p1_handshake">
  <sce:use template="../_templates/tcp_time_wait_dual_phase_otw_probe.sce-template.xml"
           p1_probe_fail_reason="no_dut_ack_to_otw_fin_in_time_wait"
           p2_probe_fail_reason="no_dut_ack_to_otw_data_in_time_wait"/>
</scxml>
