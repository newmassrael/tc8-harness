<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_151: SD_Send_triggerEventUINT8Reliable_Eventgroup_2.

  Faithful reliable-EVENT observation (eventgroup deviates — see below).
  The tester opens a live TCP connection to the DUT's reliable
  endpoint (SubscribeEventgroupTcpSession), subscribes eventgroup 0x0007
  carrying an IPv4 Endpoint option that advertises that TCP endpoint
  (l4proto 0x06), then calls triggerEventUINT8Reliable (Method 0x05). The
  DUT must Ack the Subscribe and deliver TestEventUINT8Reliable (Event
  0x8003) as a NOTIFICATION over the held TCP connection — vsomeip pushes
  reliable events back over the tcp_server_endpoint connection the
  subscriber opened (routing_manager_impl normalises the subscriber's
  reliable port to the server's own), so a client-initiated TCP session is
  what makes the reliable event observable.

  Spec-faithful observation: phase 3 matches the specific Event 0x8003, so
  the always-on cyclic TestEventUINT8 (0x8001, UDP) does NOT satisfy it;
  only the triggered reliable event over TCP does. This is the wire proof
  that triggerEventUINT8Reliable drives TestEventUINT8Reliable over TCP.

  EVENTGROUP DEVIATION (residual debt): the spec places 0x8003 on eg 0x02
  mixed with the unreliable events, which vsomeip NACKs for a UDP-only
  Subscribe; the harness isolates 0x8003 in a reliable-only eg 0x0007 (see
  ets.fdepl) so it stays subscribable. The SD builder CAN already emit a
  multi-option (UDP+TCP) Subscribe (someip_ets_173), so the residual gap is
  moving 0x8003 back onto eg 0x02 in ets.fdepl — which would force the
  eg-0x02 UDP-only subscribers onto the dual-endpoint form — not a missing
  builder capability. Until then this case observes 0x8003 on eg 0x0007.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1
            with sd_ipv4_endpoint_count >= 1.
    Phase 2 (listening_phase2): SubscribeEventgroupAck for eventgroup
            0x0007 (Type 2 entry, ttl > 0). ttl == 0 -> Nack -> fail.
    Phase 3 (listening_phase3): Notification carrying Event 0x8003
            (TestEventUINT8Reliable) on SERVICE-ID-1, delivered over TCP.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_151"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_ipv4_endpoint_count >= 1"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer_with_endpoint"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="listening_phase3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0"
                target="fail_phase2_subscribe_nacked"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_subscribe_ack"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x02 and captured.method_id == 0x8003 and captured.src_port == expected.tcp_port"
                target="pass"/>
    <transition event="phase3_deadline_exceeded" target="inconclusive_phase3_no_notification"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer_with_endpoint">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_with_ipv4_endpoint_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"subscribe_eventgroup_nacked_ttl_zero","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_subscribe_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_subscribe_ack_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase3_no_notification">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_testeventuint8reliable_0x8003_over_tcp_after_trigger_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
