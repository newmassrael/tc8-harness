<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_151: SD_Send_triggerEventUINT8Reliable_Eventgroup_2.

  LENIENT — NOT YET FAITHFUL (tracked debt). The faithful case would
  trigger triggerEventUINT8Reliable (Method 0x05) and observe
  TestEventUINT8Reliable (Event 0x8003) delivered over TCP. That needs
  the tester to issue a Subscribe carrying BOTH a UDP and a valid TCP
  endpoint option (mixed-reliability eventgroup) and to listen on TCP
  for the delivery — the dual-endpoint Subscribe the SD builder does
  not yet have. Until then, 0x8003 is isolated in eg 0x0007 (see
  ets.fdepl) and this case stays lenient: it subscribes eg 0x02 and
  accepts the always-on cyclic TestEventUINT8 (0x8001, MSB set) per the
  BASIC_03 lenient pattern, verifying only the SD Ack — NOT the
  reliable event. Sibling 148/149/150 ARE faithful; 151 is the one
  still gated on the dual-endpoint Subscribe. Do not count this as
  reliable-event coverage.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1
            with sd_ipv4_endpoint_count >= 1.
    Phase 2 (listening_phase2): SubscribeEventgroupAck for eventgroup
            0x0002 (Type 2 entry, ttl > 0). ttl == 0 -> Nack -> fail.
    Phase 3 (listening_phase3): any Notification with method_id high
            bit set (0x8000) on SERVICE-ID-1 — lenient match, NOT the
            reliable Event 0x8003.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_151"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_ipv4_endpoint_count >= 1"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer_with_endpoint"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="listening_phase3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0"
                target="fail_phase2_subscribe_nacked"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_subscribe_ack"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x02 and (captured.method_id &amp; 0x8000) == 0x8000"
                target="pass"/>
    <transition event="phase3_deadline_exceeded" target="inconclusive_phase3_no_notification"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer_with_endpoint">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_with_ipv4_endpoint_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"subscribe_eventgroup_nacked_ttl_zero","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_subscribe_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_subscribe_ack_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase3_no_notification">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_notification_with_event_msb_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
