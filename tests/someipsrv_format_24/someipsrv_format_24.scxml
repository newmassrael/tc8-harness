<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.24 SOMEIPSRV_FORMAT_24: Instance ID field of the Type 2
  entry shall carry the configured SERVICE-ID-1-INSTANCE-ID
  (SdServerServiceInstanceID). Injected at runtime via CLI option
  expect instance_id=<hex> into expected.instance_id.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_24"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].instance_id == expected.instance_id"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].instance_id != expected.instance_id"
                target="fail_instance_id"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_instance_id">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_instance_id_mismatch","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_ack_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
