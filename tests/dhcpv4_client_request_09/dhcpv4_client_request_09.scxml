<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_09: DHCPREQUEST generated during
  REBINDING state — 'server identifier' (Option 54) MUST NOT be filled
  (RFC 2131 §4.3.6 table 5).

  Case shape:
    an OFFER and ACK take the DUT to BOUND; T1 takes it to RENEWING,
    and leaving that REQUEST unanswered takes it on to REBINDING at T2.
    The REQUEST it sends from there must not carry Option 54 — a
    rebinding client is no longer addressing one particular server.

  RFC 2131 §4.3.6 table 5: 'server identifier' option is MUST NOT for
  DHCPREQUEST in RENEWING / REBINDING. The same invariant as REQUEST_06
  but observed on the REBINDING REQUEST after T2 fires.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_09"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_request_field.sce-template.xml"
           pass_expr="captured.option_absent(54)"
           fail_state="fail_rebinding_request_carries_server_id"
           fail_reason="dut_rebinding_request_carries_server_id"
           fail_role="observed_violation"/>
</scxml>
