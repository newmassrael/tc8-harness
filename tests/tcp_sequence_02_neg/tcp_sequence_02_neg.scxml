<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.17 TCP_SEQUENCE_02 negative — lwIP egress self-validation of the positive
  _02 "from SYN-SENT the DUT ACKs the tester's ISN+1" guard. The observed ack is the
  DUT's first pure ACK (its response to the injected SYN,ACK); the DUT's own SYN is not a
  pure ACK, so the trait arms kTcpFaultPureAckNumWrong up front (arm-before) and corrupts
  only that ACK. Pass = the ack_num does NOT equal tester ISN+1 (the injected violation);
  fail_compliant = the DUT acked ISN+1 despite the flavor (fault inert). lwIP-only
  (kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_sequence_02_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpSequence02LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpSequence02LocalOffset)"
           pass_expr="captured.ack_num != ::tc8::sce::tcp::kTesterInitialSeq + 1U"
           fail_state="fail_compliant"
           fail_reason="dut_ack_num_correct_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_ack_to_synack_within_listen_window"/>
</scxml>
