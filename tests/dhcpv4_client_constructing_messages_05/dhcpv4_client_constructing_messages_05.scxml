<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.6 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_05:
    the client MUST read options out of the 'sname' field when Option
    Overload says they are there
    (RFC 2132 §9.3 Option Overload + RFC 2131 §4.1, MUST).

  Three DUT-side observables carry the verdict: the DISCOVER, the
  REQUEST, and a UDP egress to IP-UNUSED-ADDRESS that can only happen
  if the DUT read the Option 3 gateway out of the overloaded field.

  Wire envelope shared with CM_06 — only divergence is the Option 52
  byte value (CM_05 = 2 → sname holds options) and which BOOTP
  fixed region carries Option 3 (Router) = SERVER1-IP. Both lift to
  `dhcpv4_router_option_egress.sce-template.xml`; the trait
  `stimulus()` selects the overload kind via ServerEmulParams.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_05"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_router_option_egress.sce-template.xml"/>
</scxml>
