<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.12 TCP_PROBING_WINDOWS_06: TCP SHOULD increase exponentially
  the interval between successive zero-window probes (RFC 1122
  §4.2.2.17 p92 — RFC 793 §3.7 page 42 SHOULD).

  Case shape:
    the tester parks the DUT in ESTABLISHED, lets one DUT-side send
    through, then shuts its window to zero in the acknowledgement. A
    second DUT-side send is stuck, so the DUT probes repeatedly — and
    what this case measures is the spacing between those probes, which
    has to keep growing rather than settle at a fixed interval.

  Mechanism (active OPEN to ESTABLISHED + small SEND + zero-window
  ACK + second SEND + observe 3 successive probes — no per-probe ACK):
    1. Active OPEN handshake on (kBasicsActiveLocalPort+152,
       kBasicsActiveRemotePort+152); the DUT enters ESTABLISHED.
    2. The tester accepts the completed connection and snapshots the
       post-handshake tester snd_nxt / rcv_nxt.
    3. The tester withholds its kernel's auto-ACKs.
    4. A data SEND of N B → DUT seg1.
    5. Settle ~150 ms; the tester sends an ACK at seg1_seq+N with
       `window=0`.
    6. A second data SEND of M B — bytes queue behind snd_wnd=0.
    7. The DUT's persist path emits zero-window probes at
       exponentially-doubled intervals because no probe is ACKed
       (each probe-fire increments the backoff). Inter-probe
       intervals: RTO0, 2*RTO0, 4*RTO0.

    The requirement is that the interval BETWEEN successive probes
    keeps growing, and RFC 1122 names no base interval, so one
    inter-probe interval is compared with the one before it and
    neither is compared with a number. Three probes bound two such
    intervals: probe 1 to probe 2, then probe 2 to probe 3. The second
    has to exceed the first by a factor of 7/4
    (TcpProbingWindows06Captured): a doubling schedule clears that with
    room, a linear one has fallen to 3/2 by then and fails, and a
    constant one fails. The wait before probe 1 is not an inter-probe
    interval and is not graded: the persist timer starts when data is
    queued behind the closed window, which the wire does not show.

    The comparison was absolute until now (more than 300 ms, then more
    than 600 ms, tuned to Linux's 200 ms timer), which failed a
    conformant DUT with a smaller base and passed one that probes at a
    constant 1 s. The times are pcap-domain, taken as each transition
    fires.

    Captured.expected_ack_num is preloaded with `snd_una_post_ack -
    1`; all 3 probe-listening states gate on
    `is_zero_window_probe(...)`, which accepts either RFC 1122
    §4.2.2.17 probe shape (Linux 0-byte at snd_una-1, BSD/lwIP 1-byte
    at snd_una) at the spec-conformant seq. Measured over three runs
    each, the second interval is twice the first on both: Linux 440 ms
    then 896 to 928 ms (ratio 2.04 to 2.11), lwIP 3.00 s then 6.00 s
    (ratio 2.00). Both clear the 7/4 factor with room.

  Four-state SCXML chain:
    * listening_seg1     — observe seg1 (DUT data segment).
    * listening_probe1   — 4 s deadline (Linux ~200 ms / lwIP ~1.2 s).
    * listening_probe2   — 4 s deadline (Linux ~400 ms / lwIP ~3.0 s).
    * listening_probe3   — 9 s deadline (Linux ~800 ms / lwIP ~6.0 s).

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  is_dut_data_segment(...)'s src_ip conjunct unreachable; case lands
  on inconclusive_no_seg1 via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_probing_windows_06"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_seg1">

  <sce:context id="captured"
               cpp:type="tc8::TcpProbingWindows06Captured"
               cpp:include="sce_integration/tcp_case_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_seg1">
    <onentry>
      <send event="deadline_seg1" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset)"
                target="listening_probe1"/>
    <transition event="deadline_seg1" target="inconclusive_no_seg1"/>
  </state>

  <state id="listening_probe1">
    <onentry>
      <send event="deadline_probe1" delay="4s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset)"
                target="listening_probe2"/>
    <transition event="deadline_probe1" target="inconclusive_no_probe1"/>
  </state>

  <state id="listening_probe2">
    <onentry>
      <send event="deadline_probe2" delay="4s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset)"
                target="listening_probe3"/>
    <transition event="deadline_probe2" target="inconclusive_no_probe2"/>
  </state>

  <state id="listening_probe3">
    <onentry>
      <!-- 9 s, not 6 s: lwIP's persist backoff places probe 3 at
           ~6.0 s after probe 2 (1.2 s, +3.0 s, +6.0 s measured), which
           races a 6 s deadline. Linux's RTO-derived probe 3 lands far
           earlier (~1.4 s after probe 2), so the wider deadline only
           buys margin for the slower-but-conformant stack. -->
      <send event="deadline_probe3" delay="9s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset) and captured.probe_interval_grew()"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows06LocalOffset) and captured.probe_interval_did_not_grow()"
                target="fail_probe_interval_not_growing"/>
    <transition event="deadline_probe3" target="inconclusive_no_probe3"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_seg1">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_first_data_segment","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_probe1">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_zero_window_probe_1","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_probe2">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_zero_window_probe_2","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_probe3">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_zero_window_probe_3","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_probe_interval_not_growing">
    <donedata>
      <content>{"verdict":"fail","reason":"probe_interval_not_longer_than_the_previous_interval","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
