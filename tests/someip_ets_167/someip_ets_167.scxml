<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_167: SD_TestFieldUINT8Array.

  Tester drives the array-field-axis chain on Methods 0x28 (Getter) /
  0x29 (Setter):
    1. getTestFieldUint8Array — observe Response with current array.
    2. setTestFieldUint8Array(0x11,0x22,0x33,0x44) — observe Response
       echoing the 4-byte payload.
    3. getTestFieldUint8Array again — Response array length 4.

  Per PRS_SOMEIPSD_00357 the DUT shall echo the field value on get and
  set. Lenient assertion on phase 4 (length == 4) covers the array
  round-trip without requiring per-byte payload introspection.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): first get Response (Method 0x28,
            message_type 0x80).
    Phase 3 (listening_phase3): set Response (Method 0x29,
            message_type 0x80, payload byte0..3 = 11/22/33/44 after the
            4-byte length prefix).
    Phase 4 (listening_phase4): post-set get Response (Method 0x28,
            message_type 0x80).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_167"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0028 and captured.message_type == 0x80"
                target="listening_phase3"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_initial_get"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0029 and captured.message_type == 0x80 and captured.payload_len == 8 and captured.payload_bytes[0] == 0x00 and captured.payload_bytes[1] == 0x00 and captured.payload_bytes[2] == 0x00 and captured.payload_bytes[3] == 0x04 and captured.payload_bytes[4] == 0x11 and captured.payload_bytes[5] == 0x22 and captured.payload_bytes[6] == 0x33 and captured.payload_bytes[7] == 0x44"
                target="listening_phase4"/>
    <transition event="phase3_deadline_exceeded" target="fail_phase3_no_set_response"/>
  </state>

  <state id="listening_phase4">
    <onentry>
      <send event="phase4_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0028 and captured.message_type == 0x80 and captured.payload_len == 8 and captured.payload_bytes[0] == 0x00 and captured.payload_bytes[1] == 0x00 and captured.payload_bytes[2] == 0x00 and captured.payload_bytes[3] == 0x04 and captured.payload_bytes[4] == 0x11 and captured.payload_bytes[5] == 0x22 and captured.payload_bytes[6] == 0x33 and captured.payload_bytes[7] == 0x44"
                target="pass"/>
    <transition event="phase4_deadline_exceeded" target="fail_phase4_no_post_set_get"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_initial_get">
    <donedata>
      <content>{"verdict":"fail","reason":"no_initial_get_array_response"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_no_set_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_set_array_response"}</content>
    </donedata>
  </final>

  <final id="fail_phase4_no_post_set_get">
    <donedata>
      <content>{"verdict":"fail","reason":"no_post_set_get_array_response"}</content>
    </donedata>
  </final>
</scxml>
