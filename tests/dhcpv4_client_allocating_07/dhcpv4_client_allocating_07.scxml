<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPV4_CLIENT_ALLOCATING_07: ARP-detected address-in-use
  → DHCPDECLINE → restart configuration process (RFC 2131 §3.1, MUST).

  Spec body: tc8_p241-p260.txt:95..145, Topology 4. Pass criteria
  4 + 6 + 7 + 10 + 12 (timing-free DISCOVER #2). The ALLOCATING_08
  sibling adds the SHOULD second-sentence timing assert; this case
  verifies the first-sentence MUST only.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_07"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_post_decline_discover.sce-template.xml"
           s5_deadline="4s"
           s5_extra_pass_cond="true"
           s5_fail_state="fail_no_second_discover"
           s5_fail_reason="no_dut_dhcp_discover_after_decline"/>
</scxml>
