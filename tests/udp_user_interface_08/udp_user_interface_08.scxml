<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.5 UDP_USER_INTERFACE_08: DUT-emitted UDP datagram carries
  the caller-specified Destination IP Address (RFC 768 'User Interface'
  MUST). Spec gates the case on `<DUTSupportsDynamicInterface>=TRUE`.

  Single tester IP makes the axis vacuous (only one valid destination),
  so a buggy DUT that ignores the caller's choice still passes.
  Activated here via the AIface-0 alias `kTesterAliasIp4Be`
  (172.16.0.4 = 0x040010AC NBO) configured by `dut/env/setup-netns.sh`:
  the stimulus passes the alias as the OpTriggerSendUdp `target_ip_be`,
  tc8-dut sends to (alias, 20000), and the SCXML cond gates the pass
  branch on wire dst_ip == alias. A DUT that defaults to the primary
  tester_ip lands on `fail_wrong_dst_ip`.

  Hand-rolled (not `udp_field_check` template) because the template
  hardcodes `dst_ip == expected.tester_ip` for the DUT-target filter;
  UI_08 needs `dst_ip == kTesterAliasIp4Be` instead, which contradicts
  that bundled conjunct.

  SCXML reads `expected.tester_alias_ip` (an `Ipv4Expected` slot
  pinned by smoke-test's `IPV4_DUT_EXPECT_STATIC` to 172.16.0.4 NBO).
  The stimulus pins the same value via the `kTesterAliasIp4Be`
  constant in `udp_pilot_common.h` — keeping the two surfaces
  independently flippable lets the strict-axis negative row
  (`ipv4.tester_alias_ip=10.99.99.99`) divert ONLY the SCXML
  expectation, leaving DUT emit at the conformant alias and forcing
  the cond to land on `fail_wrong_dst_ip` (a strict-axis NEG covering
  this case's pass guard).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_user_interface_08"
       datamodel="null"
       initial="listening">
  <sce:context id="captured"
               cpp:type="tc8::UdpCaptured"
               cpp:include="sce_integration/udp_captured.h"/>
  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <!--
      Both transitions narrow on `src_ip == expected.dut_iface_ip` so
      tester-origin frames (the harness's UT request, vsomeip SD
      multicast) fall outside dispatch. `dst_ip ==
      expected.tester_alias_ip` is the spec-axis assertion: DUT must
      honour the caller-specified Destination IP. `src_port == 20028`
      is the per-case attribution literal.
    -->
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_alias_ip and captured.src_port == 20028"
                target="pass"/>
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.src_port == 20028 and captured.dst_ip != expected.tester_alias_ip"
                target="fail_wrong_dst_ip"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_wrong_dst_ip">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_udp_with_wrong_user_interface_dst_ip","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_originated_udp_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
