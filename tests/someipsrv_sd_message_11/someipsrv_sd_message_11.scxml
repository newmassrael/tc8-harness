<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.3.11 SOMEIPSRV_SD_MESSAGE_11: The Subscribe Eventgroup entry
  type (0x06) shall be used to subscribe to an eventgroup
  (TR_SOMEIP_00385). The harness emits a SubscribeEventgroup via the
  TestCaseTraits<SM>::stimulus() hook and verifies the DUT responds
  with a Type 2 entry (0x07 Ack/Nack) echoing the configured Service ID.
  tc8-dut has no eventgroups configured (vsomeip.json), so vsomeip Nacks
  with ttl=0 — the Service ID echo is the per-case discriminator that
  distinguishes a working SOME/IP-SD plumbing from a silent drop.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_sd_message_11"
       datamodel="null"
       initial="listening_phase1">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="true"
           entry_type="0x07"
           pass_expr="captured.sd_entries[0].service_id == expected.service_id"
           fail_state="fail_service_id"
           fail_reason="ack_entry_service_id_mismatch"/>
</scxml>
