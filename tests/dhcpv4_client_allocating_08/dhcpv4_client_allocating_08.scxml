<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPV4_CLIENT_ALLOCATING_08: After DHCPDECLINE the client
  SHOULD wait a minimum of ten seconds before restarting the
  configuration process (RFC 2131 §3.1 second sentence, SHOULD).

  Spec body: tc8_p241-p260.txt:147..207, Topology 4. Pass criteria
  ALLOCATING_07 + step 13 (`interval > (10 - ParamToleranceTime) sec`).
  Window `[9_000_000, 12_000_000]` us = `[9 s, 12 s]` (ToleranceTime
  default = 1 s; upper bound covers the trait's [10000, 11000] ms
  desync draw + worker jitter without false negatives).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_08"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_post_decline_discover.sce-template.xml"
           s5_deadline="13s"
           s5_extra_pass_cond="captured.dhcpv4.decline_to_discover_within_us(9000000, 12000000)"
           s5_fail_state="fail_no_second_discover_in_window"
           s5_fail_reason="no_dut_dhcp_discover_within_decline_to_discover_window"/>
</scxml>
