<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_16 negative — closes
  the self-reference trap on the positive _16 case. tc8-dut runs the
  LL claim via OpStartLLAutoconfBuggy(flavor=ReplySenderIpWrong): its
  defending ARP Reply carries sender_proto_ip = the DUT iface IP (a
  routable, non-LL value) instead of the committed LL, violating
  RFC 3927 §2.5.

  Same two-phase wiring as the positive _16: pre_claim → post_claim on
  the first DUT Announce; the shared scheduleClaimConditionTesterRequest
  observer queries the committed LL, snapshots it into
  expected_responder_sender_ip_be, and emits the claim-condition ARP
  Request. The DUT's responder then emits the (buggy) Reply.

  The DUT Reply is identified flavor-independently by
  is_arp_reply() + eth_src == DUT MAC + target_hw == tester MAC, with
  expected_responder_sender_ip_be != 0 proving the observer ran.

  Pass = the wrong sender_proto_ip is detected. fail_compliant_emit =
  tc8-dut ignored the flavor and emitted a compliant Reply, so the
  harness would have silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_16_neg"
       datamodel="null"
       initial="listening_pre_claim">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening_pre_claim">
    <onentry>
      <send event="claim_deadline" delay="6s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_announce()"
                target="listening_post_claim"/>
    <transition event="claim_deadline" target="inconclusive_no_claim_observed"/>
  </state>

  <state id="listening_post_claim">
    <onentry>
      <send event="reply_deadline" delay="3s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply() and captured.eth_src == expected.dut_iface_mac and captured.target_hw == expected.tester_mac and captured.expected_responder_sender_ip_be != 0 and captured.sender_proto_ip != captured.expected_responder_sender_ip_be"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply() and captured.eth_src == expected.dut_iface_mac and captured.target_hw == expected.tester_mac and captured.expected_responder_sender_ip_be != 0 and captured.sender_proto_ip == captured.expected_responder_sender_ip_be"
                target="fail_compliant_emit"/>
    <transition event="reply_deadline" target="inconclusive_no_responder_reply"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_claim_observed">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_announce_committed_link_local_address","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_responder_reply">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_emit_arp_reply_for_claim_address","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_emit">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_compliant_reply_despite_reply_sender_ip_wrong_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
