<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.5.2 SOMEIPSRV_BASIC_02: The Service-Instance-IDs of
  0x0000 and 0xFFFF shall not be used for a service — 0x0000 is reserved
  and 0xFFFF describes "all service instances" in FindService.

  Stimulus: emitFindServiceBoot with FindServiceTarget.instance_id =
  0xFFFF (any-instance probe). The DUT replies with an OfferService
  whose entry instance_id is the actual published instance — pass
  criterion asserts that value is neither 0x0000 nor 0xFFFF.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_basic_02"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].instance_id != 0x0000 and captured.sd_entries[0].instance_id != 0xFFFF"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].instance_id == 0x0000"
                target="fail_instance_zero"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].instance_id == 0xFFFF"
                target="fail_instance_all"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_instance_zero">
    <donedata>
      <content>{"verdict":"fail","reason":"offer_instance_id_is_reserved_zero"}</content>
    </donedata>
  </final>

  <final id="fail_instance_all">
    <donedata>
      <content>{"verdict":"fail","reason":"offer_instance_id_is_reserved_all"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
