<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_01: at time T1 the client
  moves to RENEWING state and sends a DHCPREQUEST to the server via IP
  unicast (RFC 2131 §4.4.5).

  Spec Test Procedure (tc8_p261-p280.txt: REACQUISITION_01):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER: DHCP Server <SERVER-1> Cause DUT to transit its state
         to DHCPCLIENT_STATE_RENEWING (= reply OFFER+ACK with short
         lease, DUT arms T1 = lease/2, emits RENEWING REQUEST).
    4.   DUT: Transit finite state to DHCPCLIENT_STATE_RENEWING.
    5.   TESTER: DHCP Server <SERVER-1> Listens (upto <ParamListenTime>).
    6.   DUT: Sends DHCPREQUEST Message.
    7.   TESTER: Verify Destination IP Address field is set to
         <SERVER1-IP-ADDRESS>.
  Pass: 4 + 6 + 7.

  Wire predicate: `captured.dst_ip_equals(expected.server_id_be)`. The
  RENEWING phase machine (RFC 2131 §4.4.5) sets the IPv4 dst to the
  Option 54 server identifier from the prior ACK; the harness emul
  advertises `kDefaultServerIdBe` (= 172.16.0.10) as Option 54, so
  `expected.server_id_be` is the right ground truth.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_01"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="captured.dst_ip_equals(expected.server_id_be)"
           fail_state="fail_renewing_request_dst_not_server_id"
           fail_reason="dut_renewing_request_dst_not_server_id"/>
</scxml>
