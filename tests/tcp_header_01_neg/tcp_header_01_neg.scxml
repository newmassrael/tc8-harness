<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.16 TCP_HEADER_01 negative — lwIP egress-fault self-validation of the
  positive _01 data-segment header-validity guard. HEADER_01's pass guard has two
  conjuncts: data_offset >= 5 and tcp_checksum_valid(). The data_offset < 5 half is
  structurally unreachable through the libtins dissector (it throws malformed_packet on
  data_offset*4 < 20 before any TcpFrame is produced — see dut/lwip_dut/README.md), so
  the checksum is the only self-validatable conjunct via the egress seam. The trait
  therefore arms kTcpFaultDataChecksumWrong (the same flavor CHECKSUM_03_NEG uses),
  XOR-invalidating the DUT data segment's checksum; data_offset >= 5 is carried in the
  filter verbatim from the positive (always satisfied — the dissector guarantees it).
  Pass = the invalid checksum observed; fail_compliant = the DUT emitted a valid
  checksum despite the flavor (fault inert). lwIP-only (capability-gated on
  kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_header_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsActiveLocalPort + 30U and captured.dst_port == ::tc8::sce::tcp::kBasicsActiveRemotePort + 30U and captured.payload_len &gt; 0 and captured.data_offset &gt;= 5"
           pass_expr="not captured.tcp_checksum_valid()"
           fail_state="fail_compliant"
           fail_reason="dut_emitted_valid_checksum_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_data_segment_within_listen_window"/>
</scxml>
