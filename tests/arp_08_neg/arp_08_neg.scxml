<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_08 negative — lwIP egress-fault self-validation of the
  positive _08 Hardware Type guard. emitArpFlavorArm(kArpFaultHwTypeWrong)
  rewrites the htype of the DUT's Request (opcode left at 1). Pass =
  corrupted hw_type observed; fail_compliant = DUT emitted 0x0001 despite
  the flavor (fault inert). lwIP-only. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_08_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.hw_type != 0x0001"
           fail_state="fail_compliant"
           fail_reason="dut_arp_request_hw_type_ethernet_despite_hw_type_wrong_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
