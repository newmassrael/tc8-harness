<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.4 IPv4_AUTOCONF_CONFLICT_09: usage cease condition - IV
  (RFC 3927 §2.5 MUST). Tester injects one ARP Reply followed by
  one ARP Request, both with sender_ip == target_ip == DUT's
  committed LL within DEFEND_INTERVAL/2; same cease + re-pick
  assertion as _06 with mixed opcodes (Reply, Request).

  Trait wiring (see ipv4_autoconf_conflict_09.h):
    scheduleDefenderCeaseConflicts(opcode1=Reply, opcode2=Request)
    on listening_post_claim entry.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_conflict_09"
       datamodel="null"
       initial="listening_pre_claim">
  <sce:use template="../_templates/ipv4_linklocal_defender_cease.sce-template.xml"/>
</scxml>
