<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.3 IPv4_TTL_01 negative — lwIP egress-fault self-validation of the positive
  _01 "TTL > 0" guard. The trait arms kIpv4FaultTtlZero, so the lwIP link-output hook
  zeroes the TTL of the DUT's Echo Reply IPv4 header (gated on the Echo Reply). libtins
  does not validate the IPv4 header checksum on parse, so the stale checksum is
  immaterial and the guard reads the zeroed TTL. Pass = TTL == 0 observed (the violation
  RFC 1122 section 3.2.1.7 forbids); fail_compliant = the DUT emitted a non-zero TTL
  despite the flavor (fault inert). lwIP-only (capability-gated on kCapEgressFault).
  Envelope: ipv4_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_ttl_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_field_check.sce-template.xml"
           pass_expr="captured.ttl == 0"
           fail_state="fail_compliant"
           fail_reason="dut_ttl_nonzero_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
