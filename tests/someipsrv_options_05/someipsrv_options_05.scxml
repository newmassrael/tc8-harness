<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.5.5 SOMEIPSRV_OPTIONS_05: Second Reserved field of the
  IPv4 Endpoint Option (the byte AFTER the IPv4 Address, before the
  Layer-4 Protocol byte) shall be 0x00 per SWS_SD_00213. Asserted
  symmetrically on both UDP and TCP endpoint options.

  Presence gate: same shape as OPTIONS_03 — explicit
  `sd_has_option_with_l4` for both axes before reading
  `.reserved2` so a missing axis fails loudly instead of resolving
  to the empty-fallback (reserved2=0) and trivially passing.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_options_05"
       datamodel="null"
       initial="listening">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="captured.sd_option_count &gt;= 1"
           entry_type="0x01"
           pass_expr="captured.sd_has_option_with_l4(::tc8::sd_option_type::kIpv4Endpoint, ::tc8::sd_l4_proto::kUdp) and captured.sd_has_option_with_l4(::tc8::sd_option_type::kIpv4Endpoint, ::tc8::sd_l4_proto::kTcp) and captured.sd_first_option_with_l4(::tc8::sd_option_type::kIpv4Endpoint, ::tc8::sd_l4_proto::kUdp).reserved2 == 0x00 and captured.sd_first_option_with_l4(::tc8::sd_option_type::kIpv4Endpoint, ::tc8::sd_l4_proto::kTcp).reserved2 == 0x00"
           fail_state="fail_reserved2"
           fail_reason="ipv4_endpoint_second_reserved_nonzero"/>
</scxml>
