<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_04: Same Destination Port with Different IP
  Address (send). DUT emits a UDP message at <testerUDPPort> as
  destination port to two distinct destinations through the same
  interface (Topology 2 — Host-1-IP / Host-2-IP). Verifies RFC 768
  'Fields' MUST: Destination Port has meaning within the context of a
  particular internet destination address.

  Spec mapping:
    Host-1-IP  → expected.tester_ip (172.16.0.1)
    Host-2-IP  → 172.16.0.3 (kUdpHost2IpBe in udp_pilot_common.h)
    testerUDPPort → kDataPort = 20000

  Two-phase observation (no wall-time coupling — phase 2 stimulus
  fires on Listening_phase2 entry):
    listening_phase1 — observe DUT-emit UDP to Host-1-IP:20000 →
                       transition to listening_phase2.
    listening_phase2 — observe DUT-emit UDP to Host-2-IP:20000 → pass.

  Both transitions narrow on `dst_port == 20000` to exclude vsomeip SD
  multicast (UDP 30490 → 224.244.224.245) and the DUT-side UT
  Confirmation (`has_ut_response` filter excludes the latter).

  Per-case unique src_port = 20040 keeps cross-case state isolated.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_04"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::UdpCaptured"
               cpp:include="sce_integration/udp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline" delay="5s"/>
    </onentry>
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.dst_port == 20000"
                target="listening_phase2"/>
    <transition event="phase1_deadline" target="fail_phase1_no_host1_egress"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline" delay="5s"/>
    </onentry>
    <transition event="udp_observed"
                cond="cpp:!captured.has_ut_response and captured.src_ip == expected.dut_iface_ip and captured.dst_ip == 0x030010AC and captured.dst_port == 20000"
                target="pass"/>
    <transition event="phase2_deadline" target="fail_phase2_no_host2_egress"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_host1_egress">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_originated_udp_to_host1_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_host2_egress">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_originated_udp_to_host2_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
