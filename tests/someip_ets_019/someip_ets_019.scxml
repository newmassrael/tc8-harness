<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_019: echoFLOAT64.

  Tester sends echoFLOAT64 (METHOD-ID 0x0012) Method Request whose payload
  is a single Float64 value serialised big-endian: 1.5 = 0x3FF8000000000000.
  DUT echoes the same Double back unchanged.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Method Response (msg_type 0x80,
            return_code 0x00) on method_id 0x0012 with payload_len == 8
            and payload bytes matching the BE 1.5 encoding -> pass.
            Any other Response shape on the same method_id -> fail.
            No Response within the deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_019"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0012 and captured.return_code == 0x00 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x3F and captured.payload_snapshot[1] == 0xF8 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x00 and captured.payload_snapshot[4] == 0x00 and captured.payload_snapshot[5] == 0x00 and captured.payload_snapshot[6] == 0x00 and captured.payload_snapshot[7] == 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0012 and captured.message_type == 0x80 and (captured.payload_len != 8 or captured.payload_snapshot[0] != 0x3F or captured.payload_snapshot[1] != 0xF8 or captured.payload_snapshot[2] != 0x00 or captured.payload_snapshot[7] != 0x00)"
                target="fail_phase2_float64_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_float64_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_float64_response_did_not_match_request","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
