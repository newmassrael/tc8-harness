<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_175: SD_Unreferenced_option.

  Tester sends a SubscribeEventgroup with one IPv4 Endpoint option
  (referenced by entry's #Opt1=1) PLUS one extra Configuration Option
  (Type 0x01, unreferenced). Per PRS_SOMEIPSD_00337 / 00387 / 00393 the
  DUT shall ignore the extra option and Ack the Subscribe.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Type 0x07 ttl > 0 Ack → pass.
            Type 0x07 ttl == 0 (Nack) → fail.

  The procedure states no time for the Ack, so the general
  <ParamListenTime> governs: a phase-2 window that elapses without an Ack
  is the DUT's silence where it must answer, observed_quiescence judged
  against that bound (docs/verdict_policy.md Section 2.1, H3), over a
  window of ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults). Phase 1 (no OfferService) is the preamble and stays
  precondition_unmet.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_175"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_subscribe_ack_within_listen_window","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
