<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_103: SD_ClientServiceGetLastValueOfEventTCP.

  Tester drives Client Mode chain (clientServiceActivate +
  clientServiceSubscribeEventgroup) then invokes
  clientServiceGetLastValueOfEvent* (Method 0x003B). The DUT's last-event
  cell for the TCP-reliable target event is pre-initialised to 0x08 (the spec's canonical
  test-event value); the response is wire-shape valid even without the
  event-receive wiring that would update the cell from a real
  Notification payload.

    Phase 1 (listening_phase1, 6 s): OfferService observation on
            SERVICE-ID-1 (DUT's server-side warm-up gate).
    Phase 2 (listening_phase2, 8 s): GetLastValueOfEvent* Method Response
            (Method ID 0x003B, message_type 0x80, payload_byte0 == 0x08).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_103"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="8s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x003B and captured.message_type == 0x80 and captured.payload_byte0 == 0x08"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_get_last_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_get_last_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_get_last_value_tcp_response"}</content>
    </donedata>
  </final>
</scxml>
