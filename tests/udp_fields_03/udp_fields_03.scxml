<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_03: DUT accepts a UDP datagram whose Source
  Port field is 0 (RFC 768 'Fields' MUST — "If not used, a value of
  zero is inserted").

  Case shape:
    the DUT listens on <unusedUDPDstPort1> and the tester sends it a
    datagram whose source port is zero — legal, and meaning no reply is
    expected. The UT channel confirms the DUT took it and saw the zero
    rather than rejecting the datagram.

  Mapping: <unusedUDPDstPort1>=kDataPort (20000). Stimulus injects UDP
  with src_port=0; DUT data listener accepts (Linux's UDP layer treats
  Source Port=0 as a wildcard, not a drop trigger). UT GetReceivedUdp
  returns received=1.

  Reuses ipv4_udp_ut_presence with expected_received=1.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_03"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="1"
           fail_reason_wrong_receipt="dut_did_not_receive_zero_source_port_udp"
           fail_reason_timeout="no_ut_confirmation_for_zero_source_port"
           fail_role="observed_violation"/>
</scxml>
