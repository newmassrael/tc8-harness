<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.9 TCP_MSS_OPTIONS_01: TCP MUST be prepared to handle an
  illegal option length for MSS in a SYN segment without crashing.
  Derived from RFC 1122 §4.2.2.5 p85 TCP Options "RFC-793 Section
  3.1" (MUST).

  Case shape:
    a passive open parks the DUT in LISTEN at <wnp> and the tester
    sends a SYN whose MSS option declares an illegal length, ilen. What
    is checked is survival: the DUT must still be running afterwards.

    Test Iterations:
      1. CASE: ilen = 0 (less than actual)
      2. CASE: ilen = 5 (more than actual)

  Mechanism: 3-phase compound stimulus, single observation phase:
    Phase A (ilen=0): bring the DUT to LISTEN on listen_port_a, then
                     send a SYN with options [0x02 0x00 0x01 0x01]
                     (kind=2, length=0, NOP×2 padding to 4 B). Close.
    Phase B (ilen=5): bring the DUT to LISTEN on listen_port_b, then
                     send a SYN with options
                     [0x02 0x05 0xAA 0xBB 0xCC NOP×3] (kind=2,
                     length=5 — three data bytes, illegal — NOP
                     padding to 8 B). Close.
    Phase V (verify): bring the DUT to LISTEN on listen_port_v and
                     complete a passive ACCEPT with well-formed
                     options (single MSS=1460 [0x02 0x04 0x05 0xB4]),
                     then a state-probe read of whether the
                     connection reached ESTABLISHED.

  "The DUT has not crashed" is graded by the DUT liveness probe
  (dut_liveness.h): after each malformed SYN the tester sends an ICMP
  Echo Request numbered by the iteration, which a running DUT answers
  (RFC 1122 §3.2.2.6, MUST). A probe unanswered for ParamListenTime
  fails that iteration (observed_quiescence), and the stimulus stops
  there, so the following DUT-control calls cannot turn the crash
  into an unperformed stimulus.

  Then the verification handshake asks whether the DUT's TCP stack
  still works: DUT-emitted SYN+ACK on the verification port quad with
  captured.ut_established == 0x01 passes; == 0x00 fails.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_mss_options_01"
       sce:transition-table="emit"
       datamodel="null"
       initial="awaiting_liveness_ilen0">

  <sce:context id="captured"
               cpp:type="tc8::TcpLivenessCaptured"
               cpp:include="sce_integration/tcp_case_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="awaiting_liveness_ilen0">
    <onentry>
      <send event="ilen0_liveness_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="dut_echo_reply"
                cond="cpp:captured.liveness_echo_seq == 1U"
                target="awaiting_liveness_ilen5"/>
    <transition event="ilen0_liveness_window_elapsed" target="fail_dut_unresponsive_after_ilen0"/>
  </state>

  <state id="awaiting_liveness_ilen5">
    <onentry>
      <send event="ilen5_liveness_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="dut_echo_reply"
                cond="cpp:captured.liveness_echo_seq == 2U"
                target="listening"/>
    <transition event="ilen5_liveness_window_elapsed" target="fail_dut_unresponsive_after_ilen5"/>
  </state>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="8s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpMssOptionsListenPort01v and captured.dst_port == ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort01v and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ut_established == 0x01"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpMssOptionsListenPort01v and captured.dst_port == ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort01v and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ut_established == 0x00"
                target="fail_not_established"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_dut_unresponsive_after_ilen0">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_unresponsive_after_syn_with_ilen0_mss","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_dut_unresponsive_after_ilen5">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_unresponsive_after_syn_with_ilen5_mss","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_not_established">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_reach_established","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_syn_ack_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
