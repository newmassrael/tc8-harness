<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.10 TCP_OUT_OF_ORDER_03: TCP SHOULD be capable of queuing
  out-of-order segments (RFC 1122 §4.2.2.20 p93 — RFC-793 RFC 1122 §3.9).

  v3.0 Test Procedure (p366):
    1. TESTER: Cause the DUT to move to ESTABLISHED state at <wnp>.
    2. TESTER: Send a data segment.
    3. DUT:    Send the ACK for the data segment.
    4. TESTER: Send <nss> data segments leaving a gap in SEQ numbers
               (as if a segment is skipped) at the beginning.
    5. DUT:    Do not send ACKs for these segments.
    6. TESTER: Send a segment having data for the missing SEQ numbers.
    7. DUT:    Send ACK for all queued data seg(s) including the
               latest one.

  Linux 6.5 deviation note (cumulative-ACK reading):
    Spec step 5 says "Do not send ACKs". Linux 6.5 has SACK enabled
    by default and DOES emit duplicate ACKs (with SACK option blocks)
    for OOO segments — they carry the SAME cumulative ack_num as the
    pre-gap ACK and so do not advance receive state. The harness
    interprets step 5 as "cumulative ack_num does not advance past
    the gap point until the gap is filled" rather than "no ACK frame
    is emitted at all". The pass guard on phase 2 verifies the
    cumulative ack_num (= injected_seq + 4 + gap + nss*N) only after
    the fill segment arrives; intermediate dup-ACKs with the
    pre-gap ack_num are tolerated implicitly because they fail the
    phase-2 ack_num equality and stay queued.

  Mechanism (active-OPEN handshake + 4× raw-inject data segments):
    1. driveActiveOpenEstablished on (kBasicsActiveLocalPort+143,
       kBasicsActiveRemotePort+143).
    2. Tester listener.acceptOne() pulls the kernel-completed
       connection off the listen queue.
    3. queryTcpSeqRange snapshots the post-handshake tester
       snd_nxt / rcv_nxt (S = snd_nxt).
    4. Tester raw-injects in order:
         SEG0     at S          (4 B payload "A0..A3"),
         SEG_GAP1 at S + 8      (4 B payload "C0..C3"),
         SEG_GAP2 at S + 12     (4 B payload "C4..C7"),
         SEG_FILL at S + 4      (4 B payload "B0..B3").
       The 4-byte gap [S+4, S+8) keeps SEG_GAP1 / SEG_GAP2 OOO until
       SEG_FILL closes it. Each segment carries flags = ACK + PSH
       and ack = rcv_nxt (in-window).
    5. DUT acknowledges:
         SEG0     -> pure ACK with ack_num == S + 4   (phase 1),
         SEG_GAP1 -> dup-ACK    with ack_num == S + 4 (SACK),
         SEG_GAP2 -> dup-ACK    with ack_num == S + 4 (SACK),
         SEG_FILL -> pure ACK with ack_num == S + 16  (phase 2).

  Three-state SCXML chain:
    * listening_handshake_ack — observe the DUT-emitted handshake
      third-leg pure ACK on the active-OPEN port quad.
    * listening_initial_ack — observe DUT pure ACK acknowledging
      SEG0 (ack_num == captured.expected_ack_num populated from
      stimulus snapshot = injected_seq + 4).
    * listening_final_cumulative_ack — observe DUT pure ACK with
      ack_num == captured.expected_ack_num_phase2 (= injected_seq +
      16). Intermediate dup-ACKs (ack_num == phase-1 value) do not
      satisfy this guard and stay queued; the final cumulative ACK
      is the only event that transitions to pass.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  is_pure_dut_ack(...)'s src_ip conjunct unreachable; case lands on
  fail_no_handshake_ack via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_out_of_order_03"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder03LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder03LocalOffset)"
                target="listening_initial_ack"/>
    <transition event="deadline_handshake_ack" target="fail_no_handshake_ack"/>
  </state>

  <state id="listening_initial_ack">
    <onentry>
      <send event="deadline_initial_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder03LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder03LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="listening_final_cumulative_ack"/>
    <transition event="deadline_initial_ack" target="fail_no_initial_ack"/>
  </state>

  <state id="listening_final_cumulative_ack">
    <onentry>
      <send event="deadline_final_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder03LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder03LocalOffset) and captured.ack_num == captured.expected_ack_num_phase2"
                target="pass"/>
    <transition event="deadline_final_ack" target="fail_no_final_cumulative_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_handshake_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_handshake_ack"}</content>
    </donedata>
  </final>

  <final id="fail_no_initial_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_initial_data_segment"}</content>
    </donedata>
  </final>

  <final id="fail_no_final_cumulative_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_emit_cumulative_ack_after_gap_fill"}</content>
    </donedata>
  </final>
</scxml>
