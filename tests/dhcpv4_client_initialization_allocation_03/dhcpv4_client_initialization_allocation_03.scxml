<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_03:
    "The client begins in INIT state and forms a DHCPDISCOVER message ...
     The client MUST include its hardware address in the 'chaddr' field"
    (RFC 2131 §4.4.1, MUST).

  Spec Test Procedure (tc8_p261-p280.txt: INIT_ALLOC_03):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER listens (no server reply).
    4.   DUT: Sends DHCPDISCOVER Message.
    5.   TESTER: Extracts the content of Source Hardware Address field.
    6.   TESTER: Verify received DISCOVER 'chaddr' equals extractedSrcHwAddr.

  Pass criteria differs from PROTOCOL_01/02 / SUMMARY_04 by relaxing the
  chaddr predicate from a transition GATE to a transition BRANCH — a
  DUT-emitted DISCOVER whose chaddr does not match the encapsulating
  L2 source MAC reaches the `fail_chaddr_mismatch` verdict instead of
  silently failing the timeout. tc8-dut writes the netlink-derived
  iface MAC into both `eth_src` and `chaddr` so this case always passes
  on the testbed; the test serves as the regression guard for any
  future DUT path that diverges between L2 src and BOOTP chaddr.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_03"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and !captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="fail_chaddr_mismatch"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_chaddr_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_chaddr_mismatch","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
