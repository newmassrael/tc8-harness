<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_05: Announcing claimed
  address. DUT emits exactly ANNOUNCE_NUM (= 2) ARP Announcements
  after the 3-Probe phase (RFC 3927 §2.4 MUST).

  Spec Test Procedure (tc8_p161-p180.txt:695..731):
    6. DUT: Sends 3 ARP Request Messages (Probes)
    8. TESTER: Wait <ANNOUNCE_WAIT - 0.05>
    10. DUT: Sends 2 ARP Request Messages (Announces)

  Pass criterion: TWO Announces (sender_ip != 0) observed after the
  Probe phase. Probes (sender_ip == 0) flow through with cond=false
  on every transition and are silently dropped — the sequencing is
  enforced by the Announce filter, not by an explicit Probe-counting
  prelude.

  Fast envelope wall budget:
    1.5 s initial-wait + 200 ms dhcp + 200 ms PROBE_WAIT
    + ~600 ms 3 Probes + 200 ms ANNOUNCE_WAIT
    + 200 ms ANNOUNCE_INTERVAL = ~2.9 s before Announce 2.
  4 s deadline gives ~1 s margin against worker scheduling jitter.

  Notes Derived from RFC 3927 p13 section 2.4 (MUST).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_05"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0"
                target="seen_announce_1"/>
    <transition event="deadline_exceeded" target="inconclusive_no_announces"/>
  </state>

  <state id="seen_announce_1">
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0"
                target="pass"/>
    <transition event="deadline_exceeded" target="inconclusive_only_one_announce"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_announces">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_arp_announce_after_probes","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_only_one_announce">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"fewer_than_2_arp_announces_within_deadline","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
