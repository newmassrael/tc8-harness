<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_02: DHCPREQUEST 'requested IP
  address' option (Option 50) carries the OFFER's yiaddr (RFC 2131
  §4.3.2).

  Spec Test Procedure (tc8_p261-p280.txt: REQUEST_02):
    1-4. DUT bring-up + DHCP client + DISCOVER.
    5.   TESTER:DHCP Server <SERVER-1> Sends DHCPOFFER (yiaddr = offered IP).
    7.   DUT: Sends DHCPREQUEST.
    8.   TESTER: Verify received DHCPREQUEST contains Option 50 = OFFER yiaddr.
  Pass: 4 + 7 + 8.

  RFC 2131 §4.3.2: in REQUESTING state the REQUEST MUST advertise the
  address being requested in Option 50 (Requested IP Address). The
  OFFER yiaddr is the dev-netns server emul default
  (`kDefaultOfferedIpBe`, 172.16.0.50), surfaced via
  `expected.offered_ip_be`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_02"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.option_be32_equals(50, expected.offered_ip_be)"
           fail_state="fail_request_requested_ip_mismatch"
           fail_reason="dut_dhcp_request_option50_mismatch_offer_yiaddr"
           fail_role="observed_violation"/>
</scxml>
