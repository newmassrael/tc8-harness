<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_12: TCP, in LAST-ACK state, MUST
  return an empty acknowledgment with proper SEQ and ACK numbers
  after receiving a segment with out-of-window SEQ or unacceptable
  ACK number, and remain in LAST-ACK. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  v3.0 Test Procedure (p301-p320.txt:697) lists two iterations:
    * CASE 1: data segment with out-of-window SEQ.
    * CASE 2: data segment with an unacceptable ACK number.

  Per-phase prelude (function-scoped TesterAutoAckDrop covers both
  phases; pure-ACK iptables suppression keeps DUT pinned in
  LAST-ACK long enough for the corrupt-segment probe to elicit the
  spec-asserted DUT challenge ACK):
    1. Active-OPEN handshake → ESTABLISHED (DUT third-leg ACK).
    2. Tester shutdown(SHUT_WR) → tester FIN+ACK → DUT auto-ACK
       observed → DUT CLOSE-WAIT.
    3. UT OpCloseTcpSocket → DUT FIN+ACK observed; tester pure ACK
       to DUT FIN suppressed by ack_drop → DUT LAST-ACK.
    4. queryTcpSeqRange snapshots tester snd_nxt / rcv_nxt.
    5. Raw-inject CASE-distinct corrupt segment.
    6. silentlyCloseTesterFd (TCP_REPAIR + close, no FIN).

  Per phase the SCXML walks four DUT-origin observations:
    1. handshake third-leg ACK (DUT pure ACK)
    2. tester-FIN-elicited DUT auto-ACK (DUT pure ACK; CLOSE-WAIT)
    3. UT-close-elicited DUT FIN+ACK (DUT enters LAST-ACK)
    4. probe-elicited DUT empty ACK to corrupt segment

  ## Linux behaviour (CASE 2 observable in LAST-ACK)

  Both phases pass on a Linux DUT. Per Linux 6.5 net/ipv4/tcp_input.c
  line 6562-6568, LAST-ACK dispatches via tcp_rcv_state_process with
  FLAG_NO_CHALLENGE_ACK; when tcp_ack returns !acceptable for
  `after(ack, snd_nxt)`, the caller explicitly fires
  tcp_send_challenge_ack(sk) for any non-SYN_RECV state. LAST-ACK
  joins FIN-WAIT-1 (UNACCEPTABLE_09), CLOSING (UNACCEPTABLE_11), and
  CLOSE-WAIT (UNACCEPTABLE_14) in honouring CASE 2.

  This contradicts an earlier extrapolation that grouped LAST-ACK
  with ESTABLISHED (UNACCEPTABLE_04) and FIN-WAIT-2 (UNACCEPTABLE_10)
  as silent-drop. EST genuinely silent-drops via
  `tcp_rcv_established` slow_path discarding the segment; FW2
  orphaned mini-socket emits RST via `tcp_timewait_state_process`
  FW2 substate. LAST-ACK takes the third path — challenge ACK via
  the tcp_rcv_state_process branch — confirmed empirically with the
  pcap kernel ring upgrade (commit c8caa79).

  Phase 1 (CASE 1 OTW SEQ): seq = snd_nxt + kOutOfWindowSeqOffset;
  ack = rcv_nxt - 1 (acceptable but does NOT acknowledge DUT FIN).
  Linux's tcp_validate_incoming OTW SEQ check fires before tcp_ack —
  challenge ACK observed.

  Phase 2 (CASE 2 unacceptable ACK): seq = snd_nxt (in-window);
  ack = rcv_nxt - 1 + kUnacceptableAckOffset (after(ack, snd_nxt)).
  tcp_rcv_state_process challenge-ACK path — empty ACK observed.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_12"
       datamodel="null"
       initial="listening_p1_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake_ack">
    <onentry><send event="deadline_p1_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_close_wait_ack"/>
    <transition event="deadline_p1_handshake_ack" target="fail_p1_no_handshake_ack"/>
  </state>
  <state id="listening_p1_close_wait_ack">
    <onentry><send event="deadline_p1_close_wait_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_dut_fin"/>
    <transition event="deadline_p1_close_wait_ack" target="fail_p1_no_close_wait_ack"/>
  </state>
  <state id="listening_p1_dut_fin">
    <onentry><send event="deadline_p1_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_probe_ack"/>
    <transition event="deadline_p1_dut_fin" target="fail_p1_no_dut_fin"/>
  </state>
  <state id="listening_p1_probe_ack">
    <onentry><send event="deadline_p1_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p2_handshake_ack"/>
    <transition event="deadline_p1_probe_ack" target="fail_p1_no_probe_ack"/>
  </state>

  <state id="listening_p2_handshake_ack">
    <onentry><send event="deadline_p2_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_close_wait_ack"/>
    <transition event="deadline_p2_handshake_ack" target="fail_p2_no_handshake_ack"/>
  </state>
  <state id="listening_p2_close_wait_ack">
    <onentry><send event="deadline_p2_close_wait_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_dut_fin"/>
    <transition event="deadline_p2_close_wait_ack" target="fail_p2_no_close_wait_ack"/>
  </state>
  <state id="listening_p2_dut_fin">
    <onentry><send event="deadline_p2_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_probe_ack"/>
    <transition event="deadline_p2_dut_fin" target="fail_p2_no_dut_fin"/>
  </state>
  <state id="listening_p2_probe_ack">
    <onentry><send event="deadline_p2_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="pass"/>
    <transition event="deadline_p2_probe_ack" target="fail_p2_no_probe_ack"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="fail_p1_no_handshake_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack_phase1"}</content></donedata></final>
  <final id="fail_p1_no_close_wait_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_close_wait_ack_phase1"}</content></donedata></final>
  <final id="fail_p1_no_dut_fin"><donedata><content>{"verdict":"fail","reason":"no_dut_fin_phase1"}</content></donedata></final>
  <final id="fail_p1_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_in_last_ack"}</content></donedata></final>

  <final id="fail_p2_no_handshake_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack_phase2"}</content></donedata></final>
  <final id="fail_p2_no_close_wait_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_close_wait_ack_phase2"}</content></donedata></final>
  <final id="fail_p2_no_dut_fin"><donedata><content>{"verdict":"fail","reason":"no_dut_fin_phase2"}</content></donedata></final>
  <final id="fail_p2_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_unacceptable_ack_in_last_ack"}</content></donedata></final>
</scxml>
