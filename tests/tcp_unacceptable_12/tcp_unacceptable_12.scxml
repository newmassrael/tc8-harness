<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_12: TCP, in LAST-ACK state, MUST
  return an empty acknowledgment with proper SEQ and ACK numbers
  after receiving a segment with out-of-window SEQ or unacceptable
  ACK number, and remain in LAST-ACK. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  v3.0 Test Procedure (p301-p320.txt:697) lists two iterations:
    * CASE 1: data segment with out-of-window SEQ.
    * CASE 2: data segment with an unacceptable ACK number.

  Per-phase prelude (the tester suppresses its pure ACKs across both
  phases, keeping the DUT pinned in LAST-ACK long enough for the
  corrupt-segment probe to elicit the spec-asserted DUT challenge
  ACK):
    1. Active-OPEN handshake → ESTABLISHED (DUT third-leg ACK).
    2. Tester write-side half-close → tester FIN+ACK → DUT auto-ACK
       observed → DUT CLOSE-WAIT.
    3. The DUT issues a CLOSE → DUT FIN+ACK observed; the tester
       pure ACK to the DUT FIN is suppressed → DUT LAST-ACK.
    4. Snapshot tester snd_nxt / rcv_nxt.
    5. Inject CASE-distinct corrupt segment.
    6. The tester drops its socket without emitting a FIN.

  Per phase the SCXML walks four DUT-origin observations:
    1. handshake third-leg ACK (DUT pure ACK)
    2. tester-FIN-elicited DUT auto-ACK (DUT pure ACK; CLOSE-WAIT)
    3. close-elicited DUT FIN+ACK (DUT enters LAST-ACK)
    4. probe-elicited DUT empty ACK to corrupt segment

  ## Linux behaviour (CASE 2 observable in LAST-ACK)

  Both phases pass on a Linux DUT. In LAST-ACK, when the incoming
  ACK is past snd_nxt, Linux fires a challenge ACK rather than
  dropping the segment. LAST-ACK joins FIN-WAIT-1 (UNACCEPTABLE_09),
  CLOSING (UNACCEPTABLE_11), and CLOSE-WAIT (UNACCEPTABLE_14) in
  honouring CASE 2.

  This contradicts an earlier extrapolation that grouped LAST-ACK
  with ESTABLISHED (UNACCEPTABLE_04) and FIN-WAIT-2 (UNACCEPTABLE_10)
  as silent-drop. EST genuinely silent-drops, discarding the
  segment; the FW2 orphaned mini-socket emits an RST via its
  TIME-WAIT substate. LAST-ACK takes the third path — challenge ACK
  via the receive state machine — confirmed empirically with the
  pcap kernel ring upgrade (commit c8caa79).

  Phase 1 (CASE 1 OTW SEQ): seq = snd_nxt + kOutOfWindowSeqOffset;
  ack = rcv_nxt - 1 (acceptable but does NOT acknowledge DUT FIN).
  Linux's out-of-window SEQ check fires before the ACK-validity
  check — challenge ACK observed.

  Phase 2 (CASE 2 unacceptable ACK): seq = snd_nxt (in-window);
  ack = rcv_nxt - 1 + kUnacceptableAckOffset (past snd_nxt).
  Receive-state-machine challenge-ACK path — empty ACK observed.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_12"
       datamodel="null"
       initial="listening_p1_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake_ack">
    <onentry><send event="deadline_p1_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset)"
                target="listening_p1_close_wait_ack"/>
    <transition event="deadline_p1_handshake_ack" target="inconclusive_p1_no_handshake_ack"/>
  </state>
  <state id="listening_p1_close_wait_ack">
    <onentry><send event="deadline_p1_close_wait_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset)"
                target="listening_p1_dut_fin"/>
    <transition event="deadline_p1_close_wait_ack" target="inconclusive_p1_no_close_wait_ack"/>
  </state>
  <state id="listening_p1_dut_fin">
    <onentry><send event="deadline_p1_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset)"
                target="listening_p1_probe_ack"/>
    <transition event="deadline_p1_dut_fin" target="inconclusive_p1_no_dut_fin"/>
  </state>
  <state id="listening_p1_probe_ack">
    <onentry><send event="deadline_p1_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="listening_p2_handshake_ack"/>
    <transition event="deadline_p1_probe_ack" target="inconclusive_p1_no_probe_ack"/>
  </state>

  <state id="listening_p2_handshake_ack">
    <onentry><send event="deadline_p2_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset)"
                target="listening_p2_close_wait_ack"/>
    <transition event="deadline_p2_handshake_ack" target="inconclusive_p2_no_handshake_ack"/>
  </state>
  <state id="listening_p2_close_wait_ack">
    <onentry><send event="deadline_p2_close_wait_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset)"
                target="listening_p2_dut_fin"/>
    <transition event="deadline_p2_close_wait_ack" target="inconclusive_p2_no_close_wait_ack"/>
  </state>
  <state id="listening_p2_dut_fin">
    <onentry><send event="deadline_p2_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset)"
                target="listening_p2_probe_ack"/>
    <transition event="deadline_p2_dut_fin" target="inconclusive_p2_no_dut_fin"/>
  </state>
  <state id="listening_p2_probe_ack">
    <onentry><send event="deadline_p2_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset) and captured.ack_num == captured.expected_ack_num_phase2"
                target="pass"/>
    <transition event="deadline_p2_probe_ack" target="inconclusive_p2_no_probe_ack"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_p1_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase1","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_p1_no_close_wait_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_wait_ack_phase1","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p1_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase1","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p1_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_in_last_ack","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p2_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase2","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p2_no_close_wait_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_wait_ack_phase2","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p2_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase2","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p2_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_unacceptable_ack_in_last_ack","role":"property_unobserved"}</content></donedata></final>
</scxml>
