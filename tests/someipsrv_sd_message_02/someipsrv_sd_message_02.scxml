<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.3.2 SOMEIPSRV_SD_MESSAGE_02: When a FindService carries a
  specific Service Instance ID (not 0xFFFF), the DUT shall reply with an
  OfferService whose entries reference only the queried instance
  (TR_SOMEIP_00351). Spec body issues two specific Finds (instance 0x0001
  then instance 0x0002) and verifies each elicits a 1-entry OfferService.

  Two-phase observation:
    Phase 1: Stimulus emits Find(instance_id=0x0001). Cond: 1-entry
             OfferService whose entries[0].instance_id == 0x0001.
             Cyclic 2-entry Offers silently dropped by the
             sd_entry_count == 1 filter.
    Phase 2: Stimulus subsequently emits Find(instance_id=0x0002). Cond:
             1-entry OfferService whose entries[0].instance_id == 0x0002.

  The two Finds are issued sequentially in Traits::stimulus(); within
  this 5 s phase 2 deadline both Find-triggered Offers will arrive.
  Phase ordering tolerates either Offer arriving first — phase 1 cond
  matches only the 0x0001 axis, phase 2 only the 0x0002 axis, so the
  two cond branches are mutually exclusive and order-independent.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_sd_message_02"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count == 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].instance_id == expected.instance_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer_for_instance_1"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count == 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].instance_id == expected.instance_id + 1"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_offer_for_instance_2"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer_for_instance_1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_single_entry_offer_for_instance_id_1_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_offer_for_instance_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_single_entry_offer_for_instance_id_2_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
