<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.7 IPv4_REASSEMBLY_10 negative — lwIP ingress-fault self-validation of the
  positive's PHASE B guard. Phase B sends a fragment pair straddling the reassembly
  timer and requires the DUT to stay silent, because the bucket must have expired before
  the tail arrives. kIpv4FaultHoldFirstFragment defers the head and replays it immediately
  ahead of the tail, so the stack meets the pair back-to-back however long the wire gap
  was — which is exactly what a DUT whose reassembly timer is too long looks like.

  ⚠ Armed MID-STREAM, between the phases. Armed from the start the flavour would defer
  phase A's head the same way, the run would settle on a phase-A final, and phase B —
  the half this negative is for — would never be entered. Phase A therefore runs exactly
  as the positive drives it, and this body consumes its Echo Reply before opening the
  window that matters.

    Pass:  a second DUT-origin Echo Reply, in the phase B window.
    Fail:  none arrived — the flavour was inert, a wiring regression rather than a DUT
           conformance violation. The single `fail` a `_neg` carries.
    Inconclusive: phase A never replied, so the arm window never opened and phase B was
           never entered. A wrong-STAGE catch, so a non-conclusion rather than inert.

  A phase-B Time Exceeded is deliberately ungraded here, as in the positive: it would say
  the bucket expired, which is the CONFORMANT outcome this negative is trying to break,
  and grading it would confuse a working DUT with a working fault.

  lwIP-only (kCapIngressFault).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_reassembly_10_neg4"
       datamodel="null"
       initial="listening_phase_a">

  <sce:context id="captured"
               cpp:type="tc8::Icmpv4Captured"
               cpp:include="sce_integration/icmpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Icmpv4Expected"
               cpp:include="sce_integration/icmpv4_expected.h"/>

  <state id="listening_phase_a">
    <onentry>
      <send event="phase_a_deadline" delay="6s"/>
    </onentry>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip"
                target="listening_phase_b"/>
    <transition event="phase_a_deadline" target="inconclusive_no_phase_a_reply"/>
  </state>

  <state id="listening_phase_b">
    <onentry>
      <send event="phase_b_deadline" delay="8s"/>
    </onentry>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip"
                target="pass"/>
    <transition event="phase_b_deadline" target="fail_compliant_silent_in_phase_b"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_silent_in_phase_b">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_stayed_silent_in_phase_b_despite_armed_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_phase_a_reply">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_phase_a_reply_so_the_arm_window_never_opened","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
