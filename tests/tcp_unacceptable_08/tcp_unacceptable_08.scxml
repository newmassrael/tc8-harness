<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_08: TCP in SYN-SENT state MUST send a
  RST control message with SEQ equal to the incoming segment's ACK
  number after receiving a segment carrying an unacceptable ACK.
  Derived from RFC 793 §3.4 p36 Establishing a Connection (MUST).

  v3.0 Test Procedure (p301-p320.txt:506), two iterations — both
  exercised:
    * Phase 1 (CASE 1): flag set = SYN,ACK with unacceptable ACK.
    * Phase 2 (CASE 2): flag set = ACK only with unacceptable ACK.

  Mechanism (per phase, mirrored on FLAGS_INVALID_05's 2-phase
  pattern):
    a. TesterAutoRstDrop suppresses tester-kernel auto-RST so the
       DUT's outbound SYN does not provoke a tester-kernel RST that
       would knock DUT out of syn-sent before the bad-ACK inject.
    b. UT OpOpenTcpSocket(Active) — DUT binds + connect() → SYN
       emitted, DUT in syn-sent. With no tester listener bound, the
       SYN goes nowhere and DUT retransmits per Linux's
       tcp_syn_retries cadence (~1 s); the spec assertion fires
       well before retransmit timing matters.
    c. TcpFrameSnippet captures the DUT-emitted SYN to learn ISN_d.
    d. tester raw-injects (CASE 1: SYN+ACK / CASE 2: ACK) with
       ack_num = ISN_d + LARGE_OFFSET. Per RFC 793 §3.4 p36 syn-sent
       responds RST(seq = incoming.ack).
    e. SCXML observes DUT RST on the per-phase active port quad.
    f. UT close — best-effort.

  Phase 2 fires via scheduleAfterStateEntry on Listening_p2_dut_rst
  so its DUT SYN is not queued behind phase 1's wall-clock absence.
  Each phase uses a distinct local/remote port pair and socket_id
  (mirror of FLAGS_INVALID_05). If tc8-dut's UT close-path races
  the lingering syn-sent retransmit on phase 2 (audit-flagged
  TEST-DESIGN concern), the case lands fail_p2_no_dut_rst on Linux
  DUT and is excluded from CI green via grep filter in
  .github/workflows/smoke-test.yml.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_08"
       datamodel="null"
       initial="listening_p1_dut_rst">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_dut_rst">
    <onentry>
      <send event="deadline_p1" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsActiveLocalPort and captured.dst_port == ::tc8::sce::tcp::kBasicsActiveRemotePort and (captured.flags &amp; 0x04) != 0"
                target="listening_p2_dut_rst"/>
    <transition event="deadline_p1" target="fail_p1_no_dut_rst"/>
  </state>

  <state id="listening_p2_dut_rst">
    <onentry>
      <send event="deadline_p2" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsActiveLocalPort + 28 and captured.dst_port == ::tc8::sce::tcp::kBasicsActiveRemotePort + 28 and (captured.flags &amp; 0x04) != 0"
                target="pass"/>
    <transition event="deadline_p2" target="fail_p2_no_dut_rst"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_p1_no_dut_rst">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_rst_phase1_synack_with_unacceptable_ack"}</content>
    </donedata>
  </final>

  <final id="fail_p2_no_dut_rst">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_rst_phase2_ack_with_unacceptable_ack"}</content>
    </donedata>
  </final>
</scxml>
