<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_12 negative — lwIP app-report-fault self-validation of the
  positive _12 max-length-report guard. The positive injects a 65 507 B UDP datagram split
  across ~45 IP fragments; the DUT reassembles it end-to-end and the GetReceivedUdp
  Confirmation reports payload_len == 65507. This negative arms kAppFaultReportWrongLength,
  so the shared data listener over-reports the reassembled length by one (65508) for the
  correctly-received datagram — the only faithful site, since the stack reassembled and
  delivered the full datagram correctly and the defect is the receive operation's reporting
  of the length. Pass = the corrupted length observed (ut_recv_payload_len != 65507);
  fail_compliant = the DUT reported the correct length despite the flavor (fault inert).
  lwIP-only (capability-gated on kCapAppFault). Envelope: udp_ut_received_check
  (report-fault dual-use).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_12_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/udp_ut_received_check.sce-template.xml"
           pass_expr="captured.ut_recv_payload_len != 65507"
           fail_reason_field="dut_reported_correct_payload_length_despite_flavor"
           fail_state="fail_compliant"
           fail_role="fault_injection_inert"/>
</scxml>
