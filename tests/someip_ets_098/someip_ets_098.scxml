<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_098: SD_ClientService_subscribe_without_method_call.

  After clientServiceActivate, the DUT enters Client Mode but `clientService
  SubscribeEventgroup` is NOT invoked. The tester then emits OfferService
  for SERVICE-ID-2; per spec the DUT must NOT respond with SubscribeEventgroup
  because the explicit subscribe trigger never fired. Any DUT-side
  SubscribeEventgroup entry (type 0x06) on SERVICE-ID-2 within the listen
  window = fail.

  Phase 1 (listening_phase1): SD warm-up — OfferService for SERVICE-ID-1.
  Phase 2 (listening_phase2): 5 s absence window after stimulus emits
          OfferService for SERVICE-ID-2. Any DUT SubscribeEventgroup entry
          on SERVICE-ID-2 = fail. Deadline = pass.

  Reference: PRS_SOMEIPSD_00386.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_098"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x06 and captured.sd_entries[0].service_id == 0xF4E8"
                target="fail_phase2_dut_subscribed_without_trigger"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_subscribed_without_trigger">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_subscribe_without_explicit_trigger"}</content>
    </donedata>
  </final>
</scxml>
