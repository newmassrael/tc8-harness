<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_03 negative — closes the
  self-reference trap on the positive _03 case (DHCPREQUEST MUST echo the
  OFFER's server-id in Option 54, RFC 2131 §3.1 / §4.3.2). The positive's
  server-id-mismatch branch is unreachable against a conformant tc8-dut,
  which always echoes the offered server-id.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorRequestServerIdCorrupt flavor, gated to the
  post-OFFER REQUEST (the DISCOVER stays conformant so the OFFER still
  matches and the lifecycle reaches REQUEST). tc8-dut then writes a wrong
  Option 54 value (192.0.2.54) in the REQUEST. A conformant client
  (flavor None) echoes the real server-id, so this negative's
  fail_compliant branch is the live conformant-DUT outcome.

  Reuses the positive's dhcpv4_request_field template with pass_expr
  inverted (pass = server-id mismatch observed); fail_compliant fires
  when the client echoed the correct server-id despite the flavor.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_03_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="!captured.option_be32_equals(54, expected.server_id_be)"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_request_echoed_server_id_despite_opt54_corrupt_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
