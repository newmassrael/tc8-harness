<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_03 negative — lwIP TCP behavioral-synthesis
  self-validation of the positive _03 no-response-to-ACK-RST guard. A conformant DUT in
  SYN-SENT silently drops an ACK+RST whose ACK is unacceptable (RFC 793 §3.9 p66); the
  positive asserts that absence. This negative arms kTcpSynthRstOnDisruptive so the lwIP
  netif input hook synthesizes the prohibited RST on the connection's 4-tuple when the
  ACK+RST arrives (the disruptive-flag gate fires on the RST), and passes only when that
  synthesized RST is observed. lwIP-only (capability-gated on kCapIngressFault).

  Two-state chain mirrors the positive's prelude, with the absence window's fail
  predicate flipped to the pass trigger:
    * listening_dut_syn — observe the DUT's active-OPEN SYN on the case 4-tuple, the same
      SYN-SENT precondition the positive confirms (deadline -> inconclusive: no SYN means
      the DUT never reached the state under test).
    * watch_synth_rst — 8 s window; the positive's absence-fail predicate
      (is_dut_rst or is_pure_dut_ack on the 4-tuple) lands on pass here, because the
      synthesized RST appears right after the injected ACK+RST; the deadline means the
      DUT stayed silent despite the armed flavor (fault inert).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_03_neg"
       datamodel="null"
       initial="listening_dut_syn">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_dut_syn">
    <onentry>
      <send event="deadline_dut_syn" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid03LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid03LocalOffset)"
                target="watch_synth_rst"/>
    <transition event="deadline_dut_syn" target="inconclusive_no_dut_syn"/>
  </state>

  <state id="watch_synth_rst">
    <onentry>
      <send event="deadline_synth_rst" delay="8s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid03LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid03LocalOffset) or captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid03LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid03LocalOffset)"
                target="pass"/>
    <transition event="deadline_synth_rst" target="fail_compliant"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_syn">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_syn_to_active_open","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_silent_despite_synth_rst_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
