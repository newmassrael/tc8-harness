<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_04: TCP in ESTABLISHED state MUST
  return an empty acknowledgment with proper SEQ and ACK numbers
  after receiving a segment with out-of-window SEQ or unacceptable
  ACK, and remain in ESTABLISHED. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  v3.0 Test Procedure (p301-p320.txt:357), two iterations — both
  exercised here:
    * CASE 1 (phase 1): data segment with out-of-window SEQ.
    * CASE 2 (phase 2): data segment with unacceptable ACK number
      (after snd_nxt).

  Linux DUT deviation — CASE 2 is silent-dropped:
    * CASE 1 OTW SEQ → Linux's `tcp_validate_incoming` reaches the
      `out_of_window` path and schedules an ACK
      (`inet_csk_schedule_ack`); the empty ACK is observable on
      pcap as the spec mandates.
    * CASE 2 bad ACK in ESTABLISHED → Linux's `tcp_rcv_established`
      slow_path step5 (Linux 6.5 net/ipv4/tcp_input.c:6026-6031)
      calls `tcp_ack`, which returns -1 for `after(ack, snd_nxt)`
      (line 3819-3820: -SKB_DROP_REASON_TCP_ACK_UNSENT_DATA), and
      the caller follows `goto discard` WITHOUT invoking
      `tcp_send_challenge_ack`. ESTABLISHED is the only state on
      Linux that genuinely silent-drops CASE 2 — the FW2 path
      emits an RST (UNACCEPTABLE_10's mini-socket substate) and
      every other non-EST state (FW1, CLOSING, LA, CW) takes the
      `tcp_rcv_state_process` branch which explicitly fires
      `tcp_send_challenge_ack(sk)` as the spec mandates. See
      reference_unacc_ack_dispatch memory for the full source
      trace + dispatch table.
      Linux DUT therefore lands `fail_no_dut_ack_to_unacc_ack`
      and is excluded from CI green via grep filter in
      .github/workflows/smoke-test.yml. A strict-RFC DUT lands
      pass without filter.

  Pass guard structure — three listening states walked in sequence:
    listening_handshake_ack  — consume the handshake third-leg ACK
        (also a DUT pure-ACK with payload=0) so the post-stimulus
        ACK matching is unambiguous.
    listening_otw_ack        — pass on next DUT pure-ACK after
        phase 1 OTW-SEQ stimulus; transitions to phase 2.
    listening_unacc_ack      — onentry schedules phase 2 stimulus
        (unacc-ACK); pass on next DUT pure-ACK; deadline → fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_04"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset)"
                target="listening_otw_ack"/>
    <transition event="deadline_handshake" target="fail_no_handshake_ack"/>
  </state>

  <state id="listening_otw_ack">
    <onentry>
      <send event="deadline_otw_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset)"
                target="listening_unacc_ack"/>
    <transition event="deadline_otw_ack" target="fail_no_otw_seq_ack"/>
  </state>

  <state id="listening_unacc_ack">
    <onentry>
      <send event="deadline_unacc_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset)"
                target="pass"/>
    <transition event="deadline_unacc_ack" target="fail_no_dut_ack_to_unacc_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_handshake_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_handshake_ack_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_no_otw_seq_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_data"}</content>
    </donedata>
  </final>

  <final id="fail_no_dut_ack_to_unacc_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_unacc_ack_data"}</content>
    </donedata>
  </final>
</scxml>
