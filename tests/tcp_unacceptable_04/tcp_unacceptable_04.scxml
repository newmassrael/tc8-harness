<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_04: TCP in ESTABLISHED state MUST
  return an empty acknowledgment with proper SEQ and ACK numbers
  after receiving a segment with out-of-window SEQ or unacceptable
  ACK, and remain in ESTABLISHED. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  Case shape — two iterations, both
  exercised here:
    * CASE 1 (phase 1): data segment with out-of-window SEQ.
    * CASE 2 (phase 2): data segment with unacceptable ACK number
      (after snd_nxt).

  How a Linux DUT answers CASE 2 (unacceptable ACK) depends on which
  kernel function the segment reaches, so it differs by state:
    * ESTABLISHED (this case) → tcp_rcv_established. Linux 6.5
      discarded the unsent-data ACK (ack after SND.NXT) silently,
      so this case timed out to inconclusive_no_dut_ack_to_unacc_ack.
      Kernel 7.0.0-31 answers with a pure ACK and the case passes
      (measured single-pc 2026-09-24); it carries no known-fail mark.
    * FIN-WAIT-2 after the application closed → the socket is an
      orphaned time-wait mini-socket, and tcp_timewait_state_process
      resets new data (UNACCEPTABLE_10, docs/tech-debt.md TD-31).
    * FIN-WAIT-1, CLOSING, LAST-ACK, CLOSE-WAIT → tcp_rcv_state_process
      sends a challenge ACK for any unacceptable ACK outside
      SYN-RECEIVED, as the spec requires (UNACCEPTABLE_09, _11, _12,
      _14).
  CASE 1 (out-of-window SEQ) gets an empty ACK here in ESTABLISHED.

  Pass guard structure — three listening states walked in sequence:
    listening_handshake_ack  — consume the handshake third-leg ACK
        (also a DUT pure-ACK with payload=0) so the post-stimulus
        ACK matching is unambiguous.
    listening_otw_ack        — pass on next DUT pure-ACK after
        phase 1 OTW-SEQ stimulus; transitions to phase 2.
    listening_unacc_ack      — onentry schedules phase 2 stimulus
        (unacc-ACK); pass on next DUT pure-ACK; deadline → fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_04"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset)"
                target="listening_otw_ack"/>
    <transition event="deadline_handshake" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_otw_ack">
    <onentry>
      <send event="deadline_otw_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset)"
                target="listening_unacc_ack"/>
    <transition event="deadline_otw_ack" target="inconclusive_no_otw_seq_ack"/>
  </state>

  <state id="listening_unacc_ack">
    <onentry>
      <send event="deadline_unacc_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable04LocalOffset)"
                target="pass"/>
    <transition event="deadline_unacc_ack" target="inconclusive_no_dut_ack_to_unacc_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_otw_seq_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_data","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_ack_to_unacc_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_unacc_ack_data","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
