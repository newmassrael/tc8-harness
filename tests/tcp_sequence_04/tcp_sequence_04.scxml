<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.17 TCP_SEQUENCE_04: from LISTEN, the DUT MUST accept a SYN
  carrying Sequence Number = 2^32 - 1 (SeqMaxVal) and emit SYN,ACK
  whose ack_num wraps to 0 per RFC 793 §3.1 modulo-32 arithmetic.

  v3.0 Test Procedure (p381-p400.txt:655-657):
    1. TESTER: Send a SYN to DUT at <wnp> with Initial Sequence Number
               equal to <SeqMaxVal>.
    2. DUT:    Send SYN,ACK with Ack Number equal to 0.

  Mechanism: same shape as SEQUENCE_01 with `tester_isn = 0xFFFFFFFFU`.
  The SYN consumes 1 sequence number (SeqMaxVal+1 == 0 modulo 2^32),
  so the DUT's SYN,ACK must carry ack_num == 0.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_sequence_04"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpSequence04ListenPort and captured.dst_port == ::tc8::sce::tcp::kTcpSequence04TesterSrcPort and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ack_num == 0U"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpSequence04ListenPort and captured.dst_port == ::tc8::sce::tcp::kTcpSequence04TesterSrcPort and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ack_num != 0U"
                target="fail_wrong_ack_num"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_wrong_ack_num">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_synack_ack_num_not_zero_for_max_isn","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_syn_ack_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
