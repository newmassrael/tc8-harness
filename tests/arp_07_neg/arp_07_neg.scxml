<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_07 negative — lwIP egress-fault self-validation of the
  positive _07 opcode guard. emitEgressFlavorArm(kArpFaultOpcodeWrong) makes
  the lwIP netif link-output hook rewrite the Operation Code of the DUT's
  emitted Request. Pass = corrupted opcode observed (opcode != 1);
  fail_compliant = DUT emitted opcode 1 despite the flavor (fault inert).
  lwIP-only (neg_expected:false on Linux). Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_07_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.opcode != 1"
           fail_state="fail_compliant"
           fail_reason="dut_emitted_arp_request_despite_opcode_wrong_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
