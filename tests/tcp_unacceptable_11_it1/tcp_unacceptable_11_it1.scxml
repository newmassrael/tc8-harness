<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_11, iteration 1 of 2: a DUT in CLOSING receives a data segment
  whose SEQ is out of the window, and MUST answer with an empty acknowledgement carrying
  the right SEQ and ACK numbers while staying in CLOSING (RFC 793 §3.4 p37).

  The iteration is a case of its own: the TC8 case is the ordered set of its iterations
  and its verdict their conjunction (case_iteration.h). The second iteration, an
  unacceptable ACK number, is tcp_unacceptable_11_it2; they share one stimulus body and
  differ only in the segment sent.

  Observable interaction: active-OPEN handshake to ESTABLISHED, the tester suppresses its
  kernel's pure ACKs so the DUT, once it CLOSEs, stays in FIN-WAIT-1 long enough for the
  tester's FIN+ACK (whose ack number does not acknowledge the DUT's FIN) to drive it into
  CLOSING; the tester then snapshots its SEQ/ACK and injects the corrupt segment. Four
  DUT-origin observations reach the machine on tcp_observed, in order:
    1. the handshake's third-leg ACK (pure ACK);
    2. the DUT's FIN+ACK (the CLOSE that put it in FIN-WAIT-1);
    3. the pure ACK of the tester's FIN (the move into CLOSING);
    4. the empty ACK answering the corrupt segment, with ack_num == expected_ack_num.

  The procedure states no listen time, so the general input parameter ParamListenTime
  bounds the wait for the answer in (4). A window that elapses without it is the DUT's
  silence where it must answer: observed_quiescence, judged against that bound (H3), over
  ParamListenTime plus ParamToleranceTime (10 s + 1 s at the defaults). The handshake,
  close-FIN and closing-ACK windows that bring the DUT to CLOSING stay inconclusive: they
  set up the state the segment tests.

  Linux sends a challenge ACK for an out-of-window SEQ regardless of state, before the
  ACK-validity check runs, so a Linux DUT passes this iteration.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_11_it1"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset)"
                target="listening_close_fin"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_close_fin">
    <onentry>
      <send event="deadline_close_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset)"
                target="listening_closing_ack"/>
    <transition event="deadline_close_fin" target="inconclusive_no_close_fin"/>
  </state>

  <state id="listening_closing_ack">
    <onentry>
      <send event="deadline_closing_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset)"
                target="listening_probe_ack"/>
    <transition event="deadline_closing_ack" target="inconclusive_no_closing_ack"/>
  </state>

  <state id="listening_probe_ack">
    <onentry>
      <send event="deadline_probe_ack" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable11Phase1LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="pass"/>
    <transition event="deadline_probe_ack" target="fail_no_probe_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_close_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_close_fin","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_closing_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_in_closing_transition","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_no_probe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_in_closing","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
