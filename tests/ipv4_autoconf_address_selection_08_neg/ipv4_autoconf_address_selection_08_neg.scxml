<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_08 negative — closes
  the self-reference trap on the positive _08 case. tc8-dut emits
  Probes via OpStartLLAutoconfBuggy(flavor=TargetOutsidePrefix):
  target_proto_ip = 192.168.1.66 (RFC 1918 private — NOT in
  169.254/16, RFC 3927 §2.1 MUST violation).

  Pass = SCXML lands on fail_target_ip_outside_link_local_prefix
  branch — the violation is detected. fail_compliant_emit = tc8-dut
  ignored the flavor byte, harness silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_08_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="!captured.target_proto_ip_in_link_local_prefix()"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_probe_despite_target_outside_prefix_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
