<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.7 IPv4_REASSEMBLY_13: IP fragments overlap check —
  RFC 791 §3.2 "An Example Reassembly Procedure" (page 29) mandates
  that on partial overlap, the more recently arrived copy wins.
  TESTER injects 4 fragments at offsets 0, 2 (wrong data, 24 B), 2
  (correct data, 8 B partially overlapping the previous), and 3
  (final, 11 B). A conformant DUT applies most-recent-wins to bytes
  16..23 and emits an Echo Reply mirroring the spec's 27 B data
  "ECU NETWORK VALIDATION TEST".

  Linux known-fail (verified 2026-04-27, kernel 6.5):
    Linux post-CVE-2018-5391 hardening (commit 7969e5c40dfd, kernel
    4.18, 2018-08) discards the entire fragment bucket on overlap
    detection. When frag 2 (offset=16, length=8) arrives while the
    bucket already has frag 1 (offset=16, length=24), ip_frag_queue
    increments IPSTATS_MIB_REASMFAILS and calls inet_frag_kill(qp).
    No reassembly, no Echo Reply → inconclusive_timeout
    (no_echo_reply_after_overlap_reassembly).
    See `reference_linux_ip_reassembly_deviations.md` for the kernel
    trace.

    This case is intentionally NOT included in default smoke
    regression (smoke-test.sh only runs CLI-positional cases). It is
    runnable on demand against a non-Linux DUT (AUTOSAR / vendor IP
    stack) that follows RFC 791 verbatim.

  Pass criterion = type=0 Echo Reply with matching echo_id +
  echo_seq + 27 B payload (kReassembly13EchoPayload).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_reassembly_13"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Icmpv4Captured"
               cpp:include="sce_integration/icmpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Icmpv4Expected"
               cpp:include="sce_integration/icmpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.echo_id == expected.echo_id and captured.echo_seq == expected.echo_seq and captured.payload_equals(std::string_view(reinterpret_cast&lt;const char*&gt;(::tc8::sce::ipv4::reassembly::kReassembly13EchoPayload.data()), ::tc8::sce::ipv4::reassembly::kReassembly13EchoPayload.size()))"
                target="pass"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.echo_id != expected.echo_id"
                target="fail_echo_id"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.echo_seq != expected.echo_seq"
                target="fail_echo_seq"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0"
                target="fail_data_mismatch"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_echo_id">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_id_mismatch_after_overlap_reassembly","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_echo_seq">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_seq_mismatch_after_overlap_reassembly","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_data_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"reassembled_echo_data_mismatch_overlap","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_echo_reply_after_overlap_reassembly","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
