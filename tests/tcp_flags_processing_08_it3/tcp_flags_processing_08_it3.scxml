<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_08, iteration 3 of 3: TCP, in CLOSED, LISTEN or SYN-SENT
  state, MUST not process a FIN. Derived from RFC 793 §3.9 p75 Event Processing (MUST). This
  iteration's state is SYN-SENT: the DUT MUST NOT respond, and MUST NOT do more than keep
  retransmitting its SYN.

  A case of its own beside tcp_flags_processing_08_it1 (CLOSED) and _it2 (LISTEN). The DUT
  performs an active OPEN to an unbound tester port (kBasicsActiveLocalPort + 52 and
  kBasicsActiveRemotePort + 52), reaching SYN-SENT; the tester suppresses its kernel auto-RST,
  which would otherwise race-kill the DUT's SYN-SENT before the bare FIN arrives. The tester
  injects a bare FIN with no ACK, which the DUT silently discards in SYN-SENT. The absence
  guard tolerates DUT SYN retransmits (RFC 793-mandated SYN-SENT timer behaviour, unrelated
  to the spec-targeted FIN response): is_dut_syn is excluded from its fail predicate, so the
  periodic retransmit (Linux base RTO 1 s) does not false-fire.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_08_it3"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_dut_syn">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_dut_syn">
    <onentry><send event="deadline_dut_syn" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset)"
                target="listening_silence"/>
    <transition event="deadline_dut_syn" target="inconclusive_no_dut_syn"/>
  </state>

  <state id="listening_silence">
    <onentry><send event="deadline_silence" delay="3s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset) or captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset) or captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing08LocalOffset)"
                target="fail_unexpected_response"/>
    <transition event="deadline_silence" target="pass"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_no_dut_syn">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_syn_to_active_open_phase3","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="fail_unexpected_response">
    <donedata><content>{"verdict":"fail","reason":"dut_emitted_response_to_fin_in_syn_sent","role":"observed_violation"}</content></donedata>
  </final>
</scxml>
