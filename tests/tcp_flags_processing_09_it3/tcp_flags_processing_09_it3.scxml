<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_09, iteration 3 of 3: TCP, in CLOSE-WAIT, CLOSING or
  LAST-ACK state, MUST not change state after receiving a FIN segment with ACK flag set.
  Derived from RFC 793 §3.9 p75 Event Processing (MUST). This iteration's state is LAST-ACK,
  with an invalid ACK number (one that does not acknowledge the DUT's FIN).

  A case of its own beside tcp_flags_processing_09_it1 (CLOSE-WAIT) and _it2 (CLOSING).

  A duplicate FIN+ACK arrives carrying an INVALID ack (one short of acknowledging the DUT's
  FIN). Same observable dispatch as the CLOSING iteration: a challenge ACK, and state stays
  LAST-ACK. A DUT FIN retransmit on its retransmit timer is tolerated.

  Absence guard (3 s): fail on DUT RST. A DUT FIN+ACK retransmit and a DUT pure ACK
  (challenge) are tolerated.

  Port quad (kBasicsActiveLocalPort + 59, kBasicsActiveRemotePort + 59).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_09_it3"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset)"
                target="listening_close_wait_ack"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_close_wait_ack">
    <onentry><send event="deadline_close_wait_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_close_wait_ack" target="inconclusive_no_close_wait_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry><send event="deadline_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset)"
                target="listening_absence"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>

  <state id="listening_absence">
    <onentry><send event="deadline_absence" delay="3s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase3LocalOffset)"
                target="fail_unexpected_state_change"/>
    <transition event="deadline_absence" target="pass"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase3_la","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_no_close_wait_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_wait_ack_phase3_la","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase3_la","role":"precondition_unmet"}</content></donedata></final>
  <final id="fail_unexpected_state_change"><donedata><content>{"verdict":"fail","reason":"dut_emitted_rst_after_dup_fin_ack_in_la","role":"observed_violation"}</content></donedata></final>
</scxml>
