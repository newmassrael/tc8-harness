<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.5 IPv4_ADDRESSING_03: DUT silently discards an IPv4 packet
  whose Destination Address is a loopback address (127.0.0.0/8 — RFC
  1122 section 3.2.1.3). Derived from RFC 791 section 3.2.

  Stimulus: TESTER injects ICMPv4 Echo Request to 127.0.0.1 on a non-
  loopback interface. Kernel's martian-source filter rejects the frame
  (src on external iface, dst on loopback space) and silently drops.

  Body shared with HEADER_02 / 04 / 08 / 09, CHECKSUM_02 via
  sce:template (tests/_templates/ipv4_negative_absence.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_addressing_03"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_negative_absence.sce-template.xml"
           fail_reason="dut_replied_despite_loopback_dst"/>
</scxml>
