<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.2 TCP_CHECKSUM_03: Sender TCP MUST generate a correct
  RFC 793 §3.1 pseudo-header checksum on segments it emits. Derived
  from RFC 1122 s4.2.2.7 p86 TCP Checksum (MUST), RFC 793 §3.1 p16
  Header.

  v3.0 Test Procedure (p301-p320.txt:194):
    1. TESTER: Cause DUT to move on to ESTABLISHED state.
    2. TESTER: Cause the application on the DUT-side to issue a SEND
               request for a data segment.
    3. DUT:    Send the data segment.
    4. TESTER: Verify that correct checksum is present in the
               incoming segment.

  Mechanism (active-OPEN handshake + DUT data send):
    1. Tester opens auxiliary listener on kBasicsActiveRemotePort and
       drives the DUT through an active OPEN. The 3-way handshake
       completes; both endpoints are now in ESTABLISHED.
    2. Tester causes the DUT to send a small fixed payload; the DUT
       emits it as one outbound DATA segment.
    3. SCXML observes the DUT-emitted DATA segment via tcp_observed
       and asserts the pseudo-header checksum is RFC-correct through
       captured.tcp_checksum_valid().

  Pass guard conjuncts (one tcp_observed edge):
    * captured.src_ip   == expected.dut_iface_ip      — DUT-origin
    * captured.dst_ip   == expected.tester_ip
    * captured.src_port == kBasicsActiveLocalPort (49500)
    * captured.dst_port == kBasicsActiveRemotePort (23456)
    * captured.payload_len > 0                         — DATA segment, not handshake ACK
    * captured.tcp_checksum_valid()                    — spec-mandated checksum compute

  payload_len > 0 distinguishes the spec-asserted DATA segment from
  the handshake's third-leg ACK (which has empty payload and would
  otherwise also pass the address conjuncts). tcp_checksum_valid()
  is the spec literal — Linux ALWAYS computes a correct checksum on
  outbound segments, so a conformant DUT lands on `pass`; a buggy
  DUT (e.g. one that emits payload with checksum=0 or a stale value)
  would still match payload_len > 0 but fail the validity guard,
  splitting the failure surface into fail_bad_checksum vs the
  generic timeout.

  Iteration coverage: spec lists no explicit iteration table for
  CHECKSUM_03; one stimulus run is sufficient since Linux's checksum
  compute path is uniform across segment shapes.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_checksum_03"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpChecksum03LocalOffset) and captured.dst_port == (::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpChecksum03LocalOffset) and captured.payload_len &gt; 0 and captured.tcp_checksum_valid()"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpChecksum03LocalOffset) and captured.dst_port == (::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpChecksum03LocalOffset) and captured.payload_len &gt; 0 and not captured.tcp_checksum_valid()"
                target="fail_bad_checksum"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_bad_checksum">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_segment_with_invalid_checksum","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_data_segment_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
