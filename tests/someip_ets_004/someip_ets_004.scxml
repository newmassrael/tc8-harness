<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_004: Burst_Test.

  Tester sends a burst of N=3 echoUINT8 Method Requests in quick
  succession (50 ms retry interval). The DUT must respond to EACH
  request with a Method Response carrying the echo. The 3-burst
  count is sufficient to verify the spec invariant ("response to
  each request") — the spec body does not fix N, and 3 keeps the
  set of waiting states below small in the SCE datamodel="null"
  model (no counter variable).

  Each Request emit increments session_id by 1 starting at 0x0001
  (per `someip_rpc_builder::emitMethodRequestAfter` semantics), so
  the three Responses arrive with session_id 0x0001 / 0x0002 /
  0x0003 and are told apart by it. This catches a DUT that replies
  once per burst AND a DUT that drops responses.

  The specification does not order the Responses, so the machine accepts
  them in any order: there is one waiting state per set of Responses still
  owed (awaiting_responses_123, _12, ..., _3), and each Response moves to
  the set without it. Every waiting state has its own window, so a
  Response still owed has at least one full window after its Request. A
  window that elapses with a Response owed is the DUT's silence where it
  must answer: observed_quiescence, judged against <ParamListenTime>
  (docs/verdict_policy.md Section 2.1, H3), over a window of
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the defaults).
  Each window has its own event name, because SCXML does not cancel a
  delayed send when its state exits.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_004"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="awaiting_responses_123"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="awaiting_responses_123">
    <onentry>
      <send event="awaiting_responses_123_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0001"
                target="awaiting_responses_23"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0002"
                target="awaiting_responses_13"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0003"
                target="awaiting_responses_12"/>
    <transition event="awaiting_responses_123_window_elapsed" target="fail_burst_response_missing"/>
  </state>

  <state id="awaiting_responses_12">
    <onentry>
      <send event="awaiting_responses_12_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0001"
                target="awaiting_responses_2"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0002"
                target="awaiting_responses_1"/>
    <transition event="awaiting_responses_12_window_elapsed" target="fail_burst_response_missing"/>
  </state>

  <state id="awaiting_responses_13">
    <onentry>
      <send event="awaiting_responses_13_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0001"
                target="awaiting_responses_3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0003"
                target="awaiting_responses_1"/>
    <transition event="awaiting_responses_13_window_elapsed" target="fail_burst_response_missing"/>
  </state>

  <state id="awaiting_responses_23">
    <onentry>
      <send event="awaiting_responses_23_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0002"
                target="awaiting_responses_3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0003"
                target="awaiting_responses_2"/>
    <transition event="awaiting_responses_23_window_elapsed" target="fail_burst_response_missing"/>
  </state>

  <state id="awaiting_responses_1">
    <onentry>
      <send event="awaiting_responses_1_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0001"
                target="pass"/>
    <transition event="awaiting_responses_1_window_elapsed" target="fail_burst_response_missing"/>
  </state>

  <state id="awaiting_responses_2">
    <onentry>
      <send event="awaiting_responses_2_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0002"
                target="pass"/>
    <transition event="awaiting_responses_2_window_elapsed" target="fail_burst_response_missing"/>
  </state>

  <state id="awaiting_responses_3">
    <onentry>
      <send event="awaiting_responses_3_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42 and captured.session_id == 0x0003"
                target="pass"/>
    <transition event="awaiting_responses_3_window_elapsed" target="fail_burst_response_missing"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_burst_response_missing">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_respond_to_every_request_in_burst","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
