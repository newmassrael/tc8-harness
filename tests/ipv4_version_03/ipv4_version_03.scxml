<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.4 IPv4_VERSION_03: the DUT's IPv4 packet carries a
  Version field equal to 4.

  Body shared with IPv4_HEADER_01 / IPv4_TTL_01 via sce:template
  (see tests/_templates/ipv4_field_check.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_version_03"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_field_check.sce-template.xml"
           pass_expr="captured.version == 4"
           fail_state="fail_version"
           fail_reason="ipv4_version_not_four"
           fail_role="observed_violation"/>
</scxml>
