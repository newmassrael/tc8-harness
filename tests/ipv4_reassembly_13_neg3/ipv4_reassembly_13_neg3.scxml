<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.7 IPv4_REASSEMBLY_13 negative (sequence variant) — lwIP egress-fault
  self-validation of the positive's `echo_seq_mismatch_after_overlap_reassembly`
  guard. The trait arms kIcmpFaultEchoSeqWrong and sends the positive's datagram
  without the overlapping wrong fragment; lwIP reassembles it and the link-output
  hook XOR-flips the sequence number of its Echo Reply, identifier intact — the
  positive reaches this final only with the identifier matching, so the filter
  requires it too. Pass = the flipped sequence observed; fail_compliant = the DUT
  echoed the sequence despite the flavor (fault inert).

  Neither reference DUT resolves an overlap (docs/tech-debt.md TD-33); the guard
  reads only the reply frame. lwIP-only (kCapEgressFault). Envelope:
  icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_reassembly_13_neg3"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 0 and captured.echo_id == expected.echo_id"
           pass_expr="captured.echo_seq != expected.echo_seq"
           fail_state="fail_compliant"
           fail_reason="dut_echoed_seq_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_echo_reply_after_reassembly_within_listen_window"/>
</scxml>
