<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_04: An ARP Announcement - IV.
  DUT's first Announce carries `target_hw` = all zeroes (RFC 3927 §2.4
  SHOULD: the Announcement is identical to the Probe shape, whose
  target_hw is set to all zeroes per RFC 826 ARP Request convention).

  Spec Test Procedure (tc8_p161-p180.txt:643..683), step 11:
    Verify Target Hardware Address = <NULL-MAC-ADDRESS>.

  `ArpCaptured::target_hw_is_zero()` encapsulates the byte-wise check
  so the SCXML guard stays a single member-method call. Body shared
  via ipv4_linklocal_announce_field.

  Notes Derived from RFC 3927 p13 section 2.4 (SHOULD) — spec body
  classifies this as SHOULD, but the pass criterion is the same wire
  shape as the MUST cases.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_04"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_announce_field.sce-template.xml"
           pass_expr="captured.target_hw_is_zero()"
           fail_state="fail_announce_target_hw_not_zero"
           fail_reason="dut_arp_announce_target_hw_not_null_mac"/>
</scxml>
