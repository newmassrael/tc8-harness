<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_09: DUT emits
  PROBE_NUM = 3 ARP Probes during the link-local probing phase
  (RFC 3927 §2.2.1). The first Probe is the preamble; each later one
  has its own ParamListenTime window, and its absence fails.

  Case shape:
    1-4. DUT brings up iface and sends DHCPDISCOVER.
    5-6. TESTER listens; verify 3 ARP Request Messages received.

  Cadence-bearing case: tc8-dut runs with the RFC default knobs
  (PROBE_WAIT 1 s, PROBE_MIN..PROBE_MAX 1..2 s) so the cadence the
  spec measures is what the tc8-dut actually emits. With those
  knobs Probe1..Probe3 land at ~2.7 s..6.7 s after the stimulus
  call (1.5 s initial wait + 200 ms DHCP fail + PROBE_WAIT + 2 ×
  uniform[1, 2] s). 12 s deadline gives ~5 s margin.

  SCXML counts via 3-step state advance — listening → seen_1 →
  seen_2 → pass — using `is_arp_probe()` so non-Probe ARP traffic
  (e.g., the post-Probe Announce phase if it leaks before the
  third Probe verdict, which it cannot with the chosen timing) does
  not advance the counter.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_09"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="12s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="seen_1"/>
    <transition event="deadline_exceeded" target="inconclusive_no_probes"/>
  </state>

  <state id="seen_1">
    <onentry>
      <send event="second_probe_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="seen_2"/>
    <transition event="second_probe_window_elapsed" target="fail_one_probe_only"/>
  </state>

  <state id="seen_2">
    <onentry>
      <send event="third_probe_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="pass"/>
    <transition event="third_probe_window_elapsed" target="fail_two_probes_only"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_probes">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_arp_probe_after_ll_start","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <!-- Each probe after the first is due within PROBE_MAX of the one before; a
       window of ParamListenTime without it is the DUT's silence. -->
  <final id="fail_one_probe_only">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_sent_one_arp_probe_of_three","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_two_probes_only">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_sent_two_arp_probes_of_three","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
