<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_12: probing-window
  conflict via ARP Reply (RFC 3927 §2.2.1, MUST). Wire shape
  differs from _11 only in opcode (2 vs 1); RFC 3927 §2.2.1 clause
  (a) is opcode-agnostic ("Request *or* Reply"), so the DUT
  conflict-detection path and verdict shape are identical.

  Spec Test Procedure (tc8_p141-p160.txt:681..725):
    1-6. DUT brings up iface, sends DHCPDISCOVER, then 3 ARP Probes.
    7.   Tester reads target_ip from DUT's ARP Probe and stores it.
    8.   Tester sends conflict ARP Response: sender_ip = stored LL,
         dst_ip = 255.255.255.255.
    10-11. DUT MUST emit a fresh ARP Request with target_ip != the
           stored value.

  See `_11/ipv4_autoconf_address_selection_11.scxml` for the full
  trait/SCXML mechanism description; this shell binds
  ConflictArpVariant::Reply via the trait header.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_12"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_conflict_repick.sce-template.xml"/>
</scxml>
