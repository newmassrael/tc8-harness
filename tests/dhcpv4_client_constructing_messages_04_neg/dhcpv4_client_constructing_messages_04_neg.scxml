<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.7 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_04 negative — closes
  the self-reference trap on the positive _04 case (the DHCPREQUEST source
  IP MUST be 0 in REQUESTING state, RFC 2131 §4.1). The positive's
  src-not-zero branch is unreachable against a conformant tc8-dut.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorRequestSrcNonzero flavor (gated to the
  post-OFFER REQUEST). tc8-dut sources the REQUEST from 192.0.2.2. A
  conformant client (flavor None) uses src=0, so this negative's
  fail_compliant branch is the live conformant-DUT outcome.

  Reuses the dhcpv4_request_field template with pass_expr inverted
  (pass = non-zero source observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_04_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="!captured.source_ip_is_zero()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_request_src_zero_despite_src_nonzero_flavor"/>
</scxml>
