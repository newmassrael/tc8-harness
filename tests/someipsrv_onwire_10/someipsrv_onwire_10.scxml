<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.6.10 SOMEIPSRV_ONWIRE_10: When the DUT receives a
  Method Request whose Service ID does not match any offered service,
  it shall reply with SOMEIP_MSG_TYPE_ERROR (0x81) and Return Code
  E_UNKNOWN_SERVICE (0x02). Tester sends a Request to UNKNOWN-SERVICE-
  ID (sentinel ::tc8::sd_test_unknown::kServiceId = 0xFFFE); pass
  requires the matched Error frame echoes the unknown service_id AND
  carries return_code == 0x02.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_onwire_10"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/someipsrv_rpc_field_check.sce-template.xml"
           phase2_filter="captured.service_id == ::tc8::sd_test_unknown::kServiceId and captured.message_type == 0x81"
           pass_expr="captured.return_code == 0x02"
           fail_state="fail_phase2_unknown_service_return_code_mismatch"
           fail_reason="error_return_code_not_e_unknown_service"/>
</scxml>
