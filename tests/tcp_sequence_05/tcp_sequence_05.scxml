<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.17 TCP_SEQUENCE_05: from ESTABLISHED, the DUT MUST
  acknowledge each tester data segment with a cumulative ACK whose
  ack_num covers the bytes received so far (RFC 793 §3.4 p27 ACK
  generation, RFC 793 §3.7 p41 Receiving a Segment).

  v3.0 Test Procedure (p381-p400.txt:689-692):
    1. TESTER: Bring DUT to ESTABLISHED state.
    2. TESTER: Send several TCP packets with Sequence Number
               correctly incremented.
    3. DUT:    Sends an ACK for every received packet with the
               expected Ack Numbers.

  Mechanism:
    A passive LISTEN + raw-injected SYN handshake on listen 13165 /
    tester +165 brings the DUT to ESTABLISHED with tester snd_nxt =
    kTesterInitialSeq + 1. The stimulus then emits three 4-byte
    PSH+ACK segments spaced by
    kDelayedAckSettle (600 ms, past the RFC 1122 §4.2.3.2 delayed-ACK
    ceiling). DUT cumulative ACKs progress through:
      kTesterInitialSeq + 5  (after seg 1, payload [0xC0..0xFE])
      kTesterInitialSeq + 9  (after seg 2)
      kTesterInitialSeq + 13 (after seg 3)

  Pass chain: 3 sequential listening states, each waiting for a pure
  DUT ACK on the listen tuple with strict equality on ack_num. The
  4-tuple match (src_ip, dst_ip, src_port, dst_port) plus
  payload_len == 0 + ACK only flags isolate the case from any
  ambient stray ACKs.

  DUT-agnostic per-segment cadence:
    The spec pass criterion is one ACK per received segment with the
    expected Ack Number. A quickack stack (Linux) ACKs each segment
    immediately; a delayed-ACK stack (lwIP) holds the ACK up to the
    RFC 1122 §4.2.3.2 ceiling (≤500 ms) and would legally coalesce
    segments arriving inside that window into one cumulative ACK —
    landing the SCXML chain at inconclusive_timeout_seg2/seg3 for a test-design
    reason, not a conformance gap (verified 2026-06-11: at the former
    100 ms spacing the lwIP fixture coalesced seg 2+3 into a single
    ack=+13). Spacing the segments by kDelayedAckSettle lets the
    delayed-ACK timer fire for each segment before the next arrives, so
    both DUT classes emit the per-segment cumulative ACKs the chain
    walks; the final gap also outlasts the close-RST race so seg 3's
    ACK is observed before teardown. This keeps the matcher strict
    (per-segment, exact ack_num) while making the case DUT-neutral.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_sequence_05"
       datamodel="null"
       initial="listen_seg1_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listen_seg1_ack">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpSequence05ListenPort, ::tc8::sce::tcp::kTcpSequence05TesterSrcPort) and captured.ack_num == ::tc8::sce::tcp::kTesterInitialSeq + 5U"
                target="listen_seg2_ack"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout_seg1"/>
  </state>

  <state id="listen_seg2_ack">
    <onentry>
      <send event="deadline_exceeded_2" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpSequence05ListenPort, ::tc8::sce::tcp::kTcpSequence05TesterSrcPort) and captured.ack_num == ::tc8::sce::tcp::kTesterInitialSeq + 9U"
                target="listen_seg3_ack"/>
    <transition event="deadline_exceeded_2" target="inconclusive_timeout_seg2"/>
  </state>

  <state id="listen_seg3_ack">
    <onentry>
      <send event="deadline_exceeded_3" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpSequence05ListenPort, ::tc8::sce::tcp::kTcpSequence05TesterSrcPort) and captured.ack_num == ::tc8::sce::tcp::kTesterInitialSeq + 13U"
                target="pass"/>
    <transition event="deadline_exceeded_3" target="inconclusive_timeout_seg3"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_seg1">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_for_seg1","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_seg2">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_for_seg2","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_seg3">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_for_seg3","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
