<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_05, iteration 2 of 2: TCP, in SYN-SENT state, MUST move on
  to CLOSED state after receiving a segment with ACK and RST and acceptable ACK number.
  Derived from RFC 793 §3.9 p67 Event Processing (MUST). This iteration's flag set is ACK
  together with RST.

  A case of its own beside tcp_flags_invalid_05_it1, which holds the shared description and
  the observation order; the two differ only in the flag set and in their port quads
  (kBasicsActiveLocalPort + 23 here).

  Pass is observed indirectly via absence: a DUT that moved to CLOSED will NOT retransmit its
  SYN, and the 3 s absence window catches one that ignored the RST.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_05_it2"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_dut_syn">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_dut_syn">
    <onentry>
      <send event="deadline_dut_syn" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid05Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid05Phase2LocalOffset)"
                target="listening_absence"/>
    <transition event="deadline_dut_syn" target="inconclusive_no_dut_syn"/>
  </state>

  <state id="listening_absence">
    <onentry>
      <send event="deadline_absence" delay="3s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid05Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid05Phase2LocalOffset) or captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid05Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid05Phase2LocalOffset)"
                target="fail_dut_continued"/>
    <transition event="deadline_absence" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_syn">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_syn_phase2_ack_rst","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_dut_continued">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_close_on_ack_rst_with_acceptable_ack","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
