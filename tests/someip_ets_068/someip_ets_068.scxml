<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_068: Unaligned_SOMEIP_Messages_overTCP.

  Tester packs three SOME/IP Method Requests into a single TCP send().
  echoUINT8RELIABLE (METHOD-ID 0x000A on the reliable port 30501) is
  used because tc8-dut's only TCP-reliable echo method is the 1-byte
  UInt8 echo; spec body names "method echoUINT8array" but the test
  invariant is "3 SOMEIP messages in 1 TCP package, one unaligned,
  DUT replies all 3" — the per-method type is incidental.

  Each Request carries a 1-byte payload, so per-message wire size is
  16 (header) + 1 (payload) = 17 bytes, NOT a multiple of 4. The
  bundle therefore lands messages at TCP-stream offsets 0, 17, 34 —
  every one of them unaligned. Per PRS_SOMEIP_00142 / PRS_SOMEIP_00569
  the DUT must walk the stream by per-message Length header and
  respond to every Request on the same TCP connection.

  Each emit increments session_id (0x0001 / 0x0002 / 0x0003) so the
  three Responses arrive pinnable in successive phases. A DUT that
  drops or coalesces responses trips one of the per-phase deadlines.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2a/b/c (listening_phase2_*): One Method Response per
            session_id with msg_type 0x80, return_code 0x00, on
            method_id 0x000A. Each phase has its own 5 s deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_068"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_a"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_a">
    <onentry>
      <send event="phase2a_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.src_port == expected.tcp_port and captured.message_type == 0x80 and captured.method_id == 0x000A and captured.return_code == 0x00 and captured.session_id == 0x0001 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x42"
                target="listening_phase2_b"/>
    <transition event="phase2a_deadline_exceeded" target="inconclusive_phase2_response_missing"/>
  </state>

  <state id="listening_phase2_b">
    <onentry>
      <send event="phase2b_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.src_port == expected.tcp_port and captured.message_type == 0x80 and captured.method_id == 0x000A and captured.return_code == 0x00 and captured.session_id == 0x0002 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x43"
                target="listening_phase2_c"/>
    <transition event="phase2b_deadline_exceeded" target="inconclusive_phase2_response_missing"/>
  </state>

  <state id="listening_phase2_c">
    <onentry>
      <send event="phase2c_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.src_port == expected.tcp_port and captured.message_type == 0x80 and captured.method_id == 0x000A and captured.return_code == 0x00 and captured.session_id == 0x0003 and captured.payload_len == 1 and captured.payload_snapshot[0] == 0x44"
                target="pass"/>
    <transition event="phase2c_deadline_exceeded" target="inconclusive_phase2_response_missing"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_response_missing">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_respond_to_every_message_in_tcp_bundle","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
