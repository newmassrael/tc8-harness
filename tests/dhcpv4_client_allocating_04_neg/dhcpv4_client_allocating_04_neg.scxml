<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_04 negative — closes the
  self-reference trap on the positive _04 case (the SELECTING DHCPREQUEST's
  BOOTP 'secs' MUST equal the originating DHCPDISCOVER's, RFC 2131 §4.3.2).
  The positive's secs-mismatch branch is unreachable against a conformant
  tc8-dut, which emits secs=0 in both DISCOVER and REQUEST.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorRequestSecsMismatch flavor, gated to the
  post-OFFER SELECTING REQUEST (the DISCOVER stays conformant so the OFFER
  still matches and the lifecycle reaches REQUEST). tc8-dut then writes a
  nonzero 'secs' in the REQUEST while the DISCOVER snapshot holds secs=0, so
  secs_matches_discover() is false. A conformant client (flavor None) emits
  matching secs, so this negative's fail_compliant branch is the live
  conformant-DUT outcome.

  Reuses the positive's dhcpv4_request_field template with pass_expr inverted
  (pass = secs mismatch observed); fail_compliant fires when the client
  echoed the DISCOVER's secs despite the flavor. The trait arms
  scheduleDiscoverSnapshotOnStateEntry so the guard can compare against the
  DISCOVER snapshot.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_04_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.secs_mismatches_discover()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_request_echoed_discover_secs_despite_secs_mismatch_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
