<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_04: ARP entry used for UDP egress after ARP Request
  learning. Identical pre-learning stimulus to ARP_03, but positive
  criterion: DUT must emit the provoked UDP to <HOST-1-IP> carrying
  Ethernet Destination = <MAC-ADDR1>. The "cached entry used" signal is
  the Eth-dst byte of the first DUT-originated UDP back to tester_ip.

  Guard fires on `udp_observed` only for frames targeted at the tester
  IP — tester-originated UDP (dst_ip = dut_iface_ip) is ignored, and the
  DUT's ARP Reply to our injected Request is filtered by `arp_observed`
  with `sender_hw == dut_iface_mac && opcode == 1` which is the
  DUT-emitted-ARP-Request fail path.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_04"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
                target="fail_dut_did_arp_request"/>
    <transition event="udp_observed"
                cond="cpp:captured.observed_udp_dst_ip == expected.tester_ip and captured.observed_udp_eth_dst == expected.tester_mac"
                target="pass"/>
    <transition event="udp_observed"
                cond="cpp:captured.observed_udp_dst_ip == expected.tester_ip and captured.observed_udp_eth_dst != expected.tester_mac"
                target="fail_wrong_eth_dst"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_dut_did_arp_request">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_arp_request_after_cache_populated"}</content>
    </donedata>
  </final>

  <final id="fail_wrong_eth_dst">
    <donedata>
      <content>{"verdict":"fail","reason":"udp_eth_dst_not_tester_mac"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_udp_from_dut_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
