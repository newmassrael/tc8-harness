<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.6.12 SOMEIPSRV_ONWIRE_12: When the DUT receives a
  Method Request whose Method ID is not implemented by the offered
  service, it shall reply with SOMEIP_MSG_TYPE_ERROR (0x81) and Return
  Code E_UNKNOWN_METHOD (0x03). Tester sends a Request to UNKNOWN-
  METHOD-ID (sentinel ::tc8::sd_test_unknown::kMethodId = 0xFFFE) on
  the configured SERVICE-ID-1; pass requires the matched Error frame
  carries message_type=0x81 AND return_code=0x03 AND echoes the
  unknown method_id.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_onwire_12"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/someipsrv_rpc_field_check.sce-template.xml"
           phase2_filter="captured.service_id == expected.service_id and captured.message_type == 0x81 and captured.method_id == ::tc8::sd_test_unknown::kMethodId"
           pass_expr="captured.return_code == 0x03"
           fail_state="fail_phase2_unknown_method_return_code_mismatch"
           fail_reason="error_return_code_not_e_unknown_method"/>
</scxml>
