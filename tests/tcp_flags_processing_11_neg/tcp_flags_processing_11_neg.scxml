<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_11 negative — lwIP TCP behavioral-synthesis
  self-validation of the positive _11 no-response-to-duplicate-ACK guard. A conformant DUT
  in ESTABLISHED silently ignores a duplicate ACK (RFC 793 §3.9 p72); the positive asserts
  that absence. This negative arms kTcpSynthRst (the existing pure-ACK gate — the duplicate
  ACK is itself a pure ACK) so the lwIP netif input hook synthesizes the prohibited RST on
  the connection's 4-tuple when the duplicate ACK arrives, and passes only when a DUT
  segment is observed on that 4-tuple. lwIP-only (capability-gated on kCapIngressFault).

  Two-state chain mirrors the positive's prelude, with the silence window's fail predicate
  flipped to the pass trigger:
    * listening_handshake_ack — observe the DUT's active-OPEN third-leg pure ACK on the case
      4-tuple, confirming ESTABLISHED (the _neg reads the wire, not the kCapTcpStateProbe
      ut_established byte the positive uses; deadline -> inconclusive).
    * watch_synth_rst — 8 s window; the positive's silence-fail predicate (any DUT segment
      on the 4-tuple) lands on pass here, because the synthesized RST appears right after the
      injected duplicate ACK; the deadline means the DUT stayed silent despite the armed
      flavor (fault inert).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_11_neg"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing11LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing11LocalOffset)"
                target="watch_synth_rst"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="watch_synth_rst">
    <onentry><send event="deadline_synth_rst" delay="8s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing11LocalOffset and captured.dst_port == ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing11LocalOffset"
                target="pass"/>
    <transition event="deadline_synth_rst" target="fail_compliant"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content></donedata>
  </final>

  <final id="fail_compliant">
    <donedata><content>{"verdict":"fail","reason":"dut_silent_despite_synth_rst_flavor","role":"fault_injection_inert"}</content></donedata>
  </final>
</scxml>
