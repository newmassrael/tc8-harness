<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.3.3.1 ICMPv4_ERROR_02: ICMP error messages ARE sent in
  response to errors on fragment 0 of a fragmented datagram. TESTER
  sends a single fragment (MF=1, offset=0) carrying the malformed
  length-10 Internet Timestamp option; the DUT MUST emit ICMP
  Parameter Problem (type=12).

  Pass Pointer value — spec-vs-implementation:
    * TC8 v3.0 spec literal: Pointer = 22 (IP header 20 + offset 2
      of the pointer byte within the Timestamp option, 0-indexed).
      RFC 792 "identifies the octet where the error was detected"
      is interpretation-dependent: pointing at the specific bad
      byte (pointer field) gives 22 under the spec's arithmetic.
    * Linux kernel convention: Pointer = 20 — points at the option
      TYPE byte (start of offending option). Also a valid RFC 792
      reading: the offending OPTION begins at octet 20, so the
      diagnostic bytes identify the option-start rather than the
      specific bad field within the option.
  Both are observed in the wild on conformant-ish stacks. Accept
  {20, 22} so this test does not penalise a DUT for choosing the
  Linux-style pointer while still catching emissions that point
  elsewhere (DUT mis-identified the parameter problem's location
  entirely). A pointer of 0 / a TTL byte / a data byte would still
  fail the test.

  Shape: positive field-check (not absence), so we do not reuse
  icmpv4_negative_absence. Two field observations (type=12, pointer
  value) plus origin filter form a 3-state machine:

    * pass — DUT replies type=12 AND pointer ∈ {20, 22} AND
      src_ip==DUT.
    * fail_wrong_pointer — DUT replies type=12 from DUT but pointer
      is neither 20 nor 22 (DUT correctly identified a parameter
      problem but mis-localized the offending byte entirely —
      meaningful enough to surface separately from "no reply at
      all").
    * fail_timeout — no DUT-origin type=12 reply within the window.

  Dispatch narrows to type=12 in icmpv4_pilot_common::dispatchIcmpFrame,
  so the tester's own outbound Echo-shape frame (type=8 on the wire
  even with the malformed options) never reaches this SCXML. The
  src_ip conjunct on both DUT-reply transitions is load-bearing: the
  BPF "icmp" filter passes any type=12 frame on the veth pair, and
  without the src_ip check a hypothetical third emitter of type=12
  could falsely pass. Mirror of TYPE_18's shape; template extraction
  deferred until a second Parameter-Problem positive lands.

  Kernel-side note: Linux's `icmp_send` gates error-class ICMP on
  `skb->pkt_type == PACKET_HOST`, so the stimulus must L2-unicast to
  the DUT — traits pass `cfg.arp.dut_iface_mac` via
  `StimulusOverrides::dst_mac`. See `reference_icmp_packet_host_gate.md`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="icmpv4_error_02"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Icmpv4Captured"
               cpp:include="sce_integration/icmpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Icmpv4Expected"
               cpp:include="sce_integration/icmpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 12 and (captured.icmp_pointer == 22 or captured.icmp_pointer == 20) and captured.src_ip == expected.dut_iface_ip"
                target="pass"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 12 and captured.icmp_pointer != 22 and captured.icmp_pointer != 20 and captured.src_ip == expected.dut_iface_ip"
                target="fail_wrong_pointer"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_wrong_pointer">
    <donedata>
      <content>{"verdict":"fail","reason":"parameter_problem_pointer_not_option_or_pointer_byte"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_parameter_problem_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
