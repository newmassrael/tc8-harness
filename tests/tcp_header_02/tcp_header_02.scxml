<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.16 TCP_HEADER_02: DUT accepts a TCP packet containing
  valid header field values. Derived from RFC 793 §3.9 Event
  Processing.

  v3.0 Test Procedure (p387):
    1. TESTER: Bring DUT to 'ESTABLISHED' state.
    2. TESTER: Send a data packet.
    3. DUT:    Sends an ACK packet with the expected Ack Number.

  Mechanism (active-OPEN handshake + injected in-window data):
    1. Drive the DUT through an active OPEN to ESTABLISHED on
       (kBasicsActiveLocalPort+31, kBasicsActiveRemotePort+31).
    2. Snapshot tester snd_nxt / rcv_nxt.
    3. Tester injects PSH+ACK with seq=snd_nxt, ack=rcv_nxt, and a
       4 B payload — a well-formed in-window data segment.
    4. The DUT receiving the in-window data schedules an ACK with
       rcv_nxt advanced by the payload length; the DUT-emitted ACK
       lands on the wire and SCXML verifies ack_num matches the
       expected (snd_nxt + payload_len).

  Two-state SCXML chain:
    * listening_handshake_ack — observe handshake third-leg ACK on
      the active-OPEN port quad. Negative-flip handle: the
      `captured.src_ip == expected.dut_iface_ip` conjunct becomes
      unreachable on ipv4.dut_iface_ip=10.99.99.99, so the negative
      smoke lands on inconclusive_no_handshake_ack.
    * listening_data_ack — observe DUT pure ACK acknowledging the
      raw-injected payload. Pass guard checks ack_num against the
      expected value populated into TcpExpected.expected_ack_num
      from the stimulus snapshot.

  Port-quad selection — kBasicsActiveLocalPort + 31 / +31. Reserved
  block +30..+38 dedicated to §4.8.6.X TCP_HEADER cluster (+30 used
  by HEADER_01).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_header_02"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpHeader02LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpHeader02LocalOffset)"
                target="listening_data_ack"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_data_ack">
    <onentry>
      <send event="deadline_data_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpHeader02LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpHeader02LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpHeader02LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpHeader02LocalOffset) and captured.ack_num != captured.expected_ack_num"
                target="fail_wrong_ack_num"/>
    <transition event="deadline_data_ack" target="inconclusive_no_data_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_data_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_valid_data","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_wrong_ack_num">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_ack_num_does_not_acknowledge_payload","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
