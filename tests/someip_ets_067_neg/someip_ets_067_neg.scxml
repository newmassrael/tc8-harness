<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_067 negative — tc8-dut SOME/IP application-fault self-validation
  of the positive _067 "echo an empty UINT8Array for a zero-length-array request" guard
  (PRS_SOMEIP_00375 / PRS_SOMEIP_00377). The trait arms kEtsFaultEchoArrayWrong (UT 0x1B
  OpSetEtsFlavor), so the harness-owned EtsImpl echoUINT8Array (method 0x0009) response carries
  one extra byte — the DUT echoes a NON-empty array, the violation the positive forbids. The
  zero-length array is WELL-FORMED, so the CommonAPI deserializer parses it and invokes
  echoUINT8Array (unlike ETS_003's EOF-rejected request, which never reaches EtsImpl), making
  the echoed value an EtsImpl-owned (faithful) fault site. Pass = the non-empty echo observed
  (payload neither truly empty nor the 4-byte zero length prefix); fail_compliant = the DUT
  echoed an empty array despite the flavor (fault inert). tc8-dut-only (capability-gated on
  kCapEtsFault — the lwIP fixture carries no SOME/IP service).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_067_neg"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0009 and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.payload_len == 0"
                target="fail_compliant"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0009 and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.payload_len == 4 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x00"
                target="fail_compliant"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0009 and captured.message_type == 0x80 and captured.return_code == 0x00"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_for_zero_length_array","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_echoed_empty_array_despite_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
