<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_16 negative — lwIP ingress-rejection self-validation of the
  positive _16 "accept a zero-checksum datagram" guard. A UDP checksum of 0 signals
  "no checksum computed" (RFC 768) and a DUT MUST accept it. The trait arms
  kUdpFaultRejectValid, so the lwIP netif input hook swallows the inbound data-listener
  frame (never forwards it to lwIP), modelling a buggy DUT that wrongly drops a datagram
  it must accept. Pass = the DUT reported the datagram NOT received (ut_received == 0,
  the injected rejection observed); fail_compliant = the DUT still accepted it despite
  the flavor (fault inert — what a conformant DUT does). lwIP-only (capability-gated on
  kCapIngressFault). Envelope: ipv4_udp_ut_presence.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_16_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_accepted_zero_checksum_udp_despite_flavor"
           fail_reason_timeout="no_ut_confirmation_for_zero_checksum_reject"
           fail_role="fault_injection_inert"/>
</scxml>
