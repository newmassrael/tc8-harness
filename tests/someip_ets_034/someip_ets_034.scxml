<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_034: echoUINT8E2E.

  Tester sends echoUINT8E2E (METHOD-ID 0x000B) with 5 args mirroring the
  AUTOSAR E2E header shape (4×UInt32 BE + 1×UInt8 = 17 bytes back-to-
  back, CommonAPI default deployment, no inter-arg padding):
    Request payload  (17 bytes):
      [00 00 00 05]        len     = 0x00000005
      [00 00 00 01]        counter = 0x00000001
      [CA FE BA BE]        dataID  = 0xCAFEBABE
      [DE AD BE EF]        crc     = 0xDEADBEEF
      [42]                 value   = 0x42

  DUT echoes the request unchanged (PRS_SOMEIP_00065 + spec p401-420
  "echoUINT8E2E_ReqArg1 = echoUINT8E2E_ResArg1, etc."). The harness
  pins all 17 response bytes individually so a regression that drops or
  reorders any E2E header field lands on
  fail_phase2_e2e_echo_mismatch instead of pass.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Method Response (msg_type 0x80,
            return_code 0x00) on method_id 0x000B whose payload equals the
            17 bytes above -> pass.
            Any other Response shape on the same method_id -> fail.
            No Response within the deadline -> fail.

  The expected 17-byte echo is the case-local default set by
  TestCaseTraits::applyExpectedDefaults (cases/someip_ets_034.h); the cond
  reads expected.payload_view(). The negative harness overrides it with a
  flipped-byte `payload=` expect token to drive fail_phase2_e2e_echo_mismatch
  as an observed_violation. The positive run needs no external value.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_034"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x000B and captured.return_code == 0x00 and captured.payload_equals(expected.payload_view())"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x000B and captured.message_type == 0x80 and !captured.payload_equals(expected.payload_view())"
                target="fail_phase2_e2e_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_e2e_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_uint8_e2e_response_did_not_match_request","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
