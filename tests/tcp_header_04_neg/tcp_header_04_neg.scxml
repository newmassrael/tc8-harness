<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.16 TCP_HEADER_04 negative — lwIP TCP behavioral-synthesis self-validation of
  the positive _04 must-discard-wrong-source-port guard. The positive drives the DUT to
  ESTABLISHED on (kBasicsActiveLocalPort+32, kBasicsActiveRemotePort+32), raw-injects an
  in-window PSH+ACK whose SOURCE port is deliberately wrong (kBasicsActiveRemotePort+132),
  and passes on a 3 s absence of any DUT pure ACK on the EST 4-tuple — a conformant DUT
  demultiplexes by the full 4-tuple (RFC 793 §3.1 / §3.9) and drops the wrong-port segment.

  This negative arms kTcpSynthAckSrcPortBlind after the handshake, so the lwIP netif input
  hook walks tcp_active_pcbs for the ESTABLISHED connection on the segment's destination
  port whose remote port differs from the segment's (wrong) source port, then synthesizes
  the prohibited pure ACK on that connection's real EST 4-tuple — modelling a source-port-
  blind demux. That proves the dut_acked_segment_with_wrong_source_port fail-final reachable.
  lwIP-only (kCapIngressFault).

  Two-state chain, same EST 4-tuple guard as the positive (is_pure_dut_ack on
  kBasicsActiveLocalPort+32 / kBasicsActiveRemotePort+32):
    * listening_handshake_ack — the active-OPEN third-leg pure ACK confirms the EST
      connection came up (precondition). Advances before the fault is armed + the trigger
      injected, so this consumes the handshake ACK, not the synthesized one.
    * listening_synth_ack_watch — passes on the synthesized prohibited pure ACK on the EST
      4-tuple; deadline -> fail_compliant (the fault was inert: a flavor-wiring regression,
      NOT a DUT conformance violation; role fault_injection_inert).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_header_04_neg"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpHeader04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpHeader04LocalOffset)"
                target="listening_synth_ack_watch"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_synth_ack_watch">
    <onentry>
      <send event="deadline_synth_ack" delay="8s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpHeader04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpHeader04LocalOffset)"
                target="pass"/>
    <transition event="deadline_synth_ack" target="fail_compliant"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_silent_despite_src_port_blind_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
