<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.6 UDP_INTRODUCTION_03: DUT emits an ICMP Destination
  Unreachable / Port Unreachable (type=3 code=3) reply when a UDP
  datagram arrives addressed to a port for which no LISTEN call is
  pending (RFC 1122 §4.1.3.1 SHOULD).

  Test Procedure (p221-p240.txt:4):
    1. TESTER: Send UDP to <DIface-0-IP>:<unusedUDPDstPort1>.
    2. TESTER: Listen for up to <ParamListenTime> on <DIface-0>.
    3. DUT: Send <ICMP-Dest-Unrchbl>.

  Stimulus is UDP-only at port 20999 — disjoint from kDataPort (20000)
  and ut::kPort (30600), so tc8-dut has no listener bound. Linux's
  kernel emits ICMP Type 3 Code 3 unconditionally on the first such
  receipt (icmp_ratelimit applies but is reset per case_id since each
  worker uses its own netns).

  Reuses udp_no_listen template (BPF=icmp, IcmpCaptured).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_introduction_03"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/udp_no_listen.sce-template.xml"/>
</scxml>
