<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.1 IPv4_HEADER_04: DUT silently discards an IPv4 packet
  whose Destination Address field is neither the DUT's own IPv4
  address nor a broadcast / multicast address. Derived from RFC 791
  sections 3.1 and 3.2, RFC 1122 section 3.2.1.3.

  Stimulus: TESTER injects an ICMPv4 Echo Request to 172.16.0.99
  (unicast host on the same subnet as DUT 172.16.0.2 but not assigned
  to the DUT). Kernel sees a foreign dst, no routing to a local iface,
  silently drops. No Echo Reply.

  Body shared with HEADER_02 / 08 / 09, CHECKSUM_02, ADDRESSING_03 via
  sce:template (tests/_templates/ipv4_negative_absence.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_header_04"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_negative_absence.sce-template.xml"
           fail_reason="dut_replied_despite_non_local_dst_ip"/>
</scxml>
