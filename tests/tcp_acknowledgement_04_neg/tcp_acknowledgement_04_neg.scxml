<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.18 TCP_ACKNOWLEDGEMENT_04 negative — lwIP TCP behavioral-synthesis
  self-validation of the positive _04 no-RST-after-pure-ACK guard. The trait drives the
  active OPEN to ESTABLISHED with the fault disarmed, arms kTcpSynthRst, then causes the
  DUT to send data so the tester kernel auto-ACKs (a pure ACK); the lwIP netif input hook
  synthesizes the prohibited RST on the connection's 4-tuple. Pass = that RST observed;
  fail_compliant = the DUT stayed silent despite the flavor (fault inert). lwIP-only
  (capability-gated on kCapIngressFault).

  Two-state chain mirrors the positive's prelude:
    * listening_handshake_ack — observe the DUT's active-OPEN third-leg pure ACK on the
      case 4-tuple (negative-flip handle: src_ip conjunct unreachable on a flipped
      dut_iface_ip → inconclusive_no_handshake_ack).
    * listening_rst_watch — 8 s window; is_dut_rst(...) on the case 4-tuple lands on pass;
      the synthesized RST appears right after the tester's auto-ACK, well inside it.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_acknowledgement_04_neg"
       datamodel="null"
       initial="listening_handshake_ack">
  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>
  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>
  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpAck04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpAck04LocalOffset)"
                target="listening_rst_watch"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>
  <state id="listening_rst_watch">
    <onentry>
      <send event="deadline_rst_watch" delay="8s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpAck04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpAck04LocalOffset)"
                target="pass"/>
    <transition event="deadline_rst_watch" target="fail_compliant"/>
  </state>
  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>
  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>
  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_silent_despite_synth_rst_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
