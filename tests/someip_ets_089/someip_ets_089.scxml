<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_089 (lite): SD_Calling_same_ports_before_and_after_suspendInterface.

  Lite verdict: spec procedure has 18 steps interleaving method calls
  before and after suspendInterface to verify the DUT keeps the same
  endpoint ports across the suspend window. The lite verdict reduces
  this to the wire-observable suspend cycle:
    1. DUT cyclic OfferService warm-up.
    2. DUT emits StopOfferService (Type 0x01 + ttl == 0) after the
       tester invokes suspendInterface (Method 0x02, fire&forget).
    3. DUT emits a fresh OfferService (Type 0x01 + ttl > 0) after the
       configured duration, on the same ports as before (verified
       implicitly because tc8-dut re-uses the vsomeip.json port config).

  Steps 1-8 (pre-suspend method calls) and 11-18 (post-suspend method
  calls) of the spec are not separately exercised — the
  unregister/re-register cycle implemented in `dut_main` calls
  CommonAPI's `unregisterService` + `registerService` against the same
  impl, which preserves the port binding. A future tightening could
  add a post-resume echo step to the verdict.

  Stimulus chain (see src/sce_integration/cases/someip_ets_089.h):
    1. emitFindServiceBoot — SERVICE-ID-1 cyclic OfferService warm-up.
    2. emitMethodRequestAfter(suspendInterface, start=0, duration=2000).

  Verdict (3-state):
    Phase 1 (listening_phase1, 6 s): observe OfferService for
            SERVICE-ID-1.
    Phase 2 (listening_phase2_stop_offer, 6 s): observe DUT-emitted
            StopOfferService (Type 0x01 + ttl == 0 on SERVICE-ID-1).
    Phase 3 (listening_phase3_resume, 8 s): observe DUT-emitted
            OfferService (Type 0x01 + ttl > 0) AFTER the suspend
            window — i.e. the resume re-offer. Cyclic OfferService
            from before suspend is intercepted by phase 1 already, so
            phase 3's first match is the re-offer.

  Reference: PRS_SOMEIPSD_00356 / 00357 / 00364, TC8 §5.1.4.3.2.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_089"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_stop_offer"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_stop_offer">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <!-- DUT-emitted StopOfferService — Type 0x01 entry with ttl == 0. -->
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl == 0"
                target="listening_phase3_resume"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_stop_offer"/>
  </state>

  <state id="listening_phase3_resume">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="8s"/>
    </onentry>
    <!-- Resumed OfferService after the suspend duration — Type 0x01,
         ttl > 0. -->
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl &gt; 0"
                target="pass"/>
    <transition event="phase3_deadline_exceeded" target="fail_phase3_no_resume_offer"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_stop_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_stop_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_no_resume_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_resume_offer_service_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
