<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.12 TCP_PROBING_WINDOWS_05: TCP SHOULD send the first zero
  window probe when the receiver window size remains zero for the
  retransmission timeout period (RFC 1122 §4.2.2.17 p92 — RFC 793 §3.7
  page 42 SHOULD).

  v3.0 Test Procedure (p377):
    1. TESTER: Cause the DUT to move on to ESTABLISHED state.
    2. TESTER: Cause the application on the DUT-side to issue a SEND
               request for data segments.
    3. DUT:    Send the data segment.
    4. TESTER: Send ACK declaring a zero window.
    5. TESTER: Cause the application on the DUT-side to issue another
               SEND request for data segment.
    6. DUT:    Send a zero window probe after some delay.
    7. TESTER: Verify that the probe has been sent by the DUT after
               waiting for at least the retransmission timeout.

  Mechanism (active OPEN to ESTABLISHED + small SEND + zero-window
  ACK + second SEND + probe observation):
    1. Active OPEN handshake on (kBasicsActiveLocalPort+150,
       kBasicsActiveRemotePort+150); the DUT enters ESTABLISHED.
    2. The tester accepts the completed connection.
    3. Snapshot tester snd_nxt / rcv_nxt. seg1_seq (= rcv_nxt) is
       the seq the DUT will assign to its first data segment.
    4. The tester withholds its kernel's auto-ACKs so the harness
       retains full control over ACK injection (otherwise a
       full-window kernel ACK to seg1 would race ahead of the
       harness's window=0 ACK and the DUT would never enter persist
       mode).
    5. A data SEND of N B — DUT emits seg1.
    6. Settle ~150 ms; the tester sends an ACK at seg1_seq+N with
       `window=0`. The DUT advances snd_una to seg1_seq+N, sets
       snd_wnd=0, and starts the persist timer.
    7. A second data SEND of M B — the DUT enqueues M bytes;
       snd_wnd=0 prevents transmission. Probe-fire await.
    8. After the first persist RTO the DUT emits a zero-window probe.
       The Linux persist path sends a 0-byte ACK at seq = snd_una - 1
       (~200 ms..1 s); lwIP's persist path sends a 1-byte new-data
       segment at seq = snd_una (~1.2 s measured). `is_zero_window_probe`
       accepts either RFC 1122 §4.2.2.17 shape.

    Captured.expected_ack_num is preloaded with snd_una_post_ack - 1.
    The probe matcher keys on that seq (Linux 0-byte form) or
    snd_una_post_ack (BSD/lwIP 1-byte form); the handshake third-leg
    ACK carries seq = seg1_seq, structurally distinct from both, so a
    stray handshake-ACK observation cannot satisfy the probe-pass
    guard.

  Two-state SCXML chain:
    * listening_seg1   — observe seg1 (DUT data segment with
      payload>0).
    * listening_probe  — observe the DUT zero-window probe via
      `is_zero_window_probe(...)`. 6 s deadline covers both Linux's
      first-probe RTO (~200 ms..1 s) and lwIP's slower persist timer
      (~1.2 s) with comfortable margin.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  is_dut_data_segment(...)'s src_ip conjunct unreachable; case lands
  on inconclusive_no_seg1 via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_probing_windows_05"
       datamodel="null"
       initial="listening_seg1">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_seg1">
    <onentry>
      <send event="deadline_seg1" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows05LocalOffset)"
                target="listening_probe"/>
    <transition event="deadline_seg1" target="inconclusive_no_seg1"/>
  </state>

  <state id="listening_probe">
    <onentry>
      <send event="deadline_probe" delay="6s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows05LocalOffset)"
                target="pass"/>
    <transition event="deadline_probe" target="inconclusive_no_zero_window_probe"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_seg1">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_first_data_segment","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_zero_window_probe">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_zero_window_probe_within_rto_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
