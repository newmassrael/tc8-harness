<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_03 negative — closes
  the self-reference trap on the positive _03 case. tc8-dut emits
  Probes via OpStartLLAutoconfBuggy(flavor=ProbeEthDstUnicast):
  the Ethernet destination is the DUT iface MAC (a unicast) instead
  of ff:ff:ff:ff:ff:ff, violating RFC 3927 §2.1.1 (a Probe whose
  sender_proto_ip is in 169.254/16 MUST be broadcast).

  Pass = SCXML lands on `pass` — the non-broadcast Eth dst is
  detected (!captured.is_eth_broadcast()). fail_compliant_emit =
  tc8-dut ignored the flavor byte and emitted a broadcast Probe, so
  the harness would have silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_03_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="!captured.is_eth_broadcast()"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_probe_despite_probe_eth_dst_unicast_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
