<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_103 negative — tc8-dut SOME/IP application-fault self-validation
  of the positive _103 last-value guard. The trait arms kEtsFaultFieldValueWrong (UT 0x1B
  OpSetEtsFlavor), so the EnhancedTestability service's GetLastValueOfEventTCP getter returns
  the cached event UInt8 with every bit flipped (0x08 ^ 0xFF = 0xF7 != 0x08). The trait drives
  the same activate / subscribe / get-last chain the positive uses; only the final readback
  flips. Pass = the corrupted readback observed (payload != 0x08); fail_compliant = the DUT
  returned the cached 0x08 despite the flavor (fault inert). tc8-dut-only (capability-gated on
  kCapEtsFault — the lwIP fixture carries no SOME/IP service). This is the only faithful SOME/IP
  fault site: the wire serialization is vendored-vsomeip-owned, but the cached value the getter
  returns is harness-owned EtsImpl.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_103_neg"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="8s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.src_port == expected.udp_port and captured.method_id == 0x003B and captured.message_type == 0x80 and captured.payload_snapshot[0] != 0x08"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.src_port == expected.udp_port and captured.method_id == 0x003B and captured.message_type == 0x80 and captured.payload_snapshot[0] == 0x08"
                target="fail_compliant"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_get_last_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_get_last_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_get_last_value_tcp_response","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_returned_cached_value_despite_ets_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
