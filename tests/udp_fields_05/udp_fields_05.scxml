<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_05: Same Port with Different IP Address
  (receive and send). DUT receives a UDP message at <unusedUDPDstPort1>
  from two distinct source IP addresses through the same interface
  (Topology 2 — Host-1-IP / Host-2-IP). Verifies RFC 768 'Fields'
  MUST: the DUT's user interface returns the source IP address along
  with the data octets so the listening application can distinguish
  the two senders.

  Spec mapping:
    Host-1-IP             → expected.tester_ip (172.16.0.1)
    Host-2-IP             → 172.16.0.3 (kUdpHost2IpBe)
    unusedUDPDstPort1     → kDataPort = 20000

  Two-phase observation:
    listening_phase1 — UT-Confirmation reports DUT received from
                       Host-1-IP → transition to listening_phase2.
    listening_phase2 — UT-Confirmation reports DUT received from
                       Host-2-IP → pass.

  tc8-dut's data listener is single-slot per (port, dst_ip), so the
  trait fires phase 2's probe + UT query on s2 entry — the second
  receipt overwrites the first, and the second query returns
  Host-2-IP. Phase 1 query already drained Host-1-IP's value before
  the overwrite.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_05"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::UdpCaptured"
               cpp:include="sce_integration/udp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline" delay="5s"/>
    </onentry>
    <transition event="udp_observed"
                cond="cpp:captured.has_ut_response and captured.ut_opcode == 0x81 and captured.ut_status == 0 and captured.ut_received == 1 and captured.ut_recv_src_ip == expected.tester_ip"
                target="listening_phase2"/>
    <transition event="phase1_deadline" target="fail_phase1_no_host1_receipt"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline" delay="5s"/>
    </onentry>
    <transition event="udp_observed"
                cond="cpp:captured.has_ut_response and captured.ut_opcode == 0x81 and captured.ut_status == 0 and captured.ut_received == 1 and captured.ut_recv_src_ip == 0x030010AC"
                target="pass"/>
    <transition event="phase2_deadline" target="fail_phase2_no_host2_receipt"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_host1_receipt">
    <donedata>
      <content>{"verdict":"fail","reason":"no_ut_confirmation_for_host1_receipt"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_host2_receipt">
    <donedata>
      <content>{"verdict":"fail","reason":"no_ut_confirmation_for_host2_receipt"}</content>
    </donedata>
  </final>
</scxml>
