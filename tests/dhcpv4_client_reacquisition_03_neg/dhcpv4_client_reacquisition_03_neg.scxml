<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_03 negative — the RENEWING
  DHCPREQUEST MUST be emitted within T1 ± ParamToleranceTime of the last
  DHCPACK (RFC 2131 §4.4.5). The positive's out-of-bounds branch is
  unreachable against a conformant tc8-dut, which arms T1 = lease/2.

  Fault injection is a real firmware mutant: the kDhcpFlavorRenewingEntryNoDelay
  flavor makes the harness-owned runBoundPhaseMachine collapse T1 onto BOUND,
  so the RENEWING REQUEST fires immediately and the last-ACK->RENEWING interval
  falls below the [2, 4] s window. A conformant client (flavor None) emits at
  T1 = 3 s, so this negative's fail_compliant branch is the live conformant-DUT
  outcome.

  Reuses the dhcpv4_renewing_request_field template with pass_expr inverted
  (pass = the interval is observed OUTSIDE the window). timing_serial.

  tc8-dut-only (the lwIP fixture carries no DHCP client).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_03_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="!captured.ack_to_request_within_us(2000000, 4000000)"
           fail_state="fail_compliant"
           fail_reason="dut_renewing_request_within_t1_window_despite_no_delay_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
