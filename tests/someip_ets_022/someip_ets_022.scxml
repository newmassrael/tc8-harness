<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_022: echoStaticUINT8Array.

  Tester sends echoStaticUINT8Array (METHOD-ID 0x0036) Method Request
  whose CommonAPI-serialised payload is exactly 5 raw UInt8 bytes —
  NO length prefix on the wire because ets.fdepl pins
  `SomeIpArrayLengthWidth = 0` (static-array semantics, see upstream
  all_features.fdepl block-comment). DUT echoes the 5 bytes back.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Method Response (msg_type 0x80,
            return_code 0x00) on method_id 0x0036 with payload_len == 5
            and bytes [0x10 0x11 0x12 0x13 0x14] -> pass.
            Any other Response shape on the same method_id -> fail.
            No Response within the deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_022"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0036 and captured.return_code == 0x00 and captured.payload_len == 5 and captured.payload_bytes[0] == 0x10 and captured.payload_bytes[1] == 0x11 and captured.payload_bytes[2] == 0x12 and captured.payload_bytes[3] == 0x13 and captured.payload_bytes[4] == 0x14"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0036 and captured.message_type == 0x80 and (captured.payload_len != 5 or captured.payload_bytes[0] != 0x10 or captured.payload_bytes[4] != 0x14)"
                target="fail_phase2_static_array_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_static_array_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_static_array_response_did_not_match_request"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_method_response_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
