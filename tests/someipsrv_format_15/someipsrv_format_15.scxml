<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.15 SOMEIPSRV_FORMAT_15: The Instance ID field of the Type 1
  Entry shall carry the configured SERVICE-ID-1-INSTANCE-ID. Injected at
  runtime via CLI option expect instance_id=<hex> into
  expected.instance_id; smoke-test.sh supplies the tc8-dut
  default (0x0001).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_15"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].instance_id == expected.instance_id"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].instance_id != expected.instance_id"
                target="fail_instance_id"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_instance_id">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_instance_id_mismatch"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_notification_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
