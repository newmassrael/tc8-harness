<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.5 UDP_USER_INTERFACE_06: DUT-emitted UDP datagram carries
  the caller-specified Destination Port (RFC 768 'User Interface'
  MUST). Mapping <testerUDPPort>=20026 — distinguish from FIELDS_02's
  20001 so the egress-port assertion is uniquely attributable.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_user_interface_06"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="captured.dst_port == 20026"
           fail_state="fail_wrong_dst_port"
           fail_reason="dut_emitted_udp_with_wrong_user_interface_dst_port"/>
</scxml>
