<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.8 TCP_CLOSING_09 negative (CLOSE-WAIT) — lwIP TCP behavioral-synthesis
  self-validation of the positive _09 no-FIN/RST-in-CW guard. The trait drives the DUT to
  CLOSE-WAIT via a tester FIN with kTcpSynthRstOnDisruptive armed; the lwIP netif input hook
  synthesizes the prohibited RST as that FIN arrives (which proves the
  dut_emitted_fin_or_rst_in_close_wait fail-final reachable). Pass = that RST observed;
  fail_compliant = DUT stayed silent despite the flavor (fault inert). lwIP-only
  (kCapIngressFault). Envelope: tcp_synth_rst_watch_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_closing_09_neg"
       datamodel="null"
       initial="listening_handshake_ack">
  <sce:use template="../_templates/tcp_synth_rst_watch_neg.sce-template.xml"
           port_offset="72U"/>
</scxml>
