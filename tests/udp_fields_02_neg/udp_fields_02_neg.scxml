<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_02 negative — lwIP egress-fault self-validation of the
  positive _02 Destination Port guard. The trait arms kUdpFaultDstPortWrong, so the
  lwIP netif link-output hook rewrites the Destination Port of the DUT's data
  egress. Pass = the corrupted dst port observed;
  fail_compliant = DUT emitted the correct ports despite the flavor (fault inert).
  lwIP-only (capability-gated on kCapEgressFault). Envelope: udp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_02_neg"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="!(captured.dst_port == 20001 and captured.src_port == 20002)"
           fail_state="fail_compliant"
           fail_reason="dut_emitted_correct_dst_port_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
