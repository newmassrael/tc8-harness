<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.2 SOMEIPSRV_OPTIONS_13: Layer-4 Protocol field [8 bits]
  of the IPv4 Multicast Option shall be 0x11 (UDP) (SWS_SD_00395).
  presence_gate filters to SubscribeAck frames carrying at least one
  IPv4 Multicast Option; pass_expr asserts that option's L4-Proto
  byte is UDP via sd_has_option_with_l4 (mirrors OPTIONS_06's UDP
  check on the Endpoint axis). Multicast events are always carried
  over UDP (the spec rule); a hypothetical TCP-multicast option would
  fail this gate.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_options_13"
       datamodel="null"
       initial="listening">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="captured.sd_ipv4_multicast_count &gt;= 1"
           entry_type="0x07"
           pass_expr="captured.sd_has_option_with_l4(::tc8::sd_option_type::kIpv4Multicast, ::tc8::sd_l4_proto::kUdp)"
           fail_state="fail_l4_udp"
           fail_reason="no_ipv4_multicast_option_with_udp_l4"/>
</scxml>
