<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_09:
    When the post-Probe ARP conflict reply asserts the offered address is in
    use, the DUT MUST send a DHCPDECLINE (RFC 2131 §4.4.1). The TC8 Pass
    Criteria check only DECLINE presence (step 10), but a conformant DECLINE
    MUST carry the declined address in Option 50 (RFC 2131 §4.4.4 / table 5);
    the harness asserts that RFC-well-formedness the same way it requires the
    chaddr to match, so a present-but-malformed Option 50 is a fail and only
    true absence falls through to inconclusive.

  Reuses dhcpv4_init_alloc_decline with the conformant Option-50 predicate;
  the _09_neg sibling binds its negation against the DeclineRequestedIpWrong
  firmware mutant. The trait injects OFFER + ACK + the ARP conflict reply
  (arp_probe_listen_ms=1500).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_09"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_init_alloc_decline.sce-template.xml"
           pass_expr="captured.dhcpv4.option_be32_equals(50, expected.dhcpv4.offered_ip_be)"
           fail_state="fail_decline_wrong_requested_ip"
           fail_reason="dut_dhcp_decline_option50_mismatch"
           fail_role="observed_violation"/>
</scxml>
