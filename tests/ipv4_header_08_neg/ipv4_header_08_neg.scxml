<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.1 IPv4_HEADER_08 negative — lwIP ingress-fault self-validation of the positive _08
  reply-absence guard. The positive injects an ICMP Echo Request whose IHL field is 13, so IHL*4 =
  52 exceeds the datagram's Total Length (28) — a malformed datagram the conformant DUT silently
  discards at its length-validation check, emitting no reply. This negative arms
  kIcmpFaultSynthEchoReply, so the lwIP netif INPUT hook synthesizes the prohibited Echo Reply
  (type 0) as that Echo Request arrives (the netif hook reads the protocol byte at its fixed
  offset before ip4_input's length check, so the bad IHL does not block the synthesis; the
  synthesized reply's source is the DUT's own netif address, so it is DUT-origin). Pass = that
  reply observed; fail_compliant = DUT stayed silent despite the flavor (fault inert). lwIP-only
  (capability-gated on kCapIngressFault). Envelope: icmpv4_synth_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_header_08_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_synth_neg.sce-template.xml"/>
</scxml>
