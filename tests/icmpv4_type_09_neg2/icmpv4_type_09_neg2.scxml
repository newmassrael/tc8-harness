<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.3.3.2 ICMPv4_TYPE_09 negative (sequence variant) — sibling of
  icmpv4_type_09_neg. The trait arms kIcmpFaultEchoSeqWrong, so the lwIP link-output
  hook XOR-flips the sequence number of the DUT's Echo Reply (gated on type=0). Proves
  the positive's `echo_seq_mismatch` fail-final reachable (fault_injection_coverage.json).
  Pass = the corrupted sequence observed (echo_seq != request seq); fail_compliant =
  the DUT echoed the sequence despite the flavor (fault inert). lwIP-only
  (capability-gated on kCapEgressFault). Envelope: icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="icmpv4_type_09_neg2"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 0 and captured.src_ip == expected.dut_iface_ip"
           pass_expr="captured.echo_seq != expected.echo_seq"
           fail_state="fail_compliant"
           fail_reason="dut_echoed_seq_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_echo_reply_within_listen_window"/>
</scxml>
