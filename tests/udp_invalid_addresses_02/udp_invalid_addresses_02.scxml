<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.7 UDP_INVALID_ADDRESSES_02: DUT discards a UDP datagram
  whose Source IP Address is a broadcast address (RFC 1122 §4.1.3.6 +
  RFC 1122 §3.2.1.3 MUST).

  Stimulus: tester injects UDP src_ip=<AIface-0-BcastIP> (directed
  broadcast, e.g. 172.16.0.255). Linux's IP receive path drops on
  martian source. UT GetReceivedUdp returns received=0.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_invalid_addresses_02"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_received_udp_with_broadcast_src_ip"
           fail_reason_timeout="no_ut_confirmation_for_broadcast_src_discard"/>
</scxml>
