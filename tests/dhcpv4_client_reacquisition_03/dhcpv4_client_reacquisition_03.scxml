<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_03: T1 = 0.5 × lease (RFC
  2131 §4.4.5). Verify the interval from "sending of last DHCPACK
  Message" to "reception of last DHCPREQUEST Message" lies within
  T1 ± ParamToleranceTime.

  Spec Test Procedure (tc8_p281-p300.txt: REACQUISITION_03):
    8. TESTER: Verify time interval(last ACK → DHCPREQUEST) ∈
       [T1 − ParamToleranceTime, T1 + ParamToleranceTime].

  Numeric bounds under fast envelope (kFastEnvelopeLeaseSeconds = 6 s):
    * T1 = lease / 2 = 3 s exact (DUT phase machine integer-div on a
      6 s lease yields 3 s).
    * ParamToleranceTime default = 1 s (spec §4.7.5).
    * Bounds = [2 s, 4 s] = [2 000 000 us, 4 000 000 us].

  Predicate: `captured.ack_to_request_within_us(2000000, 4000000)`.
  The dispatcher records the ACK ts when its frame lands on the wire
  (msg_type=5) regardless of state advancement, so the state-3 ACK
  injection in `dhcpv4_renewing_request_field` updates the landmark
  without disturbing the SCXML's `is_dhcp_request` lifecycle gating.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_03"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="captured.ack_to_request_within_us(2000000, 4000000)"
           fail_state="fail_renewing_request_t1_out_of_bounds"
           fail_reason="dut_renewing_request_t1_interval_out_of_bounds"
           fail_role="observed_violation"/>
</scxml>
