<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_164: SD_SuspendInterface.

  Per PRS_SOMEIPSD_00356 / 00363 / 00364 / SIP_SD_811 the DUT must emit
  StopOfferService when suspendInterface is invoked, stay silent during
  the suspend window, then emit OfferService on resume. The trait calls
  setFieldA before the suspend so the method-axis is exercised; post-
  resume getFieldA confirms field method service still works.

    Phase 1 (listening_phase1, 6 s): OfferService observation on
            SERVICE-ID-1.
    Phase 2 (listening_phase2, 11 s): setFieldA Response (Method 0x42,
            message_type 0x80, payload 0x77).
    Phase 3 (listening_phase3, 11 s): entering it sends suspendInterface
            (2000 ms); the StopOfferService entry (Type 0x01 ttl == 0 on
            SERVICE-ID-1) is awaited.
    Suspended (2 s), then awaiting_resume (11 s): the OfferService entry
            (ttl > 0) of the resume. An Offer during the suspension is
            taken as the resume too, so a DUT that resumes early is not
            failed for it.
    Phase 4 (listening_phase4, 11 s): entering it sends getFieldA; the
            Response (Method 0x40, message_type 0x80, any payload) is
            awaited. Spec verdict is internally inconsistent on the value
            match; lenient verdict treats any post-resume Response as
            conformance.

  Each step after the set is sent when the machine enters the state that
  awaits its answer (the trait's scheduleAfterStateEntry), so the tester
  suspends only after the set was answered and gets only after the DUT
  resumed: no step depends on a fixed sleep guessing how fast the DUT is.
  Every answer awaited is one the procedure requires, so a window that
  elapses without it is the DUT's silence where it must answer:
  observed_quiescence, judged against <ParamListenTime>
  (docs/verdict_policy.md Section 2.1, H3), over a window of
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the defaults).
  The resume window opens once the 2 s suspension the tester asked for has
  elapsed, so the DUT has the whole window after it was due to resume.
  Each window has its own event name, because SCXML does not cancel a
  delayed send when its state exits.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_164"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl &gt; 0"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0042 and captured.message_type == 0x80 and captured.payload_snapshot[0] == 0x77"
                target="listening_phase3"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_set_response"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl == 0"
                target="suspended"/>
    <transition event="phase3_deadline_exceeded" target="fail_phase3_no_stop_offer"/>
  </state>

  <state id="suspended">
    <onentry>
      <send event="suspension_elapsed" delay="2s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl &gt; 0"
                target="listening_phase4"/>
    <transition event="suspension_elapsed" target="awaiting_resume"/>
  </state>

  <state id="awaiting_resume">
    <onentry>
      <send event="resume_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl &gt; 0"
                target="listening_phase4"/>
    <transition event="resume_window_elapsed" target="fail_no_resume_offer"/>
  </state>

  <state id="listening_phase4">
    <onentry>
      <send event="phase4_deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0040 and captured.message_type == 0x80"
                target="pass"/>
    <transition event="phase4_deadline_exceeded" target="fail_phase4_no_post_resume_get"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_set_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_set_field_response","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_no_stop_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_stop_offer_service_within_listen_window","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_no_resume_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_after_suspension","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_phase4_no_post_resume_get">
    <donedata>
      <content>{"verdict":"fail","reason":"no_post_resume_get_field_response","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
