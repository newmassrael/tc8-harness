<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.12 SOMEIPSRV_FORMAT_12: After the TESTER emits a
  FindService (Service ID = SERVICE-ID-1), the DUT's solicited
  OfferService Type 1 entry shall carry IndexFirstOptionRun == 0 —
  the first options run begins at byte 0 of the options array.

  The FindService is emitted by the harness via the
  TestCaseTraits<Format12SM>::stimulus() hook; this SCXML only
  verifies the DUT's reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_12"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].index_first == 0"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].index_first != 0"
                target="fail_index_first"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_index_first">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_index_first_option_run_nonzero"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_notification_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
