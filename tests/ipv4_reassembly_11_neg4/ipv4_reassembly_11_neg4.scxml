<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.7 IPv4_REASSEMBLY_11 negative (data variant) — lwIP egress-fault
  self-validation of the positive's `reassembled_echo_data_mismatch_large_ttl`
  guard. The trait arms kIcmpFaultEchoPayloadByteWrong and sends the positive's
  two Large-TTL fragments back to back; lwIP reassembles them and the link-output
  hook flips the first Data octet of its Echo Reply, identifier and sequence
  intact — the positive reaches this final only with both matching, so the
  filter requires them too. Pass = data differing from reassembly11EchoData();
  fail_compliant = the DUT echoed the data despite the flavor (fault inert).

  Neither reference DUT reaches the positive's reply (docs/tech-debt.md TD-28);
  the guard reads only the reply frame. lwIP-only (kCapEgressFault). Envelope:
  icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_reassembly_11_neg4"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 0 and captured.echo_id == expected.echo_id and captured.echo_seq == expected.echo_seq"
           pass_expr="!captured.payload_equals(::tc8::sce::ipv4::reassembly::reassembly11EchoData())"
           fail_state="fail_compliant"
           fail_reason="dut_echoed_data_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_echo_reply_after_reassembly_within_listen_window"/>
</scxml>
