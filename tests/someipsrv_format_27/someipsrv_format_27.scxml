<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.27 SOMEIPSRV_FORMAT_27: The Reserved field immediately
  following the TTL field of the Type 2 entry (bytes 12..13, upper
  12 bits) shall be zero. The lower 4 bits of byte 13 carry the
  subscribe Counter; guard masks it out (0xFFF0) before comparing.

  Conformance-bridge note: TC8 v3.0 §5.1.5 references AUTOSAR R4.1
  Rev 3 SOMEIPSD §6.7.5.x, which defined byte 13 as a 1-byte Reserved
  field (no Counter sub-field). R4.2+ (specifically PRS_SOMEIPSD_00787
  / _00789) carved the lower 4 bits out for Subscribe Counter
  mirroring; vsomeip 3.7.1 obeys the newer layout. Masking the lower
  4 bits is therefore not a deviation from R4.2+ — it's a bridge that
  preserves the FORMAT_27 invariant ("upper 12 bits of byte 13 are
  zero") while accepting a non-zero Counter that the R4.1 spec didn't
  anticipate. A strict-R4.1 DUT under this same guard lands green
  (Counter would be 0).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_27"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and (captured.sd_entries[0].reserved_counter &amp; 0xFFF0) == 0"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and (captured.sd_entries[0].reserved_counter &amp; 0xFFF0) != 0"
                target="fail_reserved_bits"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_reserved_bits">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_reserved_bits_nonzero"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_ack_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
