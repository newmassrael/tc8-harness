<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_128:
  SD_Multicast_FindService_Major_Minor_Version_set_to_all.

  Tester sends two bursts of 10 multicast FindService at 100 ms cadence:
  burst A with Major Version = 0xFF (wildcard "any major"); burst B with
  Minor Version = 0xFFFFFFFF (wildcard "any minor"). DUT must reply with
  at least one OfferService per burst per PRS_SOMEIPSD_00422 / 00423; the
  ids in TC8's Reference row (00268 / 00305 / 00306 / 00307 / 00351) are
  entry- and option-format requirements — 00351 is the Find entry's own
  field encoding, including the wildcard values this case sets — not the
  duty to answer. Lenient verdict mirrors ETS_127 — accepts any
  OfferService observation (multicast or unicast) since vsomeip emits
  multicast Offer during the burst window.

    Phase 1 (listening_phase1): OfferService for SERVICE-ID-1 → phase 2.
    Phase 2 (listening_phase2): OfferService again → pass.

  Both phases trip on the cyclic 1 Hz Offer cadence; the per-burst
  invariant is exercised by the stimulus chain (DUT must not crash
  under the burst rate) rather than per-phase wire-shape distinction.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_128"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl &gt; 0"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl &gt; 0"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_offer"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_phase2_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
