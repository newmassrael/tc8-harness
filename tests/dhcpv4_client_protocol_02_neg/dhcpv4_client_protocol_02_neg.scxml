<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.2 DHCPv4_CLIENT_PROTOCOL_02 negative — closes the
  self-reference trap on the positive _02 case (Option 53 "DHCP message
  type" MUST be present in every DHCP message, RFC 2131 §3). The
  positive's fail_message_type_option_absent branch is unreachable
  against a conformant tc8-dut, which always emits Option 53.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorDiscoverOmitMessageType flavor, which makes
  tc8-dut's emitDhcpMessage replace the Option 53 TLV with three PAD
  bytes — the message keeps a valid magic cookie but carries no DHCP
  Message Type option. A conformant DUT (flavor None) emits Option 53, so
  this negative distinguishes a buggy client from a conformant one.

  Pass = the missing Option 53 IS observed (magic cookie valid but
  has_message_type_option false). fail_compliant = the client emitted
  Option 53 despite the flavor — the live conformant-DUT outcome and a
  flavor-wiring regression catch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_protocol_02_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.op == 1
                      and captured.magic_cookie_valid
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.has_message_type_option()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_carried_message_type_option_despite_omit_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
