<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_08 negative —
  closes the self-reference trap on positive _08 (the ARP Probe MUST carry
  sender_proto_ip = 0, RFC 2131 §4.4.1 / RFC 5227 §2.1.1).

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the ProbeSenderIpNonzero flavor (arp_probe_listen_ms=1500), so
  tc8-dut's emitArpProbe writes a non-zero sentinel sender IP. A conformant
  client (flavor None) probes with sender_ip = 0, so this negative's
  fail_compliant branch is the live conformant-DUT outcome.

  Reuses dhcpv4_init_alloc_arp_probe with the pass predicate inverted
  (pass = the malformed Probe is observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_08_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_init_alloc_arp_probe.sce-template.xml"
           pass_expr="!captured.arp.is_dhcp_arp_probe(expected.dhcpv4.offered_ip_be)"
           fail_state="fail_compliant"
           fail_reason="dut_arp_probe_carried_zero_sender_ip_despite_nonzero_flavor"/>
</scxml>
