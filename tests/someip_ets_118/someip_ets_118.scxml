<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_118: SD_Ignore_Options_in_FindService.

  Tester sends 10 multicast FindService messages each carrying one IPv4
  Endpoint option (entry's #Opt1=0 — option unreferenced). Per
  PRS_SOMEIPSD_00268 / SIP_SD_877 / SIP_SD_878 the DUT shall ignore the
  option; the case grades its answer to the Finds, an OfferService for
  SERVICE-ID-1 sent to the tester alone (unicast).

    Phase 1 (listening_phase1): a UNICAST Type 0x01 OfferService
            (captured.dst_is_unicast(): the DUT's cyclic multicast Offers
            do not count) -> pass.

  That Offer is the DUT's answer the procedure requires, so a window that
  elapses without it is the DUT's silence where it must answer:
  observed_quiescence, judged against <ParamListenTime>
  (docs/verdict_policy.md Section 2.1, H3), over a window of
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the defaults).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_118"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.dst_is_unicast()"
                target="pass"/>
    <transition event="phase1_deadline_exceeded" target="fail_no_unicast_offer"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_unicast_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_unicast_offer_service_within_listen_window","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
