<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.7.8 SOMEIPSRV_RPC_08: Implementations shall not answer
  with errors to SOME/IP messages that already carry an error
  (return_code 0x01..0x1F). Tester sends two Method Requests targeting
  METHOD-ID-1-SI-1: the first with return_code = 0x01 and the second
  with return_code = 0x1F (the two endpoints of the spec's
  E_NOT_OK..E_WRONG_INTERFACE_VERSION range). DUT must NOT reply to
  either with a SOMEIP_MSG_TYPE_ERROR (0x81).

    Phase 1: DUT emits OfferService for SERVICE-ID-1.
    Phase 2: 6 s window covering both Requests. Pass on deadline (no
             Error observed). Fail if any non-SD frame with msg_type
             0x81 arrives for the configured SERVICE-ID-1.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_rpc_08"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x81"
                target="fail_phase2_error_observed"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_error_observed">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_returned_error_for_request_already_carrying_error"}</content>
    </donedata>
  </final>
</scxml>
