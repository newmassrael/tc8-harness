<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_032: echoUINT8ArrayMinSize happy-path.

  Spec defines the array as constrained to 3..5 elements (ReqArg1 spec
  table p401-420). Tester sends 4 elements (within range) to METHOD-ID
  0x0037 with 32-bit BE length prefix. DUT echoes the array back
  unchanged. ETS_033 covers the too-short complement.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_032"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0037 and captured.return_code == 0x00 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x10 and captured.payload_snapshot[5] == 0x11 and captured.payload_snapshot[6] == 0x12 and captured.payload_snapshot[7] == 0x13"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0037 and captured.message_type == 0x80 and (captured.payload_len != 8 or captured.payload_snapshot[3] != 0x04 or captured.payload_snapshot[4] != 0x10 or captured.payload_snapshot[5] != 0x11 or captured.payload_snapshot[6] != 0x12 or captured.payload_snapshot[7] != 0x13)"
                target="fail_phase2_array_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_array_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_arraymin_response_did_not_match_request","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
