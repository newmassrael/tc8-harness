<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_04: T2 = 0.875 × lease (RFC
  2131 §4.4.5). Verify the interval from "sending of last DHCPACK
  Message" to the REBINDING REQUEST is within T2 ± ParamToleranceTime.

  Spec Test Procedure (tc8_p281-p300.txt: REACQUISITION_04):
    8. TESTER: Verify time interval(last ACK → DHCPREQUEST) ∈
       [T2 − ParamToleranceTime, T2 + ParamToleranceTime].

  Numeric bounds under fast envelope (kFastEnvelopeLeaseSeconds = 6 s):
    * T2 = lease × 7/8 = 5 s (DUT phase machine integer-floor on a 6 s
      lease yields 5; spec exact value is 5.25 s).
    * ParamToleranceTime default = 1 s (spec §4.7.5).
    * Bounds = [4.25 s, 6.25 s] = [4 250 000 us, 6 250 000 us]. The 4
      250 000 lower bound comes from the spec's exact T2 = 5.25 s; the
      DUT's integer-floor 5.0 s sits 1 s below the upper bound and
      0.75 s above the lower bound (well clear).

  REBINDING template (4-state) supplies the lifecycle: state 4
  observes the REBINDING REQUEST (broadcast) after T2 fires.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_04"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_request_field.sce-template.xml"
           pass_expr="captured.ack_to_request_within_us(4250000, 6250000)"
           fail_state="fail_rebinding_request_t2_out_of_bounds"
           fail_reason="dut_rebinding_request_t2_interval_out_of_bounds"
           fail_role="observed_violation"/>
</scxml>
