<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_05:
    "Any arriving DHCPACK messages must be silently discarded" (RFC 2131
    §4.4.1, MUST — applies to the INIT / SELECTING phase before any
    OFFER has been accepted; an early ACK has no DISCOVER it could be
    answering and is therefore an out-of-order message).

  Case shape:
    the DUT discovers, and the tester answers with an ACK that no OFFER
    preceded. Nothing in the exchange asked for it, so the DUT has to
    drop it without a word — no REQUEST may follow.

  Same lifecycle as INIT_ALLOC_04 (DISCOVER → absence window) — the
  divergence is purely in the stimulus message_type (5 = ACK instead
  of 2 = OFFER). The DUT's SELECTING-phase pollForReply filters by
  expected_msg_type = 2 (OFFER), so the ACK is dropped at the parser
  and the DUT never enters REQUESTING.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_05"
       datamodel="null"
       initial="listening_for_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_no_request"/>
    <transition event="s1_deadline" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_no_request">
    <onentry>
      <send event="s2_deadline" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="fail_unexpected_request"/>
    <transition event="s2_deadline" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_unexpected_request">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_request_after_lone_ack","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
