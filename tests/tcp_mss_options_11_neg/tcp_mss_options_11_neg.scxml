<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.9 TCP_MSS_OPTIONS_11 negative — lwIP egress-fault self-validation of the
  positive _11 "active-OPEN SYN advertises an MSS option" guard. The trait arms
  kTcpFaultSynMssZero, so the lwIP link-output hook walks the DUT SYN's TCP options to
  the kind=2 MSS option and zeroes its value (gated on the pure SYN; SYN stays set and
  ACK clear so the filter still selects it). The dissector parses the now-zero option as
  mss == 0 — indistinguishable from a SYN that omitted the option, the violation the
  positive forbids. Pass = the zeroed MSS observed (mss == 0); fail_compliant = the DUT
  advertised a receive MSS despite the flavor (fault inert). lwIP-only (capability-gated
  on kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_mss_options_11_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 40U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 40U)"
           pass_expr="captured.mss == 0"
           fail_state="fail_compliant"
           fail_reason="dut_syn_advertised_mss_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_syn_within_listen_window"/>
</scxml>
