<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_10, iteration 1 of 2: TCP in FIN-WAIT-2 state MUST return
  an empty acknowledgment with proper SEQ and ACK numbers after receiving a data segment
  with an out-of-window SEQ, and remain in FIN-WAIT-2. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  A case of its own beside tcp_unacceptable_10_it2, which carries the unacceptable-ACK
  question; the two share a preamble and differ only in the segment sent, and in their
  port quads.

  Observable protocol interaction: active-OPEN handshake → ESTABLISHED → the DUT issues a
  CLOSE, driving it into FIN-WAIT-1 → the tester kernel auto-ACKs the DUT FIN (NOT
  suppressed, the case deliberately allows the collapse) → DUT advances to FIN-WAIT-2 →
  snapshot tester SEQ/ACK → inject the out-of-window-SEQ data segment → DUT empty ACK.

  Three DUT-origin observations on tcp_observed:
    1. handshake third-leg ACK (pure ACK, ack = ISN_t + 1)
    2. close-elicited DUT FIN+ACK (DUT CLOSE → FIN-WAIT-1; tester ACK transitions DUT to
       FIN-WAIT-2)
    3. data-elicited empty ACK to the corrupt segment

  Negative smoke flips ipv4.dut_iface_ip → first state's src_ip-conjunct unreachable →
  inconclusive_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_10_it1"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10Phase1LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry>
      <send event="deadline_dut_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10Phase1LocalOffset)"
                target="listening_data_ack"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>

  <state id="listening_data_ack">
    <onentry>
      <send event="deadline_data_ack" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10Phase1LocalOffset)"
                target="pass"/>
    <transition event="deadline_data_ack" target="fail_no_data_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_fin_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_no_data_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_finwait2","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
