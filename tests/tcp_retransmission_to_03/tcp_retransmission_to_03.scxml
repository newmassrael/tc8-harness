<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.11 TCP_RETRANSMISSION_TO_03: Karn's algorithm — TCP MUST
  preserve RTO doubling across an ACK that acknowledges a previously
  retransmitted segment (RFC 1122 §4.2.3.1 p95 — RFC 6298 §3 / §5).

  Case shape:
    the tester parks the DUT in ESTABLISHED and takes one DUT-side send,
    then withholds the acknowledgement so the DUT's timer fires and the
    segment comes again. The tester acknowledges the retransmitted
    segment, takes a second DUT-side send, and withholds again. The
    specification checks that the second segment's retransmission timer
    is twice the RTO the first segment was sent under: the acknowledgement
    covered a retransmitted segment, so it yields no RTT sample (Karn),
    and the backed-off value survives it.

  What is graded (TcpKarnCaptured::backed_off_rto_kept):
    the DUT's RTO once the second segment is in flight, against twice the
    RTO the DUT held while the first segment was in flight, within TC8's
    Millisec Tolerance (100 ms). Both are the DUT's own values (TCP_INFO),
    so no capture or scheduling jitter applies to them. The earlier check,
    both values `>= 350 ms` (Linux's 200 ms floor doubled), neither stated
    the relation nor held for another stack's numbers.

  What the wire decides:
    that the first segment and its retransmission were sent. The
    retransmission is waited for as long as the DUT's RTO says it will take
    (tcp_retransmission_series.h), not for a fixed 3 s, which a sender with
    the RFC 1122 3 s initial RTO would miss.

  Verdict order (first matching transition wins, W3C SCXML §3.13):
    - handshake not completed                       -> inconclusive
    - the first data segment was not seen           -> inconclusive
    - the retransmission's window elapsed unseen while the DUT counts one
                                                    -> inconclusive (capture)
    - the window elapsed and the DUT's counter could not be read
                                                    -> error
    - no retransmission, by the DUT's own count     -> fail
    - an RTO could not be read                      -> error
    - second segment's RTO not twice the first      -> fail (Karn)
    - otherwise                                     -> pass

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes the active OPEN fail;
  the stimulus returns before setting `ut_handshake_completed`, and the
  first cond fires.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_03"
       sce:transition-table="emit"
       datamodel="null"
       initial="evaluate_karn">

  <sce:context id="captured"
               cpp:type="tc8::TcpKarnCaptured"
               cpp:include="sce_integration/tcp_case_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="evaluate_karn">
    <onentry>
      <send event="evaluate" delay="0ms"/>
    </onentry>
    <transition event="evaluate"
                cond="cpp:not captured.ut_handshake_completed"
                target="inconclusive_handshake_did_not_complete"/>
    <transition event="evaluate"
                cond="cpp:captured.segment_ts_us[0] == 0"
                target="inconclusive_data_segment_unobserved"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 1 and captured.retransmission_missed_by_capture()"
                target="inconclusive_retransmission_not_captured"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 1 and not captured.missed_query_valid"
                target="error_retransmission_count_query_failed"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 1"
                target="fail_no_phase1_retx"/>
    <transition event="evaluate"
                cond="cpp:not captured.initial_rto_valid"
                target="error_initial_rto_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p1_valid"
                target="error_phase1_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p2_valid"
                target="error_phase2_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.backed_off_rto_kept()"
                target="fail_phase2_rto_not_doubled"/>
    <transition event="evaluate" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_handshake_did_not_complete">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_handshake_did_not_complete","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_data_segment_unobserved">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_data_segment_unobserved","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_retransmission_not_captured">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_counted_a_retransmission_the_capture_did_not_show","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="error_retransmission_count_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"retransmission_count_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="error_initial_rto_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"initial_rto_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="error_phase1_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"phase1_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="error_phase2_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"phase2_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="fail_no_phase1_retx">
    <donedata>
      <content>{"verdict":"fail","reason":"no_phase1_retransmit_observed_in_kernel","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_rto_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase2_rto_not_doubled_karns_violation","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
