<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_06 negative — lwIP egress-fault self-validation of the
  positive _06 Length guard. The trait arms kUdpFaultLengthWrong, so the lwIP netif
  link-output hook rewrites the UDP Length field of the DUT's data egress to a value
  != 8 + payload. Pass = the wrong length observed; fail_compliant = DUT emitted the
  correct length (16) despite the flavor (fault inert). lwIP-only (capability-gated
  on kCapEgressFault). Envelope: udp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_06_neg"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="!(captured.dst_port == 20000 and captured.length == 16)"
           fail_state="fail_compliant"
           fail_reason="dut_emitted_correct_length_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
