<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_10, iteration 2 of 2: TCP in FIN-WAIT-2 state MUST return
  an empty acknowledgment with proper SEQ and ACK numbers after receiving an in-window data
  segment whose ACK is unacceptable, and remain in FIN-WAIT-2. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  A case of its own beside tcp_unacceptable_10_it1, which holds the shared preamble; the two
  differ only in the segment sent, and in their port quads.

  Linux DUT deviation, an RST instead of the ACK: Linux 6.5 emits an RST per its TIME-WAIT
  substate processing, a violation of RFC 793 §3.4 and not a silent drop. After the DUT
  closes a FIN-WAIT-1 socket whose application has closed (no reader), Linux substitutes the
  full socket with an orphaned TIME-WAIT mini-socket in the FW2 substate; a payload-bearing
  non-FIN segment with in-window SEQ trips the "new data after half-duplex close" branch,
  which returns an RST verdict, and Linux emits an RST on the segment's 4-tuple. This is a
  third dispatch behaviour distinct from EST (silent-drop, the ACK path short-circuits) and
  FW1 / CW / CLOSING / LA (challenge-ACK via the receive state machine). A Linux DUT
  therefore lands fail_dut_rst_to_unacc_ack and carries a platform_known_fail mark (see
  docs/tech-debt.md TD-31). A spec-compliant DUT emitting an empty ACK lands pass.

  Observable protocol interaction: active-OPEN handshake → ESTABLISHED → the DUT issues a
  CLOSE, driving it into FIN-WAIT-1 → the tester kernel auto-ACKs the DUT FIN (NOT
  suppressed, the case deliberately allows the collapse) → DUT advances to FIN-WAIT-2 →
  snapshot tester SEQ/ACK → inject an in-window SEQ with an unacceptable ACK → DUT empty ACK
  or RST.

  Three DUT-origin observations on tcp_observed:
    1. handshake third-leg ACK (pure ACK, ack = ISN_t + 1)
    2. close-elicited DUT FIN+ACK (DUT CLOSE → FIN-WAIT-1; tester ACK transitions DUT to
       FIN-WAIT-2)
    3. unacceptable-ACK-elicited empty ACK (spec) or RST (Linux deviation)

  Negative smoke flips ipv4.dut_iface_ip → first state's src_ip-conjunct unreachable →
  inconclusive_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_10_it2"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry>
      <send event="deadline_dut_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset)"
                target="listening_unacc_ack"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>

  <state id="listening_unacc_ack">
    <onentry>
      <send event="deadline_unacc_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset)"
                target="fail_dut_rst_to_unacc_ack"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10Phase2LocalOffset)"
                target="pass"/>
    <transition event="deadline_unacc_ack" target="inconclusive_no_dut_ack_to_unacc_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_fin_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_dut_rst_to_unacc_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_rst_to_unacc_ack_finwait2","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_ack_to_unacc_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_unacc_ack_finwait2","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
