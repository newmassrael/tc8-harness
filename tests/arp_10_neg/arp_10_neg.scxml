<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_10 negative — lwIP egress-fault self-validation of the
  positive _10 Hardware Address Length guard. emitArpFlavorArm(kArpFaultHwLenWrong)
  rewrites the hlen of the DUT's Request (opcode left at 1; the 6-byte
  address fields keep their layout). Pass = corrupted hw_addr_len observed;
  fail_compliant = DUT emitted 6 despite the flavor (fault inert).
  lwIP-only. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_10_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.hw_addr_len != 6"
           fail_state="fail_compliant"
           fail_reason="dut_arp_request_hw_addr_len_six_despite_hw_len_wrong_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
