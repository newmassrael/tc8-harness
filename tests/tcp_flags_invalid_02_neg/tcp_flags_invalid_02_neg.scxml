<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_02 negative — lwIP egress self-validation of the
  positive _02 "TCP in LISTEN RSTs an ACK-bearing segment with SEQ = SEG.ACK" guard. The
  trait arms kTcpFaultRstSeqWrong before driving the LISTEN probe, so the DUT's RST (gated
  on the RST flag) carries a flipped sequence number off the incoming SEG.ACK. Pass = the
  RST's seq does NOT equal the probe's ACK (the injected violation); fail_compliant = the
  DUT set seq = SEG.ACK despite the flavor (fault inert). The positive's phase-2
  LISTEN-survival check is unnecessary — the _neg only proves the RST-seq guard reachable.
  lwIP-only (kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_02_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsListenPort, ::tc8::sce::tcp::kBasicsTesterPort)"
           pass_expr="captured.seq_num != ::tc8::sce::tcp::kFlagsInvalid02ProbeAck"
           fail_state="fail_compliant"
           fail_reason="dut_rst_seq_correct_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_rst_to_syn_ack_in_listen"/>
</scxml>
