<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.5 DHCPv4_CLIENT_USAGE_01 negative — a client with multiple
  interfaces MUST use DHCP independently per interface, so DISCOVER#2 (DIface-1)
  MUST carry a chaddr distinct from DISCOVER#1 (DIface-0) (RFC 2131 §3.6). The
  positive's chaddr-collision branch is unreachable against a conformant tc8-dut
  (each iface uses its own MAC).

  Fault injection is a real firmware mutant: kDhcpFlavorShareChaddrAcrossIface
  armed on the secondary-iface (iface_index=1) client makes the UT server copy
  iface-0's bound MAC into that client's chaddr_override, so its DISCOVER#2
  carries iface-0's chaddr (collision). iface-0's client stays conformant (no
  flavor) so DISCOVER#1 + s1's chaddr_matches_dut_mac gate hold. A conformant
  secondary client uses iface-1's own MAC, so this negative's fail_compliant
  branch is the live conformant-DUT outcome.

  Mirrors the positive's two-state lifecycle; only the s2 outcomes are swapped
  (collision = the injected violation = pass). Topology 2 (dual-iface).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_usage_01_neg"
       datamodel="null"
       initial="listening_for_d0_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_d0_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_d1_discover"/>
    <transition event="s1_deadline" target="inconclusive_no_d0_discover"/>
  </state>

  <state id="listening_for_d1_discover">
    <onentry>
      <send event="s2_deadline" delay="6s"/>
    </onentry>
    <!-- Inverted vs the positive: a same-chaddr DISCOVER#2 is the injected
         RFC 2131 §3.6 collision (the mutant manifested) -> pass; a
         distinct-chaddr DISCOVER#2 is the conformant DUT -> fail_compliant. -->
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and not captured.chaddr_differs_from_snapshot()
                      and captured.discover_chaddr_snapshot_taken"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_differs_from_snapshot()"
                target="fail_compliant"/>
    <transition event="s2_deadline" target="inconclusive_no_d1_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"diface_1_chaddr_distinct_despite_share_chaddr_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_d0_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_on_diface_0","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_d1_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_on_diface_1","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
