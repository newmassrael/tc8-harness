<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_04 negative — closes
  the self-reference trap on the positive _04 case (a DHCPOFFER whose 'xid'
  does not match the most recent DHCPDISCOVER MUST be silently discarded,
  RFC 2131 §4.4.1). The positive's fail_unexpected_request branch is
  unreachable against a conformant tc8-dut, which drops the mismatched OFFER
  in pollForReply and never emits a DHCPREQUEST.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorAcceptMismatchedXidOffer flavor, which relaxes
  pollForReply's xid acceptance gate. The tester injects a single OFFER with
  xid = DISCOVER.xid + 1 (the positive's xid_offset stimulus); the buggy
  client accepts it and emits a DHCPREQUEST. A conformant client (flavor
  None) stays silent, so this negative's fail_compliant_silence branch is the
  live conformant-DUT outcome.

  Inverts the positive's absence window: pass = the prohibited DHCPREQUEST IS
  observed; fail_compliant_silence = the DUT stayed silent despite the flavor
  (a flavor-wiring regression catch).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_04_neg"
       datamodel="null"
       initial="listening_for_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_request"/>
    <transition event="s1_deadline" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_request">
    <onentry>
      <send event="s2_deadline" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="pass"/>
    <transition event="s2_deadline" target="fail_compliant_silence"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_silence">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_silently_discarded_mismatched_xid_offer_despite_accept_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
