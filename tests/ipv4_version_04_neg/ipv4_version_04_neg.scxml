<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.4 IPv4_VERSION_04 negative — lwIP ingress-fault self-validation of the positive _04
  reply-absence guard. The positive injects an ICMP Echo Request whose IPv4 Version field is 6
  (not 4) — a datagram the conformant DUT silently discards at its version check, emitting no
  reply. This negative arms kIcmpFaultSynthEchoReply, so the lwIP netif INPUT hook synthesizes the
  prohibited Echo Reply (type 0) as that Echo Request arrives (the hook gates on the L2 ethertype
  and the protocol byte at a fixed offset, not the Version field, and runs before ip4_input's
  version drop; the synthesized reply's source is the DUT's own netif address and carries Version
  4, so it is a well-formed DUT-origin reply). Pass = that reply observed; fail_compliant = DUT
  stayed silent despite the flavor (fault inert). lwIP-only (capability-gated on kCapIngressFault).
  Envelope: icmpv4_synth_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_version_04_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_synth_neg.sce-template.xml"/>
</scxml>
