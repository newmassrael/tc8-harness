<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.6 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_04: Source IP
  address field of DHCPREQUEST Message is 0 (RFC 2131 §4.1).

  Spec Test Procedure (tc8_p241-p260.txt: CONSTRUCTING_MESSAGES_04):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER causes DUT to transit to DHCPCLIENT_STATE_REQUESTING
         (= reply OFFER on observed DISCOVER so the DUT issues REQUEST).
    4.   DUT: Transit finite state to DHCPCLIENT_STATE_REQUESTING
         (= emit DHCPREQUEST).
    5.   TESTER: Verify received DHCPREQUEST contains source IP = 0.
  Pass: 4 + 5.

  Sibling of CONSTRUCTING_MESSAGES_03 (DISCOVER source IP = 0). Both
  are RFC 2131 §4.1 invariants for messages broadcast prior to the
  client obtaining its IP — which by RFC 2131 §3.1 includes the
  REQUESTING-state DHCPREQUEST.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_04"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.source_ip_is_zero()"
           fail_state="fail_request_src_ip_not_zero"
           fail_reason="dut_dhcp_request_src_ip_not_zero"
           fail_role="observed_violation"/>
</scxml>
