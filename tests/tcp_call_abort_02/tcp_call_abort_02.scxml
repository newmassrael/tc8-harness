<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.5 TCP_CALL_ABORT_02: For ABORT call in ESTABLISHED state
  TCP MUST enter CLOSED state. Derived from RFC 793 §3.9 p62 Event
  Processing (MUST).

  v3.0 Test Procedure (p324):
    1. TESTER: Cause the DUT to move on to ESTABLISHED state
    2. TESTER: Cause the application to issue an ABORT call
    3. DUT:    Send a RST control message
    4. TESTER: Verify that the DUT moves on to CLOSED state

  Mechanism (active-OPEN handshake → UT abort → DUT RST → verify-probe
  ACK on killed 4-tuple → DUT closed-port RST as wire-observable proof
  of CLOSED):
    * Prelude: driveActiveOpenEstablished on (kBasicsActiveLocalPort
      + 90, kBasicsActiveRemotePort + 90); accept tester fd.
    * UT abort: sendAbortTcpSocketRequest invokes tc8-dut's
      abortTcpSocket → SO_LINGER {1,0} + ::close → kernel emits RST
      and disposes the socket synchronously per socket(7) LINGER
      semantics. Erases the socket_id from tcp_listeners_.
    * Tester fd disposed via silentlyCloseTesterFd (TCP_REPAIR +
      close, no FIN egress) so the post-prelude verify-probe is the
      only stimulus on the 4-tuple.
    * Verify probe: raw-inject ACK on the killed 4-tuple after the
      DUT RST observation; DUT-side socket is gone, Linux's
      tcp_v4_send_reset emits a closed-port RST. Same pattern as
      §4.8.6.7 FLAGS_PROCESSING_02 phase 2 + §4.8.6.8 TCP_CLOSING_03.

  SCXML chain (3 listening states + 3 fail terminals + pass):
    handshake_ack → dut_rst (DUT ABORT-RST observation) →
    verify_rst (verify-probe ACK draws DUT closed-port RST) → pass

  Pass criteria mapping:
    * #3 (DUT RST)            = listening_dut_rst observation.
    * #4 (DUT in CLOSED)      = listening_verify_rst observation of
                                DUT closed-port RST after probe.

  Negative IP-flip path: src_ip-conjunct on listening_handshake_ack
  unreachable, lands on fail_no_handshake_ack at the 5 s deadline +
  ~2 s prelude wall-time ≈ 8 s.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_call_abort_02"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 90U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 90U)"
                target="listening_dut_rst"/>
    <transition event="deadline_handshake_ack" target="fail_no_handshake_ack"/>
  </state>

  <state id="listening_dut_rst">
    <onentry><send event="deadline_dut_rst" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 90U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 90U)"
                target="listening_verify_rst"/>
    <transition event="deadline_dut_rst" target="fail_no_dut_rst"/>
  </state>

  <state id="listening_verify_rst">
    <onentry><send event="deadline_verify_rst" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 90U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 90U)"
                target="pass"/>
    <transition event="deadline_verify_rst" target="fail_no_verify_rst"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="fail_no_handshake_ack">
    <donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack"}</content></donedata>
  </final>

  <final id="fail_no_dut_rst">
    <donedata><content>{"verdict":"fail","reason":"dut_did_not_emit_rst_after_abort_in_est"}</content></donedata>
  </final>

  <final id="fail_no_verify_rst">
    <donedata><content>{"verdict":"fail","reason":"dut_did_not_close_after_abort_in_est"}</content></donedata>
  </final>
</scxml>
