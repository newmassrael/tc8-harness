<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_07 negative (phase 1 / CLOSE-WAIT) — lwIP TCP
  behavioral-synthesis self-validation of the positive _07 no-response-to-URG guard in
  CLOSE-WAIT. The trait drives the DUT to CLOSE-WAIT, arms kTcpSynthRstOnDisruptive, then
  injects a URG-only segment the DUT MUST silently ignore; the lwIP netif input hook
  synthesizes the prohibited RST. Pass = that RST observed; fail_compliant = DUT stayed silent
  despite the flavor (fault inert). lwIP-only (kCapIngressFault). Envelope: tcp_synth_rst_watch_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_07_neg"
       datamodel="null"
       initial="listening_handshake_ack">
  <sce:use template="../_templates/tcp_synth_rst_watch_neg.sce-template.xml"
           port_offset="::tc8::sce::tcp::kTcpFlagsProcessing07Phase1LocalOffset"/>
</scxml>
