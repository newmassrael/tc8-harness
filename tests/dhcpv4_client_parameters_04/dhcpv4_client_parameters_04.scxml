<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.4 DHCPv4_CLIENT_PARAMETERS_04: if the client includes a
  Parameter Request List (Option 55) in DISCOVER, the same byte sequence
  MUST appear in any subsequent DHCPREQUEST (RFC 2131 §4.3.6, MUST).

  Spec Test Procedure (tc8_p241-p260.txt: PARAMETERS_04):
    1-4. DUT bring-up + DHCP client + DISCOVER.
    5.   TESTER: Extracts Option 55 from DISCOVER → <extractedParamReq>.
    6-7. TESTER: Sends DHCPOFFER + listens for REQUEST.
    8.   DUT: Sends DHCPREQUEST.
    9.   TESTER: Verify REQUEST contains Option 55 == extractedParamReq.

  Cross-message snapshot is taken on the listening_for_discover →
  listening_for_request transition by `scheduleDiscoverSnapshotOnStateEntry`
  (registered alongside the OFFER stimulus in the trait). The snapshot
  copies the DISCOVER's Option 55 bytes into Captured slots that survive
  the next dispatcher iteration's `fillDhcpv4CapturedFromFrame()`. The
  pass-guard then compares the REQUEST's Option 55 against the snapshot.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_parameters_04"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.option_param_request_list_matches_discover()"
           fail_state="fail_request_param_request_mismatch"
           fail_reason="dut_dhcp_request_option55_mismatch_discover"
           fail_role="observed_violation"/>
</scxml>
