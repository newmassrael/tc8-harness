<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_044: echoUTF16DYNAMIC_with_odd_number_after_termination.

  Tester sends echoUTF16DYNAMIC (METHOD-ID 0x0016) Method Request whose
  string-length prefix declares 9 bytes follow, but those 9 bytes are
  [BOM 'h' 'i' UTF-16 null + 1 trailing odd byte] — the odd byte sits
  AFTER the UTF-16 null terminator. CommonAPI's InputStream walk-back
  loop (capicxx-someip-runtime InputStream.cpp:259-263) strips trailing
  non-zero bytes until it finds two consecutive zeros, so the 0xFF byte
  is stripped, the loop exits at itsSize=8, and `8 % 2 == 0` passes the
  oddness gate. The DUT then deserializes "hi" cleanly and echoes it
  back via the canonical 12-byte response shape (same as ETS_039) —
  because CommonAPI re-serialises from the C++ std::string, the trailing
  odd byte is dropped from the reply. Pass Criteria per spec p571-580:
  "DUT: returns method response message with odd number after the
  termination and corrected values" — the "corrected values" are the
  canonical 12-byte echo.

  Wire layout (request, 13 bytes payload):
    [00 00 00 09]       len_BE = 9 (BOM + 'h' + 'i' + null + odd byte)
    [FE FF]             BOM
    [00 68]             'h'
    [00 69]             'i'
    [00 00]             UTF-16 null terminator
    [FF]                odd trailing byte (stripped by walk-back)

  Phase 1: SD OfferService observation.
  Phase 2: Method Response (msg_type 0x80, return_code 0x00) on
           method_id 0x0016 whose payload equals the canonical 12-byte
           UTF-16 "hi" echo -> pass. Same cond as ETS_039.

  The expected 12-byte echo is the case-local default set by
  TestCaseTraits::applyExpectedDefaults (cases/someip_ets_044.h); the cond
  reads expected.payload_view() (a full-payload equality). The negative
  harness overrides it with a flipped-byte `payload=` expect token to drive
  fail_phase2_utf16_echo_mismatch as an observed_violation. The positive
  run needs no external value.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_044"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0016 and captured.return_code == 0x00 and captured.payload_equals(expected.payload_view())"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0016 and captured.message_type == 0x80 and !captured.payload_equals(expected.payload_view())"
                target="fail_phase2_utf16_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_utf16_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_utf16_response_did_not_match_request","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
