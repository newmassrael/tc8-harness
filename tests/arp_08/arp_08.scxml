<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_08: ARP request Hardware Type field shall carry
  ARP_HARDWARE_ETHERNET (0x0001) per RFC 826. UT 0x02 egress provocation
  forces the DUT Request — see arp_07.scxml. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_08"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.hw_type == 0x0001"
           fail_state="fail_hw_type"
           fail_reason="hw_type_not_ethernet"
           fail_role="observed_violation"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
