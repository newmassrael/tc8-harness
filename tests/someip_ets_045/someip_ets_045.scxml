<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_045: echoUTF16DYNAMIC_wrong_BOM.

  Tester sends echoUTF16DYNAMIC (METHOD-ID 0x0016) Method Request whose
  CommonAPI-serialised payload corrupts the UTF-16 BOM bytes (0xFEFF
  -> 0xDEAD); the SOME/IP Length stays self-consistent so the frame
  reaches the CommonAPI deserializer. The InputStream UTF-16 path
  (capicxx-someip-runtime InputStream.cpp:248-281) calls
  `checkBom(StringEncoding::UTF16BE)`, fails, and sets
  `errorOccurred_`, which the dispatcher translates into an Error
  Response (msg_type 0x81 / return_code 0x09 E_MALFORMED_MESSAGE).

  Spec wording (PRS_SOMEIP_00087) demands MALFORMED_MESSAGE; the
  lenient ETS_001/_002 verdict pattern accepts Error Response,
  non-zero return_code, or silent ignore.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Error Response, Method Response with
            non-zero return_code, or deadline -> pass. Method Response
            with return_code 0x00 -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_045"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0016 and captured.message_type == 0x81"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0016 and captured.message_type == 0x80 and captured.return_code != 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0016 and captured.message_type == 0x80 and captured.return_code == 0x00"
                target="fail_phase2_dut_accepted_wrong_bom"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_accepted_wrong_bom">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_returned_ok_response_for_wrong_utf16_bom","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
