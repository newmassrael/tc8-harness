<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_16: IPv4 Link-Local
  address claim condition - I.

  RFC 3927 §2.5 MUST: once the host has successfully claimed an IPv4
  Link-Local address, it must respond to ARP Requests targeting that
  address with an ARP Reply identifying its hardware address.

  Spec Test Procedure (tc8_p161-p180.txt:413..456):
    1-7.  DUT brings up iface, sends DHCPDISCOVER, then 3 ARP Probes
          for tentative LL_DUT.
    8.    Tester waits ANNOUNCE_WAIT for the DUT to assign LL_DUT to
          the iface (the claim condition).
    9.    Tester emits ARP Request:
          - sender_proto_ip = LL_TESTER (expected.tester_linklocal_ip)
          - target_proto_ip = LL_DUT (read from observed Probes)
          - sender_hw       = MAC-ADDR1 (kTesterInjectedMac)
    10-11. DUT MUST emit ARP Reply:
          - sender_proto_ip = LL_DUT
          - target_proto_ip = LL_TESTER

  Pass criterion: DUT-emitted ARP Reply (opcode 2) carrying
  - sender_proto_ip == DUT's claimed LL (spec step 10)
  - target_proto_ip == tester's LL          (spec step 10)
  - eth_src == sender_hw == DUT MAC          (RFC 826)
  - target_hw == tester MAC                  (RFC 826)
  - eth_dst == broadcast                     (RFC 3927 §2.5 last MUST)

  RFC 3927 §2.5 last MUST overrides RFC 826's permissive Reply
  framing: any ARP packet whose sender_proto_ip is in 169.254/16
  — including Replies — MUST be sent via link-layer broadcast, not
  unicast. Our sender_proto_ip is the DUT's committed LL by
  construction, so the L2 dst is broadcast unconditionally; the
  ARP-body target_hw still carries the asker's MAC (RFC 826).
  §4.5.6.4 CONFLICT_11 asserts the same broadcast invariant from
  the AIFACE-LL Request angle.

  Trait wiring: the 4-arg stimulus emits OpStartLLAutoconf (fast
  envelope) immediately, then registers a `scheduleAfterStateEntry`
  observer keyed on `Listening_post_claim`. SCXML transitions
  pre_claim → post_claim on observing the DUT's first ARP Announce
  (RFC 3927 §2.4: opcode=1, sender==target==committed_ll). On
  post_claim entry the observer (a) issues OpQueryLLAddress
  synchronously, (b) snapshots the DUT's committed LL into Captured,
  and (c) emits the claim-condition ARP Request. tc8-dut's post-claim
  responder thread emits the ARP Reply on receipt; SCXML observes the
  Reply via the standard 3-arg dispatchArpFrame helper.

  Splitting the deadline across the two phases — pre_claim has 6 s
  budget covering DHCP fail + PROBE/ANNOUNCE, post_claim has 3 s
  covering UT-query + Request + ~50 ms responder tick — eliminates
  the wall-time magic-number coupling that an entry-time delay would
  carry. SCXML deadline is the only timing promise to the spec; the
  trait stops measuring it.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_16"
       datamodel="null"
       initial="listening_pre_claim">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening_pre_claim">
    <onentry>
      <send event="claim_deadline" delay="6s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_announce()"
                target="listening_post_claim"/>
    <transition event="claim_deadline" target="inconclusive_no_claim_observed"/>
  </state>

  <state id="listening_post_claim">
    <onentry>
      <send event="reply_deadline" delay="3s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply() and captured.sender_proto_ip == captured.expected_responder_sender_ip_be and captured.target_proto_ip == expected.tester_linklocal_ip and captured.expected_responder_sender_ip_be != 0 and captured.eth_src == expected.dut_iface_mac and captured.sender_hw == expected.dut_iface_mac and captured.target_hw == expected.tester_mac and captured.is_eth_broadcast()"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply()"
                target="fail_reply_wrong_fields"/>
    <transition event="reply_deadline" target="inconclusive_no_responder_reply"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_claim_observed">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_announce_committed_link_local_address","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_responder_reply">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_emit_arp_reply_for_claim_address","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_reply_wrong_fields">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_arp_reply_carried_wrong_sender_or_target_ip","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
