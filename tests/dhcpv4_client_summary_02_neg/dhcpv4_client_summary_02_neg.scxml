<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.1 DHCPv4_CLIENT_SUMMARY_02 negative — the client MUST discard a
  DHCPOFFER whose xid does not match the most recent DHCPDISCOVER (RFC 2131
  §4.3.1) and select the matching server. The positive's wrong-server branch is
  unreachable against a conformant tc8-dut.

  Fault injection is a real firmware mutant: kDhcpFlavorAcceptMismatchedXidOffer
  relaxes pollForReply's xid gate (SELECTING OFFER wait only), so the buggy
  client accepts SERVER-1's mismatched-xid OFFER (sent first) and its REQUEST
  carries Option 54 = SERVER-1's identifier instead of SERVER-2's. A conformant
  client (flavor None) discards SERVER-1 and selects SERVER-2, so this negative's
  fail_compliant branch is the live conformant-DUT outcome.

  Reuses the dhcpv4_request_field template with pass_expr inverted (pass = the
  REQUEST did NOT select SERVER-2 = the mismatched OFFER was wrongly accepted).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_summary_02_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="!captured.option_be32_equals(54, expected.second_server_id_be)"
           fail_state="fail_compliant"
           fail_reason="dut_selected_second_server_despite_accept_mismatched_xid_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
