<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_03: DUT emits the ARP
  Probe (RFC 3927 §2.2.1) as a broadcast frame.

  Spec Test Procedure (tc8_p141-p160.txt:294..330):
    1-4. DUT brings up iface and sends DHCPDISCOVER (tc8-dut emits one
         observable Discover then falls back to LL after dhcp_timeout_ms).
    5-7. TESTER listens for DUT-emitted ARP Probe with target IP in
         169.254/16 and verifies Ethernet destination = broadcast.

  Pass criterion (tc8_p141-p160.txt:328..330):
    DUT-emitted ARP Probe has Eth dst = ff:ff:ff:ff:ff:ff.

  Probe shape per RFC 3927 §2.1.1: opcode=1, sender_proto_ip=0,
  target_proto_ip = tentative LL ∈ 169.254.0.0/16. Encapsulated in
  `ArpCaptured::is_arp_probe()` so the SCXML stays compact.

  Tester stimulus: OpStartLLAutoconf with the fast envelope (200 ms
  knobs); first Probe lands roughly 1.7 s after the RPC (1.5 s
  initial-wait + 200 ms dhcp_timeout + 200 ms PROBE_WAIT). 4 s SCXML
  deadline gives 2 s margin against worker scheduling jitter.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_03"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1
                      and captured.sender_proto_ip == 0
                      and (captured.target_proto_ip &amp; 0xFFFFU) == 0xFEA9U
                      and !captured.is_eth_broadcast()"
                target="fail_probe_not_broadcast"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_probe_not_broadcast">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_arp_probe_not_eth_broadcast","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_arp_probe_after_ll_start","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
