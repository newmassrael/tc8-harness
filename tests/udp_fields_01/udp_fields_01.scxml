<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_01: DUT-emitted UDP datagram carries the
  caller-specified Source Port (RFC 768 'Fields' SHOULD).

  Case shape:
    the tester has the DUT send a datagram sourced from
    <unusedUDPDstPort1>, and the source port on the wire has to be
    exactly that — the caller's choice reaches the header unaltered.

  Mapping: <unusedUDPDstPort1> = 20001 (kDataPeerPort) for harness.
  TriggerSendUdp(src_port=20001, dst=tester_ip:kDataPort, payload=8 B).
  SCXML asserts captured.src_port == 20001 on the DUT-origin frame.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_01"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="captured.src_port == 20001"
           fail_state="fail_wrong_src_port"
           fail_reason="dut_emitted_udp_with_wrong_src_port"
           fail_role="observed_violation"/>
</scxml>
