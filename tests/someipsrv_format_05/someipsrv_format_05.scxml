<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.5 SOMEIPSRV_FORMAT_05: Message Type shall be 0x02 (NOTIFICATION).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_05"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.message_type == 0x02"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.message_type != 0x02"
                target="fail_message_type"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_message_type">
    <donedata>
      <content>{"verdict":"fail","reason":"message_type_not_0x02"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_notification_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
