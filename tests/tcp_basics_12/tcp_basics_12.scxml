<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.1 TCP_BASICS_12: TCP MUST move on to CLOSED state from
  TIME-WAIT state after a timeout of 2*MSL, where TIME-WAIT is
  reached through CLOSING state. Derived from RFC 793 §3.2 p23
  Terminology (MUST).

  Case shape:
    the tester walks the DUT into CLOSING and acknowledges its FIN, so
    the DUT enters TIME-WAIT by the simultaneous-close route. Waiting
    past 2*MSL with 20% margin, a further FIN has to draw an RST —
    TIME-WAIT has expired and the connection is gone.

  Prelude mechanism — see tcp_basics_14 SCXML preamble for the
  full CLOSING-path walkthrough: with the tester withholding its
  kernel's auto-ACKs, an injected FIN+ACK pair drives the DUT
  FW1 → CLOSING → TIME-WAIT, and the tester silently closes its
  own side without emitting a FIN. After TIME-WAIT entry the tester
  waits kTimeWaitFullWait (72 s) before injecting the replay FIN —
  Linux's TIME-WAIT timer has fired by then, so the DUT emits the
  closed-port RST per RFC 793 §3.4.

  See tests/_templates/tcp_time_wait_4state.sce-template.xml for
  the shared 4-state observation chain (incl. the COUPLING NOTE
  pairing the 78s replay deadline below to kTimeWaitFullWait in
  src/sce_integration/tcp_pilot_common.h).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_basics_12"
       datamodel="null"
       initial="listening_handshake_ack">
  <sce:use template="../_templates/tcp_time_wait_4state.sce-template.xml"
           mid_label="closing_ack"
           mid_fail_reason="no_dut_ack_in_closing_transition"
           replay_label="replay_rst"
           replay_method="is_dut_rst"
           replay_deadline="78s"
           replay_fail_reason="no_dut_rst_after_2msl_post_time_wait_via_closing"
           local_offset="kTcpBasics12LocalOffset"/>
</scxml>
