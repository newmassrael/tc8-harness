<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.8 TCP_CLOSING_06: TCP, in ESTABLISHED state, MUST send a
  FIN segment when the local user issues a CLOSE call. Derived from
  RFC 793 §3.5 p38 Closing a Connection (MUST).

  Case shape:
    the tester parks the DUT in ESTABLISHED and has the DUT-side
    application close; the FIN the DUT puts on the wire is the
    observable.

  Observable interactions (active OPEN to ESTABLISHED → application
  CLOSE → observe DUT FIN):
    * Prelude: drive the DUT through an active OPEN to ESTABLISHED on
      (kBasicsActiveLocalPort + 70, kBasicsActiveRemotePort + 70).
      The DUT-emitted third-leg pure ACK lands on
      listening_handshake_ack, proving the DUT is in EST. Port quad
      +70 reserves the §4.8.6.8 active-OPEN block (clear of FP
      cluster's +50..+63).
    * The DUT application issues a CLOSE; the DUT enqueues a FIN+ACK
      on the connection. The tester kernel sees the DUT FIN and would
      normally auto-ACK it (entering FW2 → TW), but no further state
      observation is needed — the spec assertion is "DUT sent a FIN",
      which lands on listening_dut_fin → pass.

  SCXML chain (2 listening states + 2 fail terminals + pass):
    handshake_ack → dut_fin → pass

  Total positive envelope ≈ DUT boot wait + handshake (~50 ms) +
  CLOSE request + DUT FIN observation. Default-7 s case timeout fits
  comfortably.

  Negative IP-flip path: src_ip-conjunct on listening_handshake_ack
  becomes unreachable, lands on inconclusive_no_handshake_ack at the 5 s
  deadline + ~2 s prelude wall-time ≈ 8 s.

  The FIN is the emission the Pass Criteria names, and the TCP chapter
  states no time for it, so a listening_dut_fin window that elapses
  without it is the DUT's silence where it must emit —
  observed_quiescence, judged against <ParamListenTime>
  (docs/verdict_policy.md Section 2.1, H3). The window is
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults). The handshake ACK is the ESTABLISHED precondition, so its
  silence stays inconclusive.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_closing_06"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpClosing06LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpClosing06LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry><send event="deadline_dut_fin" delay="11s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpClosing06LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpClosing06LocalOffset)"
                target="pass"/>
    <transition event="deadline_dut_fin" target="fail_no_dut_fin"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content></donedata>
  </final>

  <final id="fail_no_dut_fin">
    <donedata><content>{"verdict":"fail","reason":"no_dut_close_fin","role":"observed_quiescence","bound":"ParamListenTime"}</content></donedata>
  </final>
</scxml>
