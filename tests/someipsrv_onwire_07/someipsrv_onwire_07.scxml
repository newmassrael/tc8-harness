<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.6.7 SOMEIPSRV_ONWIRE_07: Message Type field. The DUT
  shall reply to a Method Request (msg_type=0x00) with a Response
  (msg_type=0x80). Tester invokes echoUINT8 (METHOD-ID-1-SI-1 = 0x0008
  on tc8-dut); pass requires the matched Response carries
  message_type=0x80 AND return_code=E_OK (0x00).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_onwire_07"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/someipsrv_rpc_field_check.sce-template.xml"
           phase2_filter="captured.service_id == expected.service_id and captured.message_type == 0x80"
           pass_expr="captured.return_code == 0x00"
           fail_state="fail_phase2_response_not_eok"
           fail_reason="response_return_code_not_e_ok"/>
</scxml>
