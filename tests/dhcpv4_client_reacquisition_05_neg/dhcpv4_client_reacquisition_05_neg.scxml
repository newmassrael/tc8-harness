<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_05 negative — in RENEWING the
  client SHOULD wait one-half of the time remaining until T2 before
  retransmitting the DHCPREQUEST (RFC 2131 §4.4.5), so the inter-RENEWING
  interval lies within [(T2-T1)/2 ± ParamToleranceTime]. The positive's
  out-of-bounds branch is unreachable against a conformant tc8-dut.

  Fault injection is a real firmware mutant: the kDhcpFlavorRenewingRetxNoDelay
  flavor makes the harness-owned runBoundPhaseMachine collapse the
  half-remaining backoff to 0, so the second RENEWING REQUEST follows the first
  within one 50 ms tick and the interval falls below the [1, 3] s window. A
  conformant client (flavor None) retransmits at (T2-T1)/2 = 2 s, so this
  negative's fail_compliant branch is the live conformant-DUT outcome.

  Reuses the dhcpv4_renewing_retx_field template with pass_expr inverted
  (pass = the interval is observed OUTSIDE the window). timing_serial.

  tc8-dut-only (the lwIP fixture carries no DHCP client).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_05_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_retx_field.sce-template.xml"
           pass_expr="!captured.frame_delta_within_us(1000000, 3000000)"
           fail_state="fail_compliant"
           fail_reason="dut_renewing_retx_interval_within_window_despite_no_delay_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
