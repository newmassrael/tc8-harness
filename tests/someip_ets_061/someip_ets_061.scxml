<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_061: Sending_two_SOMEIP_Messages_in_a_row.

  Tester packs two Method Requests (echoUINT8 / Method 0x0008 +
  echoENUM / Method 0x0017) into a single UDP datagram. Per
  PRS_SOMEIP_00142 / PRS_SOMEIP_00569 the DUT must walk the bundle
  one message at a time using each message's Length header and
  emit a Method Response for each Request. Spec p589 Pass Criteria
  permits "one message or separate messages" — Linux DUT
  (CommonAPI-on-vsomeip) emits two distinct UDP datagrams, so each
  Response is pinned to its own session_id (0x0001 / 0x0002) in
  successive phases. A DUT that drops or coalesces responses trips
  the per-phase deadline.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2a (listening_phase2_a): Method Response with msg_type 0x80,
            method_id 0x0008, return_code 0x00, session_id 0x0001
            (echoUINT8 reply).
    Phase 2b (listening_phase2_b): Method Response with msg_type 0x80,
            method_id 0x0017, return_code 0x00, session_id 0x0002
            (echoENUM reply).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_061"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_a"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_a">
    <onentry>
      <send event="phase2a_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00 and captured.session_id == 0x0001 and captured.payload_len == 1 and captured.payload_byte0 == 0x42"
                target="listening_phase2_b"/>
    <transition event="phase2a_deadline_exceeded" target="fail_phase2_response_missing"/>
  </state>

  <state id="listening_phase2_b">
    <onentry>
      <send event="phase2b_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0017 and captured.return_code == 0x00 and captured.session_id == 0x0002 and captured.payload_len == 1 and captured.payload_byte0 == 0x01"
                target="pass"/>
    <transition event="phase2b_deadline_exceeded" target="fail_phase2_response_missing"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_response_missing">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_respond_to_every_message_in_bundle"}</content>
    </donedata>
  </final>
</scxml>
