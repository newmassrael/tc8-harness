<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_05: DUT-emitted ARP
  Probe carries `sender_hw` = the DUT iface MAC (RFC 3927 §2.2.1
  derived; RFC 826 ar$sha for any ARP frame, MUST).

  Spec Test Procedure (tc8_p141-p160.txt:358..373):
    1-4. DUT brings up iface and sends DHCPDISCOVER.
    5-7. TESTER listens; verify Source HW Address == DIface-0 MAC.

  Distinct from the Ethernet `eth_src` filter on the listening guard
  — the assertion is on the ARP payload field. A buggy DUT could
  emit a Probe with eth_src=DUT but a stale `sender_hw` from a prior
  iface state.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_05"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="captured.sender_hw == expected.dut_iface_mac"
           fail_state="fail_sender_hw_not_dut_iface_mac"
           fail_reason="arp_probe_sender_hw_mismatch_dut_iface_mac"/>
</scxml>
