<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_15: DUT silently discards a UDP datagram
  whose Checksum field is non-zero AND invalid (RFC 1122 §4.1.3.4
  MUST). Stimulus writes a deliberately-wrong checksum into the
  conformantly-sized datagram — Linux's UDP receive path drops with
  InCsumErrors before any per-port dispatch. UT GetReceivedUdp
  returns received=0.

  Reuses ipv4_udp_ut_presence with expected_received=0.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_15"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_received_udp_with_invalid_checksum"
           fail_reason_timeout="no_ut_confirmation_for_invalid_checksum_discard"/>
</scxml>
