<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.7.2 SOMEIPSRV_RPC_02: The single-transport requirement
  also applies to Notifications — Subscribe and Notification flow for
  SERVICE-ID-2 reuse the same transport endpoint
  (TR_SOMEIP_00150 — TCP Binding).

    Phase 1: DUT's OfferService for SERVICE-ID-2 (0xF4E8).
    Phase 2: DUT acks the tester's SubscribeEventgroup with a Type 2
             entry (0x07, ttl &gt; 0) for EVENT-GROUP-ID-1-SI-2 (0x0003).
    Phase 3: DUT emits a Notification carrying service_id 0xF4E8 +
             event-MSB method_id (TestEventUINT8 SomeIpEventID = 0x8001
             in ets2.fdepl).

  Same multi-service vsomeip plumbing as RPC_01 (TC8_DUT_SERVICE_2=1,
  vsomeip-multi-service.json declares the events/eventgroups for
  SERVICE-ID-2). dut_main's event_thread fires TestEventUINT8 on impl_si2
  every 250 ms, so the post-Subscribe Notification arrives within phase 3.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_rpc_02"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == ::tc8::someipsrv_si2::kServiceId"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].service_id == ::tc8::someipsrv_si2::kServiceId"
                target="listening_phase3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0 and captured.sd_entries[0].service_id == ::tc8::someipsrv_si2::kServiceId"
                target="fail_phase2_subscribe_nacked"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_subscribe_ack"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == ::tc8::someipsrv_si2::kServiceId and captured.message_type == 0x02 and (captured.method_id &amp; 0x8000) == 0x8000"
                target="pass"/>
    <transition event="phase3_deadline_exceeded" target="inconclusive_phase3_no_notification"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_for_service_id_2_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"subscribe_eventgroup_nacked_ttl_zero","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_subscribe_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_subscribe_ack_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase3_no_notification">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_notification_for_service_id_2_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
