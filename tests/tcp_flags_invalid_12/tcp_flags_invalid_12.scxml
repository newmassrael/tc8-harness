<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_12: TCP, in CLOSING state, MUST send
  an ACK with next expected SEQ number after receiving any segment
  with OTW SEQ number and remain in the same state. Derived from
  RFC 793 §3.9 p69 Event Processing (MUST).

  v3.0 Test Procedure (p337) lists 5 iterations (RST=0 across all):
    * CASE 1: flag set = SYN
    * CASE 2: flag set = SYN, ACK
    * CASE 3: flag set = ACK
    * CASE 4: flag set = FIN
    * CASE 5: flag set = Data segment

  Per-phase prelude (the tester withholds its pure ACK across all
  five phases, keeping the DUT pinned in FIN-WAIT-1 long enough for
  the tester FIN+ACK injection to drive it into CLOSING):
    1. Active OPEN handshake → ESTABLISHED (DUT third-leg ACK).
    2. The tester accepts the connection.
    3. Close-to-CLOSING drive — DUT application CLOSE (DUT FIN+ACK
       observed; tester pure ACK withheld) → snapshot tester snd_nxt
       / rcv_nxt (includes the consumed DUT FIN) → tester injects
       FIN+ACK with seq = snd_nxt and ack = rcv_nxt - 1 (acceptable
       per RFC 793 §3.4 in [snd.una, snd.nxt] but does NOT
       acknowledge DUT FIN) → DUT FW1 → CLOSING with DUT pure ACK
       observation.
    4. tester injects a CASE-distinct OTW probe with seq =
       tester_seq_post_fin + kOutOfWindowSeqOffset and ack =
       tester_ack_post_fin - 1U (CASE 2..5; CASE 1 SYN-only carries
       ack=0). The DUT's OTW SEQ branch fires before its ACK
       processing — challenge ACK observed.
    5. The tester closes its endpoint silently (no tester FIN
       emitted), freeing the 4-tuple cleanly between phases.

  Per phase the SCXML walks four DUT-origin observations:
    1. handshake third-leg ACK (DUT pure ACK)
    2. close-elicited DUT FIN+ACK
    3. CLOSING-transition DUT pure ACK (response to non-acking
       tester FIN+ACK)
    4. probe-elicited DUT empty ACK (challenge ACK per RFC 793 §3.9)

  CASE 4 (FIN) carries an ACK flag with rcv_nxt - 1 — the DUT drops
  bare-FIN segments before reaching its OTW SEQ branch (verified
  empirically in 08), so carrying ACK keeps the segment past the
  early-drop. Same convention as FLAGS_INVALID_08 / _09 / _10 / _11
  / _13.

  Negative smoke (ipv4.dut_iface_ip flip): pass guard's src_ip-
  conjunct fails on phase 1's listening_p1_handshake_ack → first
  state's 5 s deadline → fail_p1_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_12"
       datamodel="null"
       initial="listening_p1_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake_ack">
    <onentry><send event="deadline_p1_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_close_fin"/>
    <transition event="deadline_p1_handshake_ack" target="fail_p1_no_handshake_ack"/>
  </state>
  <state id="listening_p1_close_fin">
    <onentry><send event="deadline_p1_close_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_closing_ack"/>
    <transition event="deadline_p1_close_fin" target="fail_p1_no_close_fin"/>
  </state>
  <state id="listening_p1_closing_ack">
    <onentry><send event="deadline_p1_closing_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_probe_ack"/>
    <transition event="deadline_p1_closing_ack" target="fail_p1_no_closing_ack"/>
  </state>
  <state id="listening_p1_probe_ack">
    <onentry><send event="deadline_p1_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort) and captured.ack_num == captured.expected_ack_num"
                target="listening_p2_handshake_ack"/>
    <transition event="deadline_p1_probe_ack" target="fail_p1_no_probe_ack"/>
  </state>

  <state id="listening_p2_handshake_ack">
    <onentry><send event="deadline_p2_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_close_fin"/>
    <transition event="deadline_p2_handshake_ack" target="fail_p2_no_handshake_ack"/>
  </state>
  <state id="listening_p2_close_fin">
    <onentry><send event="deadline_p2_close_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_closing_ack"/>
    <transition event="deadline_p2_close_fin" target="fail_p2_no_close_fin"/>
  </state>
  <state id="listening_p2_closing_ack">
    <onentry><send event="deadline_p2_closing_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_probe_ack"/>
    <transition event="deadline_p2_closing_ack" target="fail_p2_no_closing_ack"/>
  </state>
  <state id="listening_p2_probe_ack">
    <onentry><send event="deadline_p2_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U) and captured.ack_num == captured.expected_ack_num_phase2"
                target="listening_p3_handshake_ack"/>
    <transition event="deadline_p2_probe_ack" target="fail_p2_no_probe_ack"/>
  </state>

  <state id="listening_p3_handshake_ack">
    <onentry><send event="deadline_p3_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 2U)"
                target="listening_p3_close_fin"/>
    <transition event="deadline_p3_handshake_ack" target="fail_p3_no_handshake_ack"/>
  </state>
  <state id="listening_p3_close_fin">
    <onentry><send event="deadline_p3_close_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 2U)"
                target="listening_p3_closing_ack"/>
    <transition event="deadline_p3_close_fin" target="fail_p3_no_close_fin"/>
  </state>
  <state id="listening_p3_closing_ack">
    <onentry><send event="deadline_p3_closing_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 2U)"
                target="listening_p3_probe_ack"/>
    <transition event="deadline_p3_closing_ack" target="fail_p3_no_closing_ack"/>
  </state>
  <state id="listening_p3_probe_ack">
    <onentry><send event="deadline_p3_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 2U) and captured.ack_num == captured.expected_ack_num_phase3"
                target="listening_p4_handshake_ack"/>
    <transition event="deadline_p3_probe_ack" target="fail_p3_no_probe_ack"/>
  </state>

  <state id="listening_p4_handshake_ack">
    <onentry><send event="deadline_p4_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 3U)"
                target="listening_p4_close_fin"/>
    <transition event="deadline_p4_handshake_ack" target="fail_p4_no_handshake_ack"/>
  </state>
  <state id="listening_p4_close_fin">
    <onentry><send event="deadline_p4_close_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 3U)"
                target="listening_p4_closing_ack"/>
    <transition event="deadline_p4_close_fin" target="fail_p4_no_close_fin"/>
  </state>
  <state id="listening_p4_closing_ack">
    <onentry><send event="deadline_p4_closing_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 3U)"
                target="listening_p4_probe_ack"/>
    <transition event="deadline_p4_closing_ack" target="fail_p4_no_closing_ack"/>
  </state>
  <state id="listening_p4_probe_ack">
    <onentry><send event="deadline_p4_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 3U) and captured.ack_num == captured.expected_ack_num_phase4"
                target="listening_p5_handshake_ack"/>
    <transition event="deadline_p4_probe_ack" target="fail_p4_no_probe_ack"/>
  </state>

  <state id="listening_p5_handshake_ack">
    <onentry><send event="deadline_p5_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 4U)"
                target="listening_p5_close_fin"/>
    <transition event="deadline_p5_handshake_ack" target="fail_p5_no_handshake_ack"/>
  </state>
  <state id="listening_p5_close_fin">
    <onentry><send event="deadline_p5_close_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 4U)"
                target="listening_p5_closing_ack"/>
    <transition event="deadline_p5_close_fin" target="fail_p5_no_close_fin"/>
  </state>
  <state id="listening_p5_closing_ack">
    <onentry><send event="deadline_p5_closing_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 4U)"
                target="listening_p5_probe_ack"/>
    <transition event="deadline_p5_closing_ack" target="fail_p5_no_closing_ack"/>
  </state>
  <state id="listening_p5_probe_ack">
    <onentry><send event="deadline_p5_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 4U) and captured.ack_num == captured.expected_ack_num_phase5"
                target="pass"/>
    <transition event="deadline_p5_probe_ack" target="fail_p5_no_probe_ack"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="fail_p1_no_handshake_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack_phase1"}</content></donedata></final>
  <final id="fail_p1_no_close_fin"><donedata><content>{"verdict":"fail","reason":"no_dut_close_fin_phase1"}</content></donedata></final>
  <final id="fail_p1_no_closing_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_in_closing_transition_phase1"}</content></donedata></final>
  <final id="fail_p1_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_syn_in_closing"}</content></donedata></final>

  <final id="fail_p2_no_handshake_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack_phase2"}</content></donedata></final>
  <final id="fail_p2_no_close_fin"><donedata><content>{"verdict":"fail","reason":"no_dut_close_fin_phase2"}</content></donedata></final>
  <final id="fail_p2_no_closing_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_in_closing_transition_phase2"}</content></donedata></final>
  <final id="fail_p2_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_synack_in_closing"}</content></donedata></final>

  <final id="fail_p3_no_handshake_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack_phase3"}</content></donedata></final>
  <final id="fail_p3_no_close_fin"><donedata><content>{"verdict":"fail","reason":"no_dut_close_fin_phase3"}</content></donedata></final>
  <final id="fail_p3_no_closing_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_in_closing_transition_phase3"}</content></donedata></final>
  <final id="fail_p3_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_ack_in_closing"}</content></donedata></final>

  <final id="fail_p4_no_handshake_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack_phase4"}</content></donedata></final>
  <final id="fail_p4_no_close_fin"><donedata><content>{"verdict":"fail","reason":"no_dut_close_fin_phase4"}</content></donedata></final>
  <final id="fail_p4_no_closing_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_in_closing_transition_phase4"}</content></donedata></final>
  <final id="fail_p4_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_fin_in_closing"}</content></donedata></final>

  <final id="fail_p5_no_handshake_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack_phase5"}</content></donedata></final>
  <final id="fail_p5_no_close_fin"><donedata><content>{"verdict":"fail","reason":"no_dut_close_fin_phase5"}</content></donedata></final>
  <final id="fail_p5_no_closing_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_in_closing_transition_phase5"}</content></donedata></final>
  <final id="fail_p5_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_data_in_closing"}</content></donedata></final>
</scxml>
