<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.2 SOMEIPSRV_OPTIONS_14: Port Number field [16 bits] of
  the IPv4 Multicast Option shall carry the port number for transporting
  multicast events of the eventgroup (SWS_SD_00396). expected.mcast_
  port is supplied via the harness expect mcast_port=30495 CLI key,
  matching the multicast block in dut/dut_service/vsomeip.json's
  eventgroup 0x0008.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_options_14"
       datamodel="null"
       initial="listening">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="captured.sd_ipv4_multicast_count &gt;= 1"
           entry_type="0x07"
           pass_expr="captured.sd_first_option_with_l4(::tc8::sd_option_type::kIpv4Multicast, ::tc8::sd_l4_proto::kUdp).port == expected.mcast_port"
           fail_state="fail_port"
           fail_reason="ipv4_multicast_port_mismatch"/>
</scxml>
