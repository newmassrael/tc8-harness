<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_14 negative (guard 2 of
  2) — closes the self-reference trap on the positive case's
  fail_emitted_during_silence branch. tc8-dut runs the conflict sequence
  via OpStartLLAutoconfBuggy(flavor=SkipFirstRateLimitSilence): it picks
  a fresh address through all 10 conflicts (so the cycle stays
  conformant), reaches the rate-limit, then emits a Probe DURING the
  RATE_LIMIT_INTERVAL silence window by skipping the mandated sleep,
  violating RFC 3927 §2.2.1 (MUST limit probing to one new address per
  RATE_LIMIT_INTERVAL).

  Guard 1 (stale re-probe) is proven separately by the NEG (guard 1)
  variant. tools/fault_injection_coverage.json is the SSOT.

  Same conflict-injection dispatch wiring as the positive _14. Pass = a
  Probe is observed inside the silence window (the violation is
  detected). silence_complete -> fail_compliant_silence = tc8-dut stayed
  silent through the window (the live conformant-DUT outcome).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_14_neg2"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="12s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="cycle"/>
    <transition event="deadline_exceeded" target="inconclusive_no_initial_probe"/>
  </state>

  <state id="cycle">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe() and captured.target_proto_ip != captured.previous_observed_probe_target_ip"
                target="cycle"/>
    <transition event="conflicts_complete" target="silence_watch"/>
    <transition event="deadline_exceeded" target="inconclusive_conflicts_incomplete"/>
  </state>

  <state id="silence_watch">
    <onentry>
      <send event="silence_complete" delay="3000ms"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="pass"/>
    <transition event="silence_complete" target="fail_compliant_silence"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_initial_probe">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_arp_probe_after_ll_start","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_conflicts_incomplete">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_re_probe_through_max_conflicts","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_silence">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_silent_despite_skip_first_silence_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
