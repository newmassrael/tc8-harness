<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_12, iteration 2 of 2: a DUT in LAST-ACK receives an
  in-window data segment whose ACK number acknowledges bytes the DUT never sent, and MUST
  answer with an empty acknowledgement carrying the right SEQ and ACK numbers while staying
  in LAST-ACK (RFC 793 §3.4 p37).

  A case of its own beside tcp_unacceptable_12_it1, which holds the shared description, the
  prelude and the observation order; the two differ only in the segment sent, and in their
  port quads.

  This iteration's segment: SEQ = snd_nxt (in the window), ACK = rcv_nxt - 1 plus
  kUnacceptableAckOffset, beyond the DUT's snd_nxt. A Linux DUT in LAST-ACK does not drop
  such a segment silently: its receive state machine sends a challenge ACK, an empty ACK
  with ack_num == expected_ack_num. LAST-ACK thus joins FIN-WAIT-1, CLOSING and CLOSE-WAIT
  in answering an unacceptable ACK (TCP_UNACCEPTABLE_09, TCP_UNACCEPTABLE_11,
  TCP_UNACCEPTABLE_14); an earlier grouping of LAST-ACK with ESTABLISHED and FIN-WAIT-2 as
  silent-drop was refuted on the wire.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_12_it2"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset)"
                target="listening_close_wait_ack"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>
  <state id="listening_close_wait_ack">
    <onentry><send event="deadline_close_wait_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_close_wait_ack" target="inconclusive_no_close_wait_ack"/>
  </state>
  <state id="listening_dut_fin">
    <onentry><send event="deadline_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset)"
                target="listening_probe_ack"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>
  <state id="listening_probe_ack">
    <onentry><send event="deadline_probe_ack" delay="11s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase2LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="pass"/>
    <transition event="deadline_probe_ack" target="fail_no_probe_ack"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_no_close_wait_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_wait_ack","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin","role":"property_unobserved"}</content></donedata></final>
  <final id="fail_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_unacceptable_ack_in_last_ack","role":"observed_quiescence","bound":"ParamListenTime"}</content></donedata></final>
</scxml>
