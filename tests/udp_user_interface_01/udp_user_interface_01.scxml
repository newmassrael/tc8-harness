<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.5 UDP_USER_INTERFACE_01: A user interface should allow the
  creation of new receive ports (RFC 768 'User Interface' MUST). Tester
  asks the DUT, through the Tier-2 seam (IUdpReceiveControl::
  createReceivePorts), to open 10 receive ports. The DUT reports how many it
  opened (opcode UT, §4.8.5 OpCreateUdpReceivePorts: the reply's actual_count;
  testability: sockets bound at once) and the stimulus records it in
  ut_create_actual_count. Pass guard:
  ut_create_actual_count == 10.

  3-state inline (no template) — sole consumer of the port-count answer. The
  runner's stimulus-settled hook raises receive_answered once; the machine does
  not react to wire frames, so none can drive a transition.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_user_interface_01"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::UdpCaptured"
               cpp:include="sce_integration/udp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="receive_answered"
                cond="cpp:captured.receive_answered and captured.ut_create_actual_count == 10"
                target="pass"/>
    <transition event="receive_answered"
                cond="cpp:captured.receive_answered and captured.ut_create_actual_count != 10"
                target="fail_wrong_port_count"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_wrong_port_count">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_create_requested_receive_port_count","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_ut_confirmation_for_create_udp_receive_ports","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
