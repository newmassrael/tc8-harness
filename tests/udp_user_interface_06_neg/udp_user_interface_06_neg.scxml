<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.5 UDP_USER_INTERFACE_06 negative — lwIP egress self-validation of the positive _06
  "DUT-emitted UDP carries the caller-specified Destination Port (20026)" guard. The trait arms
  kUdpFaultDstPortWrong, so the netif link-output hook rewrites the DUT-emitted datagram's
  destination port off 20026.
  Pass = the captured egress UDP's destination port is NOT 20026 (dst_port != 20026, the injected
  violation observed); fail_compliant = the DUT emitted 20026 despite the flavor (fault inert —
  what a conformant DUT does). lwIP-only (kCapEgressFault). The egress sibling of
  UDP_USER_INTERFACE_05_NEG (source port). Envelope: udp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_user_interface_06_neg"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="!(captured.dst_port == 20026)"
           fail_state="fail_compliant"
           fail_reason="dut_emitted_correct_dst_port_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
