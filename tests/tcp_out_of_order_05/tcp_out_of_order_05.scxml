<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.10 TCP_OUT_OF_ORDER_05: in a stream of full-sized
  segments there SHOULD be an ACK for at least every second segment
  (RFC 1122 §4.2.3.2 p96 — When to Send an ACK Segment, SHOULD).

  Case shape:
    the tester drives the DUT to full-window operation in ESTABLISHED,
    then fills the DUT's receive buffer with full-sized segments. Every
    segment has to be acknowledged, and the count is what this case
    checks: across an even number of segments the DUT must return at
    least one acknowledgement per two — no thinner than that.

  Mechanism (active OPEN to ESTABLISHED + 10 MSS-sized PSH+ACKs +
  5-ACK consume chain):
    1. Active OPEN handshake on (kBasicsActiveLocalPort+147,
       kBasicsActiveRemotePort+147); the DUT enters ESTABLISHED.
    2. The tester accepts the completed connection.
    3. Snapshot the post-handshake tester snd_nxt / rcv_nxt.
    4. The tester sends 10 consecutive 1460 B PSH+ACKs at S,
       S+1460, S+2920, ... S+13140. 5 ms inter-segment pacing keeps
       each DUT ACK on the wire in arrival order without pcap
       dispatch coalescing them into a single snapshot.
    5. The DUT acknowledges either:
         * quickack mode (post-handshake `pingpong=0`): 1 ACK per
           segment = 10 ACKs;
         * non-quickack: cumulative ACK every other segment per
           RFC 1122 §4.2.3.2 stretchACK floor = 5 ACKs;
         * mixed transition during the burst: somewhere in between.
       All cases satisfy the spec's "at least half" floor (≥ 5
       ACKs for 10 segments).

  Six-state SCXML chain consumes the handshake third-leg ACK first,
  then 5 distinct DUT pure ACKs (each guard matches `is_pure_dut_ack
  (...)` on the active-OPEN quad — distinct ack_num values per ACK
  are not needed because each phase consumes ONE ACK and the
  underlying SCE event queue dispatches in arrival order). Falling
  short of 5 ACKs deadlines in the corresponding `listening_ack_N`
  phase and lands on `fail_insufficient_dut_acks`.

  The procedure states no listen time, so the general input parameter
  <ParamListenTime> bounds the wait for each of the five ACKs the
  pass criterion requires. An ACK window that elapses short of the
  count is the DUT's silence where it must still acknowledge:
  observed_quiescence, judged against that bound (H3), over
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults) per ACK. The handshake window (5 s) stays inconclusive: it
  sets up the connection the stream is sent on. Whether a silence
  stands as a fail is the CLI's call on the run's hypotheses. A
  conformant DUT's ACKs follow the burst (≈50 ms) within its
  delayed-ACK timer (≤ 500 ms), so the pass path is unchanged by the
  window length.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  is_pure_dut_ack(...)'s src_ip conjunct unreachable; case lands
  on inconclusive_no_handshake_ack via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_out_of_order_05"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset)"
                target="listening_ack_1"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_ack_1">
    <onentry>
      <send event="deadline_ack_1" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset)"
                target="listening_ack_2"/>
    <transition event="deadline_ack_1" target="fail_insufficient_dut_acks"/>
  </state>

  <state id="listening_ack_2">
    <onentry>
      <send event="deadline_ack_2" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset)"
                target="listening_ack_3"/>
    <transition event="deadline_ack_2" target="fail_insufficient_dut_acks"/>
  </state>

  <state id="listening_ack_3">
    <onentry>
      <send event="deadline_ack_3" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset)"
                target="listening_ack_4"/>
    <transition event="deadline_ack_3" target="fail_insufficient_dut_acks"/>
  </state>

  <state id="listening_ack_4">
    <onentry>
      <send event="deadline_ack_4" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset)"
                target="listening_ack_5"/>
    <transition event="deadline_ack_4" target="fail_insufficient_dut_acks"/>
  </state>

  <state id="listening_ack_5">
    <onentry>
      <send event="deadline_ack_5" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpOutOfOrder05LocalOffset)"
                target="pass"/>
    <transition event="deadline_ack_5" target="fail_insufficient_dut_acks"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_insufficient_dut_acks">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_fewer_than_5_acks_for_10_full_sized_segments","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
