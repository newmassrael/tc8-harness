<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_08 negative (phase 1 / CLOSED) — lwIP self-validation of
  the positive _08 RST-seq=0 guard in CLOSED. The positive sends a bare FIN to a closed port;
  the DUT MUST reply RST with seq=0 (RFC 793 §3.9). This negative arms the egress
  kTcpFaultRstSeqWrong flavor (NOT the ingress synthesis — the conformant DUT genuinely emits a
  RST here, so the fault corrupts its sequence) and raw-injects the FIN; the lwIP link-output
  hook flips the DUT RST's sequence off zero. Pass = the non-zero sequence observed;
  fail_compliant = the DUT sent SEQ=0 despite the flavor (fault inert). lwIP-only
  (kCapEgressFault). The wire shape matches BASICS_04_NEG2 (same closed-port RST-seq fault);
  this distinct sibling is required because the coverage SSOT binds each fail-final to a _neg of
  ITS base case. Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_08_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsClosedPort, ::tc8::sce::tcp::kBasicsTesterPort)"
           pass_expr="captured.seq_num != 0"
           fail_state="fail_compliant"
           fail_reason="dut_rst_seq_zero_despite_flavor_in_closed"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_rst_to_fin_in_closed"/>
</scxml>
