<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.3.14 SOMEIPSRV_SD_MESSAGE_14: After a SubscribeEventgroup
  carrying an UNKNOWN-SERVICE-ID, the DUT shall respond with a
  SubscribeEventgroupNack — entry type 0x07, TTL=0 (TR_SOMEIP §6.7.4.2.4).
  The harness emits the malformed Subscribe via stimulus(); the DUT's
  echoed Service ID is verified separately by SD_MESSAGE_16. Here we
  assert only the TTL=0 invariant that distinguishes Nack from Ack.

  The UNKNOWN-SERVICE-ID sentinel is 0xFFFE (just below 0xFFFF, which
  SD reserves for the FindService Any-Instance value). vsomeip has no
  service 0xFFFE configured, so the Nack carries ttl=0 regardless of
  whether it Nacks-by-service-unknown or Nacks-by-eventgroup-unknown.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_sd_message_14"
       datamodel="null"
       initial="listening_phase1">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="true"
           entry_type="0x07"
           pass_expr="captured.sd_entries[0].ttl == 0"
           fail_state="fail_ttl"
           fail_reason="nack_entry_ttl_not_zero"/>
</scxml>
