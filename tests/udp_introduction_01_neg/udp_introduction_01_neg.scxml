<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.6 UDP_INTRODUCTION_01 negative — lwIP app-layer self-validation of the
  positive _01 "DUT denies a directed-broadcast UDP datagram" guard. Identical wire
  shape and seam to ipv4_addressing_02_neg (directed broadcast → the data listener
  drops it on the recovered destination address, an RFC 1122 §3.2.1.3 application
  decision; lwIP delivers the directed broadcast to the INADDR_ANY socket). The trait
  arms kAppFaultAcceptDirectedBroadcast (UT 0x1A OpSetAppFlavor) so the listener skips
  that discard and counts the datagram a conformant DUT must drop.
  Pass = the DUT reported the directed broadcast received (ut_received == 1); fail_compliant
  = the DUT still denied it despite the flavor (fault inert). lwIP-only (kCapAppFault).
  Envelope: ipv4_udp_ut_presence.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_introduction_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="1"
           fail_reason_wrong_receipt="dut_denied_directed_broadcast_despite_flavor"
           fail_reason_timeout="no_ut_confirmation_for_directed_broadcast_accept"
           fail_role="fault_injection_inert"/>
</scxml>
