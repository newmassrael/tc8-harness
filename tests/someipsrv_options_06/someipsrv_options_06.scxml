<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.2 SOMEIPSRV_OPTIONS_06: Layer-4 Protocol field of the
  IPv4 Endpoint Option shall be 0x11 (UDP) per SWS_SD_00214 — the
  "Checking For UDP" variant of the spec rule. The companion TCP
  variant lives in OPTIONS_15. Pass criterion: at least one IPv4
  Endpoint Option carries L4-Proto=0x11 (UDP).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_options_06"
       datamodel="null"
       initial="listening_phase1">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="captured.sd_option_count &gt;= 1"
           entry_type="0x01"
           pass_expr="captured.sd_has_option_with_l4(::tc8::sd_option_type::kIpv4Endpoint, ::tc8::sd_l4_proto::kUdp)"
           fail_state="fail_l4_udp"
           fail_reason="no_ipv4_endpoint_option_with_udp_l4"/>
</scxml>
