<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.1 IPv4_HEADER_05 negative (truncation variant) — lwIP egress-fault self-validation
  of the positive's "the echoed payload carries the full 548 B" guard (RFC 791 §3.1 576-octet
  MUST). The trait arms kIcmpFaultEchoPayloadTruncate, so the lwIP link-output hook shrinks the
  Echo Reply's IP total_length to carry only 64 of the 548 Data bytes; libtins slices the inner
  PDU by total_length (ip.cpp), so the dissected payload_len becomes 64 (type 0 intact, so the
  filter still selects the reply). Pass = a truncated payload observed (payload_len != 548, the
  violation the positive forbids); fail_compliant = the DUT echoed the full 548 B despite the
  flavor (fault inert). The _NEG sibling covers the wrong-bytes half. lwIP-only (capability-
  gated on kCapEgressFault). Envelope: icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_header_05_neg2"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 0 and captured.src_ip == expected.dut_iface_ip"
           pass_expr="captured.payload_len != 548"
           fail_state="fail_compliant"
           fail_reason="dut_echoed_full_payload_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_echo_reply_for_576_byte_datagram"/>
</scxml>
