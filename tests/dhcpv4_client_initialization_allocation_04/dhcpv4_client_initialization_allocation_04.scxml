<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_04:
    "If the 'xid' of an arriving DHCPOFFER message does not match the
     'xid' of the most recent DHCPDISCOVER message, the DHCPOFFER
     message must be silently discarded" (RFC 2131 §4.4.1, MUST).

  Spec Test Procedure (tc8_p261-p280.txt: INIT_ALLOC_04):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER:DHCP Server Listens.
    4.   DUT: Sends DHCPDISCOVER.
    5.   TESTER: Extracts xid → <extractedXID>.
    6.   TESTER: Sends DHCPOFFER with xid = (extractedXID + 1) (mismatched).
    7.   TESTER: Listens.
    8.   DUT: Does NOT send DHCPREQUEST.
  Pass: 4 + 8 (DUT silently discards mismatched OFFER, no REQUEST).

  Reuses SUMMARY_02's `xid_offset` pattern — single mismatched-xid OFFER
  injected on listening_for_no_request entry; SCXML waits a 4 s absence
  window. Any DUT REQUEST observation drives the verdict to fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_04"
       datamodel="null"
       initial="listening_for_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_no_request"/>
    <transition event="s1_deadline" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_no_request">
    <onentry>
      <send event="s2_deadline" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="fail_unexpected_request"/>
    <transition event="s2_deadline" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_unexpected_request">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_request_after_mismatched_xid_offer","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
