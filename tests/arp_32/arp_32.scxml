<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_32: ARP cache merge on two Requests. Tester injects
  ARP Request with MAC1, then ARP Request with MAC2, same sender_proto_ip
  = <HOST-1-IP>. RFC 826 translation-table update requires the second
  frame to overwrite the first's entry. The follow-up UT 0x02 stimulus
  provokes DUT UDP egress back to tester; pass = eth_dst == MAC2.

  Pass/fail guards all predicate on udp_observed events destined for the
  tester_ip (filters out tester-originated UDP). The arp_observed branch
  catches the "neither injection succeeded" failure mode where the DUT's
  cache stays cold and it issues its own ARP Request.

  Body shared with ARP_33 / ARP_34 / ARP_35 via sce:template (single
  source of truth — see
  tests/_templates/arp_group_c_cache_merge_second_mac.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_32"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_group_c_cache_merge_second_mac.sce-template.xml"/>
</scxml>
