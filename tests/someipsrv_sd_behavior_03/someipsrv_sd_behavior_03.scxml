<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.4.3 SOMEIPSRV_SD_BEHAVIOR_03: Server Answer Behavior —
  if a unicast FindService (Unicast Flag = 1) arrives more than
  ½ CYCLIC_OFFER_DELAY after the last sent OfferService, the DUT shall
  answer with a multicast OfferService. (Per SOMEIPSD §6.7.5.2 /
  TR_SOMEIP_00423.)

  Cadence-relative timing. Emitting the Find at a fixed wall-clock offset
  assumes the DUT's cyclic-offer timer is on an assumed schedule; under CPU
  contention that timer skews, the Find lands at an unknown position in the
  cycle, and a Find that arrives <½ CYCLIC after the last offer draws a
  (correct-for-that-input) UNICAST reply — a harness-timing false fail, not a
  DUT defect. Instead the harness ANCHORS the Find to the DUT's own offer:
  it waits past the repetition phase into the main phase, observes one cyclic
  OfferService, and emits the Find exactly ½ CYCLIC + margin after THAT
  observed offer. So the last offer the DUT sent is reliably >½ CYCLIC
  (1000 ms, cyclic_offer_delay = 2000 ms) ago and its next cyclic (at
  +2000 ms) has not yet fired — regardless of how the DUT's SD timer skews,
  because the anchor is the DUT's actual offer, not a clock guess.

  Stimulus (TestCaseTraits<...>::stimulus): scheduleAfterStateEntry on
  `listening_offer_reply` emits the unicast Find on entry. The SCXML owns the
  1300 ms anchor hold; the trait just fires on the symbolic state.

  Phases:
    waiting_main_phase    — absorb the init/repetition offers; a 6500 ms timer
      clears them across the plausible DUT-start delay so the next observed
      offer is a clean main-phase cyclic (2000 ms cadence, ≥2000 ms follower).
    awaiting_anchor       — the next multicast OfferService is the anchor; a
      2600 ms deadline (>1 cyclic) guarantees one is seen or the run is
      inconclusive (never a false fail).
    anchored              — hold 1300 ms (½ cyclic + 300 ms) so the Find lands
      in the multicast-reply window, then enter listening_offer_reply.
    listening_offer_reply — the Find is emitted on entry; a 500 ms deadline
      catches the solicited reply (~50 ms) yet fires before the next cyclic
      (+700 ms into this state), so a cyclic Offer cannot mask a unicast
      solicited reply. Pass on a multicast solicited OfferService, fail on a
      unicast one, inconclusive on no reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_sd_behavior_03"
       datamodel="null"
       initial="waiting_main_phase">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="waiting_main_phase">
    <onentry>
      <send event="main_phase_reached" delay="6500ms"/>
    </onentry>
    <transition event="main_phase_reached" target="awaiting_anchor"/>
  </state>

  <state id="awaiting_anchor">
    <onentry>
      <send event="anchor_timeout" delay="2600ms"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.dst_ip == expected.sd_multicast_ip"
                target="anchored"/>
    <transition event="anchor_timeout" target="inconclusive_no_offer_after_unicast_find"/>
  </state>

  <state id="anchored">
    <onentry>
      <send event="find_due" delay="1300ms"/>
    </onentry>
    <transition event="find_due" target="listening_offer_reply"/>
  </state>

  <state id="listening_offer_reply">
    <onentry>
      <send event="s2_deadline_exceeded" delay="500ms"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.dst_ip == expected.sd_multicast_ip"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="fail_offer_not_multicast"/>
    <transition event="s2_deadline_exceeded" target="inconclusive_no_offer_after_unicast_find"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_offer_not_multicast">
    <donedata>
      <content>{"verdict":"fail","reason":"offer_dst_ip_not_multicast_after_unicast_find","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_offer_after_unicast_find">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_within_listen_window_after_unicast_find","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
