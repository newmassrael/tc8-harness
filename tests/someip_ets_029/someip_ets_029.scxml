<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_029: echoUINT8Array16BitLength.

  Same wire-shape contract as ETS_028 but with a 16-bit BE length
  prefix on the UInt8[] (deployment SomeIpArrayLengthWidth = 2).
  Tester sends [0x00 0x03 0x42 0x43 0x44] to METHOD-ID 0x003F. DUT
  echoes the array back unchanged on the wire.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_029"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x003F and captured.return_code == 0x00 and captured.payload_len == 5 and captured.payload_bytes[0] == 0x00 and captured.payload_bytes[1] == 0x03 and captured.payload_bytes[2] == 0x42 and captured.payload_bytes[3] == 0x43 and captured.payload_bytes[4] == 0x44"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x003F and captured.message_type == 0x80 and (captured.payload_len != 5 or captured.payload_bytes[1] != 0x03 or captured.payload_bytes[2] != 0x42 or captured.payload_bytes[3] != 0x43 or captured.payload_bytes[4] != 0x44)"
                target="fail_phase2_array_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_array_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_array16_response_did_not_match_request"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_method_response_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
