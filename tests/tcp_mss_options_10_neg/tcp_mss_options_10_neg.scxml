<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.9 TCP_MSS_OPTIONS_10 negative — lwIP TCP egress field-fault self-validation of
  the positive _10 default-MSS-536 guard. With no MSS option at setup, a conformant DUT segments
  a SEND at the 536 B default (RFC 1122 §4.2.2.6); the positive's fail-final fires iff the first
  DUT data segment is not 536 B. This negative arms kTcpFaultDataSegTruncate so the lwIP
  link-output hook shrinks the DUT data segment's IP total_length — libtins re-slices the
  dissected payload to 64 B — and passes only when that wrong-size (!= 536) segment is observed.
  lwIP-only (capability-gated on kCapEgressFault).

  Single observation state mirrors the positive, with the size predicate flipped:
    * listening — the positive's fail predicate (is_dut_data_segment with payload_len != 536)
      lands on pass here, because the truncated segment dissects to 64 B; payload_len == 536 means
      the DUT segmented at the default despite the armed flavor (fault inert); the deadline means
      no data segment was emitted (precondition unmet).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_mss_options_10_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpMssOptionsListenPort10, ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort10) and captured.payload_len != 536U"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpMssOptionsListenPort10, ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort10) and captured.payload_len == 536U"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_segmented_at_536_despite_truncate_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_data_segment_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
