<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.1 TCP_BASICS_09: in LAST-ACK state, on receipt of the
  ACK of its own FIN the DUT's TCP MUST move to CLOSED. Verification
  per spec is observational: a subsequent non-RST segment to the now-
  closed port must elicit a RST from the DUT — the RFC 793 §3.9 p65
  CLOSED-state response, identical to BASICS_04. Derived from
  RFC 793 §3.2 p23 Terminology.

  Case shape:
    a passive close from CLOSE-WAIT walks the DUT to LAST-ACK, where it
    emits FIN; the tester kernel auto-acknowledges, which should end
    the connection. A further non-RST segment sent to that port has to
    draw an RST — the proof that the DUT really reached CLOSED.

  Pass criteria fold into a 2-state SCXML chain:
    listening_fin: wait for DUT FIN+ACK on phase ports
                   (the LAST-ACK entry marker, spec step 2)
                   → listening_rst
    listening_rst: wait for DUT RST on the closed-port quad
                   (spec step 5) → pass

  Distinguishing the two observation events requires distinct port
  quads — the LAST-ACK FIN flows on (49500→23456) (the active-open
  pair), while the closed-port RST is provoked by a raw-inject from
  (49152→49500) and elicits a RST flowing (49500→49152). The dst_port
  conjunct is what splits "DUT close FIN" from "DUT closed-port RST"
  on the wire.

  The tester-kernel ACK of the DUT's FIN — what actually causes the
  LAST-ACK → CLOSED transition — is silent at the SCXML level (it is
  a tester-origin segment and src_ip filter excludes it). The harness
  proves the transition happened by the existence of the subsequent
  RST: a DUT still in LAST-ACK would either drop or queue the closed-
  port stimulus rather than RST it.

  Both observations are Pass Criteria (step 2 FIN, step 5 RST), and the
  TCP chapter states no time for either, so a state window that elapses
  without its segment is the DUT's silence where it must emit —
  observed_quiescence, judged against <ParamListenTime>
  (docs/verdict_policy.md Section 2.1, H3). Each window is
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults), on a timer event of its own.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_basics_09"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_fin">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_fin">
    <onentry>
      <send event="deadline_fin" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpBasics09LocalOffset) and captured.dst_port == (::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpBasics09LocalOffset) and (captured.flags &amp; 0x01) != 0"
                target="listening_rst"/>
    <transition event="deadline_fin" target="fail_timeout_fin"/>
  </state>

  <state id="listening_rst">
    <onentry>
      <send event="deadline_rst" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpBasics09LocalOffset) and captured.dst_port == ::tc8::sce::tcp::kBasicsTesterPort and (captured.flags &amp; 0x04) != 0"
                target="pass"/>
    <transition event="deadline_rst" target="fail_timeout_rst"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_timeout_fin">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_fin_into_last_ack","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_timeout_rst">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_rst_from_closed","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
