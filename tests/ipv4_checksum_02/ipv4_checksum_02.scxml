<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.2 IPv4_CHECKSUM_02: DUT discards a packet whose IPv4
  header checksum does not match the RFC 1071 one's-complement sum of
  the header words. Derived from RFC 791 section 3.1, RFC 1122
  section 3.2.1.2.

  Stimulus: TESTER injects ICMPv4 Echo Request with one bit of the IP
  header checksum flipped post-compute. Kernel's ip_rcv runs the
  RFC 1071 validation, sees non-zero, silently drops.

  Body shared with HEADER_02 / 04 / 08 / 09, ADDRESSING_03 via
  sce:template (tests/_templates/ipv4_negative_absence.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_checksum_02"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_negative_absence.sce-template.xml"
           fail_reason="dut_replied_despite_invalid_header_checksum"/>
</scxml>
