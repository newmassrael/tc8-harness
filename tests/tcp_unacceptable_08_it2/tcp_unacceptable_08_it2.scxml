<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_08, iteration 2 of 2: TCP in SYN-SENT state MUST send a
  RST control message with SEQ equal to the incoming segment's ACK
  number after receiving a segment carrying an unacceptable ACK.
  Derived from RFC 793 §3.4 p36 Establishing a Connection (MUST).

  The iteration is a case of its own: the TC8 case is the ordered set of its iterations
  and its verdict their conjunction (case_iteration.h). This one sends a segment with the
  flag set ACK only and an unacceptable ACK; the first iteration, SYN,ACK with an
  unacceptable ACK, is tcp_unacceptable_08_it1. They share one stimulus body and differ
  only in the flags of the injected segment.

  Observable protocol interaction:
    a. The tester suppresses its kernel's auto-RST so the DUT's
       outbound SYN does not provoke a tester-kernel RST that would
       knock the DUT out of SYN-SENT before the bad-ACK injection.
    b. The DUT issues an active OPEN — SYN emitted, DUT in SYN-SENT.
       With no tester endpoint listening, the SYN goes nowhere and
       the DUT retransmits per Linux's tcp_syn_retries cadence
       (~1 s); the spec assertion fires well before retransmit
       timing matters.
    c. The DUT-emitted SYN is observed to learn ISN_d.
    d. The tester injects ACK with ack_num = ISN_d + LARGE_OFFSET.
       Per RFC 793 §3.4 p36 SYN-SENT responds RST(seq = incoming.ack).
    e. SCXML observes the DUT RST on the iteration's active port quad.
    f. The DUT closes the socket — best-effort.

  The procedure states no listen time, so the general input parameter
  <ParamListenTime> bounds the wait for the RST. A window that
  elapses without it is the DUT's silence where it must answer:
  observed_quiescence, judged against that bound (H3),
  over ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults). SYN-SENT is the stimulus's own setup (the DUT SYN is
  awaited before the bad ACK is sent). Whether a silence stands as a
  fail is the CLI's call on the run's hypotheses.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_08_it2"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_dut_rst">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_dut_rst">
    <onentry>
      <send event="deadline_dut_rst" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable08Phase2LocalOffset and captured.dst_port == ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable08Phase2LocalOffset and (captured.flags &amp; 0x04) != 0"
                target="pass"/>
    <transition event="deadline_dut_rst" target="fail_no_dut_rst"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_dut_rst">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_rst_ack_with_unacceptable_ack","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
