<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_06 negative — closes
  the self-reference trap on the positive _06 case. tc8-dut emits
  Probes via OpStartLLAutoconfBuggy(flavor=SenderIpNonzero):
  sender_proto_ip = DUT iface IP (RFC 3927 §2.1.1 MUST = 0).

  Pass = SCXML lands on fail_sender_proto_ip_nonzero branch — the
  violation is detected. fail_compliant_emit = tc8-dut ignored the
  flavor byte, harness silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_06_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="captured.sender_proto_ip != 0"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_probe_despite_sender_ip_nonzero_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
