<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_16: DUT accepts a UDP datagram whose
  Checksum field is 0x0000 — the RFC 768 'no checksum computed'
  sentinel. Linux's `net.ipv4.udp_l4_csum_check` defaults to
  pass-through on zero-cksum datagrams (RFC 1122 §4.1.3.4 SHOULD
  default to checksumming-on but allow caller-side bypass via
  cksum=0).

  Reuses ipv4_udp_ut_presence with expected_received=1.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_16"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="1"
           fail_reason_wrong_receipt="dut_did_not_accept_zero_checksum_udp"
           fail_reason_timeout="no_ut_confirmation_for_zero_checksum_accept"
           fail_role="observed_violation"/>
</scxml>
