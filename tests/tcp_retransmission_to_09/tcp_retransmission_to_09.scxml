<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §4.8.6.11 TCP_RETRANSMISSION_TO_09: TCP SHOULD use an
  upper bound of 2*MSL of RTO for SYN segments. Derived from
  RFC 1122 §4.2.3.1 p96 Retransmission Timeout Calculation (SHOULD).

  SYN sibling of _08 (data path). Linux 6.5 has a SYN-specific
  `tcp_syn_linear_timeouts = 4` cadence (first 4 retxs at constant
  ~1 s, then exponential doubling) on top of the same TCP_RTO_MAX
  120 s cap. Spec's 2*MSL = 60 s plateau is unreachable on Linux
  inside any reasonable budget because the kernel's RTO_MAX exceeds
  the spec's 2*MSL.

  Verdict ladder (single kernel-state (TCP_INFO) snapshot,
  evaluate-pattern):
    1. `not ut_handshake_completed`        → inconclusive_handshake_did_not_complete
       (the DUT never initiated the active OPEN; on the negative
        IP-flip path the harness never reaches the DUT.)
    2. `not ut_tcpi_p1_valid`              → error_query_failed
    3. `ut_tcpi_p1_retransmits == 0`       → fail_no_retx
       (SYN retransmits never fired — the tester's auto-RST suppression
        probably leaked or the DUT exited SYN-SENT for another reason.)
    4. `rto_us > 63_000_000`               → fail_rto_above_2msl_cap
       (Linux RTO_MAX path, 120 s — exceeds spec's 60 s)
    5. `rto_us < 57_000_000`               → inconclusive_rto_below_2msl_cap
       (Linux mid-doubling at observation budget cap, or any DUT
        plateauing too low)
    6. fall-through                        → pass (rto_us within
       60 s ± 5%, the 2*MSL band)

  Wall-time budget: 35 s. Linux's SYN RTO timeline at 35 s mark
  is in mid-exponential phase (rto ≈ 16-25 s); plateau detection
  never fires within the budget on this kernel. The verdict
  consistently lands on `inconclusive_rto_below_2msl_cap`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_09"
       datamodel="null"
       initial="evaluate_kernel_observations">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="evaluate_kernel_observations">
    <onentry>
      <send event="evaluate" delay="0ms"/>
    </onentry>
    <transition event="evaluate"
                cond="cpp:not captured.ut_handshake_completed"
                target="inconclusive_handshake_did_not_complete"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p1_valid"
                target="error_query_failed"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_retransmits == 0"
                target="fail_no_retx"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_rto_us &gt; 63000000"
                target="fail_rto_above_2msl_cap"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_rto_us &lt; 57000000"
                target="inconclusive_rto_below_2msl_cap"/>
    <transition event="evaluate" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_handshake_did_not_complete">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_active_open_did_not_initiate","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="error_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx">
    <donedata>
      <content>{"verdict":"fail","reason":"no_syn_retransmits_observed_in_kernel","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_rto_above_2msl_cap">
    <donedata>
      <content>{"verdict":"fail","reason":"rto_plateau_above_2_msl_linux_rto_max_120s_exceeds_spec_2_msl_60s","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_rto_below_2msl_cap">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"rto_below_2_msl_did_not_plateau_within_observation_budget","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
