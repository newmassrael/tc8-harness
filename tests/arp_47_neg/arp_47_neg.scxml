<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_47 negative — lwIP egress-fault self-validation of the
  positive _47 Reply Hardware Address Length guard.
  emitEgressFlavorArm(kArpFaultHwLenWrong) rewrites the hlen of the DUT's
  Reply (opcode left at 2; same flavor as the _10 Request mutant). Pass =
  corrupted hw_addr_len observed; fail_compliant = DUT emitted 6 despite
  the flavor (fault inert). lwIP-only. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_47_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 2 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.hw_addr_len != 6"
           fail_state="fail_compliant"
           fail_reason="dut_arp_reply_hw_addr_len_six_despite_hw_len_wrong_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_arp_reply_within_listen_window"/>
</scxml>
