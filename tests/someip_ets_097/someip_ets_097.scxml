<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_097: SD_Client_restarts_tcp_connection.

  Per PRS_SOMEIPSD_00527: when the DUT-as-client tries to subscribe to a
  TCP-reliable eventgroup and the first TCP connect attempt is refused,
  vsomeip must re-attempt the connect when it receives another OfferService
  Message for the same service.

  Stimulus chain (see src/sce_integration/cases/someip_ets_097.h):
    1. emitFindServiceBoot — SERVICE-ID-1 server warm-up.
    2. emitMethodRequestAfter(clientServiceActivate) — DUT spawns
       ets3 ClientTarget Proxy (gated by TC8_DUT_CLIENT_MODE).
    3. emitMethodRequestAfter(clientServiceSubscribeEventgroup) — DUT calls
       subscribe() on the TCP-reliable event.
    4. emitOfferServiceMulticastWithEndpoint(offer1, tester:30509, TCP) —
       OfferService #1 with no listener bound → DUT first SYN gets RST.
    5. Sleep 1.5 s — DUT vsomeip arms its retry timer.
    6. openTcpListener(:30509) + emitOfferServiceMulticastWithEndpoint(offer2)
       — second OfferService triggers vsomeip's offer-driven reconnect.
    7. acceptTcpOnce(timeout=3 s) — sets c.tcp_handshake_completed=1 if the
       second SYN completes the handshake.

  Verdict (3-state):
    Phase 1 (listening_phase1, 6 s): tester-side server warm-up — observe
            an OfferService for SERVICE-ID-1.
    Phase 2 (listening_phase2_subscribe_seen, 12 s): observe DUT
            SubscribeEventgroup for SERVICE-ID 0xF4E9 carrying an IPv4
            Endpoint Option with l4_proto = 0x06 (TCP).
    Phase 3 (listening_phase3_handshake, 6 s): verify the stimulus chain
            completed the handshake. Cond reads `c.tcp_handshake_completed`
            once the deadline fires (the stimulus thread writes the slot
            during accept()).

  Reference: PRS_SOMEIPSD_00527.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_097"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_subscribe_seen"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_subscribe_seen">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="12s"/>
    </onentry>
    <!-- DUT-emitted SubscribeEventgroup for ets3 (SERVICE-ID 0xF4E9) carrying
         an IPv4 Endpoint option whose l4_proto is TCP (0x06). The bundled
         option index is 0 (single-option subscribe with #Opt1=1). -->
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x06 and captured.sd_entries[0].service_id == 0xF4E9 and captured.sd_option_count >= 1 and captured.sd_options[0].type == 0x04 and captured.sd_options[0].l4_proto == 0x06"
                target="listening_phase3_handshake"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_subscribe_with_tcp_option"/>
  </state>

  <state id="listening_phase3_handshake">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="6s"/>
    </onentry>
    <!-- The stimulus chain writes c.tcp_handshake_completed = 1 after the
         tester-side accept() returns. Cond on the deadline reads the slot
         once and routes to pass / fail accordingly. -->
    <transition event="phase3_deadline_exceeded"
                cond="cpp:captured.tcp_handshake_completed == 1"
                target="pass"/>
    <transition event="phase3_deadline_exceeded"
                target="fail_phase3_no_tcp_handshake_after_second_offer"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_subscribe_with_tcp_option">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_subscribe_with_tcp_option_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_no_tcp_handshake_after_second_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_complete_tcp_handshake_after_second_offer"}</content>
    </donedata>
  </final>
</scxml>
