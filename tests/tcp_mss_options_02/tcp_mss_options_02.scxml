<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.9 TCP_MSS_OPTIONS_02: TCP MUST be able to receive No
  Operation and End of Options List options in a SYN segment.
  Derived from RFC 1122 §4.2.2.5 p85 TCP Options "RFC-793 Section
  3.1" (MUST).

  v3.0 Test Procedure (p356):
    1. TESTER: Cause DUT to move on to LISTEN state at <wnp>.
    2. TESTER: Send a SYN with three No Operation options followed
               by an End of Options list option.
    3. DUT:    Send SYN,ACK.
    4. TESTER: Send ACK.
    5. TESTER: Verify DUT in ESTABLISHED state.

  Mechanism (driveSeamRawPassiveAccept):
    - UT OpOpenTcpSocket(passive, kTcpMssOptionsListenPort02).
    - TesterAutoRstDrop scoped — Linux's tester kernel would
      otherwise emit RST against the DUT-emitted SYN+ACK on a
      4-tuple where it has no socket.
    - Raw-inject SYN with options bytes [0x01 0x01 0x01 0x00]
      (three NOP + one EOL — RFC 793 §3.1 kind=1 / kind=0). The
      4-byte options region keeps Data Offset = 6 with no extra
      padding from the builder.
    - TcpFrameSnippet learns DUT ISN_d from the SYN+ACK reply.
    - Raw-inject ACK with seq=tester_isn+1, ack=ISN_d+1; DUT TCB
      transitions SYN-RCVD → ESTABLISHED.
    - 50 ms settle + UT OpQueryTcpEstablished writes the boolean
      into captured.ut_established BEFORE SCE start() arms the
      listen window (TestRunner runs stimulus before start()).

  Pass guard (one tcp_observed edge):
    * captured.src_ip   == expected.dut_iface_ip   — DUT-origin
    * captured.dst_ip   == expected.tester_ip
    * captured.src_port == kTcpMssOptionsListenPort02 (DUT bound)
    * captured.dst_port == kTcpMssOptionsTesterSrcPort02
    * (captured.flags & SYN) != 0 AND (captured.flags & ACK) != 0
    * captured.ut_established == 0x01

  fail_not_established: SYN,ACK observed but UT reports not-
  established (the third-leg ACK was dropped, the DUT failed to
  accept(), or the kernel rejected the handshake mid-flight).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_mss_options_02"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpMssOptionsListenPort02 and captured.dst_port == ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort02 and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ut_established == 0x01"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpMssOptionsListenPort02 and captured.dst_port == ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort02 and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ut_established == 0x00"
                target="fail_not_established"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_not_established">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_reach_established"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_ack_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
