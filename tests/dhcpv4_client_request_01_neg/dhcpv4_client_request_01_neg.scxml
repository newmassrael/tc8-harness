<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_01 negative — closes the
  self-reference trap on the positive _01 case (DHCPREQUEST 'ciaddr' MUST
  be 0 in REQUESTING state; the requested address rides in Option 50, not
  the BOOTP fixed header, RFC 2131 §4.3.2). The positive's ciaddr-not-zero
  branch is unreachable against a conformant tc8-dut.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorRequestCiaddrNonzero flavor (gated to the
  post-OFFER REQUEST). tc8-dut fills 'ciaddr' with the requested address
  in the REQUEST. A conformant client (flavor None) leaves ciaddr=0, so
  this negative's fail_compliant branch is the live conformant-DUT
  outcome.

  Reuses the dhcpv4_request_field template with pass_expr inverted
  (pass = ciaddr non-zero observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_01_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="!captured.ciaddr_is_zero()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_request_ciaddr_zero_despite_ciaddr_nonzero_flavor"/>
</scxml>
