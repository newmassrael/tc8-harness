<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPV4_CLIENT_REQUEST_06: DHCPREQUEST generated during
  RENEWING state — 'server identifier' (Option 54) MUST NOT be filled
  (RFC 2131 §4.3.6 table 5).

  Spec Test Procedure (tc8_p261-p280.txt: REQUEST_06):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER: DHCP Server <SERVER-1> Cause DUT to transit its state
         to DHCPCLIENT_STATE_RENEWING (= reply OFFER+ACK with short lease,
         DUT arms T1, emits RENEWING REQUEST at lease/2).
    4.   DUT: Transit finite state to DHCPCLIENT_STATE_RENEWING.
    5.   TESTER: DHCP Server <SERVER-1> Listens (upto <ParamListenTime>).
    6.   DUT: Sends DHCPREQUEST Message (RENEWING).
    7.   TESTER: Verify received DHCPREQUEST does NOT carry Option 54.
  Pass: 4 + 6 + 7.

  RFC 2131 §4.3.6 table 5: 'server identifier' option is MUST NOT for
  DHCPREQUEST in RENEWING / REBINDING. The server identification is
  carried implicitly via the IP unicast destination (RENEWING) or via
  the broadcast envelope (REBINDING).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_06"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="captured.option_absent(54)"
           fail_state="fail_renewing_request_carries_server_id"
           fail_reason="dut_renewing_request_carries_server_id"/>
</scxml>
