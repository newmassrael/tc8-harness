<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.1 UDP_MessageFormat_02: DUT accepts a UDP packet
  containing a well-formed UDP Header (RFC 768 'Format'). Source
  Port + Destination Port + Length + Checksum all conformant.

  Same wire shape as ADDRESSING_01 + FIELDS_03 (default-conformant
  injection); registering separately to pin the spec section's
  invariant (RFC 768 'Format' MUST as opposed to RFC 1122 §3.2.1.3
  ADDRESSING-side rule). Reuses ipv4_udp_ut_presence with
  expected_received=1.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_messageformat_02"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="1"
           fail_reason_wrong_receipt="dut_did_not_accept_well_formed_udp"
           fail_reason_timeout="no_ut_confirmation_for_well_formed_udp_accept"/>
</scxml>
