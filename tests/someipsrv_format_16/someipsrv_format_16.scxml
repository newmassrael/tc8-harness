<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.16 SOMEIPSRV_FORMAT_16: Major Version field of the Type 1
  entry shall carry the configured SERVICE-ID-1-MAJ-VER. Injected at
  runtime via CLI option expect major_version=<n> into
  expected.major_version; smoke-test.sh supplies the tc8-dut
  default (1; see mock_dut/ets/ets.fidl version { major 1 minor 0 }).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_16"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].major_version == expected.major_version"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].major_version != expected.major_version"
                target="fail_major_version"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_major_version">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_major_version_mismatch"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_notification_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
