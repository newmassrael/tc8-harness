<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_01: An ARP Announcement - I.
  DUT's first Announce after the 3-Probe phase has Ethernet
  destination = broadcast (RFC 3927 §2.4 MUST: identical to the Probe
  shape, broadcast on the local link).

  Spec Test Procedure (tc8_p161-p180.txt:466..512), step 11:
    Verify Ethernet Destination Hardware Address = ETHERNET_BROADCAST_ADDR.

  `ArpCaptured::is_eth_broadcast()` evaluates the encapsulating
  Ethernet header dst — distinct from the ARP `target_hw` payload
  field which _04 asserts (zero). Body shared with ANNOUNCING_02/_03/_04
  via the ipv4_linklocal_announce_field template.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_01"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_announce_field.sce-template.xml"
           pass_expr="captured.is_eth_broadcast()"
           fail_state="fail_announce_eth_dst_not_broadcast"
           fail_reason="dut_arp_announce_eth_dst_not_broadcast"
           fail_role="observed_violation"/>
</scxml>
