<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.5.1 SOMEIPSRV_BASIC_01: A service shall be identified
  using the Service-ID. Two-phase observation:

    Phase 1 (listening_phase1): DUT emits an OfferService for SERVICE-ID-1
            in response to the tester's FindService stimulus. SD entry
            type 0x01, sd_entries[0].service_id == expected.service_id.
    Phase 2 (listening_phase2): DUT replies to the tester's Method
            Request (echoUINT8, method_id=0x08) with a Response
            (message_type 0x80) carrying return_code E_OK (0x00) and
            the same service_id / method_id.

  The two stimuli are issued sequentially by
  TestCaseTraits<Basic01SM>::stimulus(): emitFindServiceBoot first, then
  emitMethodRequestAfter once the OfferService cycle is well underway.
  The single SCXML observes both phases on a unified pipeline.

  Pcap captures both directions on veth-tester, so the tester's own
  outgoing FindService and Method Request also fire `someip_notification`;
  their transitions have no match in the current state and are silently
  consumed.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_basic_01"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.method_id == 0x0008"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
