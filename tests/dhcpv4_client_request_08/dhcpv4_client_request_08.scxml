<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_08: DHCPREQUEST generated during
  RENEWING state — 'ciaddr' MUST be filled in with client's IP address
  (RFC 2131 §4.4.5).

  Spec Test Procedure (tc8_p261-p280.txt: REQUEST_08):
    1-2. DUT bring-up + DHCP client configure.
    3-4. TESTER causes DUT to BOUND (OFFER+ACK), then to RENEWING (T1).
    5.   TESTER: DHCP Server <SERVER-1> Listens (upto <ParamListenTime>).
    6.   DUT: Sends DHCPREQUEST Message (RENEWING).
    7.   TESTER: Verify ciaddr = <SERVER1-IP-POOL-0-0>.
  Pass: 4 + 6 + 7.

  RFC 2131 §4.4.5: in RENEWING/REBINDING the client's bound IP is
  carried in the BOOTP 'ciaddr' field — Option 50 (Requested IP) is
  forbidden in these phases (REQUEST_07/_10), so ciaddr is the only
  channel by which the client communicates which lease it is renewing.

  expected.offered_ip_be is the yiaddr the tester emul advertised in
  the OFFER and echoed in the ACK (kDefaultOfferedIpBe = 172.16.0.50).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_08"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="captured.ciaddr_equals(expected.offered_ip_be)"
           fail_state="fail_renewing_request_ciaddr_mismatch"
           fail_reason="dut_renewing_request_ciaddr_mismatch"/>
</scxml>
