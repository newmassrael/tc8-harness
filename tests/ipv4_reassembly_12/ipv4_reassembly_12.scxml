<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.7 IPv4_REASSEMBLY_12: Check fragment with Low TTL value.
  Per RFC 791 §3.2 the reassembly timer is "the maximum of TLB and
  TTL" — the timer must not be DECREASED if the arriving fragment's
  TTL is lower than the current setting. TESTER sends frag 0 (offset=0,
  MF=1, TTL=LowTTLValue) and waits less than ipIniReassembleTimeout
  before frag 1 (offset=1, MF=0, TTL=LowTTLValue). A conformant DUT
  reassembles within the original timer window and emits an Echo
  Reply mirroring id/seq/data.

  Tight-margin note: smoke-test.sh installs a per-netns
  `ipfrag_time=2` toggle for the dut_ns, collapsing the spec's 15 s
  ipIniReassembleTimeout recommendation to 2 s so the case completes
  in seconds. The 1 s inter-fragment wait then sits inside a 2 s
  baseline timer (50 percent margin) — a DUT that wrongly applied
  MIN-with-TTL on Low TTL could collapse the window below 1 s and
  lose the bucket; this case observes that it does not. Linux ignores
  TTL entirely (single static `ipfrag_time` per netns, no RFC 791 §3.2
  MAX(TLB, TTL) coupling), so the bucket survives 2 s regardless of
  TTL — frag 1 lands at 1 s, reassembly completes, Echo Reply lands.
  A strict-RFC 791 DUT lands the same wire-level pass since MAX(2, 2)
  = 2 s. The prior 30 s/1 s margin was so wide the invariant was not
  actively exercised; tightening to 2 s/1 s narrows the diagnostic
  gap.

  Pass criterion = type=0 Echo Reply with matching echo_id +
  echo_seq + 8 B payload (kFragmentsEchoPayload — same body shape
  as FRAGMENTS_01).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_reassembly_12"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Icmpv4Captured"
               cpp:include="sce_integration/icmpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Icmpv4Expected"
               cpp:include="sce_integration/icmpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.echo_id == expected.echo_id and captured.echo_seq == expected.echo_seq and captured.payload_equals(std::string_view(reinterpret_cast&lt;const char*&gt;(::tc8::sce::ipv4::fragments::kFragmentsEchoPayload.data()), ::tc8::sce::ipv4::fragments::kFragmentsEchoPayload.size()))"
                target="pass"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.echo_id != expected.echo_id"
                target="fail_echo_id"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.echo_seq != expected.echo_seq"
                target="fail_echo_seq"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0"
                target="fail_data_mismatch"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_echo_id">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_id_mismatch_after_low_ttl_reassembly","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_echo_seq">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_seq_mismatch_after_low_ttl_reassembly","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_data_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"reassembled_echo_data_mismatch_low_ttl","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_echo_reply_after_low_ttl_reassembly","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
