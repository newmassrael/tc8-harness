<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.2 SOMEIPSRV_OPTIONS_15: Layer-4 Protocol field of the
  IPv4 Endpoint Option shall be 0x06 (TCP) per SWS_SD_00214 — the
  "Checking For TCP" companion to OPTIONS_06. Spec calls out
  SERVICE-ID-2; vsomeip OfferService for service 0xF4E7 already emits
  both UDP (30502) and TCP (30501) IPv4 Endpoint Options because the
  service is configured with both transports — verifying the TCP
  axis on the same OfferService cleanly observes the L4-Proto=0x06
  invariant the spec requires of any IPv4 Endpoint Option whose port
  is a TCP port. The TCP-port value itself is asserted alongside via
  expected.tcp_port (30501) so this case stays distinct from OPTIONS_06.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_options_15"
       datamodel="null"
       initial="listening_phase1">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="captured.sd_option_count &gt;= 1"
           entry_type="0x01"
           pass_expr="captured.sd_has_option_with_l4(::tc8::sd_option_type::kIpv4Endpoint, ::tc8::sd_l4_proto::kTcp) and captured.sd_first_option_with_l4(::tc8::sd_option_type::kIpv4Endpoint, ::tc8::sd_l4_proto::kTcp).port == expected.tcp_port"
           fail_state="fail_l4_tcp"
           fail_reason="no_ipv4_endpoint_option_with_tcp_l4_or_port_mismatch"/>
</scxml>
