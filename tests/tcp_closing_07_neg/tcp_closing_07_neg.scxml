<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.8 TCP_CLOSING_07 negative — lwIP TCP behavioral-synthesis
  self-validation of the positive _07 no-RST-in-FIN-WAIT-1 guard. A conformant DUT in
  FIN-WAIT-1 ACKs incoming data and stays in FW1 (RFC 793 §3.5); the positive's
  remain_in_fw1 guard fails only on a DUT RST. This negative arms
  kTcpSynthRstOnDisruptive so the lwIP netif input hook synthesizes the prohibited RST on
  the connection's 4-tuple when the FW1 data segment (PSH) arrives, and passes only when
  that synthesized RST is observed. lwIP-only (capability-gated on kCapIngressFault).

  Two-state chain (the positive's full handshake_ack -> dut_fin -> dut_data_ack ->
  remain_in_fw1 chain collapses to confirm + watch, so the synthesized RST cannot race an
  intermediate state):
    * listening_handshake_ack — observe the DUT's active-OPEN third-leg pure ACK,
      confirming the connection (deadline -> inconclusive).
    * watch_synth_rst — 8 s window; the positive's remain_in_fw1 fail predicate (is_dut_rst
      on the 4-tuple) lands on pass here. The DUT's own half-close FIN and conformant data
      ACK do not match is_dut_rst, so only the synthesized RST trips it; the deadline means
      the DUT stayed conformant despite the armed flavor (fault inert).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_closing_07_neg"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 73U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 73U)"
                target="watch_synth_rst"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="watch_synth_rst">
    <onentry><send event="deadline_synth_rst" delay="8s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 73U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 73U)"
                target="pass"/>
    <transition event="deadline_synth_rst" target="fail_compliant"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content></donedata>
  </final>

  <final id="fail_compliant">
    <donedata><content>{"verdict":"fail","reason":"dut_silent_despite_synth_rst_flavor","role":"fault_injection_inert"}</content></donedata>
  </final>
</scxml>
