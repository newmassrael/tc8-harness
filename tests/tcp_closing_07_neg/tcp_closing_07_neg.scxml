<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.8 TCP_CLOSING_07 negative (FIN-WAIT-1) — lwIP TCP behavioral-synthesis
  self-validation of the positive _07 no-RST-in-FW1 guard. The trait drives the DUT to FW1,
  arms kTcpSynthRstOnDisruptive, and injects FW1 data (PSH); the lwIP netif input hook
  synthesizes the prohibited RST. Pass = that RST observed; fail_compliant = DUT stayed silent
  despite the flavor (fault inert). lwIP-only (kCapIngressFault). Shares the standard
  active-OPEN confirm-then-watch envelope. Envelope: tcp_synth_rst_watch_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_closing_07_neg"
       datamodel="null"
       initial="listening_handshake_ack">
  <sce:use template="../_templates/tcp_synth_rst_watch_neg.sce-template.xml"
           port_offset="::tc8::sce::tcp::kTcpClosing07LocalOffset"/>
</scxml>
