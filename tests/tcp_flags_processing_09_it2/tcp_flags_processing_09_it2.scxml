<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_09, iteration 2 of 3: TCP, in CLOSE-WAIT, CLOSING or
  LAST-ACK state, MUST not change state after receiving a FIN segment with ACK flag set.
  Derived from RFC 793 §3.9 p75 Event Processing (MUST). This iteration's state is CLOSING,
  with an invalid ACK number (one that does not acknowledge the DUT's FIN).

  A case of its own beside tcp_flags_processing_09_it1 (CLOSE-WAIT) and _it3 (LAST-ACK).

  A duplicate FIN+ACK arrives carrying an INVALID ack (one short of the value that would
  acknowledge the DUT's own FIN). The DUT in CLOSING is awaiting the ACK of its own FIN; an
  invalid ack draws a challenge ACK per RFC 5961. The DUT may emit a pure ACK (the challenge)
  but state stays CLOSING (CLOSING to TIME-WAIT needs a valid ack). The DUT may also
  retransmit its own FIN on its retransmit timer, which is tolerated.

  Absence guard (3 s): fail on DUT RST. A DUT FIN+ACK retransmit (its own FIN, unrelated to the
  dup-FIN response) and a DUT pure ACK (challenge) are tolerated.

  Port quad (kBasicsActiveLocalPort + 58, kBasicsActiveRemotePort + 58).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_09_it2"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry><send event="deadline_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset)"
                target="listening_closing_ack"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>

  <state id="listening_closing_ack">
    <onentry><send event="deadline_closing_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset)"
                target="listening_absence"/>
    <transition event="deadline_closing_ack" target="inconclusive_no_closing_ack"/>
  </state>

  <state id="listening_absence">
    <onentry><send event="deadline_absence" delay="3s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing09Phase2LocalOffset)"
                target="fail_unexpected_state_change"/>
    <transition event="deadline_absence" target="pass"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase2_closing","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase2_closing","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_no_closing_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_closing_ack_phase2_closing","role":"precondition_unmet"}</content></donedata></final>
  <final id="fail_unexpected_state_change"><donedata><content>{"verdict":"fail","reason":"dut_emitted_rst_after_dup_fin_ack_in_closing","role":"observed_violation"}</content></donedata></final>
</scxml>
