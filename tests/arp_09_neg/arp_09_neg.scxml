<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_09 negative — lwIP egress-fault self-validation of the
  positive _09 Protocol Type guard. emitEgressFlavorArm(kArpFaultProtoTypeWrong)
  rewrites the ptype of the DUT's Request (opcode left at 1). Pass =
  corrupted proto_type observed; fail_compliant = DUT emitted 0x0800
  despite the flavor (fault inert). lwIP-only. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_09_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.proto_type != 0x0800"
           fail_state="fail_compliant"
           fail_reason="dut_arp_request_proto_type_ipv4_despite_proto_type_wrong_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
