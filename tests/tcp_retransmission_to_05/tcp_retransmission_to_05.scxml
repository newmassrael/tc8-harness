<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.11 TCP_RETRANSMISSION_TO_05: TCP MUST include "exponential
  backoff" (check that it increases) for successive RTO values for
  sending SYN segments (RFC 1122 §4.2.3.1 MUST — RFC 6298 §5).

  v3.0 Test Procedure (p370):
    1. TESTER: Cause the application on the DUT-side to issue an
               active OPEN call.
    2. DUT:    Send a SYN.
    3. TESTER: Do not send SYN, ACK.
    4. DUT:    Retransmit the SYN segment after a timeout.
    5. TESTER: Do not send SYN,ACK and verify that RTO retransmission
               interval is increasing at a fast (at least more than
               linear) rate.

  Mechanism (kernel-side TCP_INFO observation, three snapshots):
    The earlier pcap-timing chain (observe SYN, retx1, retx2, retx3
    inter-frame deltas in a 4-state SCXML) was deterministic at
    workers=1 but flaked under workers=4 parallel load — pcap's
    SOFTIRQ delivery raced the per-state deadline guards. Replacing
    the wire-timing assertions with three synchronous OpQueryTcpInfo
    (0x13) reads off the DUT's connect-side fd (set by openTcpActive
    BEFORE the connector worker is spawned —
    upper_tester_server.cpp:1199, so the fd is queryable while in
    TCP_SYN_SENT) makes the verdict a function of kernel state, not
    pcap delivery latency. Stimulus phases:

    1. Active OPEN to a tester-side port with no listener;
       `TesterAutoRstDrop` swallows the tester-kernel's auto-RST so
       the DUT stays in TCP_SYN_SENT and the retransmit timer doubles
       on every fire per RFC 6298 §5 step 5.5. dut_ns sysctl
       `tcp_syn_linear_timeouts=0` disables Linux's "first 4 retries
       use linear RTO" deviation so doubling kicks in on retx 1.
       Expected sequence on Linux 6.x: initial RTO ≈ 1 s, retx 1 at
       +1 s (icsk_rto: 1 s → 2 s), retx 2 at +2 s (2 s → 4 s), retx 3
       at +4 s (4 s → 8 s). Total to retx 3 ≈ 7 s wall-clock.
    2. **Phase 1 snapshot** (post-retx 1): poll at 50 ms cadence
       until `tcpi_retransmits >= 1`; deadline 2 s. Pass criterion:
       `tcpi_rto >= 1500000` us (proves the kernel doubled icsk_rto
       from the 1 s initial RTO — a non-doubling DUT would still
       report ~1 s).
    3. **Phase 2 snapshot** (post-retx 2): poll until
       `tcpi_retransmits >= 2`; deadline 4 s. Pass criterion:
       `tcpi_rto > p1.tcpi_rto` (strict growth proves a second
       doubling — a constant-RTO DUT would leave p2.rto == p1.rto).
    4. **Phase 3 snapshot** (post-retx 3): poll until
       `tcpi_retransmits >= 3`; deadline 8 s. Pass criterion:
       `tcpi_rto > p2.tcpi_rto` (strict growth proves a third
       doubling). Three observations of strict growth across the
       cluster pin the "more than linear" RFC 1122 §4.2.3.1 MUST.

  SCXML shape — single state with a `<send delay="0ms"/>`-raised
  evaluation event, multiple cond-keyed transitions; first matching
  transition wins per W3C SCXML RFC 793 §3.13. Transitions ordered fail-first
  (handshake → query validity → retransmit-count thresholds → rto
  growth) so the most-proximal cause short-circuits to its specific
  verdict before falling through to pass. Mirrors _04's evaluate
  pattern exactly, adjusted for SYN-side RTO baselines.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes the UT RPC
  request unreachable; queryTcpInfoSync returns valid=false on every
  poll in the SYN-SENT probe loop, ut_handshake_completed stays
  false, and the SCXML's first cond verdicts as
  `fail:dut_handshake_did_not_complete`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_05"
       datamodel="null"
       initial="evaluate_kernel_observations">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="evaluate_kernel_observations">
    <onentry>
      <send event="evaluate" delay="0ms"/>
    </onentry>
    <transition event="evaluate"
                cond="cpp:not captured.ut_handshake_completed"
                target="fail_handshake_did_not_complete"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p1_valid"
                target="fail_phase1_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p2_valid"
                target="fail_phase2_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p3_valid"
                target="fail_phase3_query_failed"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_retransmits &lt; 1"
                target="fail_no_syn_retx_1"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p2_retransmits &lt; 2"
                target="fail_no_syn_retx_2"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p3_retransmits &lt; 3"
                target="fail_no_syn_retx_3"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_rto_us &lt; 1500000"
                target="fail_initial_rto_not_doubled"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p2_rto_us &lt;= captured.ut_tcpi_p1_rto_us"
                target="fail_retx2_not_doubled"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p3_rto_us &lt;= captured.ut_tcpi_p2_rto_us"
                target="fail_retx3_not_doubled"/>
    <transition event="evaluate" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_handshake_did_not_complete">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_handshake_did_not_complete"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_query_failed">
    <donedata>
      <content>{"verdict":"fail","reason":"phase1_tcp_info_query_failed"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_query_failed">
    <donedata>
      <content>{"verdict":"fail","reason":"phase2_tcp_info_query_failed"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_query_failed">
    <donedata>
      <content>{"verdict":"fail","reason":"phase3_tcp_info_query_failed"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_1"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_2"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_3">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_3"}</content>
    </donedata>
  </final>

  <final id="fail_initial_rto_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase1_rto_below_doubled_baseline"}</content>
    </donedata>
  </final>

  <final id="fail_retx2_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase2_rto_not_greater_than_phase1"}</content>
    </donedata>
  </final>

  <final id="fail_retx3_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase3_rto_not_greater_than_phase2"}</content>
    </donedata>
  </final>
</scxml>
