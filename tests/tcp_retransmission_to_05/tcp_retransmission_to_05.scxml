<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.11 TCP_RETRANSMISSION_TO_05: TCP MUST include "exponential
  backoff" (check that it increases) for successive RTO values for
  sending SYN segments (RFC 1122 §4.2.3.1 MUST — RFC 6298 §5).

  v3.0 Test Procedure (p370):
    1. TESTER: Cause the application on the DUT-side to issue an
               active OPEN call.
    2. DUT:    Send a SYN.
    3. TESTER: Do not send SYN, ACK.
    4. DUT:    Retransmit the SYN segment after a timeout.
    5. TESTER: Do not send SYN,ACK and verify that RTO retransmission
               interval is increasing at a fast (at least more than
               linear) rate.

  Mechanism (active-OPEN with no listener + tester-RST suppression +
  observe 3 SYN retransmits with strictly increasing inter-frame
  deltas):
    1-2. Same as TCP_RETRANSMISSION_TO_06: UT OpOpenTcpSocket(Active)
         + `TesterAutoRstDrop` shared_ptr held across the full SCXML
         phase budget (~16 s; covers the 1 s + 2 s + 4 s = 7 s
         exponential sequence plus margin).
    3.   Linux's `tcp_retransmit_skb` doubles `icsk_rto` on every
         retransmit while in SYN-SENT (RFC 6298 §5 step 5.5: "Set
         RTO <- RTO * 2"), producing the 1 s / 2 s / 4 s sequence
         that the SCXML chain matches against per-state
         `frame_delta_us()` windows.

  Strict timing assertion ("more than linear"):
    The retx1 guard anchors the initial RTO to RFC 6298 §2.1
    (`frame_delta_us > 800 ms and < 1500 ms`). With initial RTO
    pinned at ~1 s, a *linear* DUT (constant interval ≤ 1.5 s) fails
    the retx2 strict lower bound `frame_delta_us > 1500 ms` because
    its second-leg interval cannot exceed the first-leg interval.
    The retx3 lower bound `frame_delta_us > 3500 ms` rejects any
    constant-2-s linear case once retx2 passes. Linux's exponential
    sequence comfortably clears every gate.

  Four-state SCXML chain:
    * listening_first_syn  — observe DUT's active-OPEN SYN.
                             Deadline 5 s covers UT boot wait + RPC
                             dispatch jitter.
    * listening_syn_retx_1 — observe SYN retx 1 within Linux's first
                             RTO (~1 s) and verify the delta lies in
                             RFC 6298's initial-RTO window.
                             Deadline 2.5 s.
    * listening_syn_retx_2 — observe SYN retx 2 with delta > 1.5 s
                             (rejects 1 s linear). Deadline 3.5 s.
    * listening_syn_retx_3 — observe SYN retx 3 with delta > 3.5 s
                             (rejects 2 s linear). Deadline 5.5 s.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  `is_dut_syn(...)` 's src_ip conjunct unreachable; case lands on
  fail_no_first_syn via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_05"
       datamodel="null"
       initial="listening_first_syn">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_first_syn">
    <onentry>
      <send event="deadline_first_syn" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset)"
                target="listening_syn_retx_1"/>
    <transition event="deadline_first_syn" target="fail_no_first_syn"/>
  </state>

  <state id="listening_syn_retx_1">
    <onentry>
      <send event="deadline_syn_retx_1" delay="2500ms"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset) and captured.frame_delta_us() &gt; 800000 and captured.frame_delta_us() &lt; 1500000"
                target="listening_syn_retx_2"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset) and (captured.frame_delta_us() &lt;= 800000 or captured.frame_delta_us() &gt;= 1500000)"
                target="fail_initial_rto_out_of_window"/>
    <transition event="deadline_syn_retx_1" target="fail_no_syn_retx_1"/>
  </state>

  <state id="listening_syn_retx_2">
    <onentry>
      <send event="deadline_syn_retx_2" delay="3500ms"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset) and captured.frame_delta_us() &gt; 1500000"
                target="listening_syn_retx_3"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset) and captured.frame_delta_us() &lt;= 1500000"
                target="fail_retx2_not_doubled"/>
    <transition event="deadline_syn_retx_2" target="fail_no_syn_retx_2"/>
  </state>

  <state id="listening_syn_retx_3">
    <onentry>
      <send event="deadline_syn_retx_3" delay="5500ms"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset) and captured.frame_delta_us() &gt; 3500000"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_syn(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo05LocalOffset) and captured.frame_delta_us() &lt;= 3500000"
                target="fail_retx3_not_doubled"/>
    <transition event="deadline_syn_retx_3" target="fail_no_syn_retx_3"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_first_syn">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_first_syn"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_1"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_2"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_3">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_3"}</content>
    </donedata>
  </final>

  <final id="fail_initial_rto_out_of_window">
    <donedata>
      <content>{"verdict":"fail","reason":"syn_retx1_rto_out_of_rfc6298_initial_window"}</content>
    </donedata>
  </final>

  <final id="fail_retx2_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"syn_retx2_delta_not_greater_than_initial_rto"}</content>
    </donedata>
  </final>

  <final id="fail_retx3_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"syn_retx3_delta_not_greater_than_retx2_lower_bound"}</content>
    </donedata>
  </final>
</scxml>
