<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.11 TCP_RETRANSMISSION_TO_05: TCP MUST include "exponential
  backoff" for successive RTO values for sending SYN segments (RFC 1122
  §4.2.3.1 MUST, RFC 6298 §5). The specification passes a DUT whose SYN
  retransmission interval grows faster than linearly: the data-segment
  property of TCP_RETRANSMISSION_TO_04, measured on the handshake.

  Case shape:
    the tester drives a DUT-side active open to a port it serves nothing
    on and suppresses its own kernel's RST, so the DUT stays in SYN-SENT
    and retransmits its SYN on its own timer three times. On the Linux
    reference DUT the netns sets `tcp_syn_linear_timeouts=0`, which turns
    off Linux's linear first SYN retries; with them on, this case fails
    that DUT, which is what the property says.

  What is graded, and why it is the RTO and not the wire interval:
    the RTO sequence the DUT reports after each retransmission must be
    increasing and convex, (rto3 - rto2) > (rto2 - rto1)
    (TcpRetransmissionSeriesCaptured::rto_growth_more_than_linear): a
    linear backoff grows on every step and does not grow its steps. The
    RTO values are the DUT's own, free of the jitter of its timer tick
    that a wire interval carries.

  What the wire decides:
    that the SYN and each retransmission were sent, and when. Each
    retransmission is waited for as long as the DUT's RTO says it will
    take (tcp_retransmission_timing.h), not for windows tuned to one
    sender: fixed 2/4/8 s windows and a 20 s RST suppression used to end
    a sender with a 3 s initial RTO early, its third retry due at 21 s.
    The first RTO is no longer held to Linux's doubled 1 s (`>= 1.5 s`).

  Verdict order (first matching transition wins, W3C SCXML §3.13):
    - the DUT's SYN was not seen                    -> inconclusive
    - a retransmission window elapsed unseen while the DUT counts more
      retransmissions than the wire showed          -> inconclusive (capture)
    - a retransmission window elapsed unseen and the DUT's counter could
      not be read                                   -> error
    - fewer retransmissions than three, by the DUT's own count
                                                    -> fail_no_syn_retx_<k>
    - an RTO after a retransmission seen on the wire could not be read
                                                    -> error_phase<k>
    - rto2 <= rto1, rto3 <= rto2                    -> fail (not increasing)
    - (rto3 - rto2) <= (rto2 - rto1)                -> fail (not more than linear)
    - otherwise                                     -> pass

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes the active OPEN fail;
  the stimulus returns before setting `ut_handshake_completed`, and the
  first cond fires.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_05"
       sce:transition-table="emit"
       datamodel="null"
       initial="evaluate_retransmissions">

  <sce:context id="captured"
               cpp:type="tc8::TcpRetransmissionSeriesCaptured"
               cpp:include="sce_integration/tcp_case_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="evaluate_retransmissions">
    <onentry>
      <send event="evaluate" delay="0ms"/>
    </onentry>
    <transition event="evaluate"
                cond="cpp:not captured.ut_handshake_completed"
                target="inconclusive_handshake_did_not_complete"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 3 and captured.retransmission_missed_by_capture()"
                target="inconclusive_retransmission_not_captured"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 3 and not captured.missed_query_valid"
                target="error_retransmission_count_query_failed"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 1"
                target="fail_no_syn_retx_1"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 2"
                target="fail_no_syn_retx_2"/>
    <transition event="evaluate"
                cond="cpp:captured.retransmissions_seen &lt; 3"
                target="fail_no_syn_retx_3"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p1_valid"
                target="error_phase1_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p2_valid"
                target="error_phase2_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p3_valid"
                target="error_phase3_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.rto_increasing_2()"
                target="fail_retx2_not_doubled"/>
    <transition event="evaluate"
                cond="cpp:not captured.rto_increasing_3()"
                target="fail_retx3_not_doubled"/>
    <transition event="evaluate"
                cond="cpp:not captured.rto_growth_more_than_linear()"
                target="fail_rto_growth_not_more_than_linear"/>
    <transition event="evaluate" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_handshake_did_not_complete">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_handshake_did_not_complete","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_retransmission_not_captured">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_counted_a_retransmission_the_capture_did_not_show","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="error_retransmission_count_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"retransmission_count_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="error_phase1_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"phase1_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="error_phase2_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"phase2_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="error_phase3_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"phase3_tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_1","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_2","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_no_syn_retx_3">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_retransmit_3","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_retx2_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase2_rto_not_greater_than_phase1","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_retx3_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase3_rto_not_greater_than_phase2","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_rto_growth_not_more_than_linear">
    <donedata>
      <content>{"verdict":"fail","reason":"rto_growth_not_more_than_linear","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
