<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_02: on DHCPACK timeout the
  client moves to REBINDING state and sends DHCPREQUEST via IP
  broadcast (RFC 2131 §4.4.5).

  Case shape:
    the DUT is brought to BOUND and then left without an answer until
    just short of T2. By then renewal to the named server has failed,
    so the REQUEST the DUT sends has to go to the broadcast address
    rather than the unicast one — the client is looking for any server
    that will have it.

  Wire shape identical to §4.7.6.8 REQUEST_12 (REBINDING dst=broadcast).
  Two case IDs share one observation pattern; the §4.7.6.8 chapter ties
  the requirement to T2 expiration ("on DHCPACK timeout"), §4.7.6.8
  REQUEST_12 ties it to the broader RFC 2131 §4.3.2 message-construction
  rule. Spec body verifies the same wire dst — pass guard reuses
  `dst_ip_is_broadcast()`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_02"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_request_field.sce-template.xml"
           pass_expr="captured.dst_ip_is_broadcast()"
           fail_state="fail_rebinding_request_dst_not_broadcast"
           fail_reason="dut_rebinding_request_dst_not_broadcast"
           fail_role="observed_violation"/>
</scxml>
