<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_11: DHCPREQUEST generated during
  REBINDING state — 'ciaddr' MUST be filled in with client's IP
  address (RFC 2131 §4.4.5).

  Case shape:
    the tester walks the DUT to BOUND and then, by answering nothing,
    on to REBINDING at T2. The REQUEST it sends from there has to carry
    its current address in 'ciaddr' — the field a client already
    holding an address uses to name it.

  Same invariant as REQUEST_08 but observed on the REBINDING REQUEST.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_11"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_request_field.sce-template.xml"
           pass_expr="captured.ciaddr_equals(expected.offered_ip_be)"
           fail_state="fail_rebinding_request_ciaddr_mismatch"
           fail_reason="dut_rebinding_request_ciaddr_mismatch"
           fail_role="observed_violation"/>
</scxml>
