<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_059: ResetInterface_wrong_Fire_and_forget_
  package_get_No_Error_back.

  Tester sends `resetInterface` (METHOD-ID-FIRE-FORGET-SI-1 = 0x0001)
  as Fire&Forget (msg_type 0x01) with interface_version = 0xFF — a
  mismatch against the DUT's declared 0x01. Per PRS_SOMEIP_00701 /
  00170 / 00171 / 00189 a Fire&Forget Request that fails header
  validation must not produce ANY response (no method response, no
  error message); the Forget half is load-bearing because the
  tester would not expect a reply for a no-return Request even on
  success. Pass Criteria from spec p587: "DUT: doesn't answer and
  does not send an error message".

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Any SOME/IP frame on method 0x0001
            (msg_type 0x80 method response or 0x81 error response)
            within the listen window -> fail. Phase 2 deadline -> pass.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_059"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0001 and (captured.message_type == 0x80 or captured.message_type == 0x81)"
                target="fail_phase2_dut_responded_to_fire_forget"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_responded_to_fire_forget">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_response_to_wrong_interface_version_fire_forget"}</content>
    </donedata>
  </final>
</scxml>
