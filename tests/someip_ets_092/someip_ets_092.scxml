<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_092: SD_Check_Reaction_to_a_Subscribe_with_ttl_0.

  Tester sends a unicast SubscribeEventgroup with ttl = 0 — i.e. a
  StopSubscribeEventgroup per SD §4.2 (PRS_SOMEIPSD_00386). The DUT
  shall NOT respond (no Ack, no Nack). The phase 2 verdict therefore
  PASSES on absence: any Type 0x07 entry on the subscribed eg
  trips the fail terminal; the deadline is the success path.

  Note: the tester must have established no prior subscription on
  the same eg, otherwise the ttl=0 message would be interpreted by
  the DUT as a tear-down of the existing subscription (still no
  Ack/Nack response on the wire — but a different code path on the
  DUT). This case uses eg 0x0002 with no prior Subscribe; the wire
  outcome is the same either way.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1
            with sd_ipv4_endpoint_count >= 1.
    Phase 2 (listening_phase2): Type 0x07 Subscribe Ack/Nack on eg 0x02
            within the deadline -> fail. Deadline expiry -> pass.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_092"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_ipv4_endpoint_count >= 1"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer_with_endpoint"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == 0x0002"
                target="fail_phase2_dut_responded_to_ttl_zero"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer_with_endpoint">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_with_ipv4_endpoint_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_responded_to_ttl_zero">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_subscribe_response_for_ttl_zero_request"}</content>
    </donedata>
  </final>
</scxml>
