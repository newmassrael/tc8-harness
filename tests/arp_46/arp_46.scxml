<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_46: ARP Response Hardware Type shall equal
  ARP_HARDWARE_ETHERNET (1) per RFC 826. A tester ARP Request provokes the
  DUT Reply (opcode 2). Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_46"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 2 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.hw_type == 1"
           fail_state="fail_hw_type_not_eth"
           fail_reason="reply_hw_type_not_ethernet"
           fail_role="observed_violation"
           inconclusive_reason="no_arp_reply_within_listen_window"/>
</scxml>
