<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.7 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_03 negative — closes
  the self-reference trap on the positive _03 case (the pre-binding
  DHCPDISCOVER source IP MUST be 0, RFC 2131 §4.1). The positive's
  fail_source_ip_not_zero branch is unreachable against a conformant
  tc8-dut.

  Fault injection is a real firmware mutant: the
  kDhcpFlavorDiscoverSrcNonzero flavor sources the DISCOVER from
  192.0.2.2. A conformant client (flavor None) uses src=0, so
  fail_compliant is the live conformant-DUT outcome.

  Reuses the dhcpv4_discover_field template with pass_expr inverted
  (pass = non-zero source observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_03_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="!captured.source_ip_is_zero()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_discover_source_ip_zero_despite_src_nonzero_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
