<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.18 SOMEIPSRV_FORMAT_18: Minor Version field of the Type 1
  entry shall carry the configured SERVICE-ID-1-MINOR-VER. Injected at
  runtime via CLI option expect minor_version=<n> into
  expected.minor_version; smoke-test.sh supplies the tc8-dut
  default (0x00000000; the vsomeip default).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_18"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].minor_version == expected.minor_version"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].minor_version != expected.minor_version"
                target="fail_minor_version"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_minor_version">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_minor_version_mismatch"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_notification_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
