<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_09: TCP in FIN-WAIT-1 state MUST
  return an empty acknowledgment with proper SEQ and ACK numbers
  after receiving a segment with out-of-window SEQ or unacceptable
  ACK, and remain in FIN-WAIT-1. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  v3.0 Test Procedure (p301-p320.txt:565), two iterations:
    * CASE 1: data segment with out-of-window SEQ.
    * CASE 2: data segment with unacceptable ACK number.

  Observable protocol interaction per phase: active-OPEN handshake
  → ESTABLISHED → the tester suppresses its kernel's pure ACKs to
  the DUT → the DUT issues a CLOSE, driving it into FIN-WAIT-1 (the
  tester kernel auto-ACK to the DUT FIN is suppressed, preventing
  collapse to FIN-WAIT-2) → snapshot tester SEQ/ACK → inject corrupt
  segment per CASE:
    * CASE 1 (OTW SEQ): seq_num = snd_nxt + kOutOfWindowSeqOffset,
                        ack_num = rcv_nxt - 1 (acceptable ACK that
                        does NOT acknowledge DUT FIN; preserves
                        FIN-WAIT-1).
    * CASE 2 (unacceptable ACK): seq_num = snd_nxt (in-window),
                        ack_num = rcv_nxt + kUnacceptableAckOffset
                        (far past DUT snd_nxt → unacceptable per
                        RFC 793 §3.9 p70).
  → DUT empty ACK on data path.

  Three DUT-origin observations per phase reach the SCXML on
  tcp_observed:
    1. handshake third-leg ACK (pure ACK, ack = ISN_t + 1)
    2. close-elicited DUT FIN+ACK (FIN flag set; the DUT CLOSE drove
       it into FIN-WAIT-1)
    3. data-elicited empty ACK to corrupt segment (the spec-
       asserted edge)

  Per-phase port quads identical to UNACCEPTABLE_14 (49500/23456
  vs 49501/23457) — same active-OPEN scaffold; the only stimulus
  delta is a DUT CLOSE replacing a tester write-side half-close plus
  suppression of the tester's pure ACKs across the phase.

  Per-state fail terminals split between the three sub-edges so
  smoke-test triage identifies which edge the DUT failed to emit.
  Negative smoke flips ipv4.dut_iface_ip → first state's
  src_ip-conjunct unreachable → inconclusive_p1_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_09"
       datamodel="null"
       initial="listening_p1_handshake">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake">
    <onentry>
      <send event="deadline_p1_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable09Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable09Phase1LocalOffset)"
                target="listening_p1_dut_fin"/>
    <transition event="deadline_p1_handshake" target="inconclusive_p1_no_handshake_ack"/>
  </state>

  <state id="listening_p1_dut_fin">
    <onentry>
      <send event="deadline_p1_dut_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable09Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable09Phase1LocalOffset)"
                target="listening_p1_data_ack"/>
    <transition event="deadline_p1_dut_fin" target="inconclusive_p1_no_dut_fin"/>
  </state>

  <state id="listening_p1_data_ack">
    <onentry>
      <send event="deadline_p1_data_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable09Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable09Phase1LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="listening_p2_handshake"/>
    <transition event="deadline_p1_data_ack" target="inconclusive_p1_no_data_ack"/>
  </state>

  <state id="listening_p2_handshake">
    <onentry>
      <send event="deadline_p2_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable09Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable09Phase2LocalOffset)"
                target="listening_p2_dut_fin"/>
    <transition event="deadline_p2_handshake" target="inconclusive_p2_no_handshake_ack"/>
  </state>

  <state id="listening_p2_dut_fin">
    <onentry>
      <send event="deadline_p2_dut_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable09Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable09Phase2LocalOffset)"
                target="listening_p2_data_ack"/>
    <transition event="deadline_p2_dut_fin" target="inconclusive_p2_no_dut_fin"/>
  </state>

  <state id="listening_p2_data_ack">
    <onentry>
      <send event="deadline_p2_data_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable09Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable09Phase2LocalOffset) and captured.ack_num == captured.expected_ack_num_phase2"
                target="pass"/>
    <transition event="deadline_p2_data_ack" target="inconclusive_p2_no_data_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_p1_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase1","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_p1_no_dut_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_fin_phase1","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_p1_no_data_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_finwait1","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_p2_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase2","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_p2_no_dut_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_fin_phase2","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_p2_no_data_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_unacceptable_ack_finwait1","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
