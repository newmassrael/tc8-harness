<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.1 DHCPv4_CLIENT_SUMMARY_04 negative — closes the
  self-reference trap on the positive _04 case (the reserved bits of the
  'flags' field MUST be zero, RFC 2131 §2). The positive's
  fail_reserved_flags_nonzero branch is unreachable against a conformant
  tc8-dut, which zeros 'flags' by construction.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorDiscoverReservedFlagsSet flavor, which makes
  tc8-dut's emitDhcpMessage set reserved bit 1 of the 'flags' field
  (bit 0 is the BROADCAST flag; bits 1..15 are reserved-and-zero). A
  conformant DUT (flavor None) emits zero reserved bits, so this negative
  distinguishes a buggy client from a conformant one.

  Pass = the non-zero reserved bit IS observed. fail_compliant = the
  client emitted zero reserved bits despite the flavor — the live
  conformant-DUT outcome and a flavor-wiring regression catch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_summary_04_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.flags_reserved_bits_zero()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.flags_reserved_bits_zero()"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_reserved_flags_zero_despite_reserved_flag_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
