<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.1 DHCPv4_CLIENT_SUMMARY_04 negative — closes the
  self-reference trap on the positive _04 case (the reserved bits of the
  'flags' field MUST be zero, RFC 2131 §2). The positive's
  fail_reserved_flags_nonzero branch is unreachable against a conformant
  tc8-dut, which zeros 'flags'.

  Fault injection is a real firmware mutant: the
  kDhcpFlavorDiscoverReservedFlagsSet flavor sets reserved bit 1 of the
  DISCOVER's 'flags'. A conformant client (flavor None) emits zero
  reserved bits, so fail_compliant is the live conformant-DUT outcome.

  Reuses the dhcpv4_discover_field template with pass_expr inverted
  (pass = non-zero reserved bit observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_summary_04_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="!captured.flags_reserved_bits_zero()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_discover_reserved_flags_zero_despite_reserved_flag_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
