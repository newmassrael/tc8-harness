<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_12: DHCPREQUEST generated during
  REBINDING state — destination IP MUST be 0xFFFFFFFF (broadcast)
  per RFC 2131 §4.4.5.

  Case shape:
    the tester walks the DUT to BOUND and on to REBINDING at T2. The
    REQUEST it sends from there has to go to the broadcast address —
    renewal with the original server has failed, so the client asks
    whoever is listening.

  RFC 2131 §4.4.5: REBINDING REQUEST is broadcast (the client has lost
  contact with its server and is reaching for any server willing to
  extend the lease). Distinct from RENEWING REQUEST (unicast to the
  server's IP — covered by REQUEST_06/_07/_08).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_12"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_request_field.sce-template.xml"
           pass_expr="captured.dst_ip_is_broadcast()"
           fail_state="fail_rebinding_request_dst_not_broadcast"
           fail_reason="dut_rebinding_request_dst_not_broadcast"
           fail_role="observed_violation"/>
</scxml>
