<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.2 DHCPV4_CLIENT_PROTOCOL_01: First four octets of the
  'options' field of the DHCP message contain the magic cookie
  99, 130, 83, 99 (RFC 1497 / RFC 2131 §3).

  Spec Test Procedure (tc8_p221-p240.txt: PROTOCOL_01):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER listens (no server reply — this case observes only the
         DUT-emitted DISCOVER).
    4.   DUT: Sends DHCPDISCOVER Message
    5.   TESTER: Verify received DISCOVER's first four options bytes
         equal <DHCP-MAGIC-COOKIE> = 0x63 0x82 0x53 0x63.

  tc8-dut emits one DHCPDISCOVER on receipt of OpStartLLAutoconf
  (`LinklocalAutoconf::emitDhcpDiscover`); the magic cookie is hard-
  coded at BOOTP body offsets 236..239 by construction. After the
  DISCOVER, tc8-dut sleeps `dhcp_timeout_ms` and falls back to LL
  probing — the LL phase emits ARP traffic that the BPF
  `udp port 67/68` filter excludes, so this SCXML never sees a
  follow-up DHCP frame.

  Pass criterion: the FIRST observed DUT-emitted DISCOVER's
  `magic_cookie_valid` predicate is true. Fail on a DISCOVER where
  the cookie is absent / mangled, or on absence-within-window.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_protocol_01"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.op == 1
                      and captured.message_type == 1
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.magic_cookie_valid"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.op == 1
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.magic_cookie_valid"
                target="fail_magic_cookie_invalid"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_magic_cookie_invalid">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_missing_magic_cookie"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_discover_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
