<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.1 SOMEIPSRV_FORMAT_01: Client ID shall be set statically to 0x0000.

  The harness updates `captured` with the parsed SOME/IP header before raising
  `someip_notification`; the transition guards inspect Client ID to produce a
  pass or fail verdict. `deadline_exceeded` covers the case where the DUT
  never sends a notification within the listen window.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_01"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.client_id == 0x0000"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.client_id != 0x0000"
                target="fail_client_id"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_client_id">
    <donedata>
      <content>{"verdict":"fail","reason":"client_id_nonzero","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_notification_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
