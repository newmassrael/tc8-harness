<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_037:
  echoUINT8RELIABLE_client_closes_TCP_connection_automatically.

  Tester opens a TCP connection to the DUT's reliable endpoint
  (port 30501), drives one echoUINT8RELIABLE round-trip to confirm
  the connection is live, then sends a `resetInterface` fire&forget
  Method Request over UDP. Per PRS_SOMEIP_00708/00711 the DUT must
  NOT tear down the established TCP reliable connection in response
  to a service stop — closing the connection is the client's
  responsibility.

    Phase 1: OfferService observation (DUT is up).
    Phase 2: Method Response on echoUINT8RELIABLE (method_id 0x000A,
             TCP transport) — confirms the reliable connection is
             established and the DUT-side endpoint is dispatching.
    Phase 3: Short deadline (200 ms). The trait's stimulus already
             ran the 5 s post-reset observation window AND populated
             `captured.tcp_peer_state` with the tester-side
             `getsockopt(TCP_INFO).tcpi_state` value before SCXML
             started, so by the time this phase enters all the
             pcap-buffered events have been replayed and the verdict
             slot is set. `tcpi_state == 1` (TCP_ESTABLISHED) means
             the DUT did not emit FIN — pass. Anything else
             (TCP_CLOSE_WAIT = 8 is the failure shape) → fail.

  No "ignore = pass" relaxation: the spec's invariant is precisely
  "DUT does not send FIN", so any TCP state other than ESTABLISHED
  signals a violation.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_037"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x000A and captured.return_code == 0x00 and captured.payload_len == 1 and captured.payload_byte0 == 0x42 and captured.src_port == expected.tcp_port"
                target="listening_phase3"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_response"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="200ms"/>
    </onentry>
    <transition event="phase3_deadline_exceeded"
                cond="cpp:captured.tcp_peer_state == 1"
                target="pass"/>
    <transition event="phase3_deadline_exceeded"
                target="fail_phase3_dut_emitted_fin"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_method_response_on_reliable_endpoint_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_dut_emitted_fin">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_tore_down_tcp_reliable_connection_on_reset_interface"}</content>
    </donedata>
  </final>
</scxml>
