<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_03: DHCPREQUEST MUST include
  Option 54 (Server Identifier) with value = the OFFER's server-id
  (RFC 2131 §3.1, §4.3.2).

  Case shape:
    the DUT discovers and <SERVER-1> offers. The REQUEST that follows
    has to carry Option 54 naming that server — with several servers
    possibly offering, the client must say whose offer it is taking.

  RFC 2131 §3.1: in REQUESTING state the REQUEST broadcast MUST carry
  the chosen server's identifier (Option 54). The OFFER's server-id is
  the dev-netns server emul default (`kDefaultServerIdBe`,
  172.16.0.10), surfaced via `expected.server_id_be` so the SCXML stays
  decoupled from the IP plan.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_03"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.option_be32_equals(54, expected.server_id_be)"
           fail_state="fail_request_server_id_mismatch"
           fail_reason="dut_dhcp_request_server_id_mismatch_offer"
           fail_role="observed_violation"/>
</scxml>
