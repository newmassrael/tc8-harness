<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_10:
    After the conflict-free Probe window, the DUT broadcasts a gratuitous
    ARP Reply (Announce) carrying sender_hw = DUT MAC and sender_ip =
    committed yiaddr (RFC 2131 §4.4.1 SHOULD). Pass Criteria step 7 verifies
    the Announce fields; a present-but-malformed Announce is a fail (not the
    deadline's inconclusive).

  Reuses dhcpv4_init_alloc_arp_announce with the conformant predicate; the
  _10_neg sibling binds its negation against the AnnounceSenderIpWrong
  firmware mutant. Same firmware path as _08 (arp_probe_listen_ms=1500) but
  with no conflict injection — the listener times out and the DUT announces.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_10"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_init_alloc_arp_announce.sce-template.xml"
           pass_expr="captured.arp.is_dhcp_arp_announce(expected.dhcpv4.offered_ip_be)"
           fail_state="fail_arp_announce_shape_mismatch"
           fail_reason="dut_arp_announce_field_mismatch"
           fail_role="observed_violation"/>
</scxml>
