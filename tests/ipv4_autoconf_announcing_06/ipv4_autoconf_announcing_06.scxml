<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_06: Announcing claimed
  address (interval and packet count). Time interval between Announce
  1 and Announce 2 is in [ANNOUNCE_INTERVAL - 50 ms, ANNOUNCE_INTERVAL
  + 50 ms] (RFC 3927 §2.4 MUST).

  Spec Test Procedure (tc8_p161-p180.txt:745..808):
    6. DUT: Sends 3 ARP Request Messages (Probes)
    8. TESTER: Wait <ANNOUNCE_WAIT - 0.05>
    10. DUT: Sends 2 ARP Request Messages (Announces)
    11-12. Verify (ANNOUNCE_INTERVAL - 50 ms) <= Δ(Announce2 - Announce1)
                                              <= (ANNOUNCE_INTERVAL + 50 ms)

  Cadence-bearing case: stimulus uses RFC 3927 defaults
  (`emitStartLLAutoconfRfcDefaults`) so ANNOUNCE_INTERVAL = 2000 ms.
  The same `dispatchArpFrame` snapshot pattern as ADDRESS_SELECTION_10
  applies — `prev_observed_ts_us` advances only when the SM changes
  state, so seen_announce_1 → pass measures Announce2.ts -
  Announce1.ts directly.

  Bounds in microseconds:
    ANNOUNCE_INTERVAL_US - 50000 = 1950000
    ANNOUNCE_INTERVAL_US + 50000 = 2050000

  Wall budget at RFC defaults:
    1.5 s initial + 200 ms dhcp + 1 s PROBE_WAIT + ~3 s 3 Probes
    + 2 s ANNOUNCE_WAIT + 2 s ANNOUNCE_INTERVAL = ~9.7 s before Announce 2.
  12 s deadline gives ~2 s margin.

  Notes Derived from RFC 3927 p13 section 2.4 (MUST). 50 ms tolerance
  per spec note.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_06"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="12s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0"
                target="seen_announce_1"/>
    <transition event="deadline_exceeded" target="fail_no_announces"/>
  </state>

  <state id="seen_announce_1">
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0 and captured.frame_delta_us() &gt;= 1950000 and captured.frame_delta_us() &lt;= 2050000"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0"
                target="fail_interval_out_of_range"/>
    <transition event="deadline_exceeded" target="fail_only_one_announce"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_announces">
    <donedata>
      <content>{"verdict":"fail","reason":"no_arp_announce_after_probes"}</content>
    </donedata>
  </final>

  <final id="fail_only_one_announce">
    <donedata>
      <content>{"verdict":"fail","reason":"fewer_than_2_arp_announces_within_deadline"}</content>
    </donedata>
  </final>

  <final id="fail_interval_out_of_range">
    <donedata>
      <content>{"verdict":"fail","reason":"announce_interval_outside_rfc3927_bounds_with_50ms_tolerance"}</content>
    </donedata>
  </final>
</scxml>
