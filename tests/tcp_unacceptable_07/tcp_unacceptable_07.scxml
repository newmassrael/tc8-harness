<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_07: TCP in LISTEN state MUST send a
  RST after receiving a spurious SYN,ACK. Derived from RFC 793 §3.4
  p35 Establishing a Connection (MUST).

  Case shape:
    a passive open parks the DUT in LISTEN, the tester injects one
    SYN,ACK, and the DUT's RST is the observable — nothing in LISTEN
    ever sent a SYN for that ACK to answer.

  Mechanism: a passive-listener DUT receives a SYN,ACK that
  potentially corresponds to an old SYN it never sent. RFC 793 §3.4
  p35 specifies that LISTEN-state TCP responds with RST. The DUT
  takes the LISTEN-arrival path for any segment carrying ACK without
  prior SYN-RCVD context, emitting RST with SEQ derived from the
  incoming ACK number (RFC 793 §3.4 p35).

  Pass guard: single-state listen window observing a DUT-origin RST
  on the (12345, 49152) port quad. The mismatched-tester-port
  exclusion is implicit — only frames from the DUT to the tester's
  injected source port match.

  The procedure states no listen time, so the general input parameter
  <ParamListenTime> bounds the wait for the RST. A window that elapses
  without it is the DUT's silence where it must answer:
  observed_quiescence, judged against that bound (H3), over
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults). Whether a silence stands as a fail is the CLI's call on
  the run's hypotheses.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_07"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsListenPort and captured.dst_port == ::tc8::sce::tcp::kBasicsTesterPort and (captured.flags &amp; 0x04) != 0"
                target="pass"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_rst_to_listen_synack","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
