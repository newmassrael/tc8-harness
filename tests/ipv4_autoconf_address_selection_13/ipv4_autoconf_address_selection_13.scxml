<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_13: probing-window
  conflict via ARP Probe (RFC 3927 §2.2.1, MUST). Hits clause (b)
  of the conflict predicate: "any ARP Probe where the packet's
  target IP address is the address being probed for, and the
  packet's sender hardware address is not the hardware address of
  the interface the host is attempting to configure".

  Case shape:
    the DUT brings up its interface, fails to find a DHCP server and
    falls back to probing a link-local address. The tester notes the
    address it is probing for and then probes for the same one itself,
    from 0.0.0.0 — a competing claim mid-probe. The DUT has to give up
    that candidate and start probing for a different address.

  See `_11/ipv4_autoconf_address_selection_11.scxml` for the full
  trait/SCXML mechanism description; this shell binds
  ConflictArpVariant::Probe via the trait header.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_13"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_conflict_repick.sce-template.xml"/>
</scxml>
