<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.1 DHCPv4_CLIENT_SUMMARY_04: the reserved bits of the 'flags'
  field are reserved for future use and MUST be set to zero by clients
  (RFC 2131 §2). flags_reserved_bits_zero() masks off bit 0 (the BROADCAST
  flag) and asserts the rest are zero — the RFC-normative reading of the
  spec's literal "Bits 2 to 16". tc8-dut zeros 'flags' by construction, so
  this case passes and serves as the regression guard; SUMMARY_04_NEG
  drives the firmware mutant that flips a reserved bit.

  Reuses the dhcpv4_discover_field template (shared with the _neg sibling).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_summary_04"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="captured.flags_reserved_bits_zero()"
           fail_state="fail_reserved_flags_nonzero"
           fail_reason="dut_dhcp_discover_reserved_flags_nonzero"/>
</scxml>
