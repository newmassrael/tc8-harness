<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.1 DHCPV4_CLIENT_SUMMARY_04: The remaining bits of the
  'flags' field are reserved for future use and MUST be set to zero
  by clients (RFC 2131 §2 Protocol Summary).

  Spec Test Procedure (tc8_p231-p240.txt: SUMMARY_04):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER listens (no server reply).
    4.   DUT: Sends DHCPDISCOVER Message
    5.   TESTER: Verify received DISCOVER carries bits 2..16 of 'flags'
         field set to 0. (The spec literal "Bits 2 to 16" is a typo —
         RFC 2131 fixes the 'flags' field at 16 bits with bit 0 the
         BROADCAST flag and bits 1..15 reserved-and-zero. The
         `flags_reserved_bits_zero()` predicate matches the RFC-
         normative reading by masking off bit 0.)

  Same stimulus as PROTOCOL_01/02 (one DHCPDISCOVER emitted by tc8-dut
  on OpStartLLAutoconf). tc8-dut's emit zeros `secs` and `flags` by
  construction (`bp[8..11] = 0`), so this case always passes against
  the tc8-dut and serves as the regression guard for
  `flags_reserved_bits_zero` semantics — a future DUT that flips a
  reserved bit will fail loudly.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_summary_04"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.flags_reserved_bits_zero()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.flags_reserved_bits_zero()"
                target="fail_reserved_flags_nonzero"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_reserved_flags_nonzero">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_reserved_flags_nonzero"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_discover_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
