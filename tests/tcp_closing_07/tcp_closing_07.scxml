<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.8 TCP_CLOSING_07: TCP, in FIN-WAIT-1 state, MUST honour
  RECEIVE calls and ACK incoming data while remaining in FIN-WAIT-1
  until the peer ACKs the DUT's FIN. Derived from RFC 793 §3.5 p38
  Closing a Connection (MUST).

  v3.0 Test Procedure (p351):
    1. TESTER: Take DUT to ESTABLISHED state
    2. TESTER: Cause DUT side application to issue a CLOSE call
    3. DUT:    DUT sends a FIN and Reaches FIN-WAIT-1 State
    4. TESTER: Cause DUT side application to issue a RECEIVE call
    5. DUT:    Issue a RECEIVE call
    6. TESTER: Send some data to DUT
    7. DUT:    Send ACK of the received data
    8. TESTER: Check that DUT receives proper data
    9. TESTER: Check that DUT remains in FIN-WAIT-1 state

  Mechanism (active OPEN to ESTABLISHED → withheld peer FIN-ACK → DUT
  FIN with no peer-ACK → raw-injected non-acking data → DUT data ACK →
  RECEIVE drains bytes → byte-match → 3 s remain-in-FW1):
    * Prelude: drive the DUT through an active OPEN to ESTABLISHED on
      (kBasicsActiveLocalPort + 73, kBasicsActiveRemotePort + 73);
      accept the tester connection; snapshot tester snd_nxt / rcv_nxt.
    * The tester withholds its kernel's auto-ACK to the DUT's FIN,
      keeping the DUT in FW1 across the stimulus and SCXML observation
      phases.
    * DUT application CLOSE → DUT FIN+ACK egress; with the peer ACK
      withheld the DUT stays in FW1.
    * Raw inject PSH+ACK with seq=ISN_t+1 (in-window data),
      ack=ISN_d+1 (= SND.UNA, doesn't advance, doesn't ack FIN), and
      16-byte payload. DUT in FW1 processes the data and emits a pure
      ACK with seq=ISN_d+2 (post-FIN snd_nxt) and
      ack=ISN_t+1+16=ISN_t+17.
    * The DUT RECEIVE call drains the queued data; the received bytes
      are compared against the injected payload and
      captured.ut_received_payload_len is set to 16U on a match
      (sentinel 0xFFFFU otherwise). captured.expected_ack_num is set
      to ISN_t+17 so SCXML's listening_dut_data_ack can check the ACK
      number is the expected one.

  SCXML chain (4 listening states + 4 fail terminals + pass):
    handshake_ack → dut_fin → dut_data_ack → remain_in_fw1 → pass

  Pass criteria mapping:
    * #3 (DUT FIN)            = listening_dut_fin observation.
    * #5 (RECEIVE call issued)= implicit in the RECEIVE; if the DUT
                                 had not issued a RECEIVE its stack
                                 still ACKs but no bytes surface →
                                 ut_received_payload_len stays at the
                                 sentinel and the deadline transition
                                 lands on fail_no_proper_data.
    * #7 (ACK of received data) = listening_dut_data_ack pure-ACK
                                  with ack_num == expected_ack_num.
    * #8 (proper data)        = listening_remain_in_fw1's deadline
                                 transition conjuncts ut_received_
                                 payload_len == 16U.
    * #9 (remain in FW1)      = listening_remain_in_fw1 fail predicate
                                 fires only on DUT RST. FIN re-tx
                                 (Linux RTO ~200 ms cadence) is
                                 expected FW1 behaviour and tolerated.

  Negative IP-flip path: src_ip-conjunct on listening_handshake_ack
  unreachable, lands on fail_no_handshake_ack at the 5 s deadline +
  ~2 s prelude wall-time ≈ 8 s.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_closing_07"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 73U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 73U)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake_ack" target="fail_no_handshake_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry><send event="deadline_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 73U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 73U)"
                target="listening_dut_data_ack"/>
    <transition event="deadline_dut_fin" target="fail_no_dut_fin"/>
  </state>

  <state id="listening_dut_data_ack">
    <onentry><send event="deadline_dut_data_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 73U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 73U) and captured.ack_num == captured.expected_ack_num"
                target="listening_remain_in_fw1"/>
    <transition event="deadline_dut_data_ack" target="fail_no_dut_data_ack"/>
  </state>

  <state id="listening_remain_in_fw1">
    <onentry><send event="deadline_remain_in_fw1" delay="3s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 73U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 73U)"
                target="fail_dut_rst_in_fw1"/>
    <transition event="deadline_remain_in_fw1"
                cond="cpp:captured.ut_received_payload_len == 16U"
                target="pass"/>
    <transition event="deadline_remain_in_fw1" target="fail_no_proper_data"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="fail_no_handshake_ack">
    <donedata><content>{"verdict":"fail","reason":"no_dut_handshake_ack"}</content></donedata>
  </final>

  <final id="fail_no_dut_fin">
    <donedata><content>{"verdict":"fail","reason":"no_dut_close_fin"}</content></donedata>
  </final>

  <final id="fail_no_dut_data_ack">
    <donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_received_data_in_fw1"}</content></donedata>
  </final>

  <final id="fail_dut_rst_in_fw1">
    <donedata><content>{"verdict":"fail","reason":"dut_emitted_rst_in_fw1"}</content></donedata>
  </final>

  <final id="fail_no_proper_data">
    <donedata><content>{"verdict":"fail","reason":"dut_did_not_receive_proper_data_in_fw1"}</content></donedata>
  </final>
</scxml>
