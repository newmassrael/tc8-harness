<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_12 negative 2 — lwIP app-report-fault self-validation of the
  positive _12 receipt guard (its fail_no_receipt final; _neg proves the length guard).
  The trait arms kAppFaultReportNoReceipt, so the shared data listener loses the 65 507 B
  datagram the stack reassembled and delivered, and the GetReceivedUdp Confirmation answers
  received=0. Pass = the DUT reported NO receipt (ut_received == 0, the injected loss
  observed); fail_compliant = the DUT reported the receipt despite the flavor (fault inert
  — what a conformant DUT does). lwIP-only (kCapAppFault). Envelope: ipv4_udp_ut_presence.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_12_neg2"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_reported_receipt_despite_flavor"
           fail_reason_timeout="no_ut_confirmation_for_receipt_loss"
           fail_role="fault_injection_inert"/>
</scxml>
