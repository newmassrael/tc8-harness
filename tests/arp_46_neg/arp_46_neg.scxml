<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_46 negative — closes the self-reference trap on the
  positive _46 (the DUT's emitted ARP Reply must carry Hardware Type
  0x0001, Ethernet, RFC 826). The positive's fail_hw_type_not_eth branch
  is unreachable against a conformant DUT, so without a fault injection the
  guard is dead code.

  Fault injection is a real lwIP firmware mutant: emitArpFlavorArm arms the
  kArpFaultHwTypeWrong egress flavor over UT 0x18 (the SAME flavor the _08
  Request mutant uses — the htype field offset is identical and the case's
  provocation selects Request vs Reply), then a tester ARP Request
  provokes the DUT's Reply, whose Hardware Type the link-output hook
  rewrites (the Operation Code is left at 2, so the frame is still a
  Reply). A conformant DUT (flavor None — every positive case, and the
  kernel-backed reference DUT, which has no such seam) emits 0x0001, so
  this negative distinguishes a buggy emitter from a conformant one.
  lwIP-only: expected:false on Linux.

  Pass = the corrupted hw_type IS observed (hw_type != 1 on a DUT-sourced
  Reply). fail_compliant = the DUT emitted 1 despite the flavor, i.e. the
  fault was inert — a flavor-wiring regression catch, not a DUT violation
  (role fault_injection_inert).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_46_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 2 and captured.sender_hw == expected.dut_iface_mac and captured.hw_type != 1"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 2 and captured.sender_hw == expected.dut_iface_mac and captured.hw_type == 1"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_no_reply"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_arp_reply_hw_type_ethernet_despite_hw_type_wrong_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_reply">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_arp_reply_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
