<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.2 DHCPv4_CLIENT_PROTOCOL_03 negative — closes the
  self-reference trap on the positive _03 case (the SELECTING DHCPREQUEST
  MUST carry Option 53 DHCP Message Type, RFC 2131 §3). The positive's
  missing-Option-53 branch is unreachable against a conformant tc8-dut,
  which always emits Option 53.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorRequestOmitMessageType flavor, gated to the
  post-OFFER SELECTING REQUEST (the DISCOVER stays conformant so the OFFER
  still matches and the lifecycle reaches REQUEST). tc8-dut then replaces
  the REQUEST's Option 53 TLV with PAD bytes. Dropping Option 53 leaves
  message_type=0 (not 3), so the REQUEST cannot be identified via
  is_dhcp_request() (which requires message_type==3), so this case cannot
  reuse the dhcpv4_request_field template and identifies the REQUEST
  by op==1 + valid magic cookie + chaddr match + absent Option 53, mirroring
  PROTOCOL_02_NEG in the two-state REQUEST lifecycle. A conformant client
  (flavor None) emits Option 53, so this negative's fail_compliant branch is
  the live conformant-DUT outcome.

  Pass = the missing Option 53 IS observed on the REQUEST; fail_compliant =
  the client emitted Option 53 despite the flavor.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_protocol_03_neg"
       datamodel="null"
       initial="listening_for_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_discover">
    <onentry>
      <send event="deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_request"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_request">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.op == 1
                      and captured.magic_cookie_valid
                      and !captured.has_message_type_option()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_no_request"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_request_carried_message_type_option_despite_omit_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_request">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_request_after_offer","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
