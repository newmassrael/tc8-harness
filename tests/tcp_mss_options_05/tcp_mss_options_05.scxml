<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.9 TCP_MSS_OPTIONS_05: TCP MUST be prepared to handle an
  illegal option length for MSS, in a SYN+ACK segment, without crashing.
  Derived from RFC 1122 §4.2.2.5 p85 TCP Options "RFC-793 Section 3.1"
  (MUST).

  Case shape:
    a DUT-side active open emits SYN, and the tester answers SYN,ACK
    whose MSS option declares an illegal length, ilen. What is checked
    is survival: the DUT must still be running afterwards — the
    handshake-reply counterpart of MSS_OPTIONS_01.

  Iterations: ilen=0 (less than RFC 793 §3.1 MSS opsize=4) and ilen=5
  (more than), on distinct port quads.

  Per phase:
    - The tester suppresses its own automatic RST that would
      otherwise answer the DUT's pure SYN arriving at a tester port
      with no listening socket.
    - The DUT's ISN_d is learned from the active-OPEN SYN it emits
      (no SYN: recorded unperformed, the case is inconclusive).
    - The tester sends SYN+ACK with seq=tester_isn, ack=ISN_d+1, and
      options carrying the malformed MSS bytes.
    - The tester sends the DUT liveness probe numbered by the phase
      (dut_liveness.h): an ICMP Echo Request, which a running DUT
      answers (RFC 1122 §3.2.2.6, MUST).

  What the DUT does with the malformed SYN+ACK itself is not graded: it
  may complete the handshake, reset or drop it, and none of those is a
  crash. The criterion is the Echo Reply.

  Verdicts: both probes answered → pass; a probe unanswered for
  ParamListenTime → fail for that phase (observed_quiescence: the DUT
  is no longer running). The stimulus stops at the first unanswered
  probe, so a crash in phase 1 is not hidden by phase 2's DUT-control
  calls going unanswered.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_mss_options_05"
       sce:transition-table="emit"
       datamodel="null"
       initial="awaiting_liveness_phase1">

  <sce:context id="captured"
               cpp:type="tc8::TcpLivenessCaptured"
               cpp:include="sce_integration/tcp_case_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="awaiting_liveness_phase1">
    <onentry>
      <send event="phase1_liveness_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="dut_echo_reply"
                cond="cpp:captured.liveness_echo_seq == 1U"
                target="awaiting_liveness_phase2"/>
    <transition event="phase1_liveness_window_elapsed" target="fail_dut_unresponsive_after_ilen0"/>
  </state>

  <state id="awaiting_liveness_phase2">
    <onentry>
      <send event="phase2_liveness_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="dut_echo_reply"
                cond="cpp:captured.liveness_echo_seq == 2U"
                target="pass"/>
    <transition event="phase2_liveness_window_elapsed" target="fail_dut_unresponsive_after_ilen5"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_dut_unresponsive_after_ilen0">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_unresponsive_after_synack_with_ilen0_mss","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_dut_unresponsive_after_ilen5">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_unresponsive_after_synack_with_ilen5_mss","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
