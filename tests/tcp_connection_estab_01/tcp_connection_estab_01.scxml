<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.15 TCP_CONNECTION_ESTAB_01: a single passive socket MUST
  accept connections from multiple remote sockets — the DUT replies
  to each tester SYN (from a distinct source port) with a SYN+ACK
  (RFC 793 §3.4 listener serving parallel half-open transitions).

  v3.0 Test Procedure (p381-p400.txt:71-77):
    1. TESTER: <OpenTCPSocket(passive)> on a single PORT1.
    2. TESTER: Send 3 TCP segments with SYN from 3 different ports.
    3. DUT:    Sends 3 SYN,ACK responses to each sending port.

  Observable interactions:
    A passive LISTEN is opened on 13170, bringing the DUT to LISTEN.
    Three raw-inject SYNs land at the listener from
    (kBasicsTesterPort + 170/171/172) at 50 ms intervals. The tester
    withholds the kernel auto-RSTs that the unbound tester source
    ports would otherwise emit on the DUT-emitted SYN+ACKs.

  Pass chain: 3 sequential listening states. Each guards on (src_port
  == 13170, dst_port == kBasicsTesterPort + N, SYN+ACK bits,
  ack_num == kTesterInitialSeq + 1). dst_port differentiates the
  three legs even though src_port (the listen port) is shared.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_connection_estab_01"
       datamodel="null"
       initial="listen_leg1">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listen_leg1">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpConnEstab01ListenPort and captured.dst_port == ::tc8::sce::tcp::kTcpConnEstab01TesterSrcPort1 and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ack_num == ::tc8::sce::tcp::kTesterInitialSeq + 1U"
                target="listen_leg2"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout_leg1"/>
  </state>

  <state id="listen_leg2">
    <onentry>
      <send event="deadline_exceeded_2" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpConnEstab01ListenPort and captured.dst_port == ::tc8::sce::tcp::kTcpConnEstab01TesterSrcPort2 and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ack_num == ::tc8::sce::tcp::kTesterInitialSeq + 1U"
                target="listen_leg3"/>
    <transition event="deadline_exceeded_2" target="inconclusive_timeout_leg2"/>
  </state>

  <state id="listen_leg3">
    <onentry>
      <send event="deadline_exceeded_3" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpConnEstab01ListenPort and captured.dst_port == ::tc8::sce::tcp::kTcpConnEstab01TesterSrcPort3 and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ack_num == ::tc8::sce::tcp::kTesterInitialSeq + 1U"
                target="pass"/>
    <transition event="deadline_exceeded_3" target="inconclusive_timeout_leg3"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_leg1">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_synack_for_leg1","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_leg2">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_synack_for_leg2","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_leg3">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_synack_for_leg3","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
