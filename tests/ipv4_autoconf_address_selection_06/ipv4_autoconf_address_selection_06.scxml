<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_06: DUT-emitted ARP
  Probe carries `sender_proto_ip` = 0.0.0.0 (RFC 3927 §2.1.1, MUST).

  Spec Test Procedure (tc8_p141-p160.txt:401..416):
    1-4. DUT brings up iface and sends DHCPDISCOVER.
    5-7. TESTER listens; verify Sender IP == 0.0.0.0.

  Body shared with ADDRESS_SELECTION_01/05/07/08 via the
  ipv4_linklocal_probe_field template.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_06"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="captured.sender_proto_ip == 0"
           fail_state="fail_sender_proto_ip_nonzero"
           fail_reason="arp_probe_sender_ip_not_0_0_0_0"
           fail_role="observed_violation"/>
</scxml>
