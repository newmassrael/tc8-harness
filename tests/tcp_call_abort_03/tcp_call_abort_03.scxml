<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.5 TCP_CALL_ABORT_03: For ABORT call in CLOSING / LAST-ACK
  / TIME-WAIT state, TCP MUST respond with "ok" and enter CLOSED state.
  Derived from RFC 793 §3.9 p62 Event Processing (MUST).

  v3.0 Test Procedure (p325):
    1. TESTER: Cause the DUT to move on to the <wst> state
    2. TESTER: Cause the application on the DUT-side to issue an
               ABORT call
    3. DUT:    Issues an ABORT call
    4. TESTER: Verify that the DUT responds with "ok" to the
               application
    5. TESTER: Verify that the DUT moves on to CLOSED state

  Iterations: <wst> ∈ {CLOSING, LAST-ACK, TIME-WAIT}.

  Mechanism (3 phases × distinct port quads):
    * Phase 1 CLOSING (+91): drive the DUT EST→FW1→CLOSING (tester
      auto-ACK withheld). DUT application ABORT → DUT RST egress.
    * Phase 2 LAST-ACK (+92): with the tester auto-ACK withheld from
      before the handshake → tester half-close → DUT EST→CW (DUT
      acks tester FIN). The DUT application half-closes its write side
      → DUT CW→LAST-ACK (DUT FIN egress; with the tester auto-ACK
      withheld the DUT stays in LAST-ACK). DUT application ABORT →
      DUT RST.
    * Phase 3 TIME-WAIT (+93): the DUT application half-closes its
      write side → DUT FIN → tester auto-ACK → DUT FW1→FW2. Tester
      half-close → tester FIN → DUT FW2→TIME-WAIT (DUT pure ACK).
      DUT application ABORT on the TIME-WAIT socket. Linux's
      TIME-WAIT bucket may not emit RST on close, so the verify-probe
      ACK is the wire-observable pass criterion.

  Each phase ends with a verify-probe ACK injected on the killed
  4-tuple as listening_pN_verify_rst is entered. The DUT-side socket
  is gone, so the DUT emits a closed-port RST — uniformly satisfies
  "DUT moves to CLOSED" across all three iters, including TIME-WAIT
  where ABORT itself is silent.

  Phase 1 stimulus runs INLINE; phases 2/3 are deferred to the
  matching pN_handshake_ack state so the per-phase wire events arrive
  while the phase's listening transitions are armed.

  SCXML chain (9 listening states + 3 fail terminals + pass):
    p1_handshake_ack → p1_settle (5 s absorb prelude+abort egress) →
    p1_verify_rst (5 s; verify-probe ACK fired on entry, observe DUT
    closed-port RST) →
    p2_handshake_ack → p2_settle → p2_verify_rst →
    p3_handshake_ack → p3_settle → p3_verify_rst → pass

  Negative IP-flip path: src_ip-conjunct on listening_p1_handshake_ack
  unreachable → inconclusive_p1_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_call_abort_03"
       datamodel="null"
       initial="listening_p1_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake_ack">
    <onentry><send event="deadline_p1_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase1LocalOffset)"
                target="listening_p1_settle"/>
    <transition event="deadline_p1_handshake_ack" target="inconclusive_p1_no_handshake_ack"/>
  </state>

  <state id="listening_p1_settle">
    <onentry><send event="deadline_p1_settle" delay="5s"/></onentry>
    <transition event="deadline_p1_settle" target="listening_p1_verify_rst"/>
  </state>

  <state id="listening_p1_verify_rst">
    <onentry><send event="deadline_p1_verify_rst" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase1LocalOffset)"
                target="listening_p2_handshake_ack"/>
    <transition event="deadline_p1_verify_rst" target="inconclusive_p1_no_close"/>
  </state>

  <state id="listening_p2_handshake_ack">
    <onentry><send event="deadline_p2_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase2LocalOffset)"
                target="listening_p2_settle"/>
    <transition event="deadline_p2_handshake_ack" target="inconclusive_p2_no_handshake_ack"/>
  </state>

  <state id="listening_p2_settle">
    <onentry><send event="deadline_p2_settle" delay="5s"/></onentry>
    <transition event="deadline_p2_settle" target="listening_p2_verify_rst"/>
  </state>

  <state id="listening_p2_verify_rst">
    <onentry><send event="deadline_p2_verify_rst" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase2LocalOffset)"
                target="listening_p3_handshake_ack"/>
    <transition event="deadline_p2_verify_rst" target="inconclusive_p2_no_close"/>
  </state>

  <state id="listening_p3_handshake_ack">
    <onentry><send event="deadline_p3_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset)"
                target="listening_p3_settle"/>
    <transition event="deadline_p3_handshake_ack" target="inconclusive_p3_no_handshake_ack"/>
  </state>

  <state id="listening_p3_settle">
    <onentry><send event="deadline_p3_settle" delay="5s"/></onentry>
    <transition event="deadline_p3_settle" target="listening_p3_verify_rst"/>
  </state>

  <state id="listening_p3_verify_rst">
    <onentry><send event="deadline_p3_verify_rst" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpCallAbort03Phase3LocalOffset)"
                target="pass"/>
    <transition event="deadline_p3_verify_rst" target="inconclusive_p3_no_close"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_p1_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase1_closing","role":"precondition_unmet"}</content></donedata>
  </final>

  <final id="inconclusive_p1_no_close">
    <donedata><content>{"verdict":"inconclusive","reason":"dut_did_not_close_after_abort_in_closing","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p2_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase2_last_ack","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p2_no_close">
    <donedata><content>{"verdict":"inconclusive","reason":"dut_did_not_close_after_abort_in_last_ack","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p3_no_handshake_ack">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase3_time_wait","role":"property_unobserved"}</content></donedata>
  </final>

  <final id="inconclusive_p3_no_close">
    <donedata><content>{"verdict":"inconclusive","reason":"dut_did_not_close_after_abort_in_time_wait","role":"property_unobserved"}</content></donedata>
  </final>
</scxml>
