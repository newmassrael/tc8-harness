<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.16 TCP_HEADER_09: DUT discards TCP packet whose Checksum
  field is zero. Derived from RFC 793 §3.1 (TCP checksum is
  mandatory, no zero-sentinel as in UDP/RFC 768).

  v3.0 Test Procedure (p393):
    1. TESTER: Bring DUT to 'ESTABLISHED' state.
    2. TESTER: Send a TCP packet with Checksum = 0 and Sequence
               Number = <SEQ>.
    3. DUT:    Discards the TCP packet and sends no ACK back.

  Mechanism: drive the DUT through an active OPEN to ESTABLISHED;
  snapshot tester snd_nxt / rcv_nxt; raw-inject in-window data with
  the TCP Checksum field forced to zero; then observe a 3 s absence
  of any DUT pure ACK on the EST 4-tuple.

  Observable dispatch: the DUT recomputes the pseudo-header sum and
  compares it against the segment's checksum field. With the field
  forced to 0x0000 while the actual computed sum is non-zero (any
  plausible payload + headers), the comparison fails and the DUT
  discards the segment. The EST socket sees no segment, no DUT ACK
  fires.

  Two-state SCXML chain: handshake_ack observation gates 3 s
  absence; negative-flip lands on no_handshake_ack.

  Port-quad — kBasicsActiveLocalPort + 37 / +37.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_header_09"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpHeader09LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpHeader09LocalOffset)"
                target="listening_absence"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_absence">
    <onentry>
      <send event="deadline_absence" delay="3s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpHeader09LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpHeader09LocalOffset)"
                target="fail_unexpected_ack"/>
    <transition event="deadline_absence" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_unexpected_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_acked_segment_with_zero_checksum","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
