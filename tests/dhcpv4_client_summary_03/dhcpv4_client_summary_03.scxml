<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.1 DHCPv4_CLIENT_SUMMARY_03: A DHCP client must accept
  DHCP messages with an 'options' field of at least 312 octets, i.e.
  receive messages of up to 576 octets total (RFC 2131 §2 / RFC 791
  minimum reassembly).

  Case shape:
    the DUT discovers, and <SERVER-1> answers with an OFFER padded out
    to 576 octets — the largest a client must accept. The DUT has to
    take that OFFER whole and answer it with a REQUEST; the REQUEST
    arriving is the proof it ingested the padded message.

  SCXML envelope identical to SUMMARY_01 — only the trait differs by
  configuring `ip_datagram_total_bytes = 576` on the server emul so
  the OFFER carries ~308 octets of PAD options before END.

  The DISCOVER is the start of the exchange the case builds on, so its
  absence stays inconclusive. The procedure listens up to
  <ParamListenTime> for the REQUEST answering the padded OFFER, so a
  window that elapses without it is the DUT's silence where it must
  answer — observed_quiescence, judged against that bound (H3), over
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults). Whether the silence stands as a fail is the CLI's call on
  the run's hypotheses. Each state's deadline event is its own, so the
  DISCOVER window's timer cannot close the REQUEST window early.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_summary_03"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_for_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_request"/>
    <transition event="s1_deadline" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_request">
    <onentry>
      <send event="s2_deadline" delay="11s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="pass"/>
    <transition event="s2_deadline" target="fail_no_request"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_no_request">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_request_after_padded_offer","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
