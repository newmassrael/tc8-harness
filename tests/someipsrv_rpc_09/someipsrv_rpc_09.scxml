<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.7.9 SOMEIPSRV_RPC_09: Error messages shall copy the
  Message ID, Request ID and Interface Version from the request but
  NOT the payload. Tester sends a Request to UNKNOWN-METHOD-ID-SI-1;
  DUT replies with SOMEIP_MSG_TYPE_ERROR (0x81); pass requires the
  Error frame to carry no payload (length field == 8, i.e. payload_len
  == 0).

    Phase 1: DUT emits OfferService for SERVICE-ID-1.
    Phase 2: 5 s window. Pass requires the Error and payload_len == 0.
             Fail (payload_present) catches Error frames that arrived
             but carried payload bytes — distinct from the no-Error
             timeout.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_rpc_09"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x81 and captured.payload_len == 0"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x81 and captured.payload_len != 0"
                target="fail_phase2_payload_present"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_error"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_payload_present">
    <donedata>
      <content>{"verdict":"fail","reason":"error_message_carried_payload","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_error">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_error_message_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
