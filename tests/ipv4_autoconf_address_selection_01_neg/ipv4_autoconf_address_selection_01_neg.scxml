<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_01 negative — closes
  the self-reference trap on the positive _01 case. tc8-dut emits
  Probes via OpStartLLAutoconfBuggy(flavor=TargetInReservedRange):
  target_proto_ip = 169.254.0.42 (X=0 → in reserved 169.254.0/24
  per RFC 3927 §2.1). The shape stays in the 169.254/16 prefix so
  the looser _08 invariant still passes; the violation is _01-
  specific.

  Re-uses the positive ipv4_linklocal_probe_field template with the
  pass condition INVERTED — the "success" outcome is the SCXML
  landing on `fail_target_ip_in_reserved_range`, proving that
  branch is reachable. A `fail_compliant_emit` outcome means
  tc8-dut ignored the flavor byte (e.g. opcode plumbing regression)
  and the harness silently accepted the buggy DUT, which is
  exactly what this case exists to catch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="!captured.target_proto_ip_in_valid_ll_range()"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_probe_despite_target_in_reserved_range_flavor"/>
</scxml>
