<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_17: ARP Request reception (Target Hardware Address =
  ff:ff:ff:ff:ff:ff). Stimulus differs from ARP_16 only in target_hw;
  pass criterion is identical. Body: arp_required_reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_17"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_required_reply.sce-template.xml"/>
</scxml>
