<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.1 TCP_BASICS_05 negative (SYN,ACK-phase variant) — lwIP egress-fault
  self-validation of the positive _05 "RST SEQ = incoming.ACK" guard. The trait arms
  kTcpFaultRstSeqWrong (shared with BASICS_04) and raw-injects a SYN,ACK whose ACK is
  the phase literal 0xC0FFEE00 to the closed port; the lwIP link-output hook XOR-flips
  the DUT RST's sequence off that echoed value (gated on the RST flag). Proves the
  positive's `dut_rst_seq_not_synack_ack_literal` fail-final reachable
  (fault_injection_coverage.json); the _NEG2 sibling covers the bare-ACK phase. Pass =
  the corrupted sequence observed (seq != incoming ACK); fail_compliant = the DUT echoed
  the ACK into SEQ despite the flavor (fault inert). lwIP-only (capability-gated on
  kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_basics_05_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsClosedPort, ::tc8::sce::tcp::kBasicsTesterPort)"
           pass_expr="captured.seq_num != 0xC0FFEE00U"
           fail_state="fail_compliant"
           fail_reason="dut_rst_seq_synack_ack_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_rst_within_listen_window"/>
</scxml>
