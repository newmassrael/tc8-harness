<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_11: TCP, in CLOSE-WAIT state, MUST
  send an ACK with next expected SEQ number after receiving any
  segment with OTW SEQ number and remain in the same state. Derived
  from RFC 793 §3.9 p69 Event Processing (MUST).

  v3.0 Test Procedure (p336) lists 5 iterations (RST=0 across all):
    * CASE 1: flag set = SYN
    * CASE 2: flag set = SYN, ACK
    * CASE 3: flag set = ACK
    * CASE 4: flag set = FIN
    * CASE 5: flag set = Data segment

  Per-phase prelude drives DUT into CLOSE-WAIT by the tester sending
  a FIN — the Linux DUT auto-ACKs the tester FIN and transitions
  ESTABLISHED → CLOSE-WAIT — same shape as UNACCEPTABLE_14. Per
  phase the SCXML walks three DUT-origin observations:
    1. handshake third-leg ACK (DUT pure ACK)
    2. close-elicited auto-ACK (DUT pure ACK acknowledging tester FIN)
    3. probe-elicited empty ACK (DUT pure ACK with rcv_nxt —
       RFC 793 §3.9 challenge-ACK semantics)

  Distinct port quads (kBasicsActiveLocalPort+N /
  kBasicsActiveRemotePort+N for N in 0..4) keep per-phase
  observations isolated. CASE 4 (FIN) carries an ACK flag with
  rcv_nxt — the Linux DUT silently drops bare-FIN segments before
  reaching the OTW SEQ branch (verified empirically in 08), so
  carrying ACK keeps the segment past the early drop and reaches
  the spec-targeted challenge ACK. Same convention as
  TCP_FLAGS_INVALID_08.

  Negative smoke (ipv4.dut_iface_ip flip): pass guard's
  src_ip-conjunct fails on phase 1's listening_p1_handshake → first
  state's 5 s deadline → inconclusive_p1_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_11"
       datamodel="null"
       initial="listening_p1_handshake">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake">
    <onentry><send event="deadline_p1_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_close_ack"/>
    <transition event="deadline_p1_handshake" target="inconclusive_p1_no_handshake_ack"/>
  </state>
  <state id="listening_p1_close_ack">
    <onentry><send event="deadline_p1_close_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort)"
                target="listening_p1_probe_ack"/>
    <transition event="deadline_p1_close_ack" target="inconclusive_p1_no_close_ack"/>
  </state>
  <state id="listening_p1_probe_ack">
    <onentry><send event="deadline_p1_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort, ::tc8::sce::tcp::kBasicsActiveRemotePort) and captured.ack_num == captured.expected_ack_num"
                target="listening_p2_handshake"/>
    <transition event="deadline_p1_probe_ack" target="inconclusive_p1_no_probe_ack"/>
  </state>

  <state id="listening_p2_handshake">
    <onentry><send event="deadline_p2_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_close_ack"/>
    <transition event="deadline_p2_handshake" target="inconclusive_p2_no_handshake_ack"/>
  </state>
  <state id="listening_p2_close_ack">
    <onentry><send event="deadline_p2_close_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U)"
                target="listening_p2_probe_ack"/>
    <transition event="deadline_p2_close_ack" target="inconclusive_p2_no_close_ack"/>
  </state>
  <state id="listening_p2_probe_ack">
    <onentry><send event="deadline_p2_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 1U) and captured.ack_num == captured.expected_ack_num_phase2"
                target="listening_p3_handshake"/>
    <transition event="deadline_p2_probe_ack" target="inconclusive_p2_no_probe_ack"/>
  </state>

  <state id="listening_p3_handshake">
    <onentry><send event="deadline_p3_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 2U)"
                target="listening_p3_close_ack"/>
    <transition event="deadline_p3_handshake" target="inconclusive_p3_no_handshake_ack"/>
  </state>
  <state id="listening_p3_close_ack">
    <onentry><send event="deadline_p3_close_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 2U)"
                target="listening_p3_probe_ack"/>
    <transition event="deadline_p3_close_ack" target="inconclusive_p3_no_close_ack"/>
  </state>
  <state id="listening_p3_probe_ack">
    <onentry><send event="deadline_p3_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 2U) and captured.ack_num == captured.expected_ack_num_phase3"
                target="listening_p4_handshake"/>
    <transition event="deadline_p3_probe_ack" target="inconclusive_p3_no_probe_ack"/>
  </state>

  <state id="listening_p4_handshake">
    <onentry><send event="deadline_p4_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 3U)"
                target="listening_p4_close_ack"/>
    <transition event="deadline_p4_handshake" target="inconclusive_p4_no_handshake_ack"/>
  </state>
  <state id="listening_p4_close_ack">
    <onentry><send event="deadline_p4_close_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 3U)"
                target="listening_p4_probe_ack"/>
    <transition event="deadline_p4_close_ack" target="inconclusive_p4_no_close_ack"/>
  </state>
  <state id="listening_p4_probe_ack">
    <onentry><send event="deadline_p4_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 3U) and captured.ack_num == captured.expected_ack_num_phase4"
                target="listening_p5_handshake"/>
    <transition event="deadline_p4_probe_ack" target="inconclusive_p4_no_probe_ack"/>
  </state>

  <state id="listening_p5_handshake">
    <onentry><send event="deadline_p5_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 4U)"
                target="listening_p5_close_ack"/>
    <transition event="deadline_p5_handshake" target="inconclusive_p5_no_handshake_ack"/>
  </state>
  <state id="listening_p5_close_ack">
    <onentry><send event="deadline_p5_close_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 4U)"
                target="listening_p5_probe_ack"/>
    <transition event="deadline_p5_close_ack" target="inconclusive_p5_no_close_ack"/>
  </state>
  <state id="listening_p5_probe_ack">
    <onentry><send event="deadline_p5_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + 4U) and captured.ack_num == captured.expected_ack_num_phase5"
                target="pass"/>
    <transition event="deadline_p5_probe_ack" target="inconclusive_p5_no_probe_ack"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_p1_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase1","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_p1_no_close_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_ack_phase1","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p1_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_syn_in_close_wait","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p2_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase2","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p2_no_close_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_ack_phase2","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p2_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_synack_in_close_wait","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p3_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase3","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p3_no_close_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_ack_phase3","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p3_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_ack_in_close_wait","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p4_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase4","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p4_no_close_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_ack_phase4","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p4_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_fin_in_close_wait","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p5_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase5","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p5_no_close_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_ack_phase5","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p5_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_data_in_close_wait","role":"property_unobserved"}</content></donedata></final>
</scxml>
