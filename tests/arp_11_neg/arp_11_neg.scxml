<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_11 negative — lwIP egress-fault self-validation of the
  positive _11 Protocol Address Length guard. emitArpFlavorArm(kArpFaultProtoLenWrong)
  rewrites the plen of the DUT's Request (opcode left at 1; the 4-byte
  address fields keep their layout). Pass = corrupted proto_addr_len
  observed; fail_compliant = DUT emitted 4 despite the flavor (fault
  inert). lwIP-only. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_11_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.proto_addr_len != 4"
           fail_state="fail_compliant"
           fail_reason="dut_arp_request_proto_addr_len_four_despite_proto_len_wrong_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
