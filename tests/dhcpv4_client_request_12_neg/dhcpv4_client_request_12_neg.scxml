<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_12 negative — REBINDING DHCPREQUEST
  MUST be broadcast (RFC 2131 §4.4.5). The positive's dst-not-broadcast
  branch is unreachable against a conformant tc8-dut.

  Standalone (NOT the dhcpv4_rebinding_request_field template): that
  template's state-4 pre-filters on dst_ip_is_broadcast() to pick the
  REBINDING REQUEST out of the RENEWING retransmission stream — which is
  exactly the field this case mutates, so the filtered template could
  never observe a unicast REBINDING. Here the firmware mutant
  (kDhcpFlavorRebindingDstUnicast) sends the REBINDING to 192.0.2.12, a
  sentinel distinct from BOTH the limited broadcast AND the server-id, so
  state-4 can discriminate three outcomes:
    - dst is broadcast            -> conformant DUT  -> fail_compliant
    - dst is neither broadcast    -> the mutant      -> pass
      nor the server-id           -> (violation observed)
    - dst == server-id            -> a RENEWING retx -> ignored (wait)

  A conformant client (flavor None) broadcasts the REBINDING, so
  fail_compliant is the live conformant-DUT outcome, not a dead branch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_12_neg"
       datamodel="null"
       initial="listening_for_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover() and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_first_request"/>
    <transition event="s1_deadline" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_first_request">
    <onentry>
      <send event="s2_deadline" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request() and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_renewing_request"/>
    <transition event="s2_deadline" target="inconclusive_no_first_request"/>
  </state>

  <state id="listening_for_renewing_request">
    <onentry>
      <send event="s3_deadline" delay="8s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request() and captured.chaddr_matches_dut_mac(expected.dut_iface_mac) and captured.dst_ip_equals(expected.server_id_be)"
                target="listening_for_rebinding_request"/>
    <transition event="s3_deadline" target="inconclusive_no_renewing_request"/>
  </state>

  <state id="listening_for_rebinding_request">
    <onentry>
      <send event="s4_deadline" delay="6s"/>
    </onentry>
    <!-- A RENEWING retransmission (dst = server_id) lands here too under
         the runBoundPhaseMachine retx schedule; it matches neither
         transition (pass excludes dst == server_id; fail_compliant
         requires broadcast) so it is ignored until the REBINDING fires. -->
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request() and captured.chaddr_matches_dut_mac(expected.dut_iface_mac) and !captured.dst_ip_is_broadcast() and !captured.dst_ip_equals(expected.server_id_be)"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_request() and captured.chaddr_matches_dut_mac(expected.dut_iface_mac) and captured.dst_ip_is_broadcast()"
                target="fail_compliant"/>
    <transition event="s4_deadline" target="inconclusive_no_rebinding_request"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_first_request">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_request_after_offer","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_renewing_request">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_renewing_request_after_ack","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_rebinding_request">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_rebinding_request_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_rebinding_request_broadcast_despite_dst_unicast_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
