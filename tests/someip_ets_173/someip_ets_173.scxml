<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_173: SD_Unicast_SubscribeEventgroup.

  Tester sends 2 unicast Subscribes carrying UDP + TCP endpoint options
  with different entry-to-options index/count configurations. Per
  PRS_SOMEIPSD_00386 / 00387 / 00391 the DUT shall Ack both Subscribes.
  Verdict accepts Ack OR Nack — vsomeip Nacks when the referenced TCP
  endpoint has no live connection (ETS_096 precedent), but both outcomes
  confirm the option walker successfully parsed the index/count config.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Type 0x07 entry on first Subscribe.
    Phase 3 (listening_phase3): Type 0x07 entry on second Subscribe.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_173"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="listening_phase3"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_first_ack"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="pass"/>
    <transition event="phase3_deadline_exceeded" target="inconclusive_phase3_no_second_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_first_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_first_subscribe_ack_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase3_no_second_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_second_subscribe_ack_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
