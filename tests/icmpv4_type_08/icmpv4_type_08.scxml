<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.3.3.2 ICMPv4_TYPE_08: ICMP Echo Reply data field. Tester sends
  an Echo Request carrying the spec literal "ECU NETWORK VALIDATION TEST"
  (27 bytes); the DUT's Echo Reply must return those 27 bytes verbatim
  per RFC 792.

  The spec literal lives in icmpv4_captured.h as kIcmpv4EchoPayloadType08;
  both the stimulus builder (case trait icmpv4_type_08.h) and the SCXML
  guard below compare against it, so the reference blob is single-
  sourced. icmpv4EchoPayloadMatches() does a byte-exact compare after
  the captured payload snapshot is populated by dispatch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="icmpv4_type_08"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Icmpv4Captured"
               cpp:include="sce_integration/icmpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Icmpv4Expected"
               cpp:include="sce_integration/icmpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip and captured.echo_payload_equals(::tc8::kIcmpv4EchoPayloadType08)"
                target="pass"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip"
                target="fail_payload_mismatch"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_payload_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_payload_not_returned_verbatim"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_echo_reply_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
