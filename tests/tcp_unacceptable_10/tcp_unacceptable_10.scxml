<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_10: TCP in FIN-WAIT-2 state MUST
  return an empty acknowledgment with proper SEQ and ACK numbers
  after receiving a segment with out-of-window SEQ or unacceptable
  ACK, and remain in FIN-WAIT-2. Derived from RFC 793 §3.4 p37
  Establishing a Connection (MUST).

  v3.0 Test Procedure (p301-p320.txt:609), two iterations — both
  exercised:
    * Phase 1 (CASE 1): data segment with OTW SEQ — empty ACK
      expected.
    * Phase 2 (CASE 2): data segment with unacceptable ACK — empty
      ACK expected.

  Linux DUT deviation — CASE 2 emits RST not ACK:
    * CASE 1 OTW SEQ → Linux's out-of-window SEQ check fires BEFORE
      entering state-specific processing and schedules an empty ACK;
      observable on the wire.
    * CASE 2 bad ACK in FIN-WAIT-2 emits an RST per Linux 6.5's
      TIME-WAIT-substate processing — RFC 793 §3.4 spec violation,
      NOT silent-drop. After the DUT closes a FIN-WAIT-1 socket
      whose application has closed (no reader), Linux substitutes
      the full socket with an orphaned TIME-WAIT mini-socket in the
      FW2 substate; subsequent payload-bearing non-FIN segments with
      in-window SEQ trip the "new data after half-duplex close"
      branch, which returns an RST verdict. Linux then emits an RST
      on the segment's 4-tuple. This is a third dispatch behaviour
      distinct from EST (silent-drop — the ACK path short-circuits)
      and FW1 / CW / CLOSING / LA (challenge-ACK via the receive
      state machine); see reference_unacc_ack_dispatch memory.
      A Linux DUT therefore lands `fail_dut_rst_to_unacc_ack` and is
      excluded from CI green via grep filter in
      .github/workflows/smoke-test.yml. A spec-compliant DUT
      emitting an empty ACK lands pass without filter.

  Observable protocol interaction: active-OPEN handshake →
  ESTABLISHED → the DUT issues a CLOSE, driving it into FIN-WAIT-1 →
  the tester kernel auto-ACKs the DUT FIN (NOT suppressed — _10
  deliberately allows the collapse) → DUT advances to FIN-WAIT-2 →
  snapshot tester SEQ/ACK → inject corrupt OTW-SEQ segment (phase 1)
  → DUT empty ACK on data path → on listening_unacc_ack entry,
  inject in-window SEQ + unacc-ACK (phase 2) → DUT empty ACK or RST.

  Four DUT-origin observations on tcp_observed:
    1. handshake third-leg ACK (pure ACK, ack = ISN_t + 1)
    2. close-elicited DUT FIN+ACK (DUT CLOSE → FIN-WAIT-1; tester
       ACK transitions DUT to FIN-WAIT-2)
    3. data-elicited empty ACK to corrupt segment (CASE 1)
    4. unacc-ACK-elicited empty ACK (CASE 2 spec) or RST (Linux
       deviation)

  Negative smoke flips ipv4.dut_iface_ip → first state's
  src_ip-conjunct unreachable → fail_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_10"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake" target="fail_no_handshake_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry>
      <send event="deadline_dut_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset)"
                target="listening_data_ack"/>
    <transition event="deadline_dut_fin" target="fail_no_dut_fin"/>
  </state>

  <state id="listening_data_ack">
    <onentry>
      <send event="deadline_data_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset)"
                target="listening_unacc_ack"/>
    <transition event="deadline_data_ack" target="fail_no_data_ack"/>
  </state>

  <state id="listening_unacc_ack">
    <onentry>
      <send event="deadline_unacc_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset)"
                target="fail_dut_rst_to_unacc_ack"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable10LocalOffset)"
                target="pass"/>
    <transition event="deadline_unacc_ack" target="fail_no_dut_ack_to_unacc_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_handshake_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_handshake_ack_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_no_dut_fin">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_fin_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_no_data_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_finwait2"}</content>
    </donedata>
  </final>

  <final id="fail_dut_rst_to_unacc_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_rst_to_unacc_ack_finwait2"}</content>
    </donedata>
  </final>

  <final id="fail_no_dut_ack_to_unacc_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_unacc_ack_finwait2"}</content>
    </donedata>
  </final>
</scxml>
