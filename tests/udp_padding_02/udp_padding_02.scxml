<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.3 UDP_Padding_02: DUT-emitted UDP datagram with even
  payload size carries no trailing padding (RFC 768 'Fields'). Wire
  Length == 8 + <udpUserDataSize> exactly — no kernel-side
  byte-alignment pad leaks onto the UDP region (any trailing pad
  would lift Length above 8+N or extend the IP payload past UDP's
  Length boundary).

  Stimulus: TriggerSendUdp(src_port=20030, dst=tester_ip:20000,
  payload=8 B kUdpDefaultData — even). SCXML asserts
  captured.length == 16.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_padding_02"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="captured.src_port == 20030 and captured.dst_port == 20000 and captured.length == 16"
           fail_state="fail_padding_or_length"
           fail_reason="dut_emitted_udp_with_padding_on_even_payload"/>
</scxml>
