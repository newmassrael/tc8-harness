<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_07: ARP request sending on missing entry. With the
  DUT's ARP cache cleared, a UT 0x02 OpTriggerSendUdp unicast reply path
  forces the DUT to ARP-resolve the tester, broadcasting an ARP Request.
  Pass on any ARP Request (opcode 1) from the DUT MAC; a non-Request
  opcode is an explicit conformance failure. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_07"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.opcode == 1"
           fail_state="fail_opcode"
           fail_reason="first_arp_was_not_request"
           fail_role="observed_violation"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
