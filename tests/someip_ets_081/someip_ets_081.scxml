<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_081: ClientServiceActivate_Server_reboot.

  After clientServiceActivate + clientServiceSubscribeEventgroup the DUT
  proxy spawns a fresh CommonAPI Proxy for ets3 (SERVICE-ID 0xF4E9) and
  vsomeip queues a SubscribeEventgroup with a TCP IPv4 Endpoint Option
  for eventgroup 0x000A (SomeIpReliable=true). The tester emits
  OfferService #1 with a TCP endpoint (session_id high, reboot=1); the
  DUT vsomeip TCP-connects to the advertised endpoint and emits the
  SubscribeEventgroup. After the first wire Subscribe is observed, the
  trait fires a second OfferService with a LOWER session_id (still
  reboot=1) — vsomeip's `is_reboot` rule (old_rb=1 && new_rb=1 &&
  old_sid >= new_sid) treats it as a server reboot, expires the local
  endpoint state, and re-attempts the TCP handshake. Per
  PRS_SOMEIPSD_00385 the DUT MUST close the old TCP and open a new one;
  the tester's detached-thread fd holder accepts the second connect on
  the same listener and bumps `tcp_handshake_count` to 2.

  Stimulus chain (see src/sce_integration/cases/someip_ets_081.h):
    1. emitFindServiceBoot — SERVICE-ID-1 server warm-up.
    2. emitMethodRequestAfter(clientServiceActivate, 0x2F).
    3. Sleep 800 ms (proxy buildProxy() registration delay).
    4. emitMethodRequestAfter(clientServiceSubscribeEventgroup, 0x32).
    5. openTcpListener(:30509) + detached thread accepting up to 2 conns,
       writing `c.tcp_handshake_count` after each accept.
    6. emitOfferServiceMulticastWithEndpoint(ets3, TCP, sid=0x0A, rb=1).
    7. State-entry observer on listening_phase3_renewed_handshake fires
       emitOfferServiceMulticastWithEndpoint(ets3, TCP, sid=0x05, rb=1)
       — vsomeip's `is_reboot` rule trips (10 >= 5) → DUT closes TCP #1
       and reconnects → tester accepts conn #2 → tcp_handshake_count = 2.

  Verdict (3-state):
    Phase 1 (listening_phase1, 6 s): observe OfferService for SERVICE-
            ID-1 (DUT's own server-side warm-up gate).
    Phase 2 (listening_phase2_first_subscribe_seen, 12 s): observe DUT-
            emitted SubscribeEventgroup (Type 0x06, ets3 0xF4E9, ttl > 0,
            with at least one IPv4 Endpoint Option carrying l4_proto =
            TCP) — implies TCP handshake #1 completed successfully.
    Phase 3 (listening_phase3_renewed_handshake, 12 s): wait for
            `tcp_handshake_count >= 2`. Phase 3 onentry triggers the
            trait-side scheduleAfterStateEntry callback that fires the
            reboot OfferService. Cond on the deadline reads the slot
            once and routes to pass / fail accordingly.

  Reference: PRS_SOMEIPSD_00385.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_081"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_first_subscribe_seen"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_first_subscribe_seen">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="12s"/>
    </onentry>
    <!-- DUT-emitted SubscribeEventgroup for ets3 (SERVICE-ID 0xF4E9),
         Type 0x06, ttl > 0, carrying an IPv4 Endpoint Option whose
         l4_proto is TCP (0x06). The TCP handshake must have completed
         before vsomeip serialises this entry. -->
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x06 and captured.sd_entries[0].service_id == 0xF4E9 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_option_count >= 1 and captured.sd_options[0].type == 0x04 and captured.sd_options[0].l4_proto == 0x06"
                target="listening_phase3_renewed_handshake"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_first_subscribe"/>
  </state>

  <state id="listening_phase3_renewed_handshake">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="12s"/>
    </onentry>
    <!-- The trait-side scheduleAfterStateEntry callback fires the reboot
         OfferService on this phase's entry; the detached accept thread
         increments `tcp_handshake_count` whenever a fresh inbound TCP
         handshake completes. Cond on the deadline reads the slot once. -->
    <transition event="phase3_deadline_exceeded"
                cond="cpp:captured.tcp_handshake_count >= 2"
                target="pass"/>
    <transition event="phase3_deadline_exceeded"
                target="fail_phase3_no_renewed_handshake"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_first_subscribe">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_subscribe_with_tcp_option_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_no_renewed_handshake">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_renew_tcp_connection_after_simulated_server_reboot"}</content>
    </donedata>
  </final>
</scxml>
