<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.11 TCP_RETRANSMISSION_TO_04: TCP MUST include "exponential
  backoff" (check that it increases) for successive RTO values for
  sending data segments (RFC 1122 §4.2.3.1 MUST — RFC 6298 §5).

  v3.0 Test Procedure (p369):
    1. TESTER: Cause the DUT to move on to ESTABLISHED state.
    2. TESTER: Cause an application on the DUT-side to issue a data
               SEND request.
    3. DUT:    Send the data segment.
    4. TESTER: Do not send ACK.
    5. DUT:    Retransmit the data segment after a timeout.
    6. TESTER: Do not send ACK and verify that RTO retransmission
               interval is increasing at a fast (at least more than
               linear) rate.

  Mechanism (kernel-state TCP_INFO observation, three snapshots):
    The earlier pcap-timing chain (observe seg1, retx1, retx2, retx3
    inter-frame deltas in a 4-state SCXML) was deterministic at
    workers=1 but flaked under workers=4 parallel load — pcap's
    SOFTIRQ delivery raced the per-state deadline guards on the
    second / third retransmit observation. Replacing the wire-timing
    assertions with three synchronous kernel-state (TCP_INFO) reads
    off the DUT's connected socket makes the verdict a function of
    kernel state, not pcap delivery latency. Stimulus phases:

    1. Active OPEN handshake on +200 port quad; snapshot tester
       snd_nxt / rcv_nxt for 4-tuple-clean prelude.
    2. The tester withholds its kernel's auto-ACKs (for the full
       stimulus body) so seg1's RTO timer fires three times without
       tester interference. RACK and TLP are disabled in dut_ns
       (mirrors RETRANSMISSION_TO_03/_05/_06 via the smoke-test
       sysctl override) so the DUT's retransmit timer follows the
       canonical RTO-doubling path.
    3. A data SEND → DUT data segment 1 (8 B). Linux's data-RTO
       sequence on a fresh local-veth ESTABLISHED socket: retx 1 at
       ~200 ms post-seg1 (RTO: 200 → 400 ms), retx 2 at +400 ms
       (400 → 800 ms), retx 3 at +800 ms (800 → 1600 ms).
    4. **Phase 1 snapshot** (post-retx 1): polled at 50 ms cadence
       until `tcpi_retransmits >= 1`; deadline 2 s. Pass criterion:
       `tcpi_rto >= 350 ms` (proves the DUT doubled its RTO from
       the 200 ms baseline).
    5. **Phase 2 snapshot** (post-retx 2): polled until
       `tcpi_retransmits >= 2`; deadline 3 s. Pass criterion:
       `tcpi_rto > p1.tcpi_rto` (proves the DUT doubled again).
       A constant-RTO DUT would leave p2.rto == p1.rto.
    6. **Phase 3 snapshot** (post-retx 3): polled until
       `tcpi_retransmits >= 3`; deadline 5 s. Pass criterion:
       `tcpi_rto > p2.tcpi_rto` (proves the DUT doubled a third
       time). Three observations of strict growth across the cluster
       pin the "more than linear" RFC 1122 §4.2.3.1 MUST.

  SCXML shape — single state with a `<send delay="0ms"/>`-raised
  evaluation event, multiple cond-keyed transitions; first matching
  transition wins per W3C SCXML §3.13. Transitions are ordered fail-
  first (handshake → query validity → retransmit-count thresholds →
  numeric rto growth) so the most-proximal cause short-circuits to
  its specific verdict before falling through to pass. delay=0ms is
  the minimal scheduler tick required to flush the stimulus-mutated
  `captured` into the cond evaluator's view; pure eventless
  transitions are not used because the SCE codegen consumes events
  into Event enum members and an enum-less initial state would have
  no firing edge at all.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes the active OPEN
  handshake fail; the stimulus returns early without setting
  `ut_handshake_completed`, so the SCXML's first cond fires and
  verdicts as `fail:dut_handshake_did_not_complete`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_04"
       datamodel="null"
       initial="evaluate_kernel_observations">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="evaluate_kernel_observations">
    <onentry>
      <send event="evaluate" delay="0ms"/>
    </onentry>
    <transition event="evaluate"
                cond="cpp:not captured.ut_handshake_completed"
                target="fail_handshake_did_not_complete"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p1_valid"
                target="fail_phase1_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p2_valid"
                target="fail_phase2_query_failed"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p3_valid"
                target="fail_phase3_query_failed"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_retransmits &lt; 1"
                target="fail_no_retx_1"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p2_retransmits &lt; 2"
                target="fail_no_retx_2"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p3_retransmits &lt; 3"
                target="fail_no_retx_3"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_rto_us &lt; 350000"
                target="fail_initial_rto_not_doubled"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p2_rto_us &lt;= captured.ut_tcpi_p1_rto_us"
                target="fail_retx2_not_doubled"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p3_rto_us &lt;= captured.ut_tcpi_p2_rto_us"
                target="fail_retx3_not_doubled"/>
    <transition event="evaluate" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_handshake_did_not_complete">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_handshake_did_not_complete","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_query_failed">
    <donedata>
      <content>{"verdict":"fail","reason":"phase1_tcp_info_query_failed","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_query_failed">
    <donedata>
      <content>{"verdict":"fail","reason":"phase2_tcp_info_query_failed","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_query_failed">
    <donedata>
      <content>{"verdict":"fail","reason":"phase3_tcp_info_query_failed","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx_1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_data_retransmit_1","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_data_retransmit_2","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx_3">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_data_retransmit_3","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_initial_rto_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase1_rto_below_doubled_baseline","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_retx2_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase2_rto_not_greater_than_phase1","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_retx3_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"phase3_rto_not_greater_than_phase2","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
