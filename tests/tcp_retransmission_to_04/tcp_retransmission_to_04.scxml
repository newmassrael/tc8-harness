<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.11 TCP_RETRANSMISSION_TO_04: TCP MUST include "exponential
  backoff" (check that it increases) for successive RTO values for
  sending data segments (RFC 1122 §4.2.3.1 MUST — RFC 6298 §5).

  v3.0 Test Procedure (p369):
    1. TESTER: Cause the DUT to move on to ESTABLISHED state.
    2. TESTER: Cause an application on the DUT-side to issue a data
               SEND request.
    3. DUT:    Send the data segment.
    4. TESTER: Do not send ACK.
    5. DUT:    Retransmit the data segment after a timeout.
    6. TESTER: Do not send ACK and verify that RTO retransmission
               interval is increasing at a fast (at least more than
               linear) rate.

  Mechanism (active-OPEN handshake + small SEND + TesterAutoAckDrop
  blocking the auto-ACK + observe 3 data retransmits with
  strictly-doubling inter-frame deltas):
    1.   Tester listener.acceptOne completes the handshake; the DUT
         is in ESTABLISHED. `queryTcpSeqRange` snapshots the
         post-handshake tester snd_nxt / rcv_nxt for 4-tuple-clean
         observation.
    2.   `TesterAutoAckDrop` installs an iptables OUTPUT rule that
         drops tester-emitted pure ACKs toward the DUT. The DUT's
         data segment goes out, the tester kernel's auto-ACK is
         silently swallowed, and `tcp_retransmit_timer` fires when
         icsk_rto elapses with snd_una unchanged.
    3.   On every data-retx fire (state == TCP_ESTABLISHED, NOT
         TCP_SYN_SENT), Linux's `tcp_retransmit_timer` enters the
         "Use normal (exponential) backoff" branch and doubles
         `icsk_rto`. The 4-tuple-pinned SCXML chain observes the
         resulting 200 ms / 400 ms / 800 ms inter-frame sequence.

  Strict timing assertion ("more than linear"):
    Linux's TCP_RTO_MIN baseline is 200 ms. Initial data RTO on a
    fresh local-veth ESTABLISHED socket converges via the RTT
    estimator to that floor. The retx1 guard anchors the initial
    RTO in [80 ms, 400 ms]; with that anchor, a constant-interval
    DUT (linear ≤ 400 ms) fails the retx2 strict lower bound
    `frame_delta_us > 300000` because its second-leg interval
    cannot exceed the first-leg upper bound. Similarly retx3's
    `frame_delta_us > 600000` rejects 400 ms linear.

  Four-state SCXML chain:
    * listening_seg1   — observe DUT's first data segment.
                         Deadline 5 s covers handshake + SEND
                         dispatch + parallel-worker jitter.
    * listening_retx_1 — observe data retx 1 within Linux's
                         initial RTO window. Deadline 1 s.
    * listening_retx_2 — observe data retx 2 with delta > 300 ms.
                         Deadline 1.5 s.
    * listening_retx_3 — observe data retx 3 with delta > 600 ms.
                         Deadline 2 s.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  `is_dut_data_segment(...)` 's src_ip conjunct unreachable; case
  lands on fail_no_seg1 via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_04"
       datamodel="null"
       initial="listening_seg1">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_seg1">
    <onentry>
      <send event="deadline_seg1" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset)"
                target="listening_retx_1"/>
    <transition event="deadline_seg1" target="fail_no_seg1"/>
  </state>

  <state id="listening_retx_1">
    <onentry>
      <send event="deadline_retx_1" delay="1s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset) and captured.frame_delta_us() &gt; 80000 and captured.frame_delta_us() &lt; 400000"
                target="listening_retx_2"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset) and (captured.frame_delta_us() &lt;= 80000 or captured.frame_delta_us() &gt;= 400000)"
                target="fail_initial_rto_out_of_window"/>
    <transition event="deadline_retx_1" target="fail_no_retx_1"/>
  </state>

  <state id="listening_retx_2">
    <onentry>
      <send event="deadline_retx_2" delay="1500ms"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset) and captured.frame_delta_us() &gt; 300000"
                target="listening_retx_3"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset) and captured.frame_delta_us() &lt;= 300000"
                target="fail_retx2_not_doubled"/>
    <transition event="deadline_retx_2" target="fail_no_retx_2"/>
  </state>

  <state id="listening_retx_3">
    <onentry>
      <send event="deadline_retx_3" delay="2s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset) and captured.frame_delta_us() &gt; 600000"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpRetransmissionTo04LocalOffset) and captured.frame_delta_us() &lt;= 600000"
                target="fail_retx3_not_doubled"/>
    <transition event="deadline_retx_3" target="fail_no_retx_3"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_seg1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_first_data_segment"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx_1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_data_retransmit_1"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_data_retransmit_2"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx_3">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_data_retransmit_3"}</content>
    </donedata>
  </final>

  <final id="fail_initial_rto_out_of_window">
    <donedata>
      <content>{"verdict":"fail","reason":"data_retx1_rto_out_of_baseline_window"}</content>
    </donedata>
  </final>

  <final id="fail_retx2_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"data_retx2_delta_not_greater_than_initial_rto"}</content>
    </donedata>
  </final>

  <final id="fail_retx3_not_doubled">
    <donedata>
      <content>{"verdict":"fail","reason":"data_retx3_delta_not_greater_than_retx2_lower_bound"}</content>
    </donedata>
  </final>
</scxml>
