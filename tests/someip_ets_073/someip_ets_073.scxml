<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_073: Union_with_wrong_type_field_for_union_member_Padding.

  Tester sends echoUNION (METHOD-ID 0x0019) with the ETS_038 9-byte
  Type 2 (uint8) baseline payload, but corrupts the inner union-type
  prefix at payload byte 7 from 0x02 to 0x07 (claims a discriminant
  beyond the 6-type range Boolean/uint8/uint16/uint32/sint8/sint16
  declared by typeCollection EtsTypes). The SOME/IP Length stays
  self-consistent (8 + 9 = 17) so the frame reaches CommonAPI; the
  Variant decoder logs "ApplyStreamVisitor type not found" /
  "ApplyVoidIndexVisitor type not found" warnings for the unknown
  discriminant but still serialises a method response back to the
  tester. Spec wording is "DUT: returns method response messages with
  the correct union type and adjusted padding" — a positive-shape
  pass criteria, NOT a malformed-rejection axis like ETS_070..072.

  Pass cond is therefore the lenient "DUT emits some method response
  on method_id 0x0019" — accepting any return_code (Linux DUT echoes
  with return_code 0x00 even though the response Variant contents are
  degraded by the unknown discriminant). Only silent ignore (no
  Response within the deadline) lands on fail — that would imply the
  DUT crashed or dropped the frame entirely on the wrong-type field.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): A Method Response (msg_type 0x80) or
            Error Response (msg_type 0x81) on method_id 0x0019 -> pass.
            No Response within the deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_073"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0019 and (captured.message_type == 0x80 or captured.message_type == 0x81)"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window_for_wrong_union_type","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
