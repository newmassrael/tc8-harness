<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.9 SOMEIPSRV_FORMAT_09: The six flag bits other than Reboot
  (bit 7) and Unicast (bit 6) shall be '0'. Mask = 0x3F.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_09"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:(captured.sd_flags &amp; 0x3F) == 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:(captured.sd_flags &amp; 0x3F) != 0x00"
                target="fail_undefined_flag_bits"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_undefined_flag_bits">
    <donedata>
      <content>{"verdict":"fail","reason":"undefined_flag_bits_nonzero"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_notification_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
