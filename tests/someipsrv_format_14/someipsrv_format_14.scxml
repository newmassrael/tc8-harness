<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.14 SOMEIPSRV_FORMAT_14: The Service ID field of the Type 1
  Entry shall carry the configured SERVICE-ID-1. The configured identity
  is injected at runtime via CLI option expect service_id=<hex> and lands
  in expected.service_id; for the smoke-test against tc8-dut
  that value is 0xF4E7 (see mock_dut/env/smoke-test.sh).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_14"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id != expected.service_id"
                target="fail_service_id"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_service_id">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_service_id_mismatch","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_notification_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
