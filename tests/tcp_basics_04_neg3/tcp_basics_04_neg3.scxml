<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.1 TCP_BASICS_04 negative (Data-phase variant) — sibling of
  tcp_basics_04_neg. The trait arms kTcpFaultRstSeqWrong and raw-injects a no-flag Data
  segment to the closed port; the lwIP link-output hook flips the DUT RST's sequence
  off zero. Proves the positive's `dut_rst_seq_not_zero_after_data` fail-final reachable
  (fault_injection_coverage.json). Pass = the non-zero sequence observed; fail_compliant
  = the DUT sent SEQ=0 despite the flavor (fault inert). lwIP-only (capability-gated on
  kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_basics_04_neg3"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsClosedPort, ::tc8::sce::tcp::kBasicsTesterPort)"
           pass_expr="captured.seq_num != 0"
           fail_state="fail_compliant"
           fail_reason="dut_rst_seq_zero_despite_flavor_after_data"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_rst_within_listen_window"/>
</scxml>
