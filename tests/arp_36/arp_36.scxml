<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_36: ARP Request reception (Target Protocol Address
  correct). Tester injects a Request whose target_ip equals the DUT's
  interface IP — the RFC 826 §"Packet Reception" "Am I the target
  protocol address?" check must succeed and DUT must reply.
  Body: arp_required_reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_36"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_required_reply.sce-template.xml"/>
</scxml>
