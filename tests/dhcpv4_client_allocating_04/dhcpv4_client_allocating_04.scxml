<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_04: the DHCPREQUEST message
  MUST use the same value in the BOOTP header's 'secs' field as the
  originating DHCPDISCOVER (RFC 2131 §4.3.2, MUST).

  Spec Test Procedure (tc8_p221-p240.txt: ALLOCATING_04):
    1-4. DUT bring-up + DHCP client + DISCOVER.
    5.   TESTER: Extracts 'secs' field from DISCOVER → <extractedSeconds>.
    6-8. TESTER: Sends DHCPOFFER + listens for REQUEST.
    9.   TESTER: Verify REQUEST 'secs' == extractedSeconds.

  Cross-message snapshot mechanics: see PARAMETERS_04 — same
  state-entry observer captures `secs` into Captured's persistent
  snapshot slot.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_04"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.secs_matches_discover()"
           fail_state="fail_request_secs_mismatch"
           fail_reason="dut_dhcp_request_secs_mismatch_discover"/>
</scxml>
