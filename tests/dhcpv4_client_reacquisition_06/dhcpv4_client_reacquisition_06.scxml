<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_06: in REBINDING state, on
  no ACK response, the client SHOULD wait one-half of the remaining
  lease time before retransmitting the DHCPREQUEST (RFC 2131 §4.4.5).

  Spec Test Procedure (tc8_p281-p300.txt: REACQUISITION_06):
    8. TESTER: Verify time interval between two DHCPREQUEST messages
       ∈ [(LEASE-TIME - T2)/2 ± ParamToleranceTime].

  Numeric bounds under retx envelope (kRetransmissionLeaseSeconds = 12 s):
    * LEASE-TIME = 12 s, T2 = lease*7/8 = 10 s.
    * (LEASE - T2)/2 = 1 s exact.
    * ParamToleranceTime default = 1 s (spec §4.7.5).
    * Bounds = [0 s, 2 s] = [0 us, 2 000 000 us]. The 0-lower bound is
      a soft floor; pcap dispatch jitter is sub-millisecond at the
      harness's 50 ms tick rate, so any in-spec REBINDING retx lands
      well above 0.

  Predicate: `captured.frame_delta_within_us(0, 2000000)`. The
  template's state-4 → state-5 transition records the first REBINDING
  REQUEST ts via the dispatcher's prev_observed_ts_us snapshot.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_06"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_retx_field.sce-template.xml"
           pass_expr="captured.frame_delta_within_us(0, 2000000)"
           fail_state="fail_rebinding_retx_interval_out_of_bounds"
           fail_reason="dut_rebinding_retx_interval_out_of_bounds"/>
</scxml>
