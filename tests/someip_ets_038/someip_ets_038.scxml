<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_038: echoUNION.

  Tester sends echoUNION (METHOD-ID 0x0019) with a SOME/IP union encoded
  per runtime defaults (unionLengthWidth = 4, unionTypeWidth = 4,
  unionDefaultOrder = true — length first, type second). Spec p401-420
  Type discriminants are 1-based: 1 = Boolean, 2 = uint8, 3 = uint16,
  4 = uint32, 5 = sint8, 6 = sint16.

  This case exercises Type 2 (uint8 = 0x42):
    Request payload (9 bytes):
      [00 00 00 01]        unionLength = 1 (size of uint8 in bytes)
      [00 00 00 02]        unionType   = 2 (= uint8)
      [42]                 value       = 0x42

  DUT echoes the request unchanged (PRS_SOMEIP_00119 + PRS_SOMEIP_00126).
  Pass cond pins all 9 response bytes individually so a regression that
  drops the union framing or rewrites the type discriminant lands on
  fail_phase2_union_echo_mismatch.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): Method Response (msg_type 0x80,
            return_code 0x00) on method_id 0x0019 with payload_len == 9
            and bytes [00,00,00,01,00,00,00,02,42] -> pass.
            Any other Response shape on the same method_id -> fail.
            No Response within the deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_038"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0019 and captured.return_code == 0x00 and captured.payload_equals(expected.payload_view())"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0019 and captured.message_type == 0x80 and !captured.payload_equals(expected.payload_view())"
                target="fail_phase2_union_echo_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_union_echo_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_union_response_did_not_match_request","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
