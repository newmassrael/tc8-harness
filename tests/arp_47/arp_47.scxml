<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_47: ARP Response Hardware Address Length shall equal
  ETHERNET_ADDR_LEN (6) per RFC 826. A tester ARP Request provokes the DUT
  Reply (opcode 2). Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_47"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 2 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.hw_addr_len == 6"
           fail_state="fail_hw_addr_len_not_six"
           fail_reason="reply_hw_addr_len_not_six"
           fail_role="observed_violation"
           inconclusive_reason="no_arp_reply_within_listen_window"/>
</scxml>
