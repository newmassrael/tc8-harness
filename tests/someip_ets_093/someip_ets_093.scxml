<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_093: SD_Check_Reboot_Detection_separate_multicast_and_unicast.

  Lite version: subtest A (multicast) only — 19-step spec procedure
  reduced to a 4-phase Ack-counting verdict (steps 1-12). Subtests B
  (unicast) and C (cross-channel robustness) are deferred to a future
  session because the spec's "initial event" wire signal (Notify of
  Field InterfaceVersion 0x8005) is not exposed by tc8-dut — our DUT
  fires only cyclic TestEventUINT8 (0x8001) which masks the
  initial-vs-cyclic discriminator. The lite verdict therefore asserts
  the wire-observable invariant: ALL three SubscribeEventgroupAcks are
  positive (ttl > 0) including the lower-session-id "reboot" Subscribe,
  i.e. the DUT does NOT reject a Subscribe whose session_id is lower
  than its predecessor (vsomeip's per-channel reboot tracker correctly
  expires + re-processes instead of Nack-ing).

  Stimulus chain (see src/sce_integration/cases/someip_ets_093.h):
    1. emitFindServiceBoot — SERVICE-ID-1 cyclic OfferService warm-up.
    2. Phase 2 onentry: emit FindService(mcast, sid=0x4, rb=1) +
       Subscribe(eg 0x5, sid=0x4, rb=1) — first Subscribe, normal cadence.
    3. Phase 3 onentry: emit FindService(mcast, sid=0x5, rb=1) +
       Subscribe(eg 0x5, sid=0x5, rb=1) — strict increment, no reboot.
    4. Phase 4 onentry: emit FindService(mcast, sid=0x1, rb=1) +
       Subscribe(eg 0x5, sid=0x1, rb=1) — both trackers fire is_reboot
       (5 >= 1), DUT expires + re-processes Subscribe; Ack must remain
       positive.

  Verdict (4-state):
    Phase 1 (listening_phase1, 6 s): observe OfferService for
            SERVICE-ID-1 (DUT cyclic warm-up gate).
    Phase 2 (listening_phase2_first_ack, 6 s): scheduler emits
            FindService #1 + Subscribe #1; expect SubscribeEventgroupAck
            with ttl > 0 on eg 0x0005.
    Phase 3 (listening_phase3_second_ack, 6 s): scheduler emits
            FindService #2 + Subscribe #2; expect Ack #2 (ttl > 0).
    Phase 4 (listening_phase4_reboot_ack, 6 s): scheduler emits
            FindService #3 (reboot sid=1) + Subscribe #3 (sid=1);
            expect Ack #3 (ttl > 0) — verifies DUT did not Nack the
            lower-sid Subscribe.

  Reference: PRS_SOMEIPSD_00157, SD §4.2.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_093"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_first_ack"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_first_ack">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <!-- DUT-emitted SubscribeEventgroupAck (Type 0x07, ttl > 0) for
         eventgroup 0x0005. -->
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == 0x0005"
                target="listening_phase3_second_ack"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0 and captured.sd_entries[0].eventgroup_id == 0x0005"
                target="fail_phase2_subscribe_nacked"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_first_ack"/>
  </state>

  <state id="listening_phase3_second_ack">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == 0x0005"
                target="listening_phase4_reboot_ack"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0 and captured.sd_entries[0].eventgroup_id == 0x0005"
                target="fail_phase3_subscribe_nacked"/>
    <transition event="phase3_deadline_exceeded" target="fail_phase3_no_second_ack"/>
  </state>

  <state id="listening_phase4_reboot_ack">
    <onentry>
      <send event="phase4_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == 0x0005"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0 and captured.sd_entries[0].eventgroup_id == 0x0005"
                target="fail_phase4_reboot_subscribe_nacked"/>
    <transition event="phase4_deadline_exceeded" target="fail_phase4_no_reboot_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"first_subscribe_eventgroup_nacked_ttl_zero"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_first_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_first_subscribe_eventgroup_ack_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"second_subscribe_eventgroup_nacked_ttl_zero"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_no_second_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_second_subscribe_eventgroup_ack_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase4_reboot_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"reboot_subscribe_eventgroup_nacked_ttl_zero"}</content>
    </donedata>
  </final>

  <final id="fail_phase4_no_reboot_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_reboot_subscribe_eventgroup_ack_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
