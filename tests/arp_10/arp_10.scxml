<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_10: ARP request sending (Hardware Address Length
  check). The DUT's emitted ARP Request must carry Hardware Address
  Length = 6 (ETHERNET_ADDR_LEN per RFC 826). Stimulus reuses the
  §5.1 Subscribe emit so the DUT's unicast Nack reply forces an ARP
  Request — see arp_07.scxml for the rationale.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_10"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac and captured.hw_addr_len == 6"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac and captured.hw_addr_len != 6"
                target="fail_hw_addr_len"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_hw_addr_len">
    <donedata>
      <content>{"verdict":"fail","reason":"hw_addr_len_not_six"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_arp_request_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
