<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_10: ARP request Hardware Address Length field shall
  carry ETHERNET_ADDR_LEN (6) per RFC 826. UT 0x02 egress provocation
  forces the DUT Request — see arp_07.scxml. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_10"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.hw_addr_len == 6"
           fail_state="fail_hw_addr_len"
           fail_reason="hw_addr_len_not_six"
           fail_role="observed_violation"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
