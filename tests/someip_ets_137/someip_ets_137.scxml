<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_137: SD_Option_shorter_with_unaligned_next_option.

  Tester sends a SubscribeEventgroup carrying two IPv4 Endpoint options
  whose individual Length fields are deliberately wrong-sized but whose
  total options array byte count stays at the canonical 24:
    - Option 1 (TCP)  declares Length=14 (canonical 9) + 5 dummy bytes appended.
    - Option 2 (UDP)  declares Length=4  (canonical 9) — body truncated.
  The entry's #Opt1 nibble is set to 2 so the parser walks both options.
  Per PRS_SOMEIPSD_00307 / 00393 / PRS_SOMEIPSD_00265 / 00274 the DUT
  must Nack. Lenient verdict accepts silent ignore — vsomeip's parser
  silent-drops on the misaligned next-option boundary.

    Phase 1: OfferService observation on SERVICE-ID-1.
    Phase 2: Type 0x07 entry on eg 0x0001 with ttl == 0 (Nack) → pass.
             Ack (ttl > 0) → fail. Deadline → pass (silent ignore).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_137"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="fail_phase2_dut_acked_misaligned_options"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_acked_misaligned_options">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_acked_misaligned_two_option_subscribe","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
