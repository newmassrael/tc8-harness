<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.5 IPv4_ADDRESSING_02: DUT silently discards an IPv4 UDP
  packet whose Destination Address is the Directed Broadcast address
  (<subnet-broadcast>, e.g. 172.16.0.255 for 172.16.0.0/24). Derived
  from RFC 791 §3.2, RFC 1122 §3.2.1.3 ("SHOULD silently discard").

  v3.0 Test Procedure (p001-p020.txt:485): TESTER sends a UDP Message
  to <directedBroadcastAddress>, then verifies via Upper Tester that
  the DUT's application layer did NOT receive it.

  Mechanism: same §4.8.5 UT channel as ADDRESSING_01, but the
  expected_received byte is 0 — the tc8-dut's data listener drops
  the datagram at the application layer when ipi_addr matches the
  iface's directed broadcast (upper_tester_server.cpp
  dataListenerLoop). Linux's kernel DOES deliver directed broadcasts
  to INADDR_ANY sockets, so the drop is an application decision per
  RFC 1122, not a kernel configuration.

  Body shared with ipv4_addressing_01 via sce:template; this consumer
  flips expected_received to 0 and supplies case-specific fail reason
  strings.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_addressing_02"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_received_directed_broadcast"
           fail_reason_timeout="no_ut_confirmation_for_directed_broadcast"/>
</scxml>
