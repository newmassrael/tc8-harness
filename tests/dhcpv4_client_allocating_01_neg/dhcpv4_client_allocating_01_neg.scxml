<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_01 negative — closes the
  self-reference trap on the positive _01 case (the client broadcasts
  DHCPDISCOVER; IPv4 destination MUST be 255.255.255.255, RFC 2131 §3.1).
  The positive's fail_dst_ip_not_broadcast branch is unreachable against
  a conformant tc8-dut, which always broadcasts.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorDiscoverDstUnicast flavor, which makes
  tc8-dut's emitDhcpMessage set the IPv4 destination to 192.0.2.1
  (RFC 5737 TEST-NET-1) instead of the limited broadcast. A conformant
  DUT (flavor None) broadcasts, so this negative distinguishes a buggy
  client from a conformant one.

  Pass = the unicast destination IS observed. fail_compliant = the client
  broadcast despite the flavor — the live conformant-DUT outcome and a
  flavor-wiring regression catch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_01_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.dst_ip_is_broadcast()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.dst_ip_is_broadcast()"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_dst_broadcast_despite_unicast_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
