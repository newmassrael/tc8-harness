<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_01 negative — closes the
  self-reference trap on the positive _01 case (the client broadcasts
  DHCPDISCOVER; IPv4 destination MUST be 255.255.255.255, RFC 2131 §3.1).
  The positive's fail_dst_ip_not_broadcast branch is unreachable against a
  conformant tc8-dut.

  Fault injection is a real firmware mutant: the
  kDhcpFlavorDiscoverDstUnicast flavor sends the DISCOVER to 192.0.2.1
  instead of the limited broadcast. A conformant client (flavor None)
  broadcasts, so fail_compliant is the live conformant-DUT outcome.

  Reuses the dhcpv4_discover_field template with pass_expr inverted
  (pass = unicast destination observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="!captured.dst_ip_is_broadcast()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_discover_dst_broadcast_despite_unicast_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
