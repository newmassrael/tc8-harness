<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_08, iteration 1 of 3: TCP, in CLOSED, LISTEN or SYN-SENT
  state, MUST not process a FIN. Derived from RFC 793 §3.9 p75 Event Processing (MUST). This
  iteration's state is CLOSED: the DUT MUST send an RST.

  A case of its own beside tcp_flags_processing_08_it2 (LISTEN) and _it3 (SYN-SENT). A closed
  port needs nothing of the DUT's control interface, so this iteration is measurable on any
  backend, which the other two are not.

  A bare FIN is injected to an unbound DUT port, so the DUT finds no socket and emits
  RST(seq=0) per RFC 793 §3.9. Same wire shape as the second iteration of TCP_BASICS_04.

  Negative IP-flip path: the src_ip-conjunct is unreachable, which lands on
  inconclusive_no_dut_rst at the 5 s deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_08_it1"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_dut_rst">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_dut_rst">
    <onentry><send event="deadline_dut_rst" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsClosedPort and captured.dst_port == ::tc8::sce::tcp::kBasicsTesterPort and (captured.flags &amp; 0x04) != 0 and captured.seq_num == 0"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kBasicsClosedPort and captured.dst_port == ::tc8::sce::tcp::kBasicsTesterPort and (captured.flags &amp; 0x04) != 0 and captured.seq_num != 0"
                target="fail_wrong_seq"/>
    <transition event="deadline_dut_rst" target="inconclusive_no_dut_rst"/>
  </state>

  <final id="pass">
    <donedata><content>{"verdict":"pass"}</content></donedata>
  </final>

  <final id="inconclusive_no_dut_rst">
    <donedata><content>{"verdict":"inconclusive","reason":"no_dut_rst_to_fin_in_closed","role":"precondition_unmet"}</content></donedata>
  </final>

  <final id="fail_wrong_seq">
    <donedata><content>{"verdict":"fail","reason":"dut_rst_seq_not_zero_after_fin_in_closed","role":"observed_violation"}</content></donedata>
  </final>
</scxml>
