<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.6.5 SOMEIPSRV_ONWIRE_05: Protocol Version is an 8-bit
  field that shall be set to 0x01 in every SOME/IP message. Tester
  invokes echoUINT8 (METHOD-ID-1-SI-1 = 0x0008) with the canonical
  Protocol Version 0x01; pass requires the matched Response carries
  protocol_version == 0x01.

  The full TC8 procedure also drives a wrong-PV (0xFF) Request and
  expects a SOMEIP_RET_CODE_E_WRONG_PROTOCOL_VERSION Error before the
  valid Request, but the wire-level invariant the spec body asserts is
  "DUT-emitted SOME/IP frames have Protocol Version 0x01". The
  positive-Request-only shape suffices to falsify a DUT that emits
  anything other than 0x01.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_onwire_05"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/someipsrv_rpc_field_check.sce-template.xml"
           phase2_filter="captured.service_id == expected.service_id and captured.message_type == 0x80"
           pass_expr="captured.protocol_version == 0x01"
           fail_state="fail_phase2_protocol_version_mismatch"
           fail_reason="response_protocol_version_not_0x01"/>
</scxml>
