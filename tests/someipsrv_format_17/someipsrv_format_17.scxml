<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.17 SOMEIPSRV_FORMAT_17: TTL (24-bit) of the Type 1 entry shall
  carry the configured SERVICE-ID-1-TTL. Injected at runtime via CLI option
  expect ttl=<n> into expected.ttl; smoke-test.sh supplies the
  tc8-dut default (3 seconds; see vsomeip.json service-discovery.ttl).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_17"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].ttl == expected.ttl"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].ttl != expected.ttl"
                target="fail_ttl"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_ttl">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_ttl_mismatch","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_notification_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
