<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.6 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_13 negative — tc8-dut DHCP
  retransmission-timing fault self-validation of the positive _13 backoff guard.
  The trait arms kDhcpFlavorRetxNoBackoff (UT 0x10 OpStartDhcpClient trailing
  flavor byte), so runLoop collapses the inter-DISCOVER wait to 0 — the
  retransmission interval falls far below the RFC 2131 §4.1 backoff range
  [FirstRetx-1, FirstRetx+1] = [3,5] s. The trait drives the same retx envelope
  the positive uses (retx_first_ms=4000, cap=64000, jitter=1000, retry_count=4);
  only the schedule is faulted, the DISCOVER shape stays conformant. Pass = the
  collapsed interval observed (first inter-DISCOVER delta NOT in [3,5] s);
  fail_compliant = the DUT backed off conformantly despite the flavor (fault
  inert). tc8-dut-only (the lwIP fixture carries no DHCP client).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_13_neg"
       datamodel="null"
       initial="listening_for_d1">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_d1">
    <onentry>
      <send event="s1_deadline" delay="3s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_d2"/>
    <transition event="s1_deadline" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_d2">
    <onentry>
      <send event="s2_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and not captured.frame_delta_within_us(3000000, 5000000)"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.frame_delta_within_us(3000000, 5000000)"
                target="fail_compliant"/>
    <transition event="s2_deadline" target="inconclusive_no_discover_2"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover_2">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_2","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_backed_off_despite_no_backoff_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
