<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.5 IPv4_AUTOCONF_LINKLOCAL_PACKETS_04: Link-Local Packets
  Are Not Forwarded.

  RFC 3927 §2.7 MUST: a host MUST NOT indiscriminately answer ARP
  Requests for addresses in the 169.254/16 prefix; it may only answer
  for the link-local address(es) it has legitimately claimed. The
  TESTER injects an ARP Request whose target_proto_ip is an
  ARBITRARY-IP-LINKLOCAL-ADDR (one the DUT has not claimed); the DUT
  MUST NOT emit an ARP Reply.

  Spec Test Procedure (tc8_p181-p200.txt:289..335):
    1-7.   DUT brings up iface, sends DHCPDISCOVER, then 3 ARP Probes
           for tentative LL_DUT.
    8.     Tester waits (PROBE_MAX*2)+ANNOUNCE_WAIT+ANNOUNCE_INTERVAL
           — i.e. through both Announces — for the DUT to commit.
    9.     Tester emits ARP Request:
           - sender_proto_ip = LL_TESTER (expected.tester_linklocal_ip)
           - target_proto_ip = ARBITRARY_LL (kArbitraryReservedLinkLocal-
                                              IpBe = 169.254.0.1)
           - sender_hw       = MAC-ADDR1 (kTesterInjectedMac)
           - target_hw       = NULL-MAC
    10-11. Listen window — DUT MUST NOT emit an ARP Reply for the
           ARBITRARY target.

  Pass criterion: absence of any DUT-emitted ARP Reply (opcode 2)
  during the post-claim window. The DUT's responder thread filters
  by `target_proto_ip == committed_LL_` (linklocal_autoconf.cpp's
  Reply branch); ARBITRARY_LL ≠ committed_LL by construction (it is
  in RFC 3927 §2.1's reserved range 169.254.0.0/24, never a valid
  pick), so the absence is enforced by the responder's filter. This
  case is the wire-level verification of that contract.

  Two-Announce gating (listening_pre_announce_1 → _2 → post_claim):
  spec step 8 explicitly waits through ANNOUNCE_INTERVAL so the
  inject lands AFTER both Announces have flown. Gating on Announce 2
  rather than Announce 1 keeps the trait spec-aligned and matches
  NETWORK_PARTITIONS_01's constraint (Announce 2's gratuitous-shape
  wire would otherwise pollute that case's absence window).

  Fast envelope wall budget:
    1.5 s initial-wait + 200 ms dhcp + 200 ms PROBE_WAIT
    + ~600 ms 3 Probes + 200 ms ANNOUNCE_WAIT
    + 200 ms ANNOUNCE_INTERVAL = ~2.9 s before Announce 2.
  Pre-claim deadline 6 s; post-claim absence window 3 s. case_timeout
  ~10 s carries comfortable margin.

  Notes Derived from RFC 3927 p16 section 2.7 (MUST).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_linklocal_packets_04"
       datamodel="null"
       initial="listening_pre_announce_1">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening_pre_announce_1">
    <onentry>
      <send event="claim_deadline" delay="6s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_announce() and captured.eth_src == expected.dut_iface_mac"
                target="listening_pre_announce_2"/>
    <transition event="claim_deadline" target="fail_no_claim_observed"/>
  </state>

  <state id="listening_pre_announce_2">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_announce() and captured.eth_src == expected.dut_iface_mac"
                target="listening_post_claim"/>
    <transition event="claim_deadline" target="fail_only_one_announce"/>
  </state>

  <state id="listening_post_claim">
    <onentry>
      <send event="absence_window_deadline" delay="3s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply() and captured.eth_src == expected.dut_iface_mac"
                target="fail_responded_to_arbitrary"/>
    <transition event="absence_window_deadline" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_claim_observed">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_announce_committed_link_local_address"}</content>
    </donedata>
  </final>

  <final id="fail_only_one_announce">
    <donedata>
      <content>{"verdict":"fail","reason":"fewer_than_2_arp_announces_within_deadline"}</content>
    </donedata>
  </final>

  <final id="fail_responded_to_arbitrary">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_arp_reply_for_arbitrary_link_local_target"}</content>
    </donedata>
  </final>
</scxml>
