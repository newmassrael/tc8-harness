<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_02: An ARP Announcement - II.
  DUT's first Announce has Source IP = Target IP = the announced
  link-local address (RFC 3927 §2.4 MUST: ARP Request where both the
  sender and target IP fields contain the IP address being announced).

  Spec Test Procedure (tc8_p161-p180.txt:535..580), step 11:
    Verify
      - Target IP Address = <DIFACE-0-IP-LINKLOCAL-ADDR>
      - Sender IP Address = <DIFACE-0-IP-LINKLOCAL-ADDR>

  Cluster filter already enforces sender_proto_ip != 0 (Announce vs
  Probe). The pass_expr adds the equality + LL-prefix requirement so
  a malformed Announce with mismatched sender/target or a non-LL
  sender_ip routes to the fail branch. Body shared via
  ipv4_linklocal_announce_field.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_02"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_announce_field.sce-template.xml"
           pass_expr="captured.sender_proto_ip == captured.target_proto_ip and captured.target_proto_ip_in_link_local_prefix()"
           fail_state="fail_announce_sender_target_ip_mismatch"
           fail_reason="dut_arp_announce_sender_target_ip_not_announced_ll"/>
</scxml>
