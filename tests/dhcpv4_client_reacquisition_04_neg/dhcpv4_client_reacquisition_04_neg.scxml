<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REACQUISITION_04 negative — the REBINDING
  DHCPREQUEST MUST be emitted within T2 ± ParamToleranceTime of the last
  DHCPACK (RFC 2131 §4.4.5). The positive's out-of-bounds branch is
  unreachable against a conformant tc8-dut, which arms T2 = lease*7/8.

  Fault injection is a real firmware mutant: the kDhcpFlavorRebindingEntryEarly
  flavor makes the harness-owned runBoundPhaseMachine collapse T2 onto T1, so
  the REBINDING REQUEST fires right after RENEWING and the last-ACK->REBINDING
  interval falls below the [4.25, 6.25] s window. A conformant client (flavor
  None) emits at T2 = 5 s, so this negative's fail_compliant branch is the live
  conformant-DUT outcome.

  Reuses the dhcpv4_rebinding_request_field template with pass_expr inverted
  (pass = the interval is observed OUTSIDE the window). timing_serial.

  tc8-dut-only (the lwIP fixture carries no DHCP client).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_reacquisition_04_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_request_field.sce-template.xml"
           pass_expr="!captured.ack_to_request_within_us(4250000, 6250000)"
           fail_state="fail_compliant"
           fail_reason="dut_rebinding_request_within_t2_window_despite_early_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
