<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_10: time interval
  between consecutive ARP Probes is in [PROBE_MIN, PROBE_MAX] with
  ±50 ms tolerance per spec note (RFC 3927 §2.2.1).

  Spec Test Procedure (tc8_p141-p160.txt:560..594):
    1-4. DUT brings up iface and sends DHCPDISCOVER.
    5-6. TESTER listens; DUT emits 3 ARP Request Messages.
    7-10. Verify Probe2-Probe1 and Probe3-Probe2 deltas are in
          [PROBE_MIN-50 ms, PROBE_MAX+50 ms] = [950 ms, 2050 ms].

  Cadence-bearing case: same RFC default knobs as _09.

  `ArpCaptured::frame_delta_us()` returns 0 on the first transition
  (no prior fired-frame baseline), so the listening->seen_1 step
  carries no delta guard — Probe1's arrival is the baseline.
  `ipv4_linklocal_common.h::dispatchArpFrame` snapshots
  `prev_observed_ts_us = observed_ts_us` only when the SM advances,
  which makes seen_1->seen_2's delta exactly Probe2.ts - Probe1.ts
  and seen_2->pass's delta exactly Probe3.ts - Probe2.ts.

  Bounds in microseconds:
    PROBE_MIN_US - 50000 = 950000
    PROBE_MAX_US + 50000 = 2050000
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_10"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="12s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="seen_1"/>
    <transition event="deadline_exceeded" target="fail_no_probes"/>
  </state>

  <state id="seen_1">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe() and captured.frame_delta_us() &gt;= 950000 and captured.frame_delta_us() &lt;= 2050000"
                target="seen_2"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_interval_out_of_range"/>
    <transition event="deadline_exceeded" target="fail_too_few_probes"/>
  </state>

  <state id="seen_2">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe() and captured.frame_delta_us() &gt;= 950000 and captured.frame_delta_us() &lt;= 2050000"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_interval_out_of_range"/>
    <transition event="deadline_exceeded" target="fail_too_few_probes"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_probes">
    <donedata>
      <content>{"verdict":"fail","reason":"no_arp_probe_after_ll_start"}</content>
    </donedata>
  </final>

  <final id="fail_too_few_probes">
    <donedata>
      <content>{"verdict":"fail","reason":"fewer_than_3_arp_probes_within_deadline"}</content>
    </donedata>
  </final>

  <final id="fail_interval_out_of_range">
    <donedata>
      <content>{"verdict":"fail","reason":"probe_interval_outside_rfc3927_bounds_with_50ms_tolerance"}</content>
    </donedata>
  </final>
</scxml>
