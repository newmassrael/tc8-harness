<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_10 negative —
  closes the self-reference trap on positive _10 (the gratuitous ARP
  Announce MUST carry the committed yiaddr as sender_proto_ip, RFC 2131
  §4.4.1).

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the AnnounceSenderIpWrong flavor (arp_probe_listen_ms=1500);
  no conflict is injected, so the listener times out and tc8-dut's
  emitArpAnnounce writes a wrong sentinel sender IP. A conformant client
  (flavor None) announces the committed IP, so this negative's
  fail_compliant branch is the live conformant-DUT outcome. The Probe stays
  conformant (the flavor only mutates the Announce).

  Reuses dhcpv4_init_alloc_arp_announce with the pass predicate inverted
  (pass = the malformed Announce is observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_10_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_init_alloc_arp_announce.sce-template.xml"
           pass_expr="!captured.arp.is_dhcp_arp_announce(expected.dhcpv4.offered_ip_be)"
           fail_state="fail_compliant"
           fail_reason="dut_arp_announce_carried_committed_ip_despite_wrong_sender_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
