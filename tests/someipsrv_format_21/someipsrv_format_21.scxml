<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.21 SOMEIPSRV_FORMAT_21: The Index First Option Run field
  of the Type 2 entry shall carry the index of the first option of this
  entry's first options run in the options array. For a Nack (no options)
  the index is 0 by default; for an Ack with at least one option the
  first run starts at offset 0 of the options array, so index == 0 holds
  in both cases against a well-behaved DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_21"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].index_first == 0"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].index_first != 0"
                target="fail_index_first"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_index_first">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_index_first_option_run_nonzero"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_ack_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
