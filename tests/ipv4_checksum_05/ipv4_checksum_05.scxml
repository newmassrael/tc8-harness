<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.2 IPv4_CHECKSUM_05: DUT's reply Echo Reply carries a
  header checksum equal to the 16-bit one's complement of the one's
  complement sum of all 16-bit header words. Derived from RFC 791
  section 3.1 p14 (Internet Header Format MUST).

  Stimulus: TESTER sends an Echo Request with the canonical valid
  checksum (pilot default). DUT replies with its own Echo Reply. SCXML
  verifies the DUT's reply checksum by independently re-running RFC 1071
  on the captured header scalars — pass iff the computed validation
  sums to zero, fail otherwise.

  Unlike HEADER/TTL/VERSION cases, the predicate is compound (multiple
  header fields feed RFC 1071), so it's exposed as a member method on
  Ipv4Captured instead of a simple comparison — SCE's codegen rewrite
  `captured.X` → `this->captured_->X` handles method calls the same way
  as fields.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_checksum_05"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Ipv4Captured"
               cpp:include="sce_integration/ipv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="ipv4_observed"
                cond="cpp:captured.src_addr == expected.dut_iface_ip and captured.header_checksum_valid()"
                target="pass"/>
    <transition event="ipv4_observed"
                cond="cpp:captured.src_addr == expected.dut_iface_ip and !captured.header_checksum_valid()"
                target="fail_checksum"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_checksum">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_reply_header_checksum_invalid"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ipv4_packet_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
