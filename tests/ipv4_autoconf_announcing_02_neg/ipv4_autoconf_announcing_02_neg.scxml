<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_02 negative — closes the
  self-reference trap on the positive _02 case. tc8-dut emits
  Announces via OpStartLLAutoconfBuggy(flavor=AnnounceSenderTargetMismatch):
  the first Announce's sender_proto_ip is driven to the DUT iface IP
  while target_proto_ip stays at the committed LL, violating RFC 3927
  RFC 3927 §2.4 (sender_ip == target_ip == announced LL).

  Pass = inverted pass_expr matched (sender != target OR target not in
  169.254/16). fail_compliant_emit = harness silently accepted the
  buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_02_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_announce_field.sce-template.xml"
           pass_expr="!(captured.sender_proto_ip == captured.target_proto_ip and captured.target_proto_ip_in_link_local_prefix())"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_announce_despite_sender_target_mismatch_flavor"/>
</scxml>
