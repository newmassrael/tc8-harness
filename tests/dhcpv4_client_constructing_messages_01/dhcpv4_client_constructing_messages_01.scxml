<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.6 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_01: The last option
  must always be the 'end' option (RFC 2131 §4.1).

  Spec Test Procedure (tc8_p241-p260.txt: CONSTRUCTING_MESSAGES_01):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER listens (no server reply — this case observes only the
         DUT-emitted DISCOVER).
    4.   DUT: Sends DHCPDISCOVER Message
    5.   TESTER: Verify received DISCOVER's options blob terminates on
         255 (End Option) at position Last.

  Same stimulus shape as PROTOCOL_01/02 / SUMMARY_04: tc8-dut emits one
  DHCPDISCOVER on receipt of OpStartLLAutoconf. The pass criterion is
  the `ends_with_end_option()` predicate which the pipeline's options
  walk populates by checking that the final TLV before running off the
  blob is the 0xFF END marker.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_01"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.ends_with_end_option()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.ends_with_end_option()"
                target="fail_last_option_not_end"/>
    <transition event="deadline_exceeded" target="inconclusive_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_last_option_not_end">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_last_option_not_end","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
