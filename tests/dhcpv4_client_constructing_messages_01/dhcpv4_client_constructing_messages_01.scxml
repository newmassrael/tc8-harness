<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.7 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_01: the last option in a
  DHCP message MUST be the END option (0xFF) (RFC 2131 §4.1).
  CONSTRUCTING_MESSAGES_01_NEG drives the firmware mutant that drops it.

  Reuses the dhcpv4_discover_field template (shared with the _neg sibling).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_01"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="captured.ends_with_end_option()"
           fail_state="fail_last_option_not_end"
           fail_reason="dut_dhcp_discover_last_option_not_end"/>
</scxml>
