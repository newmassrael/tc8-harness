<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.8 TCP_CLOSING_03 negative (ESTABLISHED) — lwIP TCP behavioral-synthesis
  self-validation of the positive _03 silent-close-on-RST-with-data guard. The positive drives
  the DUT to ESTABLISHED and injects an in-window RST+ACK carrying data, which a conformant DUT
  must absorb by transitioning to CLOSED without emitting any reply (RFC 1122 §4.2.2.12 /
  RFC 793 §3.4). This negative arms kTcpSynthRstOnDisruptive, so the lwIP netif input hook
  synthesizes the prohibited RST on the connection 4-tuple as that RST+ACK+data segment arrives
  (the RST flag trips the disruptive-union gate), proving the dut_emitted_response_to_rst_with_
  data_in_est fail-final reachable. Pass = that RST observed; fail_compliant = DUT stayed silent
  despite the flavor (fault inert). lwIP-only (kCapIngressFault). Shares the standard active-OPEN
  confirm-then-watch envelope. Envelope: tcp_synth_rst_watch_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_closing_03_neg"
       datamodel="null"
       initial="listening_handshake_ack">
  <sce:use template="../_templates/tcp_synth_rst_watch_neg.sce-template.xml"
           port_offset="71U"/>
</scxml>
