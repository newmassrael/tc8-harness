<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.6 UDP_INTRODUCTION_01: DUT denies a UDP datagram whose
  Destination IP Address is the directed broadcast of the iface's
  network. Spec inverts the RFC 1122 §4.1.1 SHOULD-allow due to the
  automotive security profile (note in spec body: "this test inverts
  the RFC requirement due to security negotiations").

  Test Procedure (p201-p220.txt:626):
    1. DUT CONFIGURE: Listen on <unusedUDPDstPort1> on <DIface-0>.
    2. DUT: Listen ...
    3. TESTER: Send UDP to <AIface-0-BcastIP>:<unusedUDPDstPort1>.
    4. TESTER: Verify via UT that the application layer did not receive.

  Mechanism: identical wire shape to IPV4_ADDRESSING_02 (directed
  broadcast → DUT data listener silent-drops via `ipi_addr ==
  iface_broadcast` filter, RFC 1122 §3.2.1.3). The two cases differ
  only in the spec invariant they pin (RFC 1122 §3.2.1.3 IP-layer
  silent discard vs §4.1.1 application-layer deny); registering both
  guards against drift if a future tc8-dut refactor changes which
  layer enforces the discard.

  Reuses ipv4_udp_ut_presence with expected_received=0.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_introduction_01"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_received_directed_broadcast_udp"
           fail_reason_timeout="no_ut_confirmation_for_directed_broadcast_deny"/>
</scxml>
