<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_033: echoUINT8ArrayMinSize_too_short.

  Spec mandates DUT returns Error MALFORMED_MESSAGE when the array
  carries fewer than the deployment-defined minimum (3 elements).
  CommonAPI-SOMEIP on Linux ignores SomeIpArrayMinLength when
  SomeIpArrayLengthWidth != 0 (per the upstream all_features.fdepl
  comment), so the MinSize axis cannot be observed directly. We
  instead drive the malformed-length axis (Wave 2 ETS_001/_002
  pattern) on the same METHOD-ID 0x0037: SOME/IP Length header
  claims 0x100 bytes follow Request ID, while the UDP datagram
  carries only the short-array body. vsomeip rejects the frame at
  parse time per PRS_SOMEIP_00099 — pass shape is Error Response
  (msg_type 0x81) OR silent ignore.

    Phase 1 (listening_phase1): OfferService observation.
    Phase 2 (listening_phase2): Error Response (pass) OR no
            Response within the deadline (also pass per Notes).
            A normal echo Response with valid return_code 0x00 →
            fail (DUT accepted the malformed input).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_033"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0037 and captured.message_type == 0x81"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0037 and captured.message_type == 0x80 and captured.return_code != 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0037 and captured.message_type == 0x80 and captured.return_code == 0x00"
                target="fail_phase2_dut_accepted_malformed"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_accepted_malformed">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_returned_ok_response_for_too_short_array","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
