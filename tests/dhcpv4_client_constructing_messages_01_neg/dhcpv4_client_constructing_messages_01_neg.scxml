<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.7 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_01 negative — closes
  the self-reference trap on the positive _01 case (the last option MUST
  always be the END option 0xFF, RFC 2131 §4.1). The positive's
  fail_last_option_not_end branch is unreachable against a conformant
  tc8-dut, which always terminates its options blob on 0xFF.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorDiscoverDropEnd flavor, which makes
  tc8-dut's emitDhcpMessage emit a PAD (0x00) in place of the trailing
  END option, so the options walk runs off the blob without seeing END.
  A conformant DUT (flavor None) ends on 0xFF, so this negative
  distinguishes a buggy client from a conformant one.

  Pass = the missing END IS observed (ends_with_end_option false on a
  DUT-emitted DISCOVER). fail_compliant = the client terminated on END
  despite the flavor — the live conformant-DUT outcome and a
  flavor-wiring regression catch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_01_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.ends_with_end_option()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.ends_with_end_option()"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_ended_with_end_option_despite_drop_end_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
