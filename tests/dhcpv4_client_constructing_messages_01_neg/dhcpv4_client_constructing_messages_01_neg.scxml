<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.7 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_01 negative — closes
  the self-reference trap on the positive _01 case (the last option MUST
  be the END option 0xFF, RFC 2131 §4.1). The positive's
  fail_last_option_not_end branch is unreachable against a conformant
  tc8-dut.

  Fault injection is a real firmware mutant: the
  kDhcpFlavorDiscoverDropEnd flavor emits a PAD (0x00) in place of the
  trailing END. A conformant client (flavor None) ends on 0xFF, so
  fail_compliant is the live conformant-DUT outcome.

  Reuses the dhcpv4_discover_field template with pass_expr inverted
  (pass = missing END observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="!captured.ends_with_end_option()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_discover_ended_with_end_option_despite_drop_end_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
