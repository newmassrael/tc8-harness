<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_07 negative — closes
  the self-reference trap on the positive _07 case. tc8-dut emits
  Probes via OpStartLLAutoconfBuggy(flavor=TargetHwNonzero):
  target_hw = DE:AD:BE:EF:00:00 (RFC 3927 §2.2.1 SHOULD = 0).

  Pass = SCXML lands on fail_target_hw_not_zero branch — the
  violation is detected. fail_compliant_emit = tc8-dut ignored the
  flavor byte, harness silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_07_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="!captured.target_hw_is_zero()"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_probe_despite_target_hw_nonzero_flavor"/>
</scxml>
