<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.7.11 SOMEIPSRV_RPC_11: The setter of a field shall be
  a request/response call. Request payload carries the value to set;
  Response payload carries the value that was set. Tester sends a
  Method Request to METHOD-ID-2-SI-1 (fieldA setter = 0x42 — relocated
  from 0x41 because spec table p401-420 reserves 0x41 for echoBitfields)
  with payload [0x42]; DUT replies with a Response (msg_type 0x80)
  carrying return_code E_OK and a payload starting with 0x42.

    Phase 1: DUT emits OfferService for SERVICE-ID-1.
    Phase 2: 5 s window. Pass requires Response with method_id 0x42,
             return_code 0x00, payload_len &gt; 0, and the first
             payload byte == 0x42. Fail (payload_mismatch) catches
             Responses that arrived with the wrong echoed value;
             inconclusive_phase2_no_response catches the no-response timeout.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_rpc_11"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0042 and captured.return_code == 0x00 and captured.payload_len > 0 and captured.payload_snapshot[0] == 0x42"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0042 and (captured.payload_len == 0 or captured.payload_snapshot[0] != 0x42)"
                target="fail_phase2_payload_mismatch"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_payload_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"setter_response_payload_did_not_echo_set_value","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_setter_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
