<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_43: ARP Response (Ethernet Source Hardware Address
  check). Tester injects an ARP Request; DUT must reply with the
  Ethernet Source set to its own interface MAC. The captured `eth_src`
  field of the received ARP frame is checked distinctly from the
  payload-level `sender_hw` so a misbehaving DUT that answers with
  mismatched Eth/ARP MACs is caught.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_43"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 2 and captured.sender_hw == expected.dut_iface_mac and captured.eth_src == expected.dut_iface_mac"
                target="pass"/>
    <!--
      Fail guard filters by opcode==2 only; dropping the `sender_hw ==
      expected.dut_iface_mac` conjunction so smoke-test `negative` rows
      that override `arp.dut_iface_mac` actually reach this branch.
      Otherwise the override falsifies every ARP-observed transition and
      the case silently lands on fail_no_reply. Safe because the only
      opcode==2 frames on the wire in this test are DUT replies to our
      injected Request: the tester stimulus is a Request (opcode=1) and
      there is no cross-case pcap leakage (pcap is per-case).
    -->
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 2 and captured.eth_src != expected.dut_iface_mac"
                target="fail_eth_src_not_dut_mac"/>
    <transition event="deadline_exceeded" target="fail_no_reply"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_eth_src_not_dut_mac">
    <donedata>
      <content>{"verdict":"fail","reason":"eth_src_not_dut_iface_mac"}</content>
    </donedata>
  </final>

  <final id="fail_no_reply">
    <donedata>
      <content>{"verdict":"fail","reason":"no_arp_reply_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
