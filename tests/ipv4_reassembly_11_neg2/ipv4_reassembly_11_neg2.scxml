<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.7 IPv4_REASSEMBLY_11 negative (identifier variant) — lwIP egress-fault
  self-validation of the positive's `echo_id_mismatch_after_large_ttl_reassembly`
  guard. The trait arms kIcmpFaultEchoIdWrong and sends the positive's two
  Large-TTL fragments back to back; lwIP reassembles them and the link-output
  hook XOR-flips the identifier of its Echo Reply. Pass = the flipped identifier
  observed (the positive's guard, verbatim); fail_compliant = the DUT echoed the
  identifier despite the flavor (fault inert). That an Echo Reply arrives at all
  shows lwIP reassembled this exact stimulus.

  Neither reference DUT reaches the positive's reply (docs/tech-debt.md TD-28);
  the guard reads only the reply frame. lwIP-only (kCapEgressFault). Envelope:
  icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_reassembly_11_neg2"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 0"
           pass_expr="captured.echo_id != expected.echo_id"
           fail_state="fail_compliant"
           fail_reason="dut_echoed_id_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_echo_reply_after_reassembly_within_listen_window"/>
</scxml>
