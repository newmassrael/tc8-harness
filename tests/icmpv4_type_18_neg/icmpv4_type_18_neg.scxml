<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.3.3.2 ICMPv4_TYPE_18 negative — lwIP egress-fault self-validation of the
  positive _18 Destination Unreachable code guard. The trait arms
  kIcmpFaultDestUnreachCodeWrong, so the lwIP link-output hook XOR-flips the code of the
  DUT's Destination Unreachable reply (gated on type=3; type untouched so the filter
  still selects it). Pass = the corrupted code observed (code != 2, the Protocol
  Unreachable value RFC 1122 §3.2.2.1 mandates); fail_compliant = the DUT emitted code 2
  despite the flavor (fault inert). lwIP-only (capability-gated on kCapEgressFault).
  Envelope: icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="icmpv4_type_18_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 3 and captured.src_ip == expected.dut_iface_ip"
           pass_expr="captured.code != 2"
           fail_state="fail_compliant"
           fail_reason="dut_dest_unreach_code_correct_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dest_unreachable_within_listen_window"/>
</scxml>
