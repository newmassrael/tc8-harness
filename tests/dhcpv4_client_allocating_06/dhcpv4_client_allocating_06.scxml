<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_06: the client times out and
  retransmits DHCPDISCOVER if no DHCPOFFER arrives (RFC 2131 §3.1, MUST).

  Case shape:
    the tester listens twice over and never offers anything. With no
    answer coming, the DUT has to discover a second time — a client
    that hears nothing retries rather than stopping.

  No OFFER injection — the absence of a server reply forces the DUT's
  retransmission path. Pilot uses retry_count=2 + retry_interval_ms=1000
  + offer_wait_ms=2000 (`emitStartDhcpClientWithRetransmission`), so the
  observed sequence is DISCOVER#1 → 2 s timeout → 1 s retry sleep →
  DISCOVER#2 → 2 s timeout (DUT then aborts; the harness only needs to
  see #1 and #2).

  Listening windows:
    listening_for_first_discover  (deadline 6 s, covers pilot bootstrap +
                                   1.5 s initial wait + DISCOVER#1)
    listening_for_second_discover (deadline 11 s = <ParamListenTime>
                                   plus <ParamToleranceTime>)

  The first DISCOVER starts the process the case builds on, so its
  absence stays inconclusive. The procedure listens up to
  <ParamListenTime> for the retransmission, so a window that elapses
  without it is the DUT's silence where it must retransmit —
  observed_quiescence, judged against that bound (H3). Whether the
  silence stands as a fail is the CLI's call on the run's hypotheses.
  Each state's deadline event is its own, so the first window's timer
  cannot close the second early.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_06"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_for_first_discover">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_first_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover() and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_second_discover"/>
    <transition event="s1_deadline" target="inconclusive_no_first_discover"/>
  </state>

  <state id="listening_for_second_discover">
    <onentry>
      <send event="s2_deadline" delay="11s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover() and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="pass"/>
    <transition event="s2_deadline" target="fail_no_resend"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_first_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_no_resend">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_discover_retransmission","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
