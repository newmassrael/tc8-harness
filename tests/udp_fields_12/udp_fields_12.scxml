<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_12: DUT accepts a UDP datagram whose Length
  field is set to the maximum supported value (RFC 768 'Fields' MUST).
  IPv4: 65 507 B payload (65 535 - 20 IP - 8 UDP). Tester injects a
  single UDP datagram split across ~45 IP fragments at 1480 B each;
  DUT's IP reassembly stitches them and delivers the full 65 515 B
  datagram to the data listener. UT GetReceivedUdp Confirmation
  reports `payload_len == 65507`.

  Reuses udp_ut_received_check (3-state: Confirmation arrives with
  ut_received==1 + payload-length predicate). Distinct from the
  payload-bytes consumers (UI_02) by pivoting on `ut_recv_payload_len`
  instead of byte equality — payload bytes [0..15] are kFragmentsEcho
  filler; the spec assertion is on the length, not on byte contents.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_12"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/udp_ut_received_check.sce-template.xml"
           pass_expr="captured.ut_recv_payload_len == 65507"
           fail_reason_field="dut_received_udp_with_unexpected_payload_length"
           fail_reason_timeout="no_ut_confirmation_for_max_length_udp"/>
</scxml>
