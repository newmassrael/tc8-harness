<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.17 TCP_SEQUENCE_04 negative — lwIP egress-fault self-validation of the
  positive _04 SYN,ACK ack_num guard (from LISTEN, the DUT's SYN,ACK acks tester ISN+1;
  here tester ISN=0xFFFFFFFF so ack_num wraps to 0). The trait arms kTcpFaultSynAckAckWrong,
  so the link-output hook flips the ack of the passive-open SYN,ACK (flags stay SYN+ACK so
  the filter still selects it). Pass = the corrupted ack observed (ack_num != 0);
  fail_compliant = the DUT acked correctly despite the flavor (fault inert). lwIP-only
  (kCapEgressFault). Envelope: tcp_egress_field_check. Same flavor as tcp_sequence_01_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_sequence_04_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_dut_syn_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpSequence04ListenPort, ::tc8::sce::tcp::kTcpSequence04TesterSrcPort)"
           pass_expr="captured.ack_num != 0U"
           fail_state="fail_compliant"
           fail_reason="dut_synack_acked_tester_isn_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_syn_ack_within_listen_window"/>
</scxml>
