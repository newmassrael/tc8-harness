<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.5 UDP_USER_INTERFACE_03: receive operations return the
  source UDP port correctly (RFC 768 'User Interface' MUST). Tester
  sends UDP with src_port=<unusedUDPSrcPort>=20019; UT GetReceivedUdp
  Confirmation surfaces the observed src_port in the response trailer;
  SCXML asserts ut_recv_src_port == 20019.

  Note: the trait uses a unique src_port (20019) per case to dodge
  cross-case state from a prior worker iteration repopulating the UT
  log. Smoke-test runs one worker at a time per case_id but each
  positive+negative iteration uses the same netns; per-case unique
  src_port keeps the SCXML's last-receipt assertion local.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_user_interface_03"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/udp_ut_received_check.sce-template.xml"
           pass_expr="captured.ut_recv_src_port == 20019"
           fail_reason_field="dut_received_udp_with_wrong_src_port_in_confirmation"
           fail_reason_timeout="no_ut_confirmation_for_src_port_check"/>
</scxml>
