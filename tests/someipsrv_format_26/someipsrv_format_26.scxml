<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.26 SOMEIPSRV_FORMAT_26: TTL field of the Type 2 entry
  shall carry the configured lifetime (SdServerTimerTTL /
  SdClientTimerTTL). Spec body Pass Criteria step 8 explicitly verifies
  the Subscribe**Ack** TTL equals SERVICE-ID-1-TTL — the trait stimulus
  subscribes to eventgroup 0x0002 (configured under TestEventUINT8 in
  dut/ets/ets.fdepl + dut/dut_service/vsomeip.json) so vsomeip Acks with
  TTL > 0. Strict cond rejects a Nack-shaped TTL=0 reply so a
  vsomeip configuration regression that silently Nacks the Subscribe
  surfaces here instead of masking through the false-positive
  Nack-accept clause that the original guard carried.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_26"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == expected.ttl"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl != expected.ttl"
                target="fail_ttl"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_ttl">
    <donedata>
      <content>{"verdict":"fail","reason":"entry_ttl_mismatch"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_ack_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
