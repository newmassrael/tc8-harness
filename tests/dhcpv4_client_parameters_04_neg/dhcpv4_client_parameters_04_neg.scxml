<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.5 DHCPv4_CLIENT_PARAMETERS_04 negative — closes the
  self-reference trap on the positive _04 case (if the DISCOVER carries
  Option 55 (Parameter Request List), the SELECTING DHCPREQUEST MUST repeat
  the same byte sequence, RFC 2131 §4.3.6). The positive's mismatch branch
  is unreachable against a conformant tc8-dut, which echoes the DISCOVER's
  Option 55 = {1, 3, 6, 15} verbatim in the REQUEST.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorRequestParamListMismatch flavor, gated to the
  post-OFFER SELECTING REQUEST (the DISCOVER stays conformant so the OFFER
  still matches and the lifecycle reaches REQUEST). tc8-dut then corrupts one
  Option 55 byte in the REQUEST while the DISCOVER snapshot holds the real
  list, so option_param_request_list_matches_discover() is false. A
  conformant client (flavor None) repeats the list, so this negative's
  fail_compliant branch is the live conformant-DUT outcome.

  Reuses the positive's dhcpv4_request_field template with pass_expr inverted
  (pass = Option 55 mismatch observed); fail_compliant fires when the client
  repeated the DISCOVER's list despite the flavor. The trait arms
  scheduleDiscoverSnapshotOnStateEntry so the guard can compare against the
  DISCOVER snapshot.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_parameters_04_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="!captured.option_param_request_list_matches_discover()"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_request_echoed_discover_param_list_despite_param_list_mismatch_flavor"/>
</scxml>
