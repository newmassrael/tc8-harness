<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.11 TCP_RETRANSMISSION_TO_06: TCP SHOULD use RTO = 1 sec
  initially (RFC 6298 §2.1 SHOULD).

  v3.0 Test Procedure (p371):
    1. TESTER: Cause the application on the DUT-side to issue an
               active OPEN call.
    2. DUT:    Send a SYN.
    3. TESTER: Do not send SYN,ACK.
    4. DUT:    Retransmit the SYN segment after a timeout.
    5. TESTER: Verify that the DUT used a timeout according to the
               referenced RFC.

  Mechanism (kernel-side TCP_INFO observation, single snapshot before
  retx fires):
    The earlier pcap-timing approach (observe inter-frame delta between
    first SYN and retx 1) was deterministic at workers=1 but flaked
    under workers=4 parallel load — pcap's SOFTIRQ delivery raced the
    SCXML's 2.5 s deadline guard on the retx-observation phase.
    Replacing the wire-timing assertion with one synchronous
    OpQueryTcpInfo (0x13) read off the DUT's connect-side fd (set by
    openTcpActive BEFORE the connector worker is spawned —
    upper_tester_server.cpp:1199, so the fd is queryable while in
    TCP_SYN_SENT) makes the verdict a function of kernel state, not
    pcap delivery latency. Stimulus phases:

    1. Active OPEN to a tester-side port with no listener; tester-
       kernel auto-RST is silently swallowed by `TesterAutoRstDrop` so
       the DUT stays in TCP_SYN_SENT and the retransmit timer remains
       armed at TCP_TIMEOUT_INIT (= 1 s on Linux 6.x).
    2. **Phase 1 snapshot** (captured BEFORE retx 1 fires): poll
       OpQueryTcpInfo at 50 ms cadence until the kernel reports state
       == TCP_SYN_SENT AND retransmits == 0. The first valid snapshot
       satisfying both is the initial-RTO observation — `tcpi_rto`
       reflects the value the kernel will use for the upcoming retx,
       i.e. RFC 6298 §2.1's initial RTO.

  Pass criteria (single state, fail-first cond chain):
    * ut_handshake_completed       — proves the DUT opened the socket
      and the connector worker called connect() (set when the polling
      loop first observes state == TCP_SYN_SENT). Doubles as the
      negative-flip detector: ipv4.dut_iface_ip=10.99.99.99 → UT RPC
      never reaches DUT → snap.valid stays false → flag stays false.
    * ut_tcpi_p1_valid             — RPC round-trip succeeded.
    * ut_tcpi_p1_state == 2 (TCP_SYN_SENT) — kernel armed the SYN.
    * ut_tcpi_p1_retransmits == 0  — snapshot caught the initial-RTO
      window before retx 1 doubled icsk_rto.
    * ut_tcpi_p1_rto_us in [800000, 1500000] — RFC 6298 §2.1's "RTO
      SHOULD be set to 1 second" with tolerance for Linux's HZ
      quantisation and worker-thread scheduling jitter.

  SCXML shape — single state with a `<send delay="0ms"/>`-raised
  evaluation event, multiple cond-keyed transitions; first matching
  transition wins per W3C SCXML RFC 793 §3.13. Mirrors the _03/_04 evaluate
  pattern exactly. delay=0ms is the minimal scheduler tick required to
  flush the stimulus-mutated `captured` into the cond evaluator's view.

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes the UT RPC
  request unreachable; queryTcpInfoSync returns valid=false on every
  poll, ut_handshake_completed stays false, and the SCXML's first
  cond verdicts as `fail:dut_handshake_did_not_complete`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_06"
       datamodel="null"
       initial="evaluate_kernel_observations">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="evaluate_kernel_observations">
    <onentry>
      <send event="evaluate" delay="0ms"/>
    </onentry>
    <transition event="evaluate"
                cond="cpp:not captured.ut_handshake_completed"
                target="fail_handshake_did_not_complete"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p1_valid"
                target="fail_phase1_query_failed"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_state != 2U"
                target="fail_socket_not_syn_sent"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_retransmits != 0U"
                target="fail_initial_window_missed"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_rto_us &lt; 800000U or captured.ut_tcpi_p1_rto_us &gt; 1500000U"
                target="fail_initial_rto_out_of_window"/>
    <transition event="evaluate" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_handshake_did_not_complete">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_handshake_did_not_complete"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_query_failed">
    <donedata>
      <content>{"verdict":"fail","reason":"phase1_tcp_info_query_failed"}</content>
    </donedata>
  </final>

  <final id="fail_socket_not_syn_sent">
    <donedata>
      <content>{"verdict":"fail","reason":"socket_state_not_syn_sent"}</content>
    </donedata>
  </final>

  <final id="fail_initial_window_missed">
    <donedata>
      <content>{"verdict":"fail","reason":"initial_rto_window_missed_retransmit_already_fired"}</content>
    </donedata>
  </final>

  <final id="fail_initial_rto_out_of_window">
    <donedata>
      <content>{"verdict":"fail","reason":"initial_rto_out_of_rfc6298_window"}</content>
    </donedata>
  </final>
</scxml>
