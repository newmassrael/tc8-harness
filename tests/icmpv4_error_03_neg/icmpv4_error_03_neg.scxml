<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.3.3.1 ICMPv4_ERROR_03 negative — lwIP ingress-fault self-validation of the
  positive _03 Parameter-Problem-absence guard. The trait injects the 2-fragment
  sequence (a malformed Timestamp option on a non-zero-offset fragment, which a
  conformant options parser skips) and arms kIcmpFaultSynthParamProblem, so the lwIP
  netif input hook synthesizes the prohibited Parameter Problem (type=12). Pass = that
  reply observed; fail_compliant = DUT stayed silent despite the flavor (fault inert).
  lwIP-only (capability-gated on kCapIngressFault). Envelope: icmpv4_synth_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="icmpv4_error_03_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_synth_neg.sce-template.xml"/>
</scxml>
