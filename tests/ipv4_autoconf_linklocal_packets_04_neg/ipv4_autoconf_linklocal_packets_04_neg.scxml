<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.5 IPv4_AUTOCONF_LINKLOCAL_PACKETS_04 negative — closes
  the self-reference trap on the positive _04 case. tc8-dut runs the
  LL claim via OpStartLLAutoconfBuggy(flavor=ReplyToArbitraryTarget):
  its post-claim responder answers the tester's ARP Request for an
  ARBITRARY (unclaimed) 169.254/16 target, violating RFC 3927 §2.7
  (a host MUST answer only for the link-local address it has claimed).

  Same two-Announce gating as the positive _04 (pre_announce_1 →
  pre_announce_2 → post_claim); the shared
  scheduleArbitraryTargetTesterRequest observer emits the
  arbitrary-target Request on post_claim entry. The buggy responder
  then emits a Reply for the unclaimed target.

  Pass = a DUT-emitted Reply is observed (is_arp_reply + eth_src ==
  DUT MAC) — the violation is detected. fail_compliant_silence =
  the DUT stayed silent for the full absence window, meaning the
  flavor did not take effect and the harness would have silently
  accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_linklocal_packets_04_neg"
       datamodel="null"
       initial="listening_pre_announce_1">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening_pre_announce_1">
    <onentry>
      <send event="claim_deadline" delay="6s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_announce() and captured.eth_src == expected.dut_iface_mac"
                target="listening_pre_announce_2"/>
    <transition event="claim_deadline" target="inconclusive_no_claim_observed"/>
  </state>

  <state id="listening_pre_announce_2">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_announce() and captured.eth_src == expected.dut_iface_mac"
                target="listening_post_claim"/>
    <transition event="claim_deadline" target="inconclusive_only_one_announce"/>
  </state>

  <state id="listening_post_claim">
    <onentry>
      <send event="absence_window_deadline" delay="3s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_reply() and captured.eth_src == expected.dut_iface_mac"
                target="pass"/>
    <transition event="absence_window_deadline" target="fail_compliant_silence"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_claim_observed">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_announce_committed_link_local_address","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_only_one_announce">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"fewer_than_2_arp_announces_within_deadline","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_silence">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_stayed_silent_despite_reply_to_arbitrary_target_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
