<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.4 IPv4_VERSION_04: DUT silently discards an IPv4 packet
  whose Version field is other than 4. Derived from RFC 791 section 3.1
  and RFC 1122 section 3.2.1.1.

  Stimulus: TESTER injects an ICMPv4 Echo Request whose IP header
  Version nibble is 6 while IHL stays 5 and the checksum is valid over
  the overridden byte. A conformant DUT drops on the Version check
  before routing; no Echo Reply reaches the tester.

  Body shared with HEADER_02 / 04 / 08 / 09, CHECKSUM_02, ADDRESSING_03
  via sce:template (tests/_templates/ipv4_negative_absence.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_version_04"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_negative_absence.sce-template.xml"
           fail_reason="dut_replied_despite_non_version_4"/>
</scxml>
