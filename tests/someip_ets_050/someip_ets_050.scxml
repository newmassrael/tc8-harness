<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_050: echoUTF8DYNAMIC_length_too_short_for_malformed_String.

  UTF-8 mirror of ETS_041. Tester sends a valid 132-byte UTF-8 Request
  first (length prefix 0x80 = 128 bytes follow = BOM 3 B + 124 'H'
  chars + 1 B trailing null) and expects a normal echo. Tester then
  sends the same 132-byte wire shape with the 4-byte string-length
  prefix corrupted to 0x02 — claims only 2 bytes follow, DUT's
  CommonAPI deserializer cannot find the trailing null within those
  2 bytes -> errorOccurred_ -> Error Response (msg_type 0x81 +
  return_code 0x09 E_MALFORMED_MESSAGE) per PRS_SOMEIP_00372 +
  PRS_SOMEIP_00087.

  Two requests with explicit session_id pinning:
    - 1st: session_id 0x0001, valid string-length 0x80
    - 2nd: session_id 0x0002, malformed string-length 0x02

  Phase 1: SD OfferService.
  Phase 2: Method Response on session_id 0x0001 with return_code 0x00
           and payload_len 132 -> phase 3.
  Phase 3: lenient verdict on session_id 0x0002 (Error / non-zero RC /
           deadline -> pass; OK echo -> fail).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_050"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0015 and captured.session_id == 0x0001 and captured.return_code == 0x00 and captured.payload_len == 132 and captured.payload_bytes_eq({0x00, 0x00, 0x00, 0x80, 0xEF, 0xBB, 0xBF, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x48, 0x00})"
                target="listening_phase3"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_valid_echo"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0015 and captured.session_id == 0x0002 and captured.message_type == 0x81"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0015 and captured.session_id == 0x0002 and captured.message_type == 0x80 and captured.return_code != 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0015 and captured.session_id == 0x0002 and captured.message_type == 0x80 and captured.return_code == 0x00"
                target="fail_phase3_dut_accepted_malformed"/>
    <transition event="phase3_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_valid_echo">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_did_not_echo_valid_first_request","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_dut_accepted_malformed">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_returned_ok_response_for_truncated_inner_string_length","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
