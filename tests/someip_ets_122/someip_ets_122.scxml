<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_122: SD_Interface_Version.

  Tester triggers the InterfaceVersion Getter Method (method_id 0x25
  per spec p401-420 Table 2). DUT must return a method response per
  PRS_SOMEIPSD_00357. tc8-dut does not declare an InterfaceVersion
  Field in ets.fidl/.fdepl, so vsomeip's routing layer responds with
  an Error Response (msg_type 0x81 + return_code 0x05/0x06 — UNKNOWN_
  SERVICE_INSTANCE / UNKNOWN_METHOD). Per SOME/IP §4.6, an Error
  Response IS a method response. Lenient verdict accepts any method
  response (msg_type 0x80 OR 0x81) on method_id 0x25; only silent
  ignore (deadline) lands on fail.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2): A Method Response (msg_type 0x80) or
            Error Response (msg_type 0x81) on method_id 0x25 -> pass.
            No Response within the deadline -> fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_122"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0025 and (captured.message_type == 0x80 or captured.message_type == 0x81)"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_method_response_within_listen_window_for_interface_version_getter","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
