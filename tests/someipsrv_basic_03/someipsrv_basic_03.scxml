<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.5.3 SOMEIPSRV_BASIC_03: Method-IDs use highest bit = 0
  for methods, highest bit = 1 for events / notifications. Three-phase
  observation:

    Phase 1 (listening_phase1): DUT emits an OfferService for SERVICE-ID-1
            in response to the tester's FindService stimulus, carrying
            >= 1 IPv4 Endpoint Option. SD entry type 0x01,
            sd_ipv4_endpoint_count >= 1.
    Phase 2 (listening_phase2): DUT replies to the tester's
            SubscribeEventgroup with a SubscribeEventgroupAck (Type 2
            entry, type=0x07, ttl > 0 differentiates from Nack).
    Phase 3 (listening_phase3): DUT emits a Notification carrying
            method_id with the highest bit (0x8000) set to 1.
            tc8-dut's TestEventUINT8 has SomeIpEventID=0x8001 in
            ets.fdepl, so the parsed method_id surface will reflect
            that.

  Stimulus issues FindService then SubscribeEventgroup sequentially via
  emitFindServiceBoot + emitSubscribeEventgroupBoot. Subscribe targets
  eventgroup 0x0002 (TestEventUINT8 group declared in fdepl plus the
  new vsomeip.json events block); the per-case `expect eventgroup_id=
  0x0002` override (smoke-test.sh) keeps the SCXML eventgroup_id
  assertion consistent with the stimulus.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_basic_03"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_ipv4_endpoint_count >= 1"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer_with_endpoint"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl &gt; 0 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id"
                target="listening_phase3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].ttl == 0"
                target="fail_phase2_subscribe_nacked"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_subscribe_ack"/>
  </state>

  <state id="listening_phase3">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x02 and (captured.method_id &amp; 0x8000) == 0x8000"
                target="pass"/>
    <transition event="phase3_deadline_exceeded" target="fail_phase3_no_notification"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer_with_endpoint">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_with_ipv4_endpoint_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_subscribe_nacked">
    <donedata>
      <content>{"verdict":"fail","reason":"subscribe_eventgroup_nacked_ttl_zero"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_subscribe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_subscribe_ack_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase3_no_notification">
    <donedata>
      <content>{"verdict":"fail","reason":"no_notification_with_event_msb_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
