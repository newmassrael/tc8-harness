<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_099: SD_ClientServiceActivate.

  Tester invokes `clientServiceActivate` (METHOD-ID 0x002F, Fire&Forget) on
  the DUT. The DUT must enter Client Mode without stopping its already-
  running Server Mode — i.e. it must start sending FindService for the
  client-side target service while continuing to OfferService for SERVICE-
  ID-1.

  Conformance verdict model (ISO/IEC 9646 / TTCN-3, docs/verdict_policy.md
  Section 2.1). It concludes pass only on an observed FindService. The
  procedure states no time for the Start-Up-Phase FindService, so the
  general <ParamListenTime> governs: a phase-2 window that elapses without
  one is the DUT's silence where it must emit, observed_quiescence judged
  against that bound (H3), over a window of ParamListenTime plus
  <ParamToleranceTime> (10 s + 1 s at the defaults). A preamble that never
  completes stays inconclusive.

  Phase 1 (listening_phase1): standard SD warm-up. Watch for the DUT's
          OfferService for SERVICE-ID-1 (proves Server Mode is live).
            * deadline -> inconclusive (inconclusive_no_offer): the DUT's SD stack never
              came up on the wire — a precondition fault (e.g. heavy-stack
              startup under load), not a FindService defect. Does not red
              the conformance gate.
  Phase 2 (listening_phase2): after stimulus fires `clientServiceActivate`,
          watch for a FindService entry (Type 0x00) on SERVICE-ID-2
          (0xF4E8).
            * FindService observed -> pass.
            * deadline -> fail (fail_no_findservice, observed_quiescence):
              the DUT did not start its client Start-Up Phase. The CLI
              makes it inconclusive when the run cannot prove the absence
              (an incomplete capture, an unanswered liveness anchor).

  Server-Mode-preserved assertion: implicit. The DUT's vsomeip server
  lifecycle is untouched by the raw-UDP client-mode runner (see
  client_mode.h), so server-side regressions surface in the full sweep
  rather than within this single SCXML phase. Phase 1's OfferService
  observation is the load-bearing proof that Server Mode reached the wire
  before the client-mode trigger; phase 2 then verifies the FindService
  side of the dual-role assertion.

  Reference: PRS_SOMEIPSD_00350 / PRS_SOMEIPSD_00351.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_099"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.is_offer_service_for(expected.service_id)"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x00 and captured.sd_entries[0].service_id == 0xF4E8"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="fail_no_findservice"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_no_findservice">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_findservice_for_service_id_2_within_listen_window","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
