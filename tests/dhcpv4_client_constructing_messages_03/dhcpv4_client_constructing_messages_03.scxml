<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.7 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_03: the IPv4 source
  address of a pre-binding DHCPDISCOVER MUST be 0 (RFC 2131 §4.1).
  CONSTRUCTING_MESSAGES_03_NEG drives the firmware mutant that sources it
  from a non-zero address.

  Reuses the dhcpv4_discover_field template (shared with the _neg sibling).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_03"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="captured.source_ip_is_zero()"
           fail_state="fail_source_ip_not_zero"
           fail_reason="dut_dhcp_discover_source_ip_not_zero"/>
</scxml>
