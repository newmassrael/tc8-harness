<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.6 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_03: Source IP
  address field of DHCPDISCOVER Message is 0 (RFC 2131 §4.1).

  Spec Test Procedure (tc8_p241-p260.txt: CONSTRUCTING_MESSAGES_03):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER listens (no server reply).
    4.   DUT: Sends DHCPDISCOVER Message
    5.   TESTER: Verify received DISCOVER's Source IP Address field
         is set to 0.

  Pre-binding DHCP traffic from a client carries IP source = 0 since
  the client has no allocated address yet. The `source_ip_is_zero()`
  predicate is NBO equality against the literal 0.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_03"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.source_ip_is_zero()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.source_ip_is_zero()"
                target="fail_source_ip_not_zero"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_source_ip_not_zero">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_source_ip_not_zero"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_discover_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
