<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_41: ARP responding (Response answers Request). Tester
  injects a fully-correct ARP Request; DUT must reply with an ARP frame
  whose opcode is Response (2). Same pass shape as ARP_16/20/26/36 — the
  case explicitly verifies the swap of opcode from 1 to 2 the reply path
  performs per RFC 826. Body: arp_required_reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_41"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_required_reply.sce-template.xml"/>
</scxml>
