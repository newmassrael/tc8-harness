<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.3.19 SOMEIPSRV_SD_MESSAGE_19: When a Subscribe carries an
  UNKNOWN-EVENT-GROUP-ID, the DUT shall Nack with TTL=0 and shall echo
  the Eventgroup ID from the Subscribe (TR_SOMEIP §6.7.4.2.4). Sentinel
  UNKNOWN-EVENT-GROUP-ID = 0xFFFE.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_sd_message_19"
       datamodel="null"
       initial="listening">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="true"
           entry_type="0x07"
           pass_expr="captured.sd_entries[0].ttl == 0 and captured.sd_entries[0].eventgroup_id == ::tc8::sd_test_unknown::kEventGroupId"
           fail_state="fail_eventgroup_id"
           fail_reason="nack_entry_eventgroup_id_not_unknown_sentinel"/>
</scxml>
