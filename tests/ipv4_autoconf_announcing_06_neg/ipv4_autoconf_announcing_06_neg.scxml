<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_06 negative — closes the
  self-reference trap on the positive _06 case. tc8-dut emits its 2
  Announces via OpStartLLAutoconf with the fast envelope
  (announce_interval = 200 ms), so the inter-frame interval is well
  below the [ANNOUNCE_INTERVAL - 50 ms, ANNOUNCE_INTERVAL + 50 ms] =
  [1.95 s, 2.05 s] tolerance window the positive _06 asserts
  (RFC 3927 §2.4 MUST).

  Cadence violation does NOT need an OpStartLLAutoconfBuggy flavor:
  the existing 0x0C opcode already parameterises announce_interval,
  so the fast 200 ms envelope drives the violation through data, not
  a code path (same pattern as ADDRESS_SELECTION_10_NEG for Probes).

  Pass = the interval IS out of range (< 1.95 s or > 2.05 s) — the
  violation is detected. fail_compliant_cadence = the interval landed
  within the RFC window, meaning the announce_interval knob did not
  take effect and the harness would have silently accepted the DUT.

  Standalone SCXML — does NOT reuse the cluster A field-shape template
  because cadence assertion uses frame_delta_us, not a field invariant.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_06_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0"
                target="seen_announce_1"/>
    <transition event="deadline_exceeded" target="inconclusive_no_announces"/>
  </state>

  <state id="seen_announce_1">
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0 and captured.frame_delta_us() &gt; 0 and (captured.frame_delta_us() &lt; 1950000 or captured.frame_delta_us() &gt; 2050000)"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.eth_src == expected.dut_iface_mac and captured.sender_proto_ip != 0"
                target="fail_compliant_cadence"/>
    <transition event="deadline_exceeded" target="inconclusive_only_one_announce"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_announces">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_arp_announce_after_probes","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_only_one_announce">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"fewer_than_2_arp_announces_within_deadline","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_cadence">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_compliant_cadence_despite_200ms_announce_interval","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
