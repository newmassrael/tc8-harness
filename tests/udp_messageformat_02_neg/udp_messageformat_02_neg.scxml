<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.1 UDP_MessageFormat_02 negative — lwIP ingress self-validation of the
  positive _02 "DUT accepts a well-formed UDP datagram" guard. The trait arms
  kUdpFaultRejectValid, so the netif input hook swallows the inbound data-listener
  frame (never forwards it to lwIP), modelling a DUT that wrongly drops a datagram it
  must accept.
  Pass = the DUT reported NO receipt (ut_received == 0, the injected rejection observed);
  fail_compliant = the DUT still accepted it despite the flavor (fault inert — what a
  conformant DUT does). lwIP-only (kCapIngressFault). Envelope: ipv4_udp_ut_presence.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_messageformat_02_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_accepted_well_formed_udp_despite_flavor"
           fail_reason_timeout="no_ut_confirmation_for_well_formed_udp_reject"
           fail_role="fault_injection_inert"/>
</scxml>
