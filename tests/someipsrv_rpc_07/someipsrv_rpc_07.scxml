<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.7.7 SOMEIPSRV_RPC_07: The receiver of a return code
  shall ignore the values of the two most significant bits. Tester sends
  a Method Request with return_code = 0xC0 to METHOD-ID-1-SI-1
  (echoUINT8 = 0x08); DUT must still reply with a Response (msg_type
  0x80, return_code = E_OK = 0x00).

    Phase 1: DUT emits OfferService for SERVICE-ID-1.
    Phase 2: 5 s window. Pass requires Response with return_code 0x00.
             Fail (response_not_ok) flags a Response that arrived but
             with a non-zero return_code, distinct from the no-response
             timeout.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_rpc_07"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code == 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0008 and captured.return_code != 0x00"
                target="fail_phase2_response_not_ok"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_response_not_ok">
    <donedata>
      <content>{"verdict":"fail","reason":"response_return_code_not_e_ok","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_response">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_response_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
