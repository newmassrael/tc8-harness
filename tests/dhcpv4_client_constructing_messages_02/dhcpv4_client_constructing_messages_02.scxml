<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.7 DHCPV4_CLIENT_CONSTRUCTING_MESSAGES_02: DHCP clients MUST
  use the IP address provided in the 'server identifier' option for any
  unicast requests to the DHCP server (RFC 2131 §4.1).

  Spec Test Procedure (tc8_p241-p260.txt: CM_02):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER: DHCP Server <SERVER-1> Cause DUT to transit its state
         to DHCPCLIENT_STATE_RENEWING.
    4.   DUT: Transit finite state to DHCPCLIENT_STATE_RENEWING.
    5.   TESTER: DHCP Server <SERVER-1> Listens.
    6.   DUT: Sends DHCPREQUEST Message.
    7.   TESTER: Verify Destination IP Address field is set to
         <SERVER1-IP-ADDRESS>.
  Pass: 4 + 6 + 7.

  Wire predicate identical to REACQUISITION_01 — both cases verify the
  RENEWING REQUEST's IP unicast destination matches the Option 54
  server identifier from the prior ACK. The §4.7.6.7 chapter framing
  positions the same observation under "constructing messages"
  (RFC 2131 §4.1) while §4.7.6.8 positions it under "reacquisition"
  (RFC 2131 §4.4.5); spec body is verbatim.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_02"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="captured.dst_ip_equals(expected.server_id_be)"
           fail_state="fail_renewing_request_dst_not_server_id"
           fail_reason="dut_renewing_request_dst_not_server_id"/>
</scxml>
