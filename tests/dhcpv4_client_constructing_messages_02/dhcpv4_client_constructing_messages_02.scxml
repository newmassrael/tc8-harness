<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.6 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_02: DHCP clients MUST
  use the IP address provided in the 'server identifier' option for any
  unicast requests to the DHCP server (RFC 2131 §4.1).

  Case shape:
    the DUT is brought up and its DHCP client configured, then driven
    into RENEWING by <SERVER-1>. Once there it has to send a REQUEST,
    and that REQUEST's destination address is the observable: it must
    be <SERVER1-IP-ADDRESS>, the unicast the earlier ACK named.

  Wire predicate identical to REACQUISITION_01 — both cases verify the
  RENEWING REQUEST's IP unicast destination matches the Option 54
  server identifier from the prior ACK. The two chapters frame the
  same observation differently: §4.7.6.7 files it under constructing
  messages (RFC 2131 §4.1), §4.7.6.8 under reacquisition
  (RFC 2131 §4.4.5), and the steps they prescribe coincide.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_02"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="captured.dst_ip_equals(expected.server_id_be)"
           fail_state="fail_renewing_request_dst_not_server_id"
           fail_reason="dut_renewing_request_dst_not_server_id"
           fail_role="observed_violation"/>
</scxml>
