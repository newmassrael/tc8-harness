<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_07 negative — lwIP egress-fault self-validation of the
  positive _07 zero-data Length guard. The trait arms kUdpFaultLengthWrong, so the
  lwIP netif link-output hook rewrites the UDP Length field of the DUT's zero-payload
  data egress to a value != 8. Pass = the wrong length observed; fail_compliant =
  DUT emitted the correct length (8) despite the flavor (fault inert). lwIP-only
  (capability-gated on kCapEgressFault). Envelope: udp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_07_neg"
       datamodel="null"
       initial="listening_phase1">
  <sce:use template="../_templates/udp_field_check.sce-template.xml"
           pass_expr="!(captured.src_port == 20003 and captured.dst_port == 20000 and captured.length == 8)"
           fail_state="fail_compliant"
           fail_reason="dut_emitted_correct_zero_data_length_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
