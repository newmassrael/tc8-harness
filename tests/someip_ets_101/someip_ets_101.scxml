<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_101: SD_ClientServiceActivate_send_StopOfferService.

  Tester activates the DUT's Client Mode and then sends StopOfferService
  (OfferService entry with TTL = 0) for SERVICE-ID-2 — the service the DUT
  is searching for. Per spec the DUT should understand the service is no
  longer available and stop sending FindService for that Service+Instance
  pair (Find-ALL queries remain allowed, but our DUT only searches for one
  pair so the distinction is moot).

  The DUT firmware's `ClientModeRunner` realises the Start-Up Phase as a
  bounded burst (kRepetitionsMax+1 = 4 emits over ~1.5 s) followed by
  Main-Phase idle, so the Stop-then-silence wire pattern matches the
  spec naturally. Future DUT firmware that emits cyclic FindService
  through the Main Phase would need the Runner to listen for inbound
  StopOfferService and react explicitly; this SCXML is the verdict
  vehicle either way.

  Conformance verdict model (ISO/IEC 9646 / TTCN-3, same as SOMEIP_ETS_152).
  The verdict is SOUND: it FAILs only on an observed post-Stop FindService
  (phase 4), never because the environment failed to drive the DUT into the
  observable precondition.

    Phase 1 (listening_phase1): SD warm-up — OfferService for SERVICE-ID-1.
            Deadline → error (error_no_offer): the SD stack never reached
            the wire (precondition fault, e.g. heavy-stack startup), not a
            FindService defect.
    Phase 2 (listening_phase2_first_find): observe first DUT FindService on
            SERVICE-ID-2 → advance. Deadline → inconclusive
            (inconclusive_no_findservice): the DUT was proven live by its
            phase-1 offer, but the transient Start-Up-Phase burst (~1.5 s)
            was not captured in window, so the post-Stop-absence assertion
            could not be reached. Not a FAIL.
    Phase 3 (listening_phase3_burst_window): 3 s burst-absorption window
            (Repetition Phase is allowed to fire multiple bursts).
    Phase 4 (listening_phase4_post_stop_absence): 4 s absence window after
            StopOfferService has been emitted. Any FindService for
            SERVICE-ID-2 = fail (sole observed violation). Deadline = pass.

  Reference: PRS_SOMEIPSD_00351 / PRS_SOMEIPSD_00363.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_101"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.is_offer_service_for(expected.service_id)"
                target="listening_phase2_first_find"/>
    <transition event="phase1_deadline_exceeded" target="error_no_offer"/>
  </state>

  <state id="listening_phase2_first_find">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x00 and captured.sd_entries[0].service_id == 0xF4E8"
                target="listening_phase3_burst_window"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_no_findservice"/>
  </state>

  <state id="listening_phase3_burst_window">
    <onentry>
      <send event="phase3_burst_window_done" delay="3s"/>
    </onentry>
    <transition event="phase3_burst_window_done" target="listening_phase4_post_stop_absence"/>
  </state>

  <state id="listening_phase4_post_stop_absence">
    <onentry>
      <send event="phase4_absence_window_done" delay="4s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x00 and captured.sd_entries[0].service_id == 0xF4E8"
                target="fail_phase4_findservice_after_stop_offer"/>
    <transition event="phase4_absence_window_done" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="error_no_offer">
    <donedata>
      <content>{"verdict":"error","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_findservice">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_findservice_during_start_phase"}</content>
    </donedata>
  </final>

  <final id="fail_phase4_findservice_after_stop_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_findservice_after_stop_offer_service"}</content>
    </donedata>
  </final>
</scxml>
