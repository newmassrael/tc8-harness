<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.6 TCP_FLAGS_INVALID_09: TCP, in FIN-WAIT-1 state, MUST
  send an ACK with next expected SEQ number after receiving any
  segment with OTW SEQ number and remain in the same state. Derived
  from RFC 793 §3.9 p69 Event Processing (MUST).

  v3.0 Test Procedure (p334) lists 5 iterations (RST=0 across all):
    * CASE 1: flag set = SYN
    * CASE 2: flag set = SYN, ACK
    * CASE 3: flag set = ACK
    * CASE 4: flag set = FIN
    * CASE 5: flag set = Data segment

  Per-phase prelude (== UNACCEPTABLE_09 phase 1 lifted to five port
  quads):
    1. Active OPEN handshake → ESTABLISHED (DUT third-leg ACK).
    2. The tester withholds its pure ACK toward the DUT for the
       phase, preventing the DUT FIN from being acknowledged and
       advancing the DUT past FW1.
    3. The DUT application CLOSEs → DUT FIN+ACK (DUT FW1).
    4. Snapshot tester snd_nxt / rcv_nxt.
    5. tester injects a CASE-distinct OTW probe with ack_num =
       rcv_nxt - 1 (acceptable per RFC 793 §3.4 — falls in
       [snd.una, snd.nxt) — but does NOT acknowledge DUT FIN,
       keeping DUT pinned in FW1 across the spec-asserted
       observation window).
    6. DUT empty ACK to OTW probe (RFC 793 §3.9 challenge ACK).

  Per phase the SCXML walks three DUT-origin observations:
    1. handshake third-leg ACK (DUT pure ACK)
    2. close-elicited DUT FIN+ACK
    3. probe-elicited DUT empty ACK

  CASE 4 (FIN) carries an ACK flag with rcv_nxt - 1 — Linux drops
  bare-FIN segments before reaching the OTW SEQ branch (verified
  empirically in 08), so carrying ACK keeps the segment past the
  early-drop. Same convention as FLAGS_INVALID_08 / _10 / _11.

  Negative smoke (ipv4.dut_iface_ip flip): pass guard's
  src_ip-conjunct fails on phase 1's listening_p1_handshake → first
  state's 5 s deadline → inconclusive_p1_no_handshake_ack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_invalid_09"
       datamodel="null"
       initial="listening_p1_handshake">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_handshake">
    <onentry><send event="deadline_p1_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset)"
                target="listening_p1_dut_fin"/>
    <transition event="deadline_p1_handshake" target="inconclusive_p1_no_handshake_ack"/>
  </state>
  <state id="listening_p1_dut_fin">
    <onentry><send event="deadline_p1_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset)"
                target="listening_p1_probe_ack"/>
    <transition event="deadline_p1_dut_fin" target="inconclusive_p1_no_dut_fin"/>
  </state>
  <state id="listening_p1_probe_ack">
    <onentry><send event="deadline_p1_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset) and captured.ack_num == captured.expected_ack_num"
                target="listening_p2_handshake"/>
    <transition event="deadline_p1_probe_ack" target="inconclusive_p1_no_probe_ack"/>
  </state>

  <state id="listening_p2_handshake">
    <onentry><send event="deadline_p2_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 1U)"
                target="listening_p2_dut_fin"/>
    <transition event="deadline_p2_handshake" target="inconclusive_p2_no_handshake_ack"/>
  </state>
  <state id="listening_p2_dut_fin">
    <onentry><send event="deadline_p2_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 1U)"
                target="listening_p2_probe_ack"/>
    <transition event="deadline_p2_dut_fin" target="inconclusive_p2_no_dut_fin"/>
  </state>
  <state id="listening_p2_probe_ack">
    <onentry><send event="deadline_p2_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 1U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 1U) and captured.ack_num == captured.expected_ack_num_phase2"
                target="listening_p3_handshake"/>
    <transition event="deadline_p2_probe_ack" target="inconclusive_p2_no_probe_ack"/>
  </state>

  <state id="listening_p3_handshake">
    <onentry><send event="deadline_p3_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 2U)"
                target="listening_p3_dut_fin"/>
    <transition event="deadline_p3_handshake" target="inconclusive_p3_no_handshake_ack"/>
  </state>
  <state id="listening_p3_dut_fin">
    <onentry><send event="deadline_p3_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 2U)"
                target="listening_p3_probe_ack"/>
    <transition event="deadline_p3_dut_fin" target="inconclusive_p3_no_dut_fin"/>
  </state>
  <state id="listening_p3_probe_ack">
    <onentry><send event="deadline_p3_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 2U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 2U) and captured.ack_num == captured.expected_ack_num_phase3"
                target="listening_p4_handshake"/>
    <transition event="deadline_p3_probe_ack" target="inconclusive_p3_no_probe_ack"/>
  </state>

  <state id="listening_p4_handshake">
    <onentry><send event="deadline_p4_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 3U)"
                target="listening_p4_dut_fin"/>
    <transition event="deadline_p4_handshake" target="inconclusive_p4_no_handshake_ack"/>
  </state>
  <state id="listening_p4_dut_fin">
    <onentry><send event="deadline_p4_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 3U)"
                target="listening_p4_probe_ack"/>
    <transition event="deadline_p4_dut_fin" target="inconclusive_p4_no_dut_fin"/>
  </state>
  <state id="listening_p4_probe_ack">
    <onentry><send event="deadline_p4_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 3U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 3U) and captured.ack_num == captured.expected_ack_num_phase4"
                target="listening_p5_handshake"/>
    <transition event="deadline_p4_probe_ack" target="inconclusive_p4_no_probe_ack"/>
  </state>

  <state id="listening_p5_handshake">
    <onentry><send event="deadline_p5_handshake" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 4U)"
                target="listening_p5_dut_fin"/>
    <transition event="deadline_p5_handshake" target="inconclusive_p5_no_handshake_ack"/>
  </state>
  <state id="listening_p5_dut_fin">
    <onentry><send event="deadline_p5_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 4U)"
                target="listening_p5_probe_ack"/>
    <transition event="deadline_p5_dut_fin" target="inconclusive_p5_no_dut_fin"/>
  </state>
  <state id="listening_p5_probe_ack">
    <onentry><send event="deadline_p5_probe_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 4U, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsInvalid09BaseOffset + 4U) and captured.ack_num == captured.expected_ack_num_phase5"
                target="pass"/>
    <transition event="deadline_p5_probe_ack" target="inconclusive_p5_no_probe_ack"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_p1_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase1","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_p1_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase1","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p1_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_syn_in_finwait1","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p2_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase2","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p2_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase2","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p2_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_synack_in_finwait1","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p3_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase3","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p3_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase3","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p3_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_ack_in_finwait1","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p4_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase4","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p4_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase4","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p4_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_fin_in_finwait1","role":"property_unobserved"}</content></donedata></final>

  <final id="inconclusive_p5_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_phase5","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p5_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_phase5","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_p5_no_probe_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_ack_to_otw_seq_data_in_finwait1","role":"property_unobserved"}</content></donedata></final>
</scxml>
