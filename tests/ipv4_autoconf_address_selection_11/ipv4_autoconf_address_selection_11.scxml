<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_11: probing-window
  conflict via ARP Request (RFC 3927 §2.2.1, MUST). Tester injects
  an ARP Request with sender_proto_ip equal to the DUT's tentative
  link-local address; DUT must select a new pseudo-random address
  and resume probing.

  Spec Test Procedure (tc8_p141-p160.txt:627..671):
    1-6. DUT brings up iface, sends DHCPDISCOVER, then 3 ARP Probes.
    7.   Tester reads target_ip from DUT's ARP Probe and stores it.
    8.   Tester sends conflict ARP Request: sender_ip = stored LL,
         dst_ip = 255.255.255.255.
    10-11. DUT MUST emit a fresh ARP Request with target_ip != the
           stored value (= re-pick).

  Pass criterion: a DUT-emitted Probe whose target_proto_ip differs
  from the FIRST observed Probe's target_proto_ip lands within the
  12 s SCXML window.

  Trait wiring: dispatchArpFrameWithFirstProbeSnapshot pins
  first_probe_target_proto_ip on listening → await_repick.
  scheduleConflictArpOnStateEntry(ConflictArpVariant::Request,
  await_repick) injects the conflict ARP from the poll-loop thread
  the moment SCXML transitions, so DUT receives the conflict during
  the RFC 3927 probe-window (PROBE_WAIT + 3 Probes + ANNOUNCE_WAIT).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_11"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_conflict_repick.sce-template.xml"/>
</scxml>
