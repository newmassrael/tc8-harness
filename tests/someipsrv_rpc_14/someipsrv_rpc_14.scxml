<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.7.14 SOMEIPSRV_RPC_14: When a service is configured with
  Number Of Instances = 2, multiple instances of the same service shall
  use different transport-layer ports (TR_SOMEIP_00163 — Multiple
  Service-Instances).

    Phase 1: OfferService SD message advertising 2 entries with distinct
             instance_ids and 2 distinct UDP ports across IPv4 Endpoint
             Options.
    Phase 2: the DUT's Method Response to each instance, from that
             instance's unreliable endpoint: UDP port 30502 for instance
             1, 30504 for instance 2.

  Stimulus: emitFindServiceBoot → emitMethodRequestAfter (port 30502) →
  emitMethodRequestAfter (port 30504). Each Method Request elicits a
  Response on the matching UDP server endpoint; src_port carries the
  server-side port the DUT bound to.

  The specification does not order the two Responses, so phase 2 accepts
  them in either order: awaiting_both_responses moves to the state that
  waits for the other one, and each of the three waiting states has its own
  window. A Response that arrives first opens the second window, so the
  instance still owed has at least one full window after its Request. A
  window that elapses without the Response owed is the DUT's silence where
  it must answer: observed_quiescence, judged against <ParamListenTime>
  (docs/verdict_policy.md Section 2.1, H3), over a window of
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the defaults).
  Each window has its own event name, because SCXML does not cancel a
  delayed send when its state exits.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_rpc_14"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 2 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[1].type == 0x01 and captured.sd_entries[0].instance_id != captured.sd_entries[1].instance_id and captured.sd_distinct_endpoint_ports_for_l4(::tc8::sd_l4_proto::kUdp) &gt;= 2"
                target="awaiting_both_responses"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="awaiting_both_responses">
    <onentry>
      <send event="both_responses_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.method_id == 0x0008 and captured.src_port == 30502"
                target="awaiting_instance_2_response"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.method_id == 0x0008 and captured.src_port == 30504"
                target="awaiting_instance_1_response"/>
    <transition event="both_responses_window_elapsed" target="fail_no_response_from_either_instance"/>
  </state>

  <state id="awaiting_instance_2_response">
    <onentry>
      <send event="instance_2_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.method_id == 0x0008 and captured.src_port == 30504"
                target="pass"/>
    <transition event="instance_2_window_elapsed" target="fail_no_response_from_instance_2"/>
  </state>

  <state id="awaiting_instance_1_response">
    <onentry>
      <send event="instance_1_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.method_id == 0x0008 and captured.src_port == 30502"
                target="pass"/>
    <transition event="instance_1_window_elapsed" target="fail_no_response_from_instance_1"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_two_entry_offer_with_distinct_udp_ports_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_no_response_from_either_instance">
    <donedata>
      <content>{"verdict":"fail","reason":"no_response_from_either_instance_udp_port","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_no_response_from_instance_1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_response_from_instance_1_udp_port_30502","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="fail_no_response_from_instance_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_response_from_instance_2_udp_port_30504","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
