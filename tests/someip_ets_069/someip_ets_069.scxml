<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_069: Unaligned_SOMEIP_Messages_overUDP.

  Tester packs three echoUINT8Array (METHOD-ID 0x0009) Method Requests
  into a single UDP datagram. Message 1 carries a 1-byte UInt8Array
  payload (32-bit BE length prefix = 1, value 0x42), so its on-wire
  size is 16 (header) + 5 (payload) = 21 bytes — NOT a multiple of 4,
  leaving messages 2 and 3 aligned at offsets 21 and 45 respectively
  (also not 4-byte-aligned within the bundle). Messages 2 and 3 carry
  4-byte arrays. Per PRS_SOMEIP_00142 / PRS_SOMEIP_00569 the DUT must
  walk the bundle one message at a time using each message's Length
  header and respond to every Request.

  Each Request carries its own session_id (0x0001 / 0x0002 / 0x0003), so
  the three Responses are told apart.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (awaiting_responses_*): one Method Response per session_id
            with msg_type 0x80, return_code 0x00, on method_id 0x0009.

  The specification does not order the Responses, so phase 2 accepts them
  in any order: there is one waiting state per set of Responses still owed
  (awaiting_responses_123, _12, ..., _3), and each Response moves to the
  set without it. Every waiting state has its own window, so a Response
  still owed has at least one full window after its Request. A window that
  elapses with a Response owed is the DUT's silence where it must answer:
  observed_quiescence, judged against <ParamListenTime>
  (docs/verdict_policy.md Section 2.1, H3), over a window of
  ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the defaults).
  Each window has its own event name, because SCXML does not cancel a
  delayed send when its state exits.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_069"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="awaiting_responses_123"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="awaiting_responses_123">
    <onentry>
      <send event="awaiting_responses_123_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0001 and captured.payload_len == 5 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x01 and captured.payload_snapshot[4] == 0x42"
                target="awaiting_responses_23"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0002 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x10 and captured.payload_snapshot[5] == 0x11 and captured.payload_snapshot[6] == 0x12 and captured.payload_snapshot[7] == 0x13"
                target="awaiting_responses_13"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0003 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x20 and captured.payload_snapshot[5] == 0x21 and captured.payload_snapshot[6] == 0x22 and captured.payload_snapshot[7] == 0x23"
                target="awaiting_responses_12"/>
    <transition event="awaiting_responses_123_window_elapsed" target="fail_response_missing"/>
  </state>

  <state id="awaiting_responses_12">
    <onentry>
      <send event="awaiting_responses_12_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0001 and captured.payload_len == 5 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x01 and captured.payload_snapshot[4] == 0x42"
                target="awaiting_responses_2"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0002 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x10 and captured.payload_snapshot[5] == 0x11 and captured.payload_snapshot[6] == 0x12 and captured.payload_snapshot[7] == 0x13"
                target="awaiting_responses_1"/>
    <transition event="awaiting_responses_12_window_elapsed" target="fail_response_missing"/>
  </state>

  <state id="awaiting_responses_13">
    <onentry>
      <send event="awaiting_responses_13_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0001 and captured.payload_len == 5 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x01 and captured.payload_snapshot[4] == 0x42"
                target="awaiting_responses_3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0003 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x20 and captured.payload_snapshot[5] == 0x21 and captured.payload_snapshot[6] == 0x22 and captured.payload_snapshot[7] == 0x23"
                target="awaiting_responses_1"/>
    <transition event="awaiting_responses_13_window_elapsed" target="fail_response_missing"/>
  </state>

  <state id="awaiting_responses_23">
    <onentry>
      <send event="awaiting_responses_23_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0002 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x10 and captured.payload_snapshot[5] == 0x11 and captured.payload_snapshot[6] == 0x12 and captured.payload_snapshot[7] == 0x13"
                target="awaiting_responses_3"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0003 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x20 and captured.payload_snapshot[5] == 0x21 and captured.payload_snapshot[6] == 0x22 and captured.payload_snapshot[7] == 0x23"
                target="awaiting_responses_2"/>
    <transition event="awaiting_responses_23_window_elapsed" target="fail_response_missing"/>
  </state>

  <state id="awaiting_responses_1">
    <onentry>
      <send event="awaiting_responses_1_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0001 and captured.payload_len == 5 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x01 and captured.payload_snapshot[4] == 0x42"
                target="pass"/>
    <transition event="awaiting_responses_1_window_elapsed" target="fail_response_missing"/>
  </state>

  <state id="awaiting_responses_2">
    <onentry>
      <send event="awaiting_responses_2_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0002 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x10 and captured.payload_snapshot[5] == 0x11 and captured.payload_snapshot[6] == 0x12 and captured.payload_snapshot[7] == 0x13"
                target="pass"/>
    <transition event="awaiting_responses_2_window_elapsed" target="fail_response_missing"/>
  </state>

  <state id="awaiting_responses_3">
    <onentry>
      <send event="awaiting_responses_3_window_elapsed" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0003 and captured.payload_len == 8 and captured.payload_snapshot[0] == 0x00 and captured.payload_snapshot[1] == 0x00 and captured.payload_snapshot[2] == 0x00 and captured.payload_snapshot[3] == 0x04 and captured.payload_snapshot[4] == 0x20 and captured.payload_snapshot[5] == 0x21 and captured.payload_snapshot[6] == 0x22 and captured.payload_snapshot[7] == 0x23"
                target="pass"/>
    <transition event="awaiting_responses_3_window_elapsed" target="fail_response_missing"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_response_missing">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_respond_to_every_message_in_bundle","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
