<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_069: Unaligned_SOMEIP_Messages_overUDP.

  Tester packs three echoUINT8Array (METHOD-ID 0x0009) Method Requests
  into a single UDP datagram. Message 1 carries a 1-byte UInt8Array
  payload (32-bit BE length prefix = 1, value 0x42), so its on-wire
  size is 16 (header) + 5 (payload) = 21 bytes — NOT a multiple of 4,
  leaving messages 2 and 3 aligned at offsets 21 and 45 respectively
  (also not 4-byte-aligned within the bundle). Messages 2 and 3 carry
  4-byte arrays. Per PRS_SOMEIP_00142 / PRS_SOMEIP_00569 the DUT must
  walk the bundle one message at a time using each message's Length
  header and respond to every Request.

  Each emit increments session_id (0x0001 / 0x0002 / 0x0003) so the
  three Responses arrive pinnable in successive phases. A DUT that
  drops or coalesces responses trips one of the per-phase deadlines.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2a/b/c (listening_phase2_*): One Method Response per
            session_id with msg_type 0x80, return_code 0x00, on
            method_id 0x0009. Each phase has its own 5 s deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_069"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_a"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_a">
    <onentry>
      <send event="phase2a_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0001 and captured.payload_len == 5 and captured.payload_bytes[0] == 0x00 and captured.payload_bytes[1] == 0x00 and captured.payload_bytes[2] == 0x00 and captured.payload_bytes[3] == 0x01 and captured.payload_bytes[4] == 0x42"
                target="listening_phase2_b"/>
    <transition event="phase2a_deadline_exceeded" target="fail_phase2_response_missing"/>
  </state>

  <state id="listening_phase2_b">
    <onentry>
      <send event="phase2b_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0002 and captured.payload_len == 8 and captured.payload_bytes[0] == 0x00 and captured.payload_bytes[1] == 0x00 and captured.payload_bytes[2] == 0x00 and captured.payload_bytes[3] == 0x04 and captured.payload_bytes[4] == 0x10 and captured.payload_bytes[5] == 0x11 and captured.payload_bytes[6] == 0x12 and captured.payload_bytes[7] == 0x13"
                target="listening_phase2_c"/>
    <transition event="phase2b_deadline_exceeded" target="fail_phase2_response_missing"/>
  </state>

  <state id="listening_phase2_c">
    <onentry>
      <send event="phase2c_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.message_type == 0x80 and captured.method_id == 0x0009 and captured.return_code == 0x00 and captured.session_id == 0x0003 and captured.payload_len == 8 and captured.payload_bytes[0] == 0x00 and captured.payload_bytes[1] == 0x00 and captured.payload_bytes[2] == 0x00 and captured.payload_bytes[3] == 0x04 and captured.payload_bytes[4] == 0x20 and captured.payload_bytes[5] == 0x21 and captured.payload_bytes[6] == 0x22 and captured.payload_bytes[7] == 0x23"
                target="pass"/>
    <transition event="phase2c_deadline_exceeded" target="fail_phase2_response_missing"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_response_missing">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_respond_to_every_message_in_bundle"}</content>
    </donedata>
  </final>
</scxml>
