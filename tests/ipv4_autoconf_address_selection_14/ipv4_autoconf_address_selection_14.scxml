<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_14: Conflict resolution -
  I. RFC 3927 §2.2.1 MUST: once the host has experienced
  MAX_CONFLICTS (=10) probing-window conflicts, it MUST limit the
  rate at which it probes for new addresses to no more than one new
  address per RATE_LIMIT_INTERVAL.

  Spec Test Procedure (tc8_p141-p160.txt:790..p161-180.txt:130):
    1-6.  DUT brings up iface, sends DHCPDISCOVER, then 3 ARP Probes
          for tentative LL-1.
    7-8.  Tester reads target_ip and injects conflict ARP Request:
          sender_proto_ip = LL-1, dst_ip = 255.255.255.255.
    10-11. DUT MUST emit fresh Probe with target_proto_ip != LL-1.
          Tester re-reads, injects conflict on LL-2.
    ...   Repeat for 10 conflict cycles total (up to step 53).
    54.   Tester listens up to RATE_LIMIT_INTERVAL.
    55.   DUT MUST NOT send any ARP Request during this window.

  Pass criterion: 10 distinct DUT-emitted Probes, each met with a
  tester conflict ARP, then full silence for the configured
  RATE_LIMIT_INTERVAL window.

  Trait wiring: dispatchArpFrameWithRepeatedConflictEmit drives the
  cycle self-loop and emits the conflict ARP synchronously after each
  observed Probe (state-entry observers CANNOT drive this — the cycle
  self-loop never changes state, so the runner's observer dedupe
  filters a self-targeted entry). After the 10th emit the helper
  raises the synthetic `conflicts_complete` event so SCXML transitions
  cycle → silence_watch.

  Fast envelope: rate_limit_interval = 3 s. silence_watch's deadline
  = 3 000 ms (= RATE_LIMIT_INTERVAL exactly): the spec MUST extends
  silence "no more than RATE_LIMIT_INTERVAL" since the host is
  permitted to emit the next Probe immediately after. Setting the
  deadline equal to the spec window keeps the assertion crisp — a
  buggy DUT emitting at t < 3 s fails, a compliant one emitting at
  t >= 3 s passes (the SCXML transitions to `pass` first; the late
  Probe arrives in a terminal state and is ignored). The
  silence_watch entry leads the DUT's rate_limit sleep by ~75 ms
  (listener-tick + wire latency), so a compliant DUT's first
  post-silence Probe lands at SCXML_t ≈ 3 200 ms — comfortably after
  the 3 000 ms deadline. The case-level deadline is 12 s, covering
  ~3 s of conflict cycles + 3 s silence with ~6 s of headroom.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_14"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="12s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="cycle"/>
    <transition event="deadline_exceeded" target="fail_no_initial_probe"/>
  </state>

  <state id="cycle">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe() and captured.target_proto_ip != captured.previous_observed_probe_target_ip"
                target="cycle"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_cycle_repeat"/>
    <transition event="conflicts_complete" target="silence_watch"/>
    <transition event="deadline_exceeded" target="fail_conflicts_incomplete"/>
  </state>

  <state id="silence_watch">
    <onentry>
      <send event="silence_complete" delay="3000ms"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_emitted_during_silence"/>
    <transition event="silence_complete" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_initial_probe">
    <donedata>
      <content>{"verdict":"fail","reason":"no_arp_probe_after_ll_start"}</content>
    </donedata>
  </final>

  <final id="fail_conflicts_incomplete">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_re_probe_through_max_conflicts"}</content>
    </donedata>
  </final>

  <final id="fail_cycle_repeat">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_re_probed_with_stale_link_local_address"}</content>
    </donedata>
  </final>

  <final id="fail_emitted_during_silence">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_arp_during_rate_limit_silence"}</content>
    </donedata>
  </final>
</scxml>
