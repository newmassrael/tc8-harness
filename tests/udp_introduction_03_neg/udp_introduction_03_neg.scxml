<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.6 UDP_INTRODUCTION_03 negative — lwIP egress-fault self-validation of the positive
  _03 "DUT emits ICMP Destination Unreachable / Port Unreachable for a datagram to a port with no
  LISTEN" guard. The trait sends the same UDP probe to the unused port the positive uses and arms
  kIcmpFaultDestUnreachCodeWrong, so the lwIP link-output hook XOR-flips the code of the DUT's
  Destination Unreachable reply (gated on type=3; type untouched so the filter still selects it).
  Pass = the corrupted code observed (code != 3, the Port Unreachable value RFC 1122 §4.1.3.1
  mandates); fail_compliant = the DUT emitted code 3 despite the flavor (fault inert). lwIP-only
  (capability-gated on kCapEgressFault). The §4.6 sibling of ICMPv4_TYPE_18_NEG. Envelope:
  icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_introduction_03_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 3 and captured.src_ip == expected.dut_iface_ip"
           pass_expr="captured.code != 3"
           fail_state="fail_compliant"
           fail_reason="dut_port_unreach_code_correct_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_port_unreachable_within_listen_window"/>
</scxml>
