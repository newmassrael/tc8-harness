<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_117: SD_Entry_references_options_of_same_kind.

  Tester sends a SubscribeEventgroup with two options of the same IPv4
  Endpoint type, both referenced by the entry (#Opt1=2). Per
  PRS_SOMEIPSD_00393 the DUT MUST Nack OR silently ignore.

    Phase 1 (listening_phase1): OfferService observation on SERVICE-ID-1.
    Phase 2 (listening_phase2):
      - Type 0x07 entry, ttl == 0  → Nack          → pass
      - Type 0x07 entry, ttl  > 0  → Ack           → fail
      - Deadline                   → silent ignore → pass

  The reference DUT reaches the Nack terminal: vsomeip rejects a pair of
  referenced same-kind endpoint options in sdi::process_eventgroupentry
  (SIP_SD_1144). An earlier wire shape left the second option unreferenced
  (#Opt1=1), which vsomeip accepted with an Ack — the reason this case was
  once carried as platform_known_fail.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_117"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id and captured.sd_entries[0].ttl &gt; 0"
                target="fail_dut_acked_malformed_subscribe"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x07 and captured.sd_entries[0].eventgroup_id == expected.eventgroup_id and captured.sd_entries[0].ttl == 0"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_dut_acked_malformed_subscribe">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_acked_malformed_subscribe","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
