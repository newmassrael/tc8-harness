<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.6 IPv4_FRAGMENTS_03 negative (data variant) — lwIP egress-fault
  self-validation of the positive's `reassembled_echo_data_mismatch_src_case` guard.
  The trait arms kIcmpFaultEchoPayloadByteWrong and sends the positive's phase 1 and
  its phase 2 retry back to back; lwIP reassembles the datagram and the link-output
  hook corrupts the first Echo Data byte of its Echo Reply, identifier and sequence
  intact — the positive reaches this final only with both matching, so the filter
  requires them too. Pass = the corruption observed; fail_compliant = the DUT echoed
  the field despite the flavor (fault inert). lwIP-only (kCapEgressFault). Envelope:
  icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_fragments_03_neg2"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 0 and captured.src_ip == expected.dut_iface_ip and captured.echo_id == expected.echo_id and captured.echo_seq == expected.echo_seq"
           pass_expr="!captured.payload_equals(::tc8::sce::ipv4::fragments::fragmentsEchoData())"
           fail_state="fail_compliant"
           fail_reason="dut_echoed_data_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_echo_reply_after_reassembly_within_listen_window"/>
</scxml>
