<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.1 IPv4_HEADER_05 negative — lwIP egress-fault self-validation of the positive's
  "the echoed 548 B match the index pattern" guard (RFC 791 §3.1 576-octet MUST). The trait
  arms kIcmpFaultEchoPayloadByteWrong, so the lwIP link-output hook XOR-flips the first Echo
  Data byte: the payload length is untouched, so the mismatch half fires (not the truncation
  half), and type 0 stays intact so the filter still selects the reply. libtins dissects the
  checksum-stale frame and reads all 548 data bytes, so the guard runs. Pass = a data byte
  differs from the index pattern (the violation the positive forbids); fail_compliant = the
  DUT echoed the 548 B verbatim despite the flavor (fault inert). lwIP-only (capability-gated
  on kCapEgressFault). Envelope: icmpv4_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_header_05_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_egress_field_check.sce-template.xml"
           filter="captured.type == 0 and captured.src_ip == expected.dut_iface_ip"
           pass_expr="captured.payload_len == 548 and !captured.payload_matches_index_pattern(548)"
           fail_state="fail_compliant"
           fail_reason="dut_echoed_correct_payload_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_echo_reply_for_576_byte_datagram"/>
</scxml>
