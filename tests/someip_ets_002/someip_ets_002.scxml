<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_002: Array_Length_too_long.

  Tester sends an echoUINT8 Method Request whose SOME/IP Length field
  is larger than the actual payload (Length = 0x20, claiming 32 bytes
  follow Request ID, but only 1 byte of payload is sent). Per
  PRS_SOMEIP_00902 / PRS_SOMEIP_00099 the DUT must reject — pass shape
  is Error Response (msg_type 0x81) OR silent ignore. A normal echo
  Response with return_code 0x00 → fail (DUT accepted the malformed
  input).

  Distinguished from ETS_001 by the magnitude of the Length lie:
  ETS_001 picks a value (0x100) far beyond any reasonable UDP MTU to
  exercise the "header claim exceeds possible" axis; ETS_002 picks a
  smaller value (0x20) within MTU to exercise the "header claim
  exceeds actual payload" axis. Both should hit the same vsomeip
  rejection path but the spec authors track them as separate
  PRS_SOMEIP requirements.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_002"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0008 and captured.message_type == 0x81"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0008 and captured.message_type == 0x80 and captured.return_code != 0x00"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == expected.service_id and captured.method_id == 0x0008 and captured.message_type == 0x80 and captured.return_code == 0x00"
                target="fail_phase2_dut_accepted_malformed"/>
    <transition event="phase2_deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_dut_accepted_malformed">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_returned_ok_response_for_array_length_too_long"}</content>
    </donedata>
  </final>
</scxml>
