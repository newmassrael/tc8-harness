<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.6 DHCPv4_CLIENT_CONSTRUCTING_MESSAGES_13:
    "Retransmission strategy using a randomized exponential backoff
     algorithm" (RFC 2131 §4.1, SHOULD).

  Spec body (tc8_p241-p260.txt: CONSTRUCTING_MESSAGES_13):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER: DHCP Server Listens for 3*(FirstRetx+Tol) s WITHOUT
         replying.
    4.   DUT: Sends multiple DHCPDISCOVER Messages.
    5.   TESTER: Verify time interval between 3rd-last and 2nd-last
         DHCPDISCOVERs is in [FirstRetx-1, FirstRetx+1] s = [3, 5] s.
    6.   TESTER: Verify time interval between last two DHCPDISCOVERs
         is in [2*FirstRetx-1, 2*FirstRetx+1] s = [7, 9] s.

  Spec defaults (firmware retx_first_ms=4000, retx_cap_ms=64000,
  retx_jitter_ms=1000) — no fast-envelope compression because the
  3-DISCOVER window is already 12 s wall and the spec's ±1 s jitter
  is at the same scale.

  3-state lifecycle: each transition advances on a DISCOVER and
  carries the matching interval predicate as a cond. Negative cond
  branches the SM into the fail_*_interval finals so a DUT that
  delivered DISCOVERs at the wrong cadence is distinguishable from
  a DUT that didn't deliver at all.

  Per-state deadlines (s1..s3) follow the post-S6a per-state
  deadline convention. s2/s3 deadlines accommodate the
  (FirstRetx + jitter) and (2*FirstRetx + jitter) bounds plus
  scheduling slack.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_constructing_messages_13"
       datamodel="null"
       initial="listening_for_d1">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening_for_d1">
    <onentry>
      <send event="s1_deadline" delay="3s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="listening_for_d2"/>
    <transition event="s1_deadline" target="fail_no_discover"/>
  </state>

  <state id="listening_for_d2">
    <onentry>
      <send event="s2_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.frame_delta_within_us(3000000, 5000000)"
                target="listening_for_d3"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and not captured.frame_delta_within_us(3000000, 5000000)"
                target="fail_first_interval_out_of_range"/>
    <transition event="s2_deadline" target="fail_no_discover_2"/>
  </state>

  <state id="listening_for_d3">
    <onentry>
      <send event="s3_deadline" delay="10s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.frame_delta_within_us(7000000, 9000000)"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and not captured.frame_delta_within_us(7000000, 9000000)"
                target="fail_second_interval_out_of_range"/>
    <transition event="s3_deadline" target="fail_no_discover_3"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_discover">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_discover_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_no_discover_2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_discover_2"}</content>
    </donedata>
  </final>

  <final id="fail_no_discover_3">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_dhcp_discover_3"}</content>
    </donedata>
  </final>

  <final id="fail_first_interval_out_of_range">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_first_retx_interval_out_of_range"}</content>
    </donedata>
  </final>

  <final id="fail_second_interval_out_of_range">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_second_retx_interval_out_of_range"}</content>
    </donedata>
  </final>
</scxml>
