<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_09 negative —
  closes the self-reference trap on positive _09 (the DHCPDECLINE sent on a
  conflict MUST echo the declined address in Option 50, RFC 2131 §4.4.4 /
  table 5).

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the DeclineRequestedIpWrong flavor (arp_probe_listen_ms=1500).
  The tester injects the ARP conflict; the DUT declines but emitDhcpMessage
  writes a wrong Option 50. A conformant client (flavor None) echoes the
  declined address, so this negative's fail_compliant branch is the live
  conformant-DUT outcome. The Probe stays conformant (the flavor only mutates
  the DECLINE).

  Reuses dhcpv4_init_alloc_decline with the pass predicate inverted
  (pass = the wrong Option 50 is observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_09_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_init_alloc_decline.sce-template.xml"
           pass_expr="!captured.dhcpv4.option_be32_equals(50, expected.dhcpv4.offered_ip_be)"
           fail_state="fail_compliant"
           fail_reason="dut_dhcp_decline_echoed_declined_address_despite_wrong_option50_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
