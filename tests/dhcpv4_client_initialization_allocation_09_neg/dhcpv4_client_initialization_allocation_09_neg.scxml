<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_09 negative —
  closes the self-reference trap on the positive _09 case (the DHCPDECLINE
  sent when the offered address is in use MUST carry the declined address
  in Option 50, RFC 2131 §4.4.1 / table 5). The positive maps a wrong-
  Option-50 DECLINE to its deadline (inconclusive), so without a fault
  injection a buggy declined-address echo is silently accepted.

  Fault injection is a real firmware mutant: the stimulus drives the DHCP
  client with the kDhcpFlavorDeclineRequestedIpWrong flavor (arp_probe_
  listen_ms = 1500 so the lifecycle reaches the post-BOUND Probe). The
  tester injects the ARP conflict reply on listening_for_decline entry; the
  DUT's listener detects it and emits a DHCPDECLINE whose Option 50 carries
  a wrong sentinel (192.0.2.50) instead of the declined yiaddr. A conformant
  client (flavor None) echoes the declined address, so this negative's
  fail_compliant branch is the live conformant-DUT outcome.

  The ARP Probe itself is conformant (the flavor only mutates the DECLINE),
  so listening_for_arp_probe passes through on the valid probe.

  Pass = the DECLINE with the wrong Option 50 IS observed. fail_compliant =
  the client echoed the declined address despite the flavor.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_09_neg"
       datamodel="null"
       initial="listening_for_discover">

  <sce:context id="captured"
               cpp:type="tc8::ArpAndDhcpv4Captured"
               cpp:include="sce_integration/arp_and_dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpAndDhcpv4Expected"
               cpp:include="sce_integration/arp_and_dhcpv4_expected.h"/>

  <state id="listening_for_discover">
    <onentry>
      <send event="s1_deadline" delay="6s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.dhcpv4.is_dhcp_discover()
                      and captured.dhcpv4.chaddr_matches_dut_mac(expected.dhcpv4.dut_iface_mac)"
                target="listening_for_first_request"/>
    <transition event="s1_deadline" target="inconclusive_no_discover"/>
  </state>

  <state id="listening_for_first_request">
    <onentry>
      <send event="s2_deadline" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.dhcpv4.is_dhcp_request()
                      and captured.dhcpv4.chaddr_matches_dut_mac(expected.dhcpv4.dut_iface_mac)"
                target="listening_for_arp_probe"/>
    <transition event="s2_deadline" target="inconclusive_no_request"/>
  </state>

  <state id="listening_for_arp_probe">
    <onentry>
      <send event="s3_deadline" delay="6s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.arp.is_dhcp_arp_probe(expected.dhcpv4.offered_ip_be)"
                target="listening_for_decline"/>
    <transition event="s3_deadline" target="inconclusive_no_arp_probe"/>
  </state>

  <state id="listening_for_decline">
    <onentry>
      <send event="s4_deadline" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.dhcpv4.is_dhcp_decline()
                      and captured.dhcpv4.chaddr_matches_dut_mac(expected.dhcpv4.dut_iface_mac)
                      and !captured.dhcpv4.option_be32_equals(50, expected.dhcpv4.offered_ip_be)"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.dhcpv4.is_dhcp_decline()
                      and captured.dhcpv4.chaddr_matches_dut_mac(expected.dhcpv4.dut_iface_mac)
                      and captured.dhcpv4.option_be32_equals(50, expected.dhcpv4.offered_ip_be)"
                target="fail_compliant"/>
    <transition event="s4_deadline" target="inconclusive_no_decline"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_decline_echoed_declined_address_despite_wrong_option50_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_request">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_request_after_offer","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_arp_probe">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_arp_probe_after_bound","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_decline">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_decline_after_arp_conflict","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
