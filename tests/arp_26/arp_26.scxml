<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_26: ARP Request reception (Protocol Type correct).
  Tester injects a Request with proto_type=0x0800 (IPv4) — the RFC 826
  §"Packet Reception" "Do I speak the protocol in ar$pro?" check must
  succeed and DUT must reply. Body: arp_required_reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_26"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_required_reply.sce-template.xml"/>
</scxml>
