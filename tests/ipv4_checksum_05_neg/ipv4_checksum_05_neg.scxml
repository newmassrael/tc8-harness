<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.2 IPv4_CHECKSUM_05 negative — lwIP egress-fault self-validation of the
  positive _05 IPv4 header-checksum guard. The trait arms kIpv4FaultHdrChecksumWrong, so
  the lwIP link-output hook XOR-invalidates the IPv4 header checksum of the DUT's Echo
  Reply (gated on the Echo Reply). libtins does not validate the IPv4 header checksum on
  parse, so the corrupted frame is still dissected and header_checksum_valid()
  recomputes RFC 1071 over the captured scalars to false. Pass = invalid checksum
  observed; fail_compliant = the DUT emitted a valid checksum despite the flavor (fault
  inert). lwIP-only (capability-gated on kCapEgressFault). Envelope: ipv4_field_check (its
  guard filters on src_addr == dut only, so it relies on the DUT's Echo Reply being the
  only IPv4 frame it sources in the window — the same single-reply assumption the positive
  makes; the DUT-side fault is itself type-0-gated in mutateIcmpFrame).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_checksum_05_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_field_check.sce-template.xml"
           pass_expr="not captured.header_checksum_valid()"
           fail_state="fail_compliant"
           fail_reason="dut_header_checksum_valid_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
