<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.4.4 SOMEIPSRV_SD_BEHAVIOR_04: A multicast FindService
  with Unicast Flag = 0 shall be answered with a multicast OfferService
  (per SOMEIPSD §6.7.5.2 / TR_SOMEIP_00423).

  Stimulus emits a multicast FindService with sd_flags = 0x80 (Reboot=1,
  Unicast=0) ~2.5 s after kickStimulus, allowing the DUT to enter Main
  Phase first.

  Phase 1 (listening_pre_find, 3940 ms deadline): ends 100 ms before
  the scheduled Find emit (4040 ms) so the SOLICITED reply lands in
  phase 2 rather than being silently absorbed here. All pre-Find
  traffic absorbed: init Offer (~T_sd+75 ms), repetitions
  (+275/+675/+1475 ms), and the post-repetition rep4 emission at
  ~T_sd+3075 ms.

  Phase 2 (listening_offer_reply, 1500 ms deadline): excludes the
  first true Main-Phase cyclic at ~T_sd+6000 ms. Pass on the DUT's
  solicited multicast OfferService, fail on a unicast solicited reply,
  fail on deadline. vsomeip 3.7.1 IGNORES multicast Finds (SIP_SD_91)
  so this case lands `inconclusive_no_offer_after_multicast_find` on the
  reference stack — a strict-spec DUT would pass via the solicited
  multicast reply per SOMEIPSD §6.7.5.2.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_sd_behavior_04"
       datamodel="null"
       initial="listening_pre_find">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_pre_find">
    <onentry>
      <send event="s1_pre_find_done" delay="3940ms"/>
    </onentry>
    <transition event="s1_pre_find_done" target="listening_offer_reply"/>
  </state>

  <state id="listening_offer_reply">
    <onentry>
      <send event="s2_deadline_exceeded" delay="1500ms"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.dst_ip == expected.sd_multicast_ip"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="fail_offer_not_multicast"/>
    <transition event="s2_deadline_exceeded" target="inconclusive_no_offer_after_multicast_find"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_offer_not_multicast">
    <donedata>
      <content>{"verdict":"fail","reason":"offer_dst_ip_not_multicast_after_multicast_find","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_offer_after_multicast_find">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_within_listen_window_after_multicast_find","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
