<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.4.4 SOMEIPSRV_SD_BEHAVIOR_04: a multicast FindService
  (Unicast Flag = 0) shall be answered with a multicast OfferService
  (per SOMEIPSD §6.7.5.2 / TR_SOMEIP_00423).

  Cadence-relative timing (same rationale as SD_BEHAVIOR_03). A fixed
  wall-clock emit offset leaves the reply window at an unknown position in the
  DUT's cyclic-offer cycle; under CPU contention a cyclic Offer can drift into
  that window and be counted as a solicited reply — a false PASS that masks
  the real behaviour. Instead the harness ANCHORS to the DUT's own offer: it
  waits into the main phase, observes one cyclic OfferService (the anchor),
  emits the multicast Find on entry to the reply state, and bounds the reply
  window so it ends before the DUT's next cyclic (+2000 ms). The window then
  sits strictly between two cyclics — no cyclic can be mistaken for a reply,
  so the verdict is deterministic. Unlike SD_BEHAVIOR_03 there is no
  ½-cyclic constraint (a multicast Find is answered multicast regardless of
  cycle position), so the Find fires right on the anchor, no hold.

  Reference-stack note: upstream vsomeip 3.7.x IGNORES multicast Finds
  (SIP_SD_91), which left this case at
  `inconclusive_no_offer_after_multicast_find` — deterministically, never a
  cyclic-drift false PASS. `patches/vsomeip/0002` answers such a Find with a
  multicast OfferService, so the reference DUT now reaches `pass` on the
  solicited reply observed inside the anchored window.

  Phases:
    waiting_main_phase    — absorb the init/repetition offers; a 6500 ms timer
      clears them across the plausible DUT-start delay so the next observed
      offer is a clean main-phase cyclic (2000 ms cadence).
    awaiting_anchor       — the next multicast OfferService is the anchor; a
      2600 ms deadline (>1 cyclic) guarantees one is seen or the run is
      inconclusive (never a false fail).
    listening_offer_reply — the multicast Find is emitted on entry; a 1300 ms
      deadline catches a solicited reply (~50 ms) yet ends before the next
      cyclic (+2000 ms). Pass on a multicast solicited OfferService, fail on a
      unicast one, inconclusive on no reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_sd_behavior_04"
       datamodel="null"
       initial="waiting_main_phase">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="waiting_main_phase">
    <onentry>
      <send event="main_phase_reached" delay="6500ms"/>
    </onentry>
    <transition event="main_phase_reached" target="awaiting_anchor"/>
  </state>

  <state id="awaiting_anchor">
    <onentry>
      <send event="anchor_timeout" delay="2600ms"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.dst_ip == expected.sd_multicast_ip"
                target="listening_offer_reply"/>
    <transition event="anchor_timeout" target="inconclusive_no_offer_after_multicast_find"/>
  </state>

  <state id="listening_offer_reply">
    <onentry>
      <send event="s2_deadline_exceeded" delay="1300ms"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.dst_ip == expected.sd_multicast_ip"
                target="pass"/>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="fail_offer_not_multicast"/>
    <transition event="s2_deadline_exceeded" target="inconclusive_no_offer_after_multicast_find"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_offer_not_multicast">
    <donedata>
      <content>{"verdict":"fail","reason":"offer_dst_ip_not_multicast_after_multicast_find","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_offer_after_multicast_find">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_within_listen_window_after_multicast_find","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
