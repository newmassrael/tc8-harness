<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.2 SOMEIPSRV_OPTIONS_12: Second Reserved field [8 bits]
  of the IPv4 Multicast Option (the byte between IPv4 Address and L4-
  Proto) shall be 0x00 (SWS_SD_00394). Mirrors OPTIONS_05's Endpoint-
  axis reserved2 check, narrowed to the multicast option.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_options_12"
       datamodel="null"
       initial="listening_phase1">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="captured.sd_ipv4_multicast_count &gt;= 1"
           entry_type="0x07"
           pass_expr="captured.sd_first_option_with_l4(::tc8::sd_option_type::kIpv4Multicast, ::tc8::sd_l4_proto::kUdp).reserved2 == 0x00"
           fail_state="fail_reserved2"
           fail_reason="ipv4_multicast_second_reserved_nonzero"/>
</scxml>
