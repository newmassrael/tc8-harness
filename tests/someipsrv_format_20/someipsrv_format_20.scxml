<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.1.20 SOMEIPSRV_FORMAT_20: Length of Type 2 Entries shall
  be 16 bytes. Structurally this means the entries-array length on an
  SD message carrying a Type 2 entry (0x06 subscribe / 0x07 ack/nack)
  is a positive multiple of 16. The TESTER emits a SubscribeEventgroup
  to trigger the DUT's Type 2 reply, then observes the array length.

  The procedure listens up to <ParamListenTime> for the
  SubscribeEventgroupAck, so a window that elapses without a Type 2 reply
  of the mandated length is the DUT's silence where it must answer:
  observed_quiescence, judged against that bound (docs/verdict_policy.md
  Section 2.1, H3), over a window of ParamListenTime plus
  <ParamToleranceTime> (10 s + 1 s at the defaults).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_format_20"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="11s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.sd_entries[0].type == 0x07 and captured.sd_entries_len >= 16 and (captured.sd_entries_len % 16) == 0"
                target="pass"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_ack_within_listen_window","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
