<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_01: DUT-emitted ARP
  Probe targets a link-local address whose third octet is in
  [1, 254] — the first 256 (169.254.0.0/24) and last 256
  (169.254.255.0/24) addresses are reserved (RFC 3927 §2.1, MUST).

  Spec Test Procedure (tc8_p141-p160.txt:271..286):
    1-4. DUT brings up iface and sends DHCPDISCOVER.
    5-7. TESTER listens; verify Target IP > 169.254.0.255 AND
                          Target IP <= 169.254.254.255.

  `ArpCaptured::target_proto_ip_in_valid_ll_range()` encapsulates the
  prefix + range conjunction so the SCXML guard stays a single
  member-method call. Body shared with ADDRESS_SELECTION_05/06/07/08
  via the ipv4_linklocal_probe_field template.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_01"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_probe_field.sce-template.xml"
           pass_expr="captured.target_proto_ip_in_valid_ll_range()"
           fail_state="fail_target_ip_in_reserved_range"
           fail_reason="probe_target_ip_in_first_or_last_256_of_169_254_16"
           fail_role="observed_violation"/>
</scxml>
