<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_10: DHCPREQUEST generated during
  REBINDING state — 'requested IP address' (Option 50) MUST NOT be
  filled (RFC 2131 §4.3.6 table 5).

  Spec Test Procedure (tc8_p261-p280.txt: REQUEST_10):
    1-2. DUT bring-up + DHCP client configure.
    3-4. TESTER causes DUT to BOUND, then to REBINDING (T2).
    5.   TESTER: DHCP Server <SERVER-1> Listens (upto <ParamListenTime>).
    6.   DUT: Sends DHCPREQUEST Message (REBINDING).
    7.   TESTER: Verify received DHCPREQUEST does NOT carry Option 50.
  Pass: 4 + 6 + 7.

  Same invariant as REQUEST_07 but observed on the REBINDING REQUEST
  after T2 fires.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_10"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_rebinding_request_field.sce-template.xml"
           pass_expr="captured.option_absent(50)"
           fail_state="fail_rebinding_request_carries_requested_ip"
           fail_reason="dut_rebinding_request_carries_requested_ip"
           fail_role="observed_violation"/>
</scxml>
