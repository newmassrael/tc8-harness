<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_03 negative — closes the
  self-reference trap on the positive _03 case. tc8-dut emits
  Announces via OpStartLLAutoconfBuggy(flavor=AnnounceSenderHwWrong):
  the first Announce's ARP sender_hw is set to a locally-administered
  sentinel that is never the DUT iface MAC, violating RFC 3927 §2.4
  (RFC 826 ar$sha == iface MAC).

  Cluster filter pins eth_src to the DUT iface MAC, so the listening
  state matches frames whose Ethernet src is correct but whose ARP
  payload sender_hw diverges — that is exactly the self-validation
  shape: the ENCAPSULATING Ethernet header is preserved, only the
  ARP-payload mutation is observable.

  Pass = inverted pass_expr matched (sender_hw != DUT MAC).
  fail_compliant_emit = harness silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_03_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_announce_field.sce-template.xml"
           pass_expr="captured.sender_hw != expected.dut_iface_mac"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_announce_despite_sender_hw_wrong_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
