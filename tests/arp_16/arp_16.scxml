<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_16: ARP Request reception (Target Hardware Address =
  00:00:00:00:00:00). RFC 826 §"Packet Generation" allows the requester
  to leave ar$tha unset since that is the value being resolved; the DUT
  must still answer if sender_ip/target_ip identify a Request to its own
  protocol address.

  Stimulus: tester injects a single ARP Request with target_hw zeroed.
  Pass on observation of an ARP Reply (opcode=2) whose sender_hw equals
  the DUT's interface MAC; its silence over <ParamListenTime> is an
  observed_quiescence fail. Body: arp_required_reply.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_16"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_required_reply.sce-template.xml"/>
</scxml>
