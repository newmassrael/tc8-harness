<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.2 IPv4_AUTOCONF_ADDRESS_SELECTION_15: Conflict resolution -
  II. RFC 3927 §2.2.1 MUST: once the host has experienced
  MAX_CONFLICTS (=10) probing-window conflicts, it MUST limit the rate
  at which it probes for new addresses to no more than one new address
  per RATE_LIMIT_INTERVAL — and the rate-limit MUST persist across
  multiple windows, not just the first one.

  Spec Test Procedure (tc8_p161-p180.txt:166..409):
    1-53. Same as _14: 10 conflict cycles for tentative LL_1..LL_10.
    54-55. Tester listens for RATE_LIMIT_INTERVAL — DUT MUST be silent.
    56-57. Tester listens; DUT emits ARP Probe with a NEW LL_11 (the
           post-rate-limit re-probe).
    58.    Verify target_ip != LL_1 (the first probed LL).
    59-60. Tester reads LL_11, injects 11th conflict.
    61-62. Tester listens for RATE_LIMIT_INTERVAL — DUT MUST be silent
           again, proving the rate-limit persists into the next window.

  Pass criterion: 10 distinct DUT-emitted Probes met with conflict ARPs,
  full silence for RATE_LIMIT_INTERVAL, one fresh post-silence Probe,
  one more conflict, then full silence again for RATE_LIMIT_INTERVAL.

  Trait wiring: dispatchArpFrameWithRepeatedConflictEmit drives the
  10-cycle phase identically to _14, then on the post-silence Probe
  (state_before == wait_repick) emits ONE more conflict. SCXML
  transitions wait_repick → silence_watch_2 directly on `arp_observed`
  — no synthetic event needed, the dispatcher's emit fires alongside
  the natural transition.

  The previous_observed_probe_target_ip side-channel (written by
  the dispatcher AFTER the SCXML step on every observed Probe) is
  what the cycle and wait_repick guards read to assert each new
  Probe targets a different LL than the immediately-preceding one.
  Catches both "DUT always picks the same LL" and "DUT picks a
  recently-conflicted LL" bugs (TC8 step 11 / step 58 verify the
  immediate-prior LL specifically, not just the first one).

  Fast envelope: rate_limit_interval = 3 s. silence_watch_1 and
  silence_watch_2 deadlines = 3 000 ms (= RATE_LIMIT_INTERVAL exactly,
  per the same favorable-asymmetry reasoning as _14). Wall budget:
    ~1.7 s (Probe1) + ~2.5 s (10 cycles)
    + 3 s (silence_1) + ~0.3 s (rate-limit recovery + Probe11)
    + 3 s (silence_2) ≈ 10.5 s.
  Global SCXML deadline 15 s gives ~4.5 s margin; 18 s case_timeout
  on top covers stimulus + post-pass settle.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_address_selection_15"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="15s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="cycle"/>
    <transition event="deadline_exceeded" target="fail_no_initial_probe"/>
  </state>

  <state id="cycle">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe() and captured.target_proto_ip != captured.previous_observed_probe_target_ip"
                target="cycle"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_cycle_repeat"/>
    <transition event="conflicts_complete" target="silence_watch_1"/>
    <transition event="deadline_exceeded" target="fail_conflicts_incomplete"/>
  </state>

  <state id="silence_watch_1">
    <onentry>
      <send event="silence_complete_1" delay="3000ms"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_emitted_during_silence_1"/>
    <transition event="silence_complete_1" target="wait_repick"/>
    <transition event="deadline_exceeded" target="fail_emitted_during_silence_1"/>
  </state>

  <state id="wait_repick">
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe() and captured.target_proto_ip != captured.previous_observed_probe_target_ip"
                target="silence_watch_2"/>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_post_silence_repeat"/>
    <transition event="deadline_exceeded" target="fail_no_post_silence_probe"/>
  </state>

  <state id="silence_watch_2">
    <onentry>
      <send event="silence_complete_2" delay="3000ms"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.is_arp_probe()"
                target="fail_emitted_during_silence_2"/>
    <transition event="silence_complete_2" target="pass"/>
    <transition event="deadline_exceeded" target="fail_emitted_during_silence_2"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_initial_probe">
    <donedata>
      <content>{"verdict":"fail","reason":"no_arp_probe_after_ll_start"}</content>
    </donedata>
  </final>

  <final id="fail_conflicts_incomplete">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_re_probe_through_max_conflicts"}</content>
    </donedata>
  </final>

  <final id="fail_cycle_repeat">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_re_probed_with_stale_link_local_address"}</content>
    </donedata>
  </final>

  <final id="fail_emitted_during_silence_1">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_arp_during_first_rate_limit_silence"}</content>
    </donedata>
  </final>

  <final id="fail_no_post_silence_probe">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_emit_arp_after_rate_limit_recovery"}</content>
    </donedata>
  </final>

  <final id="fail_post_silence_repeat">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_post_silence_probe_targets_first_ll"}</content>
    </donedata>
  </final>

  <final id="fail_emitted_during_silence_2">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_emitted_arp_during_second_rate_limit_silence"}</content>
    </donedata>
  </final>
</scxml>
