<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.12 TCP_PROBING_WINDOWS_04: even if the receive window is
  closed indefinitely, the sending TCP MUST allow the connection to
  stay open as long as probes are acknowledged (RFC 1122 §4.2.2.17
  p92 — RFC 793 §3.7 page 42 MUST).

  v3.0 Test Procedure (p376):
    1. TESTER: Cause DUT to move on to ESTABLISHED state.
    2. TESTER: Cause the application on the DUT-side to issue a SEND
               request for data segment.
    3. DUT:    Send the data segment.
    4. TESTER: Send ACK declaring a zero receive window.
    5. TESTER: Cause the application on the DUT-side to issue another
               SEND request for data segment.
    6. DUT:    Send a zero window probe.
    7. TESTER: Acknowledge the probe maintaining zero window.
    8. DUT:    Keep on sending the zero window probes, staying in the
               ESTABLISHED state, as long as the tester acknowledges
               each of them at every reception.

  Mechanism (active-OPEN handshake + small SEND + zero-window ACK +
  second SEND + 3-probe consume chain with per-probe ACK injection):
    1. driveActiveOpenEstablished on (kBasicsActiveLocalPort+151,
       kBasicsActiveRemotePort+151).
    2. Tester listener.acceptOne(); queryTcpSeqRange snapshots the
       post-handshake tester snd_nxt / rcv_nxt.
    3. TesterAutoAckDrop suppresses tester-kernel auto-ACKs so the
       harness retains full control over ACK injection.
    4. UT OpSendTcpData(N B) → DUT seg1.
    5. Settle ~150 ms; raw-inject ACK at seg1_seq+N with `window=0`.
       DUT advances snd_una, sets snd_wnd=0, persist timer arms.
    6. UT OpSendTcpData(M B) — bytes queue behind snd_wnd=0; the
       socket is now in persist state.
    7. Linux's persist path emits zero-window probes via
       `tcp_send_probe0` → `tcp_xmit_probe_skb(sk, 0)`. Each probe
       is a 0-byte ACK at seq = snd_una - 1. snd_una never advances
       (no data is acked), so all probes share the same seq.

    Observer-driven loop: each transition into Listening_probe2 /
    Listening_probe3 fires a `scheduleAfterStateEntry` lambda that
    raw-injects another ACK with `window=0` (same ack_num,
    snd_una_post_ack). Linux's `tcp_ack_probe` sees window still 0
    → reschedules the next probe with current `icsk_backoff`
    (inter-probe interval doubles each round; the backoff is NOT
    reset because the ACK does not advance snd_una). The DUT keeps
    probing at exponentially-increasing intervals.

  Captured.expected_ack_num is preloaded with `snd_una_post_ack - 1`.
  All 3 SCXML probe-listening states gate on `is_zero_window_probe(
  ...)`, which accepts either RFC 1122 §4.2.2.17 probe shape — Linux's
  0-byte garbage-octet at snd_una-1, or the BSD/lwIP 1-byte new-data
  probe at snd_una — both at the spec-conformant seq. The seq + length
  discrimination keeps a non-probe segment out (e.g. the handshake
  third-leg ACK, seq=seg1_seq, or a genuine >1-byte data segment).
  lwIP's per-probe persist cadence (~1.2 s, +3.0 s, +6.0 s) clears the
  4 s / 6 s / 10 s deadlines with margin.

  Four-state SCXML chain:
    * listening_seg1     — observe seg1 (DUT data segment).
    * listening_probe1   — 4 s deadline; probe 1 fires after Linux's
      first persist RTO (typically 200 ms..1 s on local veth).
    * listening_probe2   — 4 s deadline; probe 2 fires after the
      doubled inter-probe interval (~400 ms..2 s).
    * listening_probe3   — 4 s deadline; probe 3 fires after the
      4× inter-probe interval (~800 ms..4 s).

  Negative flip: ipv4.dut_iface_ip=10.99.99.99 makes
  is_dut_data_segment(...)'s src_ip conjunct unreachable; case lands
  on fail_no_seg1 via the 5 s phase-1 deadline.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_probing_windows_04"
       datamodel="null"
       initial="listening_seg1">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_seg1">
    <onentry>
      <send event="deadline_seg1" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_data_segment(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset)"
                target="listening_probe1"/>
    <transition event="deadline_seg1" target="fail_no_seg1"/>
  </state>

  <state id="listening_probe1">
    <onentry>
      <send event="deadline_probe1" delay="4s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset)"
                target="listening_probe2"/>
    <transition event="deadline_probe1" target="fail_no_probe1"/>
  </state>

  <state id="listening_probe2">
    <onentry>
      <send event="deadline_probe2" delay="6s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset)"
                target="listening_probe3"/>
    <transition event="deadline_probe2" target="fail_no_probe2"/>
  </state>

  <state id="listening_probe3">
    <onentry>
      <send event="deadline_probe3" delay="10s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_zero_window_probe(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpProbingWindows04LocalOffset)"
                target="pass"/>
    <transition event="deadline_probe3" target="fail_no_probe3"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_no_seg1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_first_data_segment"}</content>
    </donedata>
  </final>

  <final id="fail_no_probe1">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_zero_window_probe_1"}</content>
    </donedata>
  </final>

  <final id="fail_no_probe2">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_zero_window_probe_2_after_ack"}</content>
    </donedata>
  </final>

  <final id="fail_no_probe3">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_zero_window_probe_3_after_ack"}</content>
    </donedata>
  </final>
</scxml>
