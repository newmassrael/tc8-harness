<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_03: An ARP Announcement - III.
  DUT's first Announce carries `sender_hw` = DUT interface MAC
  (RFC 3927 §2.4 MUST: the Announcement is identical to the Probe shape,
  i.e. sender_hw is the host's own hardware address).

  Spec Test Procedure (tc8_p161-p180.txt:591..631), step 11:
    Verify Source Hardware Address = <DIFACE-0-MAC-ADDR>.

  ARP `sender_hw` (payload field) is distinct from the encapsulating
  Ethernet `eth_src` — the cluster filter pins eth_src to the DUT MAC
  so the SCXML can attribute the frame; the pass_expr then asserts the
  ARP-payload sender_hw matches the same MAC (a buggy DUT could
  diverge if it copied a different MAC into the payload). Body
  shared via ipv4_linklocal_announce_field.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_03"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_announce_field.sce-template.xml"
           pass_expr="captured.sender_hw == expected.dut_iface_mac"
           fail_state="fail_announce_sender_hw_not_dut_mac"
           fail_reason="dut_arp_announce_sender_hw_not_dut_iface_mac"/>
</scxml>
