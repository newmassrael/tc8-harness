<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.18 TCP_ACKNOWLEDGEMENT_03 negative — lwIP egress self-validation of the
  positive _03 "DUT ACKs raw-injected data with the expected Ack Number" guard. The trait
  drives the raw passive accept (handshake) with the fault disarmed, then arms
  kTcpFaultPureAckNumWrong before injecting the data, so the data-elicited ACK (the only
  pure DUT ACK observed here) carries a flipped ack_num. Pass = the corrupted ack observed
  (ack_num != expected_ack_num); fail_compliant = the DUT acked correctly despite the
  flavor (fault inert). lwIP-only (kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_acknowledgement_03_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpAck03ListenPort, ::tc8::sce::tcp::kTcpAck03TesterSrcPort)"
           pass_expr="captured.ack_num != captured.expected_ack_num"
           fail_state="fail_compliant"
           fail_reason="dut_ack_num_correct_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_ack_to_data"/>
</scxml>
