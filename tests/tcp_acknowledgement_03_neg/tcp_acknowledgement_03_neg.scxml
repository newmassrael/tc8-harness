<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.18 TCP_ACKNOWLEDGEMENT_03 negative — lwIP egress self-validation of the
  positive _03 "DUT ACKs raw-injected data with the expected Ack Number" guard. The
  trait drives the raw passive accept (handshake) with the fault disarmed, then arms
  kTcpFaultDataAckNumWrong before injecting the data, so the data-elicited ACK (the only
  pure DUT ACK observed here) carries a flipped ack_num.
  Pass = the data-ACK's ack_num does NOT acknowledge the payload (the injected violation);
  fail_compliant = the DUT still acked correctly despite the flavor (fault inert).
  lwIP-only (kCapEgressFault). Mirrors tcp_acknowledgement_03's single data-ACK state.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_acknowledgement_03_neg"
       datamodel="null"
       initial="listening_data_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>
  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_data_ack">
    <onentry>
      <send event="deadline_data_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpAck03ListenPort, ::tc8::sce::tcp::kTcpAck03TesterSrcPort) and captured.ack_num != captured.expected_ack_num"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpAck03ListenPort, ::tc8::sce::tcp::kTcpAck03TesterSrcPort) and captured.ack_num == captured.expected_ack_num"
                target="fail_compliant_correct_ack_num"/>
    <transition event="deadline_data_ack" target="inconclusive_no_data_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_data_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_data","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_compliant_correct_ack_num">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_ack_num_correct_despite_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>
</scxml>
