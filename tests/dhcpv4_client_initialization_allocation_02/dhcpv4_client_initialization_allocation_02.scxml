<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_02:
    "The client begins in INIT state and forms a DHCPDISCOVER message ...
     The client sets 'ciaddr' to 0x00000000" (RFC 2131 §4.4.1, MUST).

  Spec Test Procedure (tc8_p261-p280.txt: INIT_ALLOC_02):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER listens (no server reply).
    4.   DUT: Sends DHCPDISCOVER Message.
    5.   TESTER: Verify received DISCOVER carries 'ciaddr' field set to 0.

  Same single-shot stimulus as PROTOCOL_01/02 / SUMMARY_04 — a
  DHCPDISCOVER emitted by tc8-dut on OpStartLLAutoconf. tc8-dut zeroes
  ciaddr by construction (the BOOTP fixed body is memset-zeroed before
  the DUT-emit fields are written), so this case always passes against
  the tc8-dut and serves as the regression guard for `ciaddr_is_zero()`
  semantics on DUT-emitted DISCOVERs (the same predicate is reused for
  REQUEST_01 against the REQUEST stage).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_02"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and captured.ciaddr_is_zero()"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.ciaddr_is_zero()"
                target="fail_ciaddr_nonzero"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_ciaddr_nonzero">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_ciaddr_not_zero","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
