<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.9 DHCPv4_CLIENT_INITIALIZATION_ALLOCATION_08:
    Post-BOUND, the DUT emits an ARP Probe for the offered yiaddr with
    sender_hw = DUT MAC and sender_ip = 0 to verify the address is not in
    use (RFC 2131 §4.4.1 / RFC 5227 §2.1.1). Pass Criteria step 7 verifies
    the probe fields; a present-but-malformed probe is a fail (not the
    deadline's inconclusive).

  Reuses dhcpv4_init_alloc_arp_probe with the conformant predicate; the
  _08_neg sibling binds its negation against the ProbeSenderIpNonzero
  firmware mutant. The trait opts into the post-BOUND ARP Probe firmware
  path (arp_probe_listen_ms=1500) and injects OFFER + ACK.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_initialization_allocation_08"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_init_alloc_arp_probe.sce-template.xml"
           pass_expr="captured.arp.is_dhcp_arp_probe(expected.dhcpv4.offered_ip_be)"
           fail_state="fail_arp_probe_shape_mismatch"
           fail_reason="dut_arp_probe_field_mismatch"/>
</scxml>
