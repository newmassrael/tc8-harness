<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.2 DHCPv4_CLIENT_PROTOCOL_01 negative — closes the
  self-reference trap on the positive _01 case (magic cookie 99,130,83,99
  in the first four 'options' octets, RFC 1497 / RFC 2131 §3). The
  positive's fail_magic_cookie_invalid branch is unreachable against a
  conformant tc8-dut, which hard-codes the cookie by construction — so
  without a fault injection the guard is dead code and the harness
  silently accepts a client emitting a mangled cookie.

  Fault injection is a real firmware mutant, not a harness-composed
  frame: the stimulus drives the ordinary DHCP client with the
  kDhcpFlavorDiscoverMagicCookieCorrupt flavor, which makes tc8-dut's
  emitDhcpMessage zero the first magic-cookie byte. A conformant DUT
  (flavor None, every positive case) emits the valid cookie, so this
  negative distinguishes a buggy client from a conformant one.

  Pass = the corrupted cookie IS observed (magic_cookie_valid false on a
  DUT-emitted BOOTREQUEST). fail_compliant = the client emitted a valid
  cookie despite the flavor, i.e. the firmware did not honour the mutant
  — the live conformant-DUT outcome and a flavor-wiring regression catch,
  not an infra-only dead branch. A corrupt cookie suppresses the options
  walk, so the violation guard reads only the BOOTP fixed fields (op,
  chaddr) — mirroring the positive's fail branch.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_protocol_01_neg"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Dhcpv4Captured"
               cpp:include="sce_integration/dhcpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Dhcpv4Expected"
               cpp:include="sce_integration/dhcpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="4s"/>
    </onentry>
    <transition event="dhcp_observed"
                cond="cpp:captured.op == 1
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)
                      and !captured.magic_cookie_valid"
                target="pass"/>
    <transition event="dhcp_observed"
                cond="cpp:captured.is_dhcp_discover()
                      and captured.chaddr_matches_dut_mac(expected.dut_iface_mac)"
                target="fail_compliant"/>
    <transition event="deadline_exceeded" target="inconclusive_no_discover"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_dhcp_discover_carried_valid_magic_cookie_despite_corrupt_cookie_flavor","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_discover">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_dhcp_discover_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
