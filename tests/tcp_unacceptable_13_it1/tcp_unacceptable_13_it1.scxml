<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_13, iteration 1 of 2: a DUT in TIME-WAIT receives a data
  segment whose SEQ is out of the window, and MUST answer with an acknowledgement carrying
  the right SEQ and ACK numbers while staying in TIME-WAIT (RFC 793 §3.4 p37).

  The iteration is a case of its own: the TC8 case is the ordered set of its iterations
  and its verdict their conjunction (case_iteration.h). The second iteration, an
  unacceptable ACK number, is tcp_unacceptable_13_it2; they share one stimulus body and
  differ only in the segment sent, and in their port quads.

  Observable interaction: active-OPEN handshake to ESTABLISHED, the DUT CLOSEs, the tester
  acknowledges and then sends its own FIN so the DUT enters TIME-WAIT, the tester drops its
  socket and injects the corrupt segment from the quad it just left. Four DUT-origin
  observations reach the machine on tcp_observed, in order:
    1. the handshake's third-leg ACK (pure ACK);
    2. the DUT's FIN+ACK (the CLOSE that starts the teardown);
    3. the DUT's ACK of the tester's FIN (the DUT is now in TIME-WAIT);
    4. the empty ACK answering the corrupt segment, with ack_num == expected_ack_num.

  The procedure states no listen time, so the general input parameter ParamListenTime
  bounds the wait for the answer in (4). A window that elapses without it is the DUT's
  silence where it must answer: observed_quiescence, judged against that bound (H3), over
  ParamListenTime plus ParamToleranceTime. The windows that walk the DUT into TIME-WAIT stay
  inconclusive: they set up the state the segment tests. Whether a silence stands as a fail
  is the CLI's call on the run's hypotheses.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_13_it1"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake">
    <onentry>
      <send event="deadline_handshake" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_dut_fin">
    <onentry>
      <send event="deadline_dut_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset)"
                target="listening_tester_fin_ack"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>

  <state id="listening_tester_fin_ack">
    <onentry>
      <send event="deadline_tester_fin_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset)"
                target="listening_probe_ack"/>
    <transition event="deadline_tester_fin_ack" target="inconclusive_no_tester_fin_ack"/>
  </state>

  <state id="listening_probe_ack">
    <onentry>
      <send event="deadline_probe_ack" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable13Phase1LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="pass"/>
    <transition event="deadline_probe_ack" target="fail_no_probe_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_dut_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_fin","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_tester_fin_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_tester_fin","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_no_probe_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_in_time_wait","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
