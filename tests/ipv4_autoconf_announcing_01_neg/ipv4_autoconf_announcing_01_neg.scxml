<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.5.6.3 IPv4_AUTOCONF_ANNOUNCING_01 negative — closes the
  self-reference trap on the positive _01 case. tc8-dut emits
  Announces via OpStartLLAutoconfBuggy(flavor=AnnounceEthDstUnicast):
  Probes stay compliant so the precondition completes; the first
  Announce's Ethernet dst is set to the DUT iface MAC instead of
  broadcast, violating RFC 3927 §2.4 / RFC 3927 §2.5 last MUST.

  Pass = SCXML lands on fail_compliant_emit branch — i.e. the
  template's inverted pass_expr matched (eth_dst != broadcast).
  fail_compliant_emit = tc8-dut ignored the flavor byte, harness
  silently accepted the buggy DUT.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_autoconf_announcing_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_linklocal_announce_field.sce-template.xml"
           pass_expr="!(captured.is_eth_broadcast())"
           fail_state="fail_compliant_emit"
           fail_reason="dut_emitted_compliant_announce_despite_eth_dst_unicast_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
