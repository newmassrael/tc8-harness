<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.7 TCP_FLAGS_PROCESSING_02, iteration 3 of 5: a DUT whose connection is in
  FIN-WAIT-1 MUST return to CLOSED on a RESET. Derived from RFC 793 §3.9 p70 Event
  Processing (MUST).

  A case of its own beside tcp_flags_processing_02_it1, which holds the shared description
  of the wire-observable "DUT moved to CLOSED"; the five iterations differ in the state the
  DUT is walked into, and in their port quads.

  This iteration: active-OPEN handshake to ESTABLISHED, then the DUT closes. The tester
  suppresses its kernel's pure ACKs, so the DUT's FIN stays unacknowledged and the DUT holds
  FIN-WAIT-1 across the probe. The tester injects an in-window RST and then a verify-probe
  ACK on the SAME 4-tuple. A full-socket state has no socket on the 4-tuple after the RST,
  so the verify ACK reaches a closed port and the DUT answers with an RST: the
  wire-observable proof that the connection was destroyed.

  The procedure states no listen time, so the general input parameter ParamListenTime bounds
  the wait for the verify RST. A verify window that elapses without it is the DUT's silence
  where it must answer: observed_quiescence, judged against that bound (H3), over
  ParamListenTime plus ParamToleranceTime (10 s + 1 s at the defaults). The handshake and FIN
  windows stay inconclusive: they set up the state the RST tests.

  Ports: (kBasicsActiveLocalPort + 61, kBasicsActiveRemotePort + 61).

  SCXML chain (3 listening states):
    listening_handshake_ack: wait for the DUT's pure ACK (handshake third leg)
                             -> listening_dut_fin
    listening_dut_fin:       wait for the DUT's FIN+ACK (the close that enters FIN-WAIT-1)
                             -> listening_verify_rst
    listening_verify_rst:    wait for DUT RST on the same ports -> pass
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_flags_processing_02_it3"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing02Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing02Phase2LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>
  <state id="listening_dut_fin">
    <onentry><send event="deadline_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing02Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing02Phase2LocalOffset)"
                target="listening_verify_rst"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>
  <state id="listening_verify_rst">
    <onentry><send event="deadline_verify_rst" delay="11s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_rst(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpFlagsProcessing02Phase2LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpFlagsProcessing02Phase2LocalOffset)"
                target="pass"/>
    <transition event="deadline_verify_rst" target="fail_no_verify_rst"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack_fw1","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin_fw1","role":"property_unobserved"}</content></donedata></final>
  <final id="fail_no_verify_rst"><donedata><content>{"verdict":"fail","reason":"dut_did_not_emit_rst_after_rst_in_fw1","role":"observed_quiescence","bound":"ParamListenTime"}</content></donedata></final>
</scxml>
