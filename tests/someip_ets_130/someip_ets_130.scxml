<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_130:
  SD_Multicast_FindService_with_unicast_Flag_to_0.

  Tester sends a multicast FindService with the SD Unicast Flag = 0
  (sd_flags = 0x80 = Reboot=1 Unicast=0). DUT must ignore the flag and
  respond with at least one unicast OfferService per PRS_SOMEIPSD_00268
  / 00305 / 00306 / 00307. Lenient verdict mirrors ETS_127 — accepts
  any OfferService observation; the spec's Unicast-vs-Multicast wire
  distinction is not reliably observable on Linux DUT (vsomeip emits
  multicast Offer during burst windows per SD §4.1.3 cadence rules).

    Phase 1 (listening_phase1): OfferService for SERVICE-ID-1 -> pass.
            Phase 1 deadline only fires if DUT crashed under the
            Unicast-Flag=0 input.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_130"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.sd_entries[0].ttl &gt; 0"
                target="pass"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>
</scxml>
