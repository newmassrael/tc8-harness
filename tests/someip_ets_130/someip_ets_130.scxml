<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_130:
  SD_Multicast_FindService_with_unicast_Flag_to_0.

  Tester sends a multicast FindService with the SD Unicast Flag = 0
  (sd_flags = 0x80 = Reboot=1 Unicast=0). DUT must ignore the flag and
  respond with at least one OfferService. The case asserts that the answer
  HAPPENS; it does not assert the answer's transport, so a unicast or a
  multicast reply both pass (SOMEIPSRV_SD_BEHAVIOR_04 is the case that
  asserts multicast).

  The duty to answer is TC8's, and AUTOSAR reads it the other way:
  PRS_SOMEIPSD_00843 (FO R22-11) requires that entries with the unicast flag
  set to 0 "shall not be answered with unicast but ignored". The ids in TC8's
  own Reference row here (PRS_SOMEIPSD_00268 / 00305 / 00306 / 00307) are
  entry- and option-format requirements covering the encoding this case
  exercises, not the duty to answer.

  Cadence-relative timing (same rationale as SD_BEHAVIOR_03/_04). Per the SD
  §4.1.3 cadence rules the DUT emits a cyclic OfferService every
  cyclic_offer_delay (2000 ms here) throughout the main phase, so a listen
  window opened at a fixed wall-clock offset will collect one whether or not
  the Find was ever answered — the verdict then passes on cyclic drift and
  asserts nothing. That same cadence rule is what makes anchoring sound: two
  consecutive cyclics bound a gap no third offer can occupy unsolicited.
  (This case carried exactly that shape until 2026-08-03: a single 6 s
  window accepting any OfferService, its own comment conceding the deadline
  "only fires if DUT crashed".) Instead the harness ANCHORS to the DUT's own
  offer: it waits into the main phase, takes the next cyclic as the anchor,
  emits the Find on entry to the reply state, and closes the window before
  the next cyclic is due. The window then sits strictly between two cyclics,
  so the only OfferService that can land in it is a solicited one.

  Phases:
    waiting_main_phase    — absorb the init/repetition offers; a 6500 ms
      timer clears them across the plausible DUT-start delay so the next
      observed offer is a clean main-phase cyclic.
    awaiting_anchor       — the next multicast OfferService is the anchor; a
      2600 ms deadline (>1 cyclic) means a DUT that never offers at all is
      reported as a precondition failure, not a property failure.
    listening_offer_reply — the multicast Find is emitted on entry; a
      1300 ms deadline catches a solicited reply (~50 ms) yet ends before
      the next cyclic (+2000 ms).

  Reference-stack note: upstream vsomeip drops Unicast-Flag=0 Finds
  (SIP_SD_91), so before `patches/vsomeip/0002` the only OfferService this
  case could ever observe was a cyclic one. The patch supplies the solicited
  answer that makes the anchored window reachable. Its branch is compile-gated
  on `ENABLE_TC8_ANSWER_MULTICAST_FIND` (default ON): a DUT built with the gate
  OFF keeps the upstream drop and this case returns to its inconclusive
  terminal — see README, "Declining a base-patch behaviour".
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_130"
       datamodel="null"
       initial="waiting_main_phase">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="waiting_main_phase">
    <onentry>
      <send event="main_phase_reached" delay="6500ms"/>
    </onentry>
    <transition event="main_phase_reached" target="awaiting_anchor"/>
  </state>

  <state id="awaiting_anchor">
    <onentry>
      <send event="anchor_timeout" delay="2600ms"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id and captured.dst_ip == expected.sd_multicast_ip"
                target="listening_offer_reply"/>
    <transition event="anchor_timeout" target="inconclusive_no_cyclic_offer"/>
  </state>

  <state id="listening_offer_reply">
    <onentry>
      <send event="reply_deadline_exceeded" delay="1300ms"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="pass"/>
    <transition event="reply_deadline_exceeded" target="inconclusive_no_offer_after_multicast_find"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_cyclic_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_cyclic_offer_service_to_anchor_on","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_offer_after_multicast_find">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_within_listen_window_after_multicast_find","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
