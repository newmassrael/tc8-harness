<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_01: DHCPREQUEST 'ciaddr' field
  is 0 in REQUESTING state (RFC 2131 §4.3.2).

  Spec Test Procedure (tc8_p241-p260.txt: REQUEST_01):
    1-2. DUT bring-up + DHCP client configure.
    3.   TESTER causes DUT to transit to DHCPCLIENT_STATE_REQUESTING
         (= reply OFFER on observed DISCOVER so the DUT issues REQUEST).
    4.   DUT: Transit finite state to DHCPCLIENT_STATE_REQUESTING.
    5.   TESTER: Verify received DHCPREQUEST contains 'ciaddr' = 0.
  Pass: 4 + 5.

  RFC 2131 §4.3.2: in REQUESTING state the address being requested
  is carried in Option 50 (Requested IP Address), not in the BOOTP
  fixed header's 'ciaddr' field. ciaddr only carries the bound IP
  during RENEWING/REBINDING.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_01"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_request_field.sce-template.xml"
           pass_expr="captured.ciaddr_is_zero()"
           fail_state="fail_request_ciaddr_not_zero"
           fail_reason="dut_dhcp_request_ciaddr_not_zero"/>
</scxml>
