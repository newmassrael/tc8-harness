<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.1 TCP_BASICS_10: in FINWAIT-1 or FINWAIT-2 state, the
  DUT's TCP MUST send an ACK in response to a tester FIN. Derived from
  RFC 793 §3.2 p23 Terminology.

  Case shape — two iterations:
    1. CASE: <wst> = FINWAIT-1
    2. CASE: <wst> = FINWAIT-2

  Both iterations share the wire-observable assertion (DUT: Send ACK)
  and reach the precondition state via the same procedure prefix
  (handshake + DUT close + tester FIN). They differ in what the DUT's
  FIN meets:
    1. FINWAIT-1: the tester kernel's ACK of the DUT's FIN is dropped,
       so the DUT stays in FINWAIT-1, and the tester FIN is injected raw
       with an ACK field short of the DUT's FIN. A kernel FIN would
       acknowledge the DUT's FIN and move it past FINWAIT-1 before the
       FIN arrived.
    2. FINWAIT-2: the tester kernel ACKs the DUT's FIN, and 100 ms later
       sends its own FIN.
  In both, the ACK graded is the one that acknowledges the tester FIN:
  ack number = the FIN's sequence number plus one, which the stimulus
  records (captured.expected_ack_num, expected_ack_num_phase2).

  Each phase uses a 2-state sub-chain to distinguish the DUT's close
  FIN (the marker that signals the procedure has reached the
  FINWAIT-X state) from the spec-target ACK (the response to tester
  FIN):

    listening_pK_fin:    wait for DUT FIN+ACK on phase-K ports
                         → listening_pK_ack
    listening_pK_ack:    wait for DUT pure ACK (no FIN/SYN/RST) on
                         the same ports → next phase or pass

  Without the FIN-first marker the SCXML would match the handshake
  third-leg ACK from the DUT and pass spuriously — same hazard
  BASICS_07 dodges by querying ut_established (which has no off-the-
  wire surrogate available here).

  The ACK to the tester FIN is the Pass Criteria of both iterations, and
  the TCP chapter states no time for it, so a listening_pK_ack window
  that elapses without it is the DUT's silence where it must answer —
  observed_quiescence for that iteration, judged against
  <ParamListenTime> (docs/verdict_policy.md Section 2.1, H3); the window
  is ParamListenTime plus <ParamToleranceTime> (10 s + 1 s at the
  defaults). The close FIN that marks FINWAIT-K is the precondition
  (step 1), so its silence stays inconclusive. Every state arms its own
  timer event so an earlier state's timer cannot close a later window.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_basics_10"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_p1_fin">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_p1_fin">
    <onentry>
      <send event="deadline_p1_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpBasics10Phase1LocalOffset) and captured.dst_port == (::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpBasics10Phase1LocalOffset) and (captured.flags &amp; 0x01) != 0"
                target="listening_p1_ack"/>
    <transition event="deadline_p1_fin" target="inconclusive_timeout_p1_fin"/>
  </state>

  <state id="listening_p1_ack">
    <onentry>
      <send event="deadline_p1_ack" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpBasics10Phase1LocalOffset) and captured.dst_port == (::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpBasics10Phase1LocalOffset) and (captured.flags &amp; 0x01) == 0 and (captured.flags &amp; 0x02) == 0 and (captured.flags &amp; 0x04) == 0 and (captured.flags &amp; 0x10) != 0 and captured.expected_ack_num != 0 and captured.ack_num == captured.expected_ack_num"
                target="listening_p2_fin"/>
    <transition event="deadline_p1_ack" target="fail_timeout_p1_ack"/>
  </state>

  <state id="listening_p2_fin">
    <onentry>
      <send event="deadline_p2_fin" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpBasics10Phase2LocalOffset) and captured.dst_port == (::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpBasics10Phase2LocalOffset) and (captured.flags &amp; 0x01) != 0"
                target="listening_p2_ack"/>
    <transition event="deadline_p2_fin" target="inconclusive_timeout_p2_fin"/>
  </state>

  <state id="listening_p2_ack">
    <onentry>
      <send event="deadline_p2_ack" delay="11s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == (::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpBasics10Phase2LocalOffset) and captured.dst_port == (::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpBasics10Phase2LocalOffset) and (captured.flags &amp; 0x01) == 0 and (captured.flags &amp; 0x02) == 0 and (captured.flags &amp; 0x04) == 0 and (captured.flags &amp; 0x10) != 0 and captured.expected_ack_num_phase2 != 0 and captured.ack_num == captured.expected_ack_num_phase2"
                target="pass"/>
    <transition event="deadline_p2_ack" target="fail_timeout_p2_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_p1_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_close_fin_phase1","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="fail_timeout_p1_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_tester_fin_phase1","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>

  <final id="inconclusive_timeout_p2_fin">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_close_fin_phase2","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="fail_timeout_p2_ack">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_ack_to_tester_fin_phase2","role":"observed_quiescence","bound":"ParamListenTime"}</content>
    </donedata>
  </final>
</scxml>
