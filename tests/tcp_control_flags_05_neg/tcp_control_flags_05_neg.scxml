<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.19 TCP_CONTROL_FLAGS_05 negative — the DUT's ACK to a URG
  segment MUST carry an ack_num acknowledging the urgent payload
  (RFC 793 §3.9). The positive's wrong-ack_num branch is unreachable
  against a conformant DUT, which acks the payload.

  Fault injection is a real lwIP egress-field mutant: kTcpFaultPureAckNumWrong
  (the same flavor TCP_ACKNOWLEDGEMENT_02_NEG uses) XOR-flips the ack_num of a
  DUT-emitted PURE ACK. It is armed MID-STREAM — after the active-OPEN
  handshake third-leg ACK has escaped — so only the URG-elicited pure ACK is
  corrupted (the handshake stays conformant and the connection holds). A
  conformant DUT (no fault) acks the payload, so this negative's fail_compliant
  branch is the live conformant-DUT outcome.

  Reuses the positive's two-state lifecycle (handshake ACK -> URG ACK); only
  the URG-ACK guard is inverted (pass = ack_num is WRONG = fault manifested).
  lwIP-only (kCapEgressFault).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_control_flags_05_neg"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry>
      <send event="deadline_handshake_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpControlFlags05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpControlFlags05LocalOffset)"
                target="listening_urg_ack"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>

  <state id="listening_urg_ack">
    <onentry>
      <send event="deadline_urg_ack" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpControlFlags05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpControlFlags05LocalOffset) and captured.ack_num != captured.expected_ack_num"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpControlFlags05LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpControlFlags05LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="fail_compliant"/>
    <transition event="deadline_urg_ack" target="inconclusive_no_urg_ack"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_compliant">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_ack_num_acknowledged_urg_payload_despite_ack_num_wrong_flavor","role":"fault_injection_inert"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_handshake_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_no_urg_ack">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_ack_to_urg_segment","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
