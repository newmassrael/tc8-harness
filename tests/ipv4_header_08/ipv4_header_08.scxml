<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.1 IPv4_HEADER_08: DUT discards a packet whose Total Length
  field is smaller than the header length implied by IHL. Derived from
  RFC 791 section 3.1 p11 (Internet Header Format MUST).

  Stimulus: TESTER injects ICMPv4 Echo Request with IHL=13 (claimed
  header = 52 bytes) while Total Length stays at 28 (default compute:
  20 IP + 8 ICMP). Kernel detects tot_len < ihl*4 in ip_rcv_core and
  silently drops.

  Body shared with HEADER_02 / 04 / 09, CHECKSUM_02, ADDRESSING_03 via
  sce:template (tests/_templates/ipv4_negative_absence.sce-template.xml).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_header_08"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_negative_absence.sce-template.xml"
           fail_reason="dut_replied_despite_ihl_times_4_gt_tot_len"/>
</scxml>
