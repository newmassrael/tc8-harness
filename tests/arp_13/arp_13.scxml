<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_13: ARP request sending (Sender Hardware Address
  check). The DUT's emitted ARP Request must carry Sender Hardware
  Address = the DUT interface's MAC. The configured MAC is supplied via
  CLI option expect arp.dut_iface_mac=aa:bb:cc:dd:ee:ff and lands in
  expected.dut_iface_mac. For the smoke-test against tc8-dut the value
  is the kernel-assigned veth-dut MAC, captured per-run by setup-netns.sh
  and threaded into smoke-test.sh.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_13"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
                target="pass"/>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 1 and captured.sender_hw != expected.dut_iface_mac"
                target="fail_sender_hw"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_sender_hw">
    <donedata>
      <content>{"verdict":"fail","reason":"sender_hw_addr_not_dut_iface"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_arp_request_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
