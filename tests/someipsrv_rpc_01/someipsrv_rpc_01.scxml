<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.5.7.1 SOMEIPSRV_RPC_01: The client and server shall use a
  single TCP/UDP transport for all methods of a service instance, also
  for distinct service instances on the same DUT (TR_SOMEIP_00150). The
  spec exercises this against SERVICE-ID-2; tc8-dut publishes SERVICE-ID-2
  via ets2.fdepl when TC8_DUT_SERVICE_2=1, on UDP port 30506.

    Phase 1: DUT's OfferService for SERVICE-ID-2 (0xF4E8) — entry type
             0x01, service_id 0xF4E8.
    Phase 2: DUT replies to the tester's Method Request (METHOD-ID-1-SI-2
             = 0x08, sent to UDP 30506 by emitMethodRequestAfter) with a
             Response (message_type 0x80, return_code E_OK, same
             service_id + method_id).

  Service-ID literal 0xF4E8 is hard-coded (not via expected.service_id)
  because the harness's expect surface tracks SERVICE-ID-1 — adding a
  parallel expect tier just for this case's hard-coded literal would be
  more bookkeeping than this single value warrants.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_rpc_01"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count &gt;= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == ::tc8::someipsrv_si2::kServiceId"
                target="listening_phase2"/>
    <transition event="phase1_deadline_exceeded" target="fail_phase1_no_offer"/>
  </state>

  <state id="listening_phase2">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == ::tc8::someipsrv_si2::kServiceId and captured.message_type == 0x80 and captured.return_code == 0x00 and captured.method_id == ::tc8::someipsrv_si2::kMethodIdEcho"
                target="pass"/>
    <transition event="phase2_deadline_exceeded" target="fail_phase2_no_response"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_phase1_no_offer">
    <donedata>
      <content>{"verdict":"fail","reason":"no_offer_service_for_service_id_2_within_listen_window"}</content>
    </donedata>
  </final>

  <final id="fail_phase2_no_response">
    <donedata>
      <content>{"verdict":"fail","reason":"no_response_for_service_id_2_method_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
