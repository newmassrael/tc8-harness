<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.2 ARP_37: ARP Request reception (Target Protocol Address
  wrong). Tester injects a Request whose target_ip is not DUT's
  interface IP; per RFC 826 "Am I the target protocol address?" the
  DUT must not reply. Absence pattern.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_37"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::ArpCaptured"
               cpp:include="sce_integration/arp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::ArpExpected"
               cpp:include="sce_integration/arp_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="3s"/>
    </onentry>
    <transition event="arp_observed"
                cond="cpp:captured.opcode == 2 and captured.sender_hw == expected.dut_iface_mac"
                target="fail_unexpected_reply"/>
    <transition event="deadline_exceeded" target="pass"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_unexpected_reply">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_replied_to_foreign_target_ip","role":"observed_violation"}</content>
    </donedata>
  </final>
</scxml>
