<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.9 TCP_MSS_OPTIONS_03: TCP MUST ignore without error any
  TCP option it does not implement. Derived from RFC 1122 §4.2.2.5
  p85 TCP Options "RFC-793 Section 3.1" (MUST).

  v3.0 Test Procedure (p357):
    1. TESTER: Cause DUT to move on to LISTEN state on a <wnp>.
    2. TESTER: Send a SYN with an unimplemented TCP option <uopt>.
    3. DUT:    Send SYN,ACK.
    4. TESTER: Send ACK.
    5. TESTER: Verify DUT in ESTABLISHED state.

  Mechanism (driveSeamRawPassiveAccept): same shape as MSS_OPTIONS_02
  with the SYN's options region carrying [0xFD 0x04 0xAA 0xBB] —
  kind=253 (RFC 4727 §7.1 reserved for experimentation, no
  implementation in any standard TCP stack), length=4 (kind + length
  + 2 data bytes), data 0xAA 0xBB. The 4-byte options region keeps
  Data Offset = 6 with no extra padding from the builder. A spec-
  conformant DUT skips the unknown kind during option parsing and
  completes the handshake normally.

  Pass guard / fail terminals identical to MSS_OPTIONS_02.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_mss_options_03"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpMssOptionsListenPort03 and captured.dst_port == ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort03 and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ut_established == 0x01"
                target="pass"/>
    <transition event="tcp_observed"
                cond="cpp:captured.src_ip == expected.dut_iface_ip and captured.dst_ip == expected.tester_ip and captured.src_port == ::tc8::sce::tcp::kTcpMssOptionsListenPort03 and captured.dst_port == ::tc8::sce::tcp::kTcpMssOptionsTesterSrcPort03 and (captured.flags &amp; 0x02) != 0 and (captured.flags &amp; 0x10) != 0 and captured.ut_established == 0x00"
                target="fail_not_established"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_not_established">
    <donedata>
      <content>{"verdict":"fail","reason":"dut_did_not_reach_established"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_dut_syn_ack_within_listen_window"}</content>
    </donedata>
  </final>
</scxml>
