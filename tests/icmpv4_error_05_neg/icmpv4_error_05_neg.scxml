<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.3.3.1 ICMPv4_ERROR_05 negative — lwIP ingress-fault self-validation of the
  positive _05 unknown-type-no-reply guard. The trait injects an ICMP message of an
  IANA-unassigned type (202, which the DUT must silently discard) and arms
  kIcmpFaultSynthEchoReply, so the lwIP netif input hook synthesizes a prohibited ICMP
  reply (an Echo Reply, type=0). Pass = that DUT-origin reply observed
  (src_ip == dut_iface_ip excludes the tester's own type-202 stimulus, exactly as the
  positive's type-agnostic dispatch requires); fail_compliant = DUT stayed silent despite
  the flavor (fault inert). lwIP-only (capability-gated on kCapIngressFault). Envelope:
  icmpv4_synth_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="icmpv4_error_05_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_synth_neg.sce-template.xml"/>
</scxml>
