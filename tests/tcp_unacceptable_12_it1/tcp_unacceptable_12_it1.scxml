<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.3 TCP_UNACCEPTABLE_12, iteration 1 of 2: a DUT in LAST-ACK receives a data
  segment whose SEQ is out of the window, and MUST answer with an empty acknowledgement
  carrying the right SEQ and ACK numbers while staying in LAST-ACK (RFC 793 §3.4 p37).

  The iteration is a case of its own: the TC8 case is the ordered set of its iterations
  and its verdict their conjunction (case_iteration.h). The second iteration, an
  unacceptable ACK number, is tcp_unacceptable_12_it2; they share one stimulus body and
  differ only in the segment sent.

  Prelude (the tester suppresses its pure ACKs for the whole iteration, so the DUT stays in
  LAST-ACK long enough for the probe to draw its answer):
    1. Active-OPEN handshake to ESTABLISHED (the DUT's third-leg ACK).
    2. The tester half-closes its write side: its FIN+ACK is auto-ACKed by the DUT, which
       is now in CLOSE-WAIT.
    3. The DUT CLOSEs: its FIN+ACK is observed, the tester's pure ACK to it is suppressed,
       and the DUT sits in LAST-ACK.
    4. The tester snapshots its SEQ/ACK and injects the corrupt segment.
    5. The tester drops its socket without emitting a FIN.

  Four DUT-origin observations reach the machine on tcp_observed, in order:
    1. the handshake's third-leg ACK (pure ACK);
    2. the DUT's auto-ACK of the tester's FIN (pure ACK; CLOSE-WAIT);
    3. the DUT's FIN+ACK (the CLOSE that put it in LAST-ACK);
    4. the empty ACK answering the corrupt segment, with ack_num == expected_ack_num.

  This iteration's segment: SEQ = snd_nxt + kOutOfWindowSeqOffset, ACK = rcv_nxt - 1. That
  ACK is acceptable but does not acknowledge the DUT's FIN, so the DUT stays in LAST-ACK;
  the Linux receive path rejects the out-of-window SEQ before it weighs the ACK and sends
  the answer.

  The procedure states no listen time, so the general input parameter ParamListenTime
  bounds the wait for the answer in (4). A window that elapses without it is the DUT's
  silence where it must answer: observed_quiescence, judged against that bound (H3), over
  ParamListenTime plus ParamToleranceTime (10 s + 1 s at the defaults). Observations 1-3
  bring the DUT to LAST-ACK and stay inconclusive: they set up the state the segment tests.
  Whether a silence stands as a fail is the CLI's call on the run's hypotheses.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_unacceptable_12_it1"
       sce:transition-table="emit"
       datamodel="null"
       initial="listening_handshake_ack">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="listening_handshake_ack">
    <onentry><send event="deadline_handshake_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset)"
                target="listening_close_wait_ack"/>
    <transition event="deadline_handshake_ack" target="inconclusive_no_handshake_ack"/>
  </state>
  <state id="listening_close_wait_ack">
    <onentry><send event="deadline_close_wait_ack" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset)"
                target="listening_dut_fin"/>
    <transition event="deadline_close_wait_ack" target="inconclusive_no_close_wait_ack"/>
  </state>
  <state id="listening_dut_fin">
    <onentry><send event="deadline_dut_fin" delay="5s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_dut_fin_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset)"
                target="listening_probe_ack"/>
    <transition event="deadline_dut_fin" target="inconclusive_no_dut_fin"/>
  </state>
  <state id="listening_probe_ack">
    <onentry><send event="deadline_probe_ack" delay="11s"/></onentry>
    <transition event="tcp_observed"
                cond="cpp:captured.is_pure_dut_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kBasicsActiveLocalPort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset, ::tc8::sce::tcp::kBasicsActiveRemotePort + ::tc8::sce::tcp::kTcpUnacceptable12Phase1LocalOffset) and captured.ack_num == captured.expected_ack_num"
                target="pass"/>
    <transition event="deadline_probe_ack" target="fail_no_probe_ack"/>
  </state>

  <final id="pass"><donedata><content>{"verdict":"pass"}</content></donedata></final>

  <final id="inconclusive_no_handshake_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_handshake_ack","role":"precondition_unmet"}</content></donedata></final>
  <final id="inconclusive_no_close_wait_ack"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_close_wait_ack","role":"property_unobserved"}</content></donedata></final>
  <final id="inconclusive_no_dut_fin"><donedata><content>{"verdict":"inconclusive","reason":"no_dut_fin","role":"property_unobserved"}</content></donedata></final>
  <final id="fail_no_probe_ack"><donedata><content>{"verdict":"fail","reason":"no_dut_ack_to_otw_seq_in_last_ack","role":"observed_quiescence","bound":"ParamListenTime"}</content></donedata></final>
</scxml>
