<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.5 IPv4_ADDRESSING_03 negative — lwIP ingress-fault self-validation of the
  positive _03 reply-absence guard. The positive injects an ICMP Echo Request whose IPv4
  destination is a loopback address (127.0.0.0/8) on a non-loopback interface — a datagram the
  conformant DUT silently discards (RFC 1122 §3.2.1.3 martian filter), emitting no reply. This
  negative arms kIcmpFaultSynthEchoReply, so the lwIP netif INPUT hook synthesizes the prohibited
  Echo Reply (type 0) as that Echo Request arrives (the gate fires on any inbound IPv4 ICMP
  frame; the bad destination only governs whether lwIP itself replies, which it must not). Pass =
  that DUT-origin reply observed; fail_compliant = DUT stayed silent despite the flavor (fault
  inert). lwIP-only (capability-gated on kCapIngressFault). Envelope: icmpv4_synth_neg.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_addressing_03_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/icmpv4_synth_neg.sce-template.xml"/>
</scxml>
