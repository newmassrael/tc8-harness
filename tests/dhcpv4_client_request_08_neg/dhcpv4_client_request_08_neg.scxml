<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.8 DHCPv4_CLIENT_REQUEST_08 negative — RENEWING DHCPREQUEST
  'ciaddr' MUST equal the bound IP (RFC 2131 §4.4.5). The positive's
  ciaddr-mismatch branch is unreachable against a conformant tc8-dut.

  Fault injection is a real firmware mutant: the
  kDhcpFlavorReacqRequestCiaddrWrong flavor (gated to the reacquisition
  REQUEST) writes a wrong ciaddr in the RENEWING REQUEST. A conformant
  client (flavor None) sets ciaddr to the bound IP, so this negative's
  fail_compliant branch is the live conformant-DUT outcome.

  Reuses the dhcpv4_renewing_request_field template with pass_expr
  inverted (pass = ciaddr mismatch observed).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_request_08_neg"
       datamodel="null"
       initial="listening_for_discover">
  <sce:use template="../_templates/dhcpv4_renewing_request_field.sce-template.xml"
           pass_expr="!captured.ciaddr_equals(expected.offered_ip_be)"
           fail_state="fail_compliant"
           fail_reason="dut_renewing_request_ciaddr_correct_despite_ciaddr_wrong_flavor"/>
</scxml>
