<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.6.5.4 UDP_FIELDS_08: DUT discards a truncated UDP datagram
  whose total wire length is less than 8 bytes (RFC 768 'Fields' MUST).

  Stimulus: tester injects an IPv4 frame whose UDP region is exactly
  4 bytes (just the source port + dest port slots). Linux's UDP layer
  rejects on `frame_remaining < sizeof(udphdr)` before any per-port
  dispatch. UT GetReceivedUdp returns received=0.

  Reuses ipv4_udp_ut_presence with expected_received=0.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="udp_fields_08"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_udp_ut_presence.sce-template.xml"
           expected_received="0"
           fail_reason_wrong_receipt="dut_received_truncated_sub_8_byte_udp"
           fail_reason_timeout="no_ut_confirmation_for_truncated_udp_discard"/>
</scxml>
