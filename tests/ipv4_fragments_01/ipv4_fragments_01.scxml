<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.6 IPV4_FRAGMENTS_01: DUT reassembles a 2-fragment Echo
  Request and emits an Echo Reply whose Identifier, Sequence Number,
  and Data are those of the reassembled Echo Request.

  TESTER sends two IP fragments (MF=1/offset=0 with first 8 B and
  MF=0/offset=1 with last 8 B of a 16 B ICMP Echo Request body). A
  conformant DUT reassembles per RFC 791 §3.2, validates the ICMP
  checksum that was computed over the full 16 B body, and emits an
  Echo Reply mirroring id/seq/data.

  Pass criterion = type=0 Echo Reply with matching echo_id +
  echo_seq (CLI-injected as kIcmpEchoId / kIcmpEchoSeq) AND matching
  Data region (kFragmentsEchoPayload, 8 bytes). The three-fail-split
  mirrors TYPE_09 but adds the Data axis via echo_payload_equals —
  that member-function form is the SCE-compatible path (SCE rewrites
  `captured.method(...)` through the captured pointer, but not bare
  `captured` as a free argument). See reference_sce_captured_arg.md.

  Stimulus at the traits layer (ipv4_fragments_01.h) builds the
  16 B ICMP body ONCE via buildIcmpEchoRequestBody — a single
  checksum covers the reassembled region the DUT sees, so the
  DUT's kernel accepts the post-reassembly datagram.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_fragments_01"
       datamodel="null"
       initial="listening">

  <sce:context id="captured"
               cpp:type="tc8::Icmpv4Captured"
               cpp:include="sce_integration/icmpv4_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Icmpv4Expected"
               cpp:include="sce_integration/icmpv4_expected.h"/>

  <state id="listening">
    <onentry>
      <send event="deadline_exceeded" delay="5s"/>
    </onentry>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip and captured.echo_id == expected.echo_id and captured.echo_seq == expected.echo_seq and captured.echo_payload_equals(std::string_view(reinterpret_cast&lt;const char*&gt;(::tc8::sce::ipv4::fragments::kFragmentsEchoPayload.data()), ::tc8::sce::ipv4::fragments::kFragmentsEchoPayload.size()))"
                target="pass"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip and captured.echo_id != expected.echo_id"
                target="fail_echo_id"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip and captured.echo_seq != expected.echo_seq"
                target="fail_echo_seq"/>
    <transition event="icmp_observed"
                cond="cpp:captured.type == 0 and captured.src_ip == expected.dut_iface_ip"
                target="fail_data_mismatch"/>
    <transition event="deadline_exceeded" target="fail_timeout"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="fail_echo_id">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_id_mismatch"}</content>
    </donedata>
  </final>

  <final id="fail_echo_seq">
    <donedata>
      <content>{"verdict":"fail","reason":"echo_seq_mismatch"}</content>
    </donedata>
  </final>

  <final id="fail_data_mismatch">
    <donedata>
      <content>{"verdict":"fail","reason":"reassembled_echo_data_mismatch"}</content>
    </donedata>
  </final>

  <final id="fail_timeout">
    <donedata>
      <content>{"verdict":"fail","reason":"no_echo_reply_after_reassembly"}</content>
    </donedata>
  </final>
</scxml>
