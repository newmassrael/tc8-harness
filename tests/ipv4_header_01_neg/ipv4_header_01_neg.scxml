<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.4.4.1 IPv4_HEADER_01 negative — lwIP egress-fault self-validation of the
  positive's "total_length >= 20" guard (RFC 791 §3.1 minimum header). The trait arms
  kIpv4FaultTotalLenWrong, so the lwIP link-output hook writes a sub-20 total_length into
  the DUT's Echo Reply IPv4 header (gated on the Echo Reply). libtins validates only IHL
  on parse (not total_length — it underflow-clamps and dissects), so the guard reads the
  mutated field. Pass = total_length below the minimum observed (the violation the
  positive forbids); fail_compliant = the DUT emitted a valid total_length despite the
  flavor (fault inert). lwIP-only (capability-gated on kCapEgressFault).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="ipv4_header_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/ipv4_field_check.sce-template.xml"
           pass_expr="!(captured.total_length &gt;= 20)"
           fail_state="fail_compliant"
           fail_reason="dut_total_length_at_least_minimum_despite_flavor"
           fail_role="fault_injection_inert"/>
</scxml>
