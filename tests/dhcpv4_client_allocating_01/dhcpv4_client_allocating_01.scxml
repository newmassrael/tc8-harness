<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.7.6.3 DHCPv4_CLIENT_ALLOCATING_01: the client broadcasts a
  DHCPDISCOVER on its local physical subnet — the IPv4 destination MUST be
  the limited broadcast 255.255.255.255 (RFC 2131 §3.1). ALLOCATING_01_NEG
  drives the firmware mutant that unicasts it.

  Reuses the dhcpv4_discover_field template (shared with the _neg sibling).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="dhcpv4_client_allocating_01"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/dhcpv4_discover_field.sce-template.xml"
           pass_expr="captured.dst_ip_is_broadcast()"
           fail_state="fail_dst_ip_not_broadcast"
           fail_reason="dut_dhcp_discover_dst_ip_not_broadcast"/>
</scxml>
