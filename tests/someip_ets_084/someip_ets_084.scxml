<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §5.1.6 SOMEIP_ETS_084: ClientServiceDeactivate.

  After clientServiceActivate + clientServiceSubscribeEventgroup, the
  tester emits an OfferService for ets3 (SERVICE-ID 0xF4E9). vsomeip
  inside the DUT proxy reacts by emitting a SubscribeEventgroup
  (Type 0x06, ttl > 0) carrying the proxy-side endpoint option. The
  test then emits clientServiceDeactivate (Method 0x30) — the proxy's
  stop() unsubscribes, vsomeip emits a SubscribeEventgroup entry with
  ttl == 0 (StopSubscribeEventgroup per SD §4.2 / PRS_SOMEIPSD_00386).

  Stimulus chain (see src/sce_integration/cases/someip_ets_084.h):
    1. emitFindServiceBoot — SERVICE-ID-1 server warm-up.
    2. emitMethodRequestAfter(clientServiceActivate, 0x2F).
    3. Sleep 800 ms (proxy buildProxy() registration delay).
    4. emitMethodRequestAfter(clientServiceSubscribeEventgroup, 0x32) —
       proxy subscribe() queues internally; vsomeip emits SD Subscribe
       only after the OfferService arrives.
    5. emitOfferServiceMulticastWithEndpoint(ets3, TCP endpoint).
    6. State-entry observer on listening_phase3_stop_seen fires
       emitMethodRequestAfter(clientServiceDeactivate, 0x30) — DUT
       proxy stop() emits StopSubscribeEventgroup.

  Verdict (4-state):
    Phase 1 (listening_phase1, 6 s): observe OfferService for
            SERVICE-ID-1 (DUT's own service warm-up gate).
    Phase 2 (listening_phase2_subscribe_seen, 12 s): observe
            DUT-emitted SubscribeEventgroup (Type 0x06, SERVICE-ID
            0xF4E9 ets3, ttl > 0).
    Phase 3 (listening_phase3_stop_seen, 10 s): observe DUT-emitted
            StopSubscribeEventgroup (Type 0x06, SERVICE-ID 0xF4E9,
            ttl == 0). Phase 3 onentry triggers the trait-side
            scheduleAfterStateEntry callback that fires the
            clientServiceDeactivate Method Request.

  References: PRS_SOMEIPSD_00386, SD §4.2.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someip_ets_084"
       datamodel="null"
       initial="listening_phase1">

  <sce:context id="captured"
               cpp:type="tc8::SomeIpCaptured"
               cpp:include="sce_integration/someip_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::SomeIpExpected"
               cpp:include="sce_integration/someip_expected.h"/>

  <state id="listening_phase1">
    <onentry>
      <send event="phase1_deadline_exceeded" delay="6s"/>
    </onentry>
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x01 and captured.sd_entries[0].service_id == expected.service_id"
                target="listening_phase2_subscribe_seen"/>
    <transition event="phase1_deadline_exceeded" target="inconclusive_phase1_no_offer"/>
  </state>

  <state id="listening_phase2_subscribe_seen">
    <onentry>
      <send event="phase2_deadline_exceeded" delay="12s"/>
    </onentry>
    <!-- DUT-emitted SubscribeEventgroup for ets3 (SERVICE-ID 0xF4E9),
         Type 0x06, ttl > 0. -->
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x06 and captured.sd_entries[0].service_id == 0xF4E9 and captured.sd_entries[0].ttl &gt; 0"
                target="listening_phase3_stop_seen"/>
    <transition event="phase2_deadline_exceeded" target="inconclusive_phase2_no_subscribe"/>
  </state>

  <state id="listening_phase3_stop_seen">
    <onentry>
      <send event="phase3_deadline_exceeded" delay="10s"/>
    </onentry>
    <!-- StopSubscribeEventgroup is a SubscribeEventgroup entry (Type
         0x06) with ttl == 0 per SD §4.2. Trait-side
         scheduleAfterStateEntry fires the clientServiceDeactivate
         Method Request on this phase's entry. -->
    <transition event="someip_notification"
                cond="cpp:captured.service_id == 0xFFFF and captured.sd_entry_count >= 1 and captured.sd_entries[0].type == 0x06 and captured.sd_entries[0].service_id == 0xF4E9 and captured.sd_entries[0].ttl == 0"
                target="pass"/>
    <transition event="phase3_deadline_exceeded" target="inconclusive_phase3_no_stop_subscribe"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase1_no_offer">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_offer_service_within_listen_window","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase2_no_subscribe">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_subscribe_for_ets3_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_phase3_no_stop_subscribe">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"no_dut_stop_subscribe_for_ets3_within_listen_window","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
