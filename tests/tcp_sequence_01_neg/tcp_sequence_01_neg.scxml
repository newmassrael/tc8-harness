<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.8.6.17 TCP_SEQUENCE_01 negative — lwIP egress-fault self-validation of the
  positive _01 SYN,ACK ack_num guard. The trait arms kTcpFaultSynAckAckWrong, so the
  lwIP link-output hook flips the acknowledgment of the DUT's passive-open SYN,ACK
  (gated on the SYN,ACK segment; the flags stay SYN+ACK so the filter still selects it).
  The tester completes the handshake from the uncorrupted seq, so the SYN,ACK is
  captured. Pass = the corrupted ack observed (ack_num != tester ISN + 1);
  fail_compliant = the DUT acked correctly despite the flavor (fault inert). lwIP-only
  (capability-gated on kCapEgressFault). Envelope: tcp_egress_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_sequence_01_neg"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/tcp_egress_field_check.sce-template.xml"
           filter="captured.is_dut_syn_ack(expected.dut_iface_ip, expected.tester_ip, ::tc8::sce::tcp::kTcpSequence01ListenPort, ::tc8::sce::tcp::kTcpSequence01TesterSrcPort)"
           pass_expr="captured.ack_num != ::tc8::sce::tcp::kTesterInitialSeq + 1U"
           fail_state="fail_compliant"
           fail_reason="dut_synack_acked_tester_isn_despite_flavor"
           fail_role="fault_injection_inert"
           inconclusive_reason="no_dut_syn_ack_within_listen_window"/>
</scxml>
