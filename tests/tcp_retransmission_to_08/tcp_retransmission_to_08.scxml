<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 v3.0 §4.8.6.11 TCP_RETRANSMISSION_TO_08: TCP SHOULD use an
  upper bound of 2*MSL of RTO for data segments. Derived from
  RFC 1122 §4.2.3.1 p96 Retransmission Timeout Calculation (SHOULD).

  The stimulus watches the DUT socket's RTO with observeRtoCeiling
  (tcp_rto_ceiling.h), which ends at the first retransmission timeout
  whose new RTO is below twice the previous one. RFC 6298 §5.5 lets
  only the upper bound stop the doubling, so that timeout IS the
  ceiling, seen directly.

  Verdict ladder (evaluate-pattern over the observation):
    1. `not ut_handshake_completed`        → inconclusive_handshake_did_not_complete
    2. `not ut_tcpi_p1_valid`              → error_query_failed
    3. `ut_tcpi_p1_retransmits == 0`       → fail_no_retx
    4. `rto_us > kTwoMslRtoUpperUs`        → fail_rto_above_2msl_cap
    5. ceiling reached, `rto_us < kTwoMslRtoLowerUs`
                                           → fail_rto_ceiling_below_2msl
    6. ceiling reached                     → pass (60 s ± 5 %, the 2*MSL band)
    7. the DUT dropped the connection before a ceiling
                                           → inconclusive_connection_dropped
    8. otherwise (still doubling at the budget)
                                           → inconclusive_rto_below_2msl_cap

  Negative IP-flip: the active OPEN to ESTABLISHED fails when
  dut_iface_ip is mis-pointed; stimulus returns early without
  setting `ut_handshake_completed`, so the SCXML's first cond fires
  and verdicts as `inconclusive:dut_handshake_did_not_complete`.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="tcp_retransmission_to_08"
       datamodel="null"
       initial="evaluate_kernel_observations">

  <sce:context id="captured"
               cpp:type="tc8::TcpCaptured"
               cpp:include="sce_integration/tcp_captured.h"/>

  <sce:context id="expected"
               cpp:type="tc8::Ipv4Expected"
               cpp:include="sce_integration/ipv4_expected.h"/>

  <state id="evaluate_kernel_observations">
    <onentry>
      <send event="evaluate" delay="0ms"/>
    </onentry>
    <transition event="evaluate"
                cond="cpp:not captured.ut_handshake_completed"
                target="inconclusive_handshake_did_not_complete"/>
    <transition event="evaluate"
                cond="cpp:not captured.ut_tcpi_p1_valid"
                target="error_query_failed"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_retransmits == 0"
                target="fail_no_retx"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_tcpi_p1_rto_us &gt; ::tc8::sce::tcp::kTwoMslRtoUpperUs"
                target="fail_rto_above_2msl_cap"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_rto_ceiling == ::tc8::RtoCeilingOutcome::CeilingReached and captured.ut_tcpi_p1_rto_us &lt; ::tc8::sce::tcp::kTwoMslRtoLowerUs"
                target="fail_rto_ceiling_below_2msl"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_rto_ceiling == ::tc8::RtoCeilingOutcome::CeilingReached"
                target="pass"/>
    <transition event="evaluate"
                cond="cpp:captured.ut_rto_ceiling == ::tc8::RtoCeilingOutcome::SocketLost"
                target="inconclusive_connection_dropped"/>
    <transition event="evaluate" target="inconclusive_rto_below_2msl_cap"/>
  </state>

  <final id="pass">
    <donedata>
      <content>{"verdict":"pass"}</content>
    </donedata>
  </final>

  <final id="inconclusive_handshake_did_not_complete">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_handshake_did_not_complete","role":"precondition_unmet"}</content>
    </donedata>
  </final>

  <final id="error_query_failed">
    <donedata>
      <content>{"verdict":"error","reason":"tcp_info_query_failed","role":"test_system_fault"}</content>
    </donedata>
  </final>

  <final id="fail_no_retx">
    <donedata>
      <content>{"verdict":"fail","reason":"no_retransmits_observed_in_kernel","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_rto_above_2msl_cap">
    <donedata>
      <content>{"verdict":"fail","reason":"rto_exceeded_2_msl","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="fail_rto_ceiling_below_2msl">
    <donedata>
      <content>{"verdict":"fail","reason":"rto_ceiling_below_2_msl","role":"observed_violation"}</content>
    </donedata>
  </final>

  <final id="inconclusive_connection_dropped">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"dut_dropped_connection_before_rto_ceiling","role":"property_unobserved"}</content>
    </donedata>
  </final>

  <final id="inconclusive_rto_below_2msl_cap">
    <donedata>
      <content>{"verdict":"inconclusive","reason":"rto_below_2_msl_did_not_plateau_within_observation_budget","role":"property_unobserved"}</content>
    </donedata>
  </final>
</scxml>
