<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §5.1.5.2 SOMEIPSRV_OPTIONS_09: Type field [8 bits] of the IPv4
  Multicast Option shall be 0x14 (SWS_SD_00391). presence_gate filters
  to SubscribeAck frames with at least one option present; pass_expr
  verifies vsomeip emitted an IPv4 Multicast Option (sd_ipv4_multicast_
  count >= 1, populated by parseSdOptionsInto when an option's type
  byte equals 0x14). The check is non-circular relative to the gate:
  the gate admits any SubscribeAck with options, and pass_expr asserts
  one of those options is the multicast type.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="someipsrv_options_09"
       datamodel="null"
       initial="listening">

  <sce:use template="../_templates/someipsrv_sd_field_check.sce-template.xml"
           presence_gate="captured.sd_option_count &gt;= 1"
           entry_type="0x07"
           pass_expr="captured.sd_ipv4_multicast_count &gt;= 1"
           fail_state="fail_type"
           fail_reason="no_ipv4_multicast_option_with_type_0x14"/>
</scxml>
