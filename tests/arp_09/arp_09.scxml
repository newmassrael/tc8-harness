<?xml version="1.0" encoding="UTF-8"?>
<!--
  TC8 §4.2.4.1 ARP_09: ARP request Protocol Type field shall carry
  ARP_PROTOCOL_IP (0x0800) per RFC 826. UT 0x02 egress provocation forces
  the DUT Request — see arp_07.scxml. Envelope: arp_field_check.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       xmlns:cpp="urn:sce:cpp"
       version="1.0"
       name="arp_09"
       datamodel="null"
       initial="listening">
  <sce:use template="../_templates/arp_field_check.sce-template.xml"
           filter="captured.opcode == 1 and captured.sender_hw == expected.dut_iface_mac"
           pass_expr="captured.proto_type == 0x0800"
           fail_state="fail_proto_type"
           fail_reason="proto_type_not_ipv4"
           fail_role="observed_violation"
           inconclusive_reason="no_arp_request_within_listen_window"/>
</scxml>
