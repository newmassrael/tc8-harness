---
import { t } from '~/lib/i18n';
import { displayStatus } from '~/lib/cases';
import { localizedDescription } from '~/lib/overrides';
import type { CaseRecord, Locale } from '~/lib/types';

interface Props {
  case: CaseRecord;
  locale: Locale;
}

const { case: c, locale } = Astro.props;
const isDeprecated = c.status === 'deprecated';
const status = displayStatus(c);
const statusKey = `case.status.${status}` as const;
const desc = localizedDescription(c, locale);
---

<section class="section" id="header">
  <div class="case-title">
    <h1>{c.case_id}</h1>
    <span class={`badge ${status}`}>{t(locale, statusKey as any)}</span>
    <span class="badge protocol">{c.protocol}</span>
  </div>
  {isDeprecated && (
    <div class="deprecated-notice" role="note">
      <strong>{t(locale, 'case.deprecated.title')}</strong>
      <p>{t(locale, 'case.deprecated.notice')}</p>
    </div>
  )}
  {desc.text && (
    <p class="desc">
      {desc.text}
      {desc.isFallback && <span class="fallback-marker">({t(locale, 'case.fallback')})</span>}
    </p>
  )}
  <dl class="kv" style="margin-top:14px">
    <dt>{t(locale, 'case.section')}</dt>
    <dd class="mono">§{c.section}</dd>
    <dt>{t(locale, 'case.protocol')}</dt>
    <dd>{c.protocol}</dd>
    {c.trait?.bpf_group && (
      <>
        <dt>{t(locale, 'case.bpf_group')}</dt>
        <dd class="mono">{c.trait.bpf_group}</dd>
      </>
    )}
    {!c.expected && c.defer_reason && c.status !== 'deprecated' && (
      <>
        <dt>{t(locale, 'case.deferReason')}</dt>
        <dd class="muted">{c.defer_reason}</dd>
      </>
    )}
  </dl>
</section>
