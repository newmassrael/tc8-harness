---
import { t } from '~/lib/i18n';
import { localizedMessages } from '~/lib/overrides';
import { captureHref, expandOpenUri } from '~/lib/pcap';
import type { CaseRecord, Locale, MessageHighlight, PacketRecord } from '~/lib/types';

interface Props {
  case: CaseRecord;
  locale: Locale;
}

const { case: c, locale } = Astro.props;
const cap = c.pcap!;
const msgs = localizedMessages(c, locale);
const msgByIdx = new Map<number, MessageHighlight>();
const caseNotes: MessageHighlight[] = [];
for (const m of msgs) {
  if (m.role === 'case-note' || m.idx < 0) caseNotes.push(m);
  else msgByIdx.set(m.idx, m);
}

function fmtMs(us: number): string {
  if (us < 1000) return `+${us} µs`;
  if (us < 1_000_000) return `+${(us / 1000).toFixed(2)} ms`;
  return `+${(us / 1_000_000).toFixed(3)} s`;
}

function dirLabel(d: PacketRecord['direction'], lo: Locale): string {
  const T = t(lo, 'pcap.tester' as any);
  const D = t(lo, 'pcap.dut' as any);
  if (d === 'tester_to_dut') return `${T} → ${D}`;
  if (d === 'dut_to_tester') return `${D} → ${T}`;
  return '—';
}

function dirClass(d: PacketRecord['direction']): string {
  if (d === 'tester_to_dut') return 'dir-t2d';
  if (d === 'dut_to_tester') return 'dir-d2t';
  return 'dir-other';
}

const outcomeKey = cap.outcome === 'pass' ? 'pcap.outcome.pass' : 'pcap.outcome.fail';

// Both null unless the capture JSON opts in (see lib/pcap.ts for the policy).
// The template is filtered once here, not per row: its placeholders expand to
// integers, so no row can widen what the check accepted.
const pcapUrl = captureHref(cap.pcap_url);
const openTemplate = captureHref(cap.open_uri_template);
---

<section class="section" id="pcap">
  <h2>
    {t(locale, 'pcap.heading')}
    <span class={`badge outcome-badge ${cap.outcome === 'pass' ? 'pass' : 'fail'}`} style="margin-left:8px;font-size:11px">
      {t(locale, outcomeKey as any)}
    </span>
    {cap.captured_at && <span class="muted" style="font-size:12px;margin-left:10px">{cap.captured_at}</span>}{pcapUrl && <a class="pcap-dl" href={pcapUrl}>{t(locale, 'pcap.download')}</a>}
  </h2>

  <div class="pcap-meta muted" style="margin-bottom:10px;font-size:12px">
    {cap.tester_ip && <span>Tester: <code>{cap.tester_ip}</code> ({cap.tester_mac})</span>}
    {cap.dut_ip && <span style="margin-left:14px">DUT: <code>{cap.dut_ip}</code> ({cap.dut_mac})</span>}
  </div>

  {caseNotes.length > 0 && (
    <div class="pcap-case-notes">
      {caseNotes.map((m) => (
        <div class={`case-note role-${m.role}`}>
          <span class={`role-badge role-${m.role}`}>{t(locale, `pcap.role.${m.role}` as any)}</span>
          <span class="msg-label">{m.label}</span>
        </div>
      ))}
    </div>
  )}

  <table class="pcap-table">
    <thead>
      <tr>
        <th>#</th>
        <th>{t(locale, 'pcap.time')}</th>
        <th>{t(locale, 'pcap.direction')}</th>
        <th>{t(locale, 'pcap.protocol')}</th>
        <th style="width:55%">{t(locale, 'pcap.summary')}</th>
        <th>{t(locale, 'pcap.note')}</th>
      </tr>
    </thead>
    <tbody>
      {cap.packets.map((p) => {
        const m = msgByIdx.get(p.idx);
        const roleClass = m ? `role-${m.role}` : '';
        return (
          <tr id={`pkt-${p.idx}`} class={`${roleClass} ${m ? 'highlighted' : ''}`}>
            <td class="mono muted">{openTemplate ? <a href={expandOpenUri(openTemplate, p.idx)} title={t(locale, 'pcap.open')}>{p.idx}</a> : p.idx}</td>
            <td class="mono">{fmtMs(p.ts_delta_us)}</td>
            <td><span class={`dir-pill ${dirClass(p.direction)}`}>{dirLabel(p.direction, locale)}</span></td>
            <td><span class="proto-pill">{p.protocol}</span></td>
            <td>{p.summary}</td>
            <td>
              {m && (
                <>
                  <span class={`role-badge role-${m.role}`}>{t(locale, `pcap.role.${m.role}` as any)}</span>
                  <span class="msg-label">{m.label}</span>
                </>
              )}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</section>
