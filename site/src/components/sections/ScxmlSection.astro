---
import { Code } from 'astro:components';
import { t } from '~/lib/i18n';
import type { CaseRecord, Locale } from '~/lib/types';

interface Props {
  case: CaseRecord;
  locale: Locale;
}

const { case: c, locale } = Astro.props;
const content = c.scxml!.content;
const lineCount = content.split('\n').length;
---

<section class="section">
  <h2>
    {t(locale, 'case.scxml.heading')}
    <span class="muted" style="font-size:11px;font-weight:400;margin-left:8px">{lineCount} {t(locale, 'case.scxml.lines')}</span>
  </h2>
  <details class="scxml-details" open={lineCount <= 80}>
    <summary>{t(locale, 'case.scxml.toggle')}</summary>
    <div class="scxml-code">
      <Code code={content} lang="xml" theme="github-dark" />
    </div>
  </details>
</section>
