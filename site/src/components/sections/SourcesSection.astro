---
import { t } from '~/lib/i18n';
import { repoBlob } from '~/lib/links';
import type { CaseRecord, Locale } from '~/lib/types';

interface Props {
  case: CaseRecord;
  locale: Locale;
}

const { case: c, locale } = Astro.props;
const sources = c.sources!;
const rows: Array<[string, string | null]> = [
  [t(locale, 'case.sources.trait'), sources.trait_h],
  [t(locale, 'case.sources.scxml'), sources.scxml],
  [t(locale, 'case.sources.test_dir'), sources.test_dir],
];
---

<section class="section" id="sources">
  <h2>{t(locale, 'case.sources.heading')}</h2>
  <dl class="kv">
    {rows.map(([label, path]) => (
      <>
        <dt>{label}</dt>
        <dd>
          {path
            ? <a href={repoBlob(path)} class="mono" target="_blank" rel="noopener">{path}</a>
            : <span class="muted">{t(locale, 'case.notAvailable')}</span>}
        </dd>
      </>
    ))}
  </dl>
</section>
