---
import { t } from '~/lib/i18n';
import { localizedApproach } from '~/lib/overrides';
import type { CaseRecord, Locale } from '~/lib/types';

interface Props {
  case: CaseRecord;
  locale: Locale;
}

const { case: c, locale } = Astro.props;
const approach = localizedApproach(c, locale);
const isDeprecatedFallback = c.status === 'deprecated' && !c.trait?.approach;
const reason = (c.defer_reason || '').trim();
---

<section class="section" id="approach">
  <h2>
    {t(locale, 'case.approach.heading')}
    {!isDeprecatedFallback && approach.isFallback && (
      <span class="fallback-marker">({t(locale, 'case.fallback')})</span>
    )}
  </h2>
  {isDeprecatedFallback ? (
    <div class="prose deprecated-approach">
      <p>{t(locale, 'case.deprecated.approachIntro')}</p>
      <p class="reason-label muted">{t(locale, 'case.deprecated.reasonHeading')}</p>
      <p class="reason-body">{reason || t(locale, 'case.deprecated.reasonUnknown')}</p>
    </div>
  ) : (
    <pre class="prose">{approach.text}</pre>
  )}
</section>
