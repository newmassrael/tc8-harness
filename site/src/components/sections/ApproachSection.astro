---
import { t } from '~/lib/i18n';
import { localizedApproach } from '~/lib/overrides';
import type { CaseRecord, Locale } from '~/lib/types';

interface Props {
  case: CaseRecord;
  locale: Locale;
}

const { case: c, locale } = Astro.props;
const approach = localizedApproach(c, locale);
---

<section class="section">
  <h2>
    {t(locale, 'case.approach.heading')}
    {approach.isFallback && (
      <span class="fallback-marker">({t(locale, 'case.fallback')})</span>
    )}
  </h2>
  <pre class="prose">{approach.text}</pre>
</section>
