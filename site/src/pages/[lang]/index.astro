---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { allCases, displayStatus } from '~/lib/cases';
import { t, locales } from '~/lib/i18n';
import { casePath } from '~/lib/links';
import { translationCoverage, hasOverride } from '~/lib/overrides';
import type { Locale } from '~/lib/types';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const protocols = Array.from(new Set(allCases.map((c) => c.protocol)));
const cov = translationCoverage(allCases.length);

interface ProtocolStat {
  protocol: string;
  total: number;
  active: number;
  pass: number;
  fail: number;
  untested: number;
  deprecated: number;
}

const protocolStats: ProtocolStat[] = protocols.map((p) => {
  const cases = allCases.filter((c) => c.protocol === p);
  const stat: ProtocolStat = {
    protocol: p,
    total: cases.length,
    active: 0,
    pass: 0,
    fail: 0,
    untested: 0,
    deprecated: 0,
  };
  for (const c of cases) {
    const s = displayStatus(c);
    stat[s] += 1;
    if (c.status === 'active') stat.active += 1;
  }
  return stat;
});
---

<BaseLayout locale={lang} title={t(lang, 'index.heading')}>
  <h2 style="margin-top:0">
    {t(lang, 'index.heading')}
    <span class="muted" style="font-size:14px">({allCases.length} {t(lang, 'index.count')})</span>
    <span class="muted" style="font-size:12px;margin-left:14px;font-weight:400">
      EN {cov.en}/{cov.total} · KO {cov.ko}/{cov.total}
    </span>
  </h2>

  <div class="protocol-dashboard">
    {protocolStats.map((s) => {
      const tested = s.pass + s.fail;
      const passPct = s.active > 0 ? (s.pass / s.active) * 100 : 0;
      const failPct = s.active > 0 ? (s.fail / s.active) * 100 : 0;
      return (
        <button class="protocol-card" type="button" data-protocol-target={s.protocol} aria-label={`Filter ${s.protocol}`}>
          <div class="proto-row">
            <span class="proto-name">{s.protocol}</span>
            <span class="proto-total muted">{s.active}<span class="muted">/{s.total}</span></span>
          </div>
          <div class="proto-bar" aria-hidden="true">
            <span class="proto-bar-pass" style={`width:${passPct}%`}></span>
            <span class="proto-bar-fail" style={`width:${failPct}%`}></span>
          </div>
          <div class="proto-stats">
            {s.pass > 0 && <span class="stat pass">{s.pass} {t(lang, 'case.status.pass')}</span>}
            {s.fail > 0 && <span class="stat fail">{s.fail} {t(lang, 'case.status.fail')}</span>}
            {s.active > tested && <span class="stat untested">{s.active - tested} {t(lang, 'case.status.untested')}</span>}
            {s.deprecated > 0 && <span class="stat deprecated">{s.deprecated} {t(lang, 'case.status.deprecated')}</span>}
          </div>
        </button>
      );
    })}
  </div>

  <div class="toolbar">
    <input id="q" type="search" placeholder={t(lang, 'index.search')} />
    <select id="protocol-filter" aria-label={t(lang, 'index.filter.protocol')}>
      <option value="">{t(lang, 'index.filter.protocol')}: {t(lang, 'index.filter.all')}</option>
      {protocols.map((p) => <option value={p}>{p}</option>)}
    </select>
    <label class="checkbox">
      <input id="hide-deprecated" type="checkbox" checked />
      {t(lang, 'index.filter.hideDeprecated')}
    </label>
    <span class="match-count muted" id="match-count"></span>
  </div>

  <table class="case-table" id="case-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>{t(lang, 'case.protocol')}</th>
        <th>§</th>
        <th style="width:60%">{t(lang, 'case.approach.heading')}</th>
        <th>{t(lang, 'case.status')}</th>
      </tr>
    </thead>
    <tbody>
      {allCases.map((c) => {
        const translated = hasOverride(c.case_id, lang);
        const traitDesc = c.trait?.description ?? '';
        const desc = traitDesc || (c.status === 'deprecated' ? c.defer_reason : '');
        const status = displayStatus(c);
        return (
          <tr data-protocol={c.protocol} data-id={c.case_id} data-desc={desc.toLowerCase()} data-section={c.section} data-translated={String(translated)} data-status={c.status}>
            <td class="id"><a href={casePath(lang, c.case_id)}>{c.case_id}</a></td>
            <td>{c.protocol}</td>
            <td class="mono muted">{c.section}</td>
            <td>
              {desc}
              {traitDesc && !translated && lang !== 'en' && <span class="fallback-marker" style="margin-left:6px">{t(lang, 'case.fallback')}</span>}
            </td>
            <td><span class={`badge ${status}`}>{t(lang, `case.status.${status}` as any)}</span></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</BaseLayout>

<script is:inline>
  const q = document.getElementById('q');
  const sel = document.getElementById('protocol-filter');
  const hideDep = document.getElementById('hide-deprecated');
  const matchCount = document.getElementById('match-count');
  const rows = Array.from(document.querySelectorAll('#case-table tbody tr'));
  const cards = Array.from(document.querySelectorAll('.protocol-card'));
  function apply() {
    const term = (q.value || '').toLowerCase();
    const proto = sel.value;
    const hide = hideDep.checked;
    let visible = 0;
    for (const row of rows) {
      const id = row.dataset.id.toLowerCase();
      const desc = row.dataset.desc;
      const section = row.dataset.section;
      const matchesText = !term || id.includes(term) || desc.includes(term) || section.includes(term);
      const matchesProto = !proto || row.dataset.protocol === proto;
      const matchesStatus = !hide || row.dataset.status !== 'deprecated';
      const show = matchesText && matchesProto && matchesStatus;
      row.style.display = show ? '' : 'none';
      if (show) visible += 1;
    }
    if (matchCount) matchCount.textContent = `${visible} / ${rows.length}`;
    for (const card of cards) {
      card.classList.toggle('active', card.dataset.protocolTarget === proto);
    }
  }
  q?.addEventListener('input', apply);
  sel?.addEventListener('change', apply);
  hideDep?.addEventListener('change', apply);
  for (const card of cards) {
    card.addEventListener('click', () => {
      const target = card.dataset.protocolTarget;
      sel.value = sel.value === target ? '' : target;
      apply();
    });
  }
  apply();
</script>
