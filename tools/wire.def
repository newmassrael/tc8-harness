# Single source of truth for the cross-language wire/fixture constants that must
# agree across the C++ stimulus builders, the Rust orchestrator, and the bash
# netns / testability scaffold. A drift between any two silently turns a positive
# test into a false pass, so these are generated from this one file rather than
# hand-mirrored.
#
# Generated consumers (regenerate: python3 tools/gen_wire_manifest.py):
#   dut/env/orchestrator/src/wire.gen.rs   include!-d as the `wire` module
#   dut/env/wire.gen.sh                     sourced by dut/env/setup-netns.sh and
#                                           lib-sp-check.sh; scripts read
#                                           $TC8_WIRE_<NAME>
# CI / pre-commit keep them fresh via `tools/gen_wire_manifest.py --check`, the
# same freshness gate `verdict_taxonomy.def` rides. Unlike verdict_taxonomy.def
# (which lives in src/ because verdict.h #includes it), this file is a pure
# codegen input — read only by gen_wire_manifest.py, never #included — so it
# lives beside its generator in tools/, outside the spec-citation scan roots.
#
# The C++ headers remain the hand-authored home of the values they own (each is
# single-homed there with its own doc + namespace), but they store them in a
# divergent representation — IPs as network-byte-order uint32, MACs as
# std::array<uint8_t,6>, echo identifiers as hex uint16. The `cpp=<header>:<sym>`
# annotation drives the `--check` cross-verifier: it parses the named C++ symbol,
# decodes it to canonical form, and asserts it equals the value below. So a C++
# retune that forgets this file is DETECTED, not silently mirrored.
#
# Entry syntax (one regex parses all):
#   /// doc lines (emitted verbatim onto the generated Rust const)
#   TC8_WIRE_<KIND>(NAME, "value"[, cpp=<relpath>:<symbol>])
# KIND ∈ { IPV4, MAC, U16, STR, INT }. KIND drives the Rust type (INT → u32,
# else &str) and the cross-check decoder; bash always gets a quoted string.

# --- Tester-injected ARP MACs — src/stimulus/arp_builder.h ------------------
/// `kTesterInjectedMac` — the sender MAC the harness injects in ARP stimulus, and
/// the lladdr the DHCPv4 CM_05/_06 synthetic-gateway pin binds to. Locally-
/// administered (`02:` prefix) so it cannot collide with a real OUI.
TC8_WIRE_MAC(ARP_TESTER_MAC, "02:00:00:00:00:A1", cpp=src/stimulus/arp_builder.h:kTesterInjectedMac)
/// `kTesterInjectedMac2` — Group C cache-merge cases (ARP_32..35).
TC8_WIRE_MAC(ARP_TESTER_MAC2, "02:00:00:00:00:A2", cpp=src/stimulus/arp_builder.h:kTesterInjectedMac2)
/// `kTesterInjectedMac3` — Group D Response-learning case ARP_40.
TC8_WIRE_MAC(ARP_TESTER_MAC3, "02:00:00:00:00:A3", cpp=src/stimulus/arp_builder.h:kTesterInjectedMac3)

# --- ICMP echo identity — src/stimulus/icmpv4_builder.h ---------------------
/// `kIcmpEchoId`.
TC8_WIRE_U16(ICMP_ECHO_ID, "0x1234", cpp=src/stimulus/icmpv4_builder.h:kIcmpEchoId)
/// `kIcmpEchoSeq`.
TC8_WIRE_U16(ICMP_ECHO_SEQ, "0x5678", cpp=src/stimulus/icmpv4_builder.h:kIcmpEchoSeq)

# --- UDP UI_07/_08 alias + FIELDS_04/_05 host-2 IPs — udp_pilot_common.h ----
# Bare addresses (the value SCXML asserts). `netns` derives the `/24` CIDR it
# configures from these, the same way bring-up derives the primary CIDRs.
/// `kDutAliasIp4Be` — DUT-side source-IP alias (UDP_USER_INTERFACE_07).
TC8_WIRE_IPV4(DUT_ALIAS_IP, "172.16.0.5", cpp=src/sce_integration/udp_pilot_common.h:kDutAliasIp4Be)
/// `kTesterAliasIp4Be` — tester-side destination-IP alias (UDP_USER_INTERFACE_08).
TC8_WIRE_IPV4(TESTER_ALIAS_IP, "172.16.0.4", cpp=src/sce_integration/udp_pilot_common.h:kTesterAliasIp4Be)
/// `kUdpHost2IpBe` — the UDP_FIELDS_04/_05 "second host on the link" address.
/// single-pc bring-up pins `<HOST2_IP, tester_mac>` NUD_PERMANENT on the DUT side
/// so the DUT's egress ARP for it resolves without a real third node; the lwIP tap
/// fixture answers ARP for it from the tap (/32). One value, two consumers.
TC8_WIRE_IPV4(HOST2_IP, "172.16.0.3", cpp=src/sce_integration/udp_pilot_common.h:kUdpHost2IpBe)

# --- DHCPv4 synthetic server/gateway — dhcpv4_default_endpoints.h -----------
/// `kDefaultServerIdBe` — the Option-3 router the DHCPv4 CM_05/_06 conditioning pins.
TC8_WIRE_IPV4(DHCPV4_SERVER1_IP4, "172.16.0.10", cpp=src/sce_integration/dhcpv4_default_endpoints.h:kDefaultServerIdBe)

# --- SOME/IP-SD version + default subscribe target --------------------------
# SSOT for the major/minor is `dut/ets/ets.fidl` (`version { major 1 minor 0 }`);
# there is no divergent C++ representation to cross-check, so these carry no cpp=
# pointer — the ets.fidl agreement stays a documented invariant.
/// SD major version — SSOT: `dut/ets/ets.fidl`.
TC8_WIRE_STR(SD_MAJOR_VERSION, "1")
/// SD minor version — same SSOT.
TC8_WIRE_STR(SD_MINOR_VERSION, "0")
/// The UNCONFIGURED subscribe target (NOT a deployed eventgroup) several
/// SOMEIPSRV/ETS cases Nack-echo. Do NOT "correct" to a deployed eventgroup —
/// that breaks the Nack-echo baseline.
TC8_WIRE_STR(SD_DEFAULT_EVENTGROUP, "0x0001")
/// SOME/IP-SD port — SSOT `tc8::dut::kSdPort` (include/tc8/dut_config.h). The
/// registered SD port both the DUT and the tester stimulus bind to. Topology
/// overlays read $TC8_WIRE_SD_PORT for the SD destination port instead of
/// re-hardcoding 30490. Emitted decimal so bash/profiles use it as a port.
TC8_WIRE_U16(SD_PORT, "30490", cpp=include/tc8/dut_config.h:kSdPort)

# --- Primary netns / tap wire identity (bash + Rust; no C++ stimulus peer) --
/// Tester-side primary IP (single-pc tester veth + lwIP tap host side).
TC8_WIRE_IPV4(TESTER_IP, "172.16.0.1")
/// DUT-side primary IP (single-pc DUT veth + lwIP DUT netif). The local DUT's
/// vsomeip.json `unicast` MUST equal this — vsomeip binds/advertises that
/// address, so a drift makes the DUT serve on an IP its netns does not own. The
/// json= glob pins this home across the base config AND every variant
/// (vsomeip-multi-*.json), which all share the netns IP (the netns IP is authority).
TC8_WIRE_IPV4(DUT_IP, "172.16.0.2", json=dut/dut_service/vsomeip*.json:unicast)
/// DUT-side /24 netmask (lwIP netif; single-pc derives it from the CIDR). The
/// local DUT's vsomeip.json `netmask` mirrors it across base + variants; pinned here.
TC8_WIRE_STR(DUT_MASK, "255.255.255.0", json=dut/dut_service/vsomeip*.json:netmask)
/// Topology-2 second veth pair (TIface-1) tester IP — the second broadcast
/// domain (172.17.0.0/24) for the dual-interface DHCP client usage case.
/// Consumed by setup-netns.sh (SECOND_VETH) and the Rust orchestrator's single-pc
/// topology (secondary veth for USAGE_01, dut/env/orchestrator/src/topology/single_pc.rs).
TC8_WIRE_IPV4(TESTER_IP_2, "172.17.0.1")
/// Topology-2 second veth pair (DIface-1) DUT IP.
TC8_WIRE_IPV4(DUT_IP_2, "172.17.0.2")

# --- lwIP tap fixture host-global names — fixtures/lwip_tap.rs + lwip-tap.conf
/// Host tap device the lwIP DUT attaches to.
TC8_WIRE_STR(TAP, "tc8lwip0")
/// Per-run scratch dir (DUT log + working files); host-global, flock-guarded.
TC8_WIRE_STR(FIX_DIR, "/tmp/tc8-lwipfix")
/// Where the last run's DUT log is preserved on teardown for postmortems.
TC8_WIRE_STR(LAST_DUT_LOG, "/tmp/tc8-lwipfix-last-dut.log")
/// flock file enforcing single-instance use of the host-global tap/scratch.
TC8_WIRE_STR(LOCK_FILE, "/var/lock/tc8-lwip-fixture.lock")
/// UT 0x17 ARP-cache conditioning window (virtual seconds). MUST track the lwIP
/// compile-time `ARP_MAXAGE` (default 300; dut/lwip_dut/lwipopts.h leaves it at
/// the default): the ARP_48/49 trait stimulus ages the table by exactly this to
/// cross the stack's `age >= ARP_MAXAGE` free condition.
TC8_WIRE_STR(ARP_CACHE_TIMEOUT_S, "300")

# --- Harness watchdog ------------------------------------------------------
/// Harness watchdog backstop (seconds). The per-case SoT is the SCXML deadline +
/// stimulus budget; this is the global last-resort kill so a hung case cannot
/// stall the suite. Bash `HARNESS_BACKSTOP_SEC`, Rust `Config::backstop_sec`.
TC8_WIRE_INT(BACKSTOP_SEC, "240")
