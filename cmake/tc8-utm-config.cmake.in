@PACKAGE_INIT@

# tc8-utm — the vendor-neutral AUTOSAR Testability UTM core (ProtocolServer +
# the MiddlewareModule extension seam + the POSIX SocketBackend). A separate,
# private OEM repository find_package()es this, links tc8::tc8_testability_server,
# and attaches its own MiddlewareModule groups. Public-standard surface only.

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/tc8-utm-targets.cmake")

check_required_components(tc8-utm)
