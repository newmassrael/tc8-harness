// Single source of truth for the TC8 active-OPEN port-quad offsets.
//
// X-macro form (see verdict_taxonomy.def for the same idiom):
//   TC8_TCP_OFFSET(name, value)        — one active-OPEN offset constant
//   TC8_TCP_OFFSET_SPAN5(name, base)   — a 5-wide span base+0..base+4 for the
//                                        5-iteration FLAGS_INVALID_08..13 loops
//
// Consumed twice by tcp_pilot_common.h, zero-cost, no parsing:
//   1. to DECLARE the named `inline constexpr std::uint16_t` constants, and
//   2. to build kActiveOpenOffsetRegistry[] for offsetRegistryUnique().
// Because both derive from THIS list, "declare an offset" and "it enters the
// uniqueness static_assert" are the SAME act — the registry cannot drift out of
// sync with the declared set (the defect this file's predecessor hand-array had).
//
// Each case that performs an active OPEN binds at (kBasicsActiveLocalPort +
// offset, kBasicsActiveRemotePort + offset). The offsets are globally unique so
// the static_assert catches same-value aliasing between two DIFFERENT cases at
// COMPILE time (e.g. the FLAGS_PROCESSING_02-positive-vs-_NEG-at-60 collision
// this registry retired). The per-case fresh-DUT smoke model already precludes a
// runtime TIME-WAIT/EADDRNOTAVAIL residue collision between cases; the invariant
// is the cheap compile-time guarantee that the values never alias regardless.
//
// A positive and its mirror `_NEG` deliberately SHARE one constant (identical
// 4-tuple; the _NEG only arms a fault flavor) — that aliasing is one entry here,
// referenced by both. Passive-listener absolute ports (kTcp*ListenPort /
// *TesterSrcPort) are a different axis and live in tcp_pilot_common.h, NOT here.

// ── HEADER_01 / MSS_OPTIONS_11/12 (active-OPEN) ──
TC8_TCP_OFFSET(kTcpHeader01LocalOffset, 30)
TC8_TCP_OFFSET(kTcpMssOptions11LocalOffset, 40)
TC8_TCP_OFFSET(kTcpMssOptions12LocalOffset, 41)

// ── MSS_OPTIONS_05/09 two-iteration active-OPEN phases ──
TC8_TCP_OFFSET(kTcpMssOptions05Phase1LocalOffset, 100)
TC8_TCP_OFFSET(kTcpMssOptions05Phase2LocalOffset, 101)
TC8_TCP_OFFSET(kTcpMssOptions09Phase1LocalOffset, 110)
TC8_TCP_OFFSET(kTcpMssOptions09Phase2LocalOffset, 111)

// ── BASICS_17 simultaneous-OPEN ──
TC8_TCP_OFFSET(kTcpBasics17LocalOffset, 120)

// ── ACK_02/04 + NAGLE_02/03 active-OPEN block ──
TC8_TCP_OFFSET(kTcpAck02LocalOffset, 130)
TC8_TCP_OFFSET(kTcpAck04LocalOffset, 131)
TC8_TCP_OFFSET(kTcpNagle02LocalOffset, 132)
TC8_TCP_OFFSET(kTcpNagle03LocalOffset, 133)

// ── CONTROL_FLAGS_05 / URGENT_PTR_04 / 
//    OUT_OF_ORDER / FLAGS_PROCESSING_10 / PROBING_WINDOWS /
//    RETRANSMISSION_TO — monotonic active-OPEN reservation +140.. ──
TC8_TCP_OFFSET(kTcpControlFlags05LocalOffset, 140)
TC8_TCP_OFFSET(kTcpUrgentPtr04LocalOffset, 142)
TC8_TCP_OFFSET(kTcpOutOfOrder03LocalOffset, 143)
TC8_TCP_OFFSET(kTcpFlagsProcessing10LocalOffset, 144)
TC8_TCP_OFFSET(kTcpOutOfOrder01LocalOffset, 145)
TC8_TCP_OFFSET(kTcpOutOfOrder02LocalOffset, 146)
TC8_TCP_OFFSET(kTcpOutOfOrder05LocalOffset, 147)
TC8_TCP_OFFSET(kTcpProbingWindows02LocalOffset, 148)
TC8_TCP_OFFSET(kTcpProbingWindows03LocalOffset, 149)
TC8_TCP_OFFSET(kTcpProbingWindows05LocalOffset, 150)
TC8_TCP_OFFSET(kTcpProbingWindows04LocalOffset, 151)
TC8_TCP_OFFSET(kTcpProbingWindows06LocalOffset, 152)
TC8_TCP_OFFSET(kTcpRetransmissionTo06LocalOffset, 153)
TC8_TCP_OFFSET(kTcpRetransmissionTo04LocalOffset, 154)
TC8_TCP_OFFSET(kTcpRetransmissionTo05LocalOffset, 155)
TC8_TCP_OFFSET(kTcpRetransmissionTo03LocalOffset, 156)

// ── SEQUENCE_02 / CONNECTION_ESTAB_03 active-OPEN ──
TC8_TCP_OFFSET(kTcpSequence02LocalOffset, 161)
TC8_TCP_OFFSET(kTcpConnEstab03LocalOffset1, 176)
TC8_TCP_OFFSET(kTcpConnEstab03LocalOffset2, 177)
