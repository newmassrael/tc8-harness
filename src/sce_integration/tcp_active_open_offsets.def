TC8_TCP_OFFSET_SPAN5(kTcpFlagsInvalid09BaseOffset, 12)
TC8_TCP_OFFSET_SPAN5(kTcpFlagsInvalid10BaseOffset, 64)
TC8_TCP_OFFSET_SPAN5(kTcpFlagsInvalid11BaseOffset, 75)
TC8_TCP_OFFSET_SPAN5(kTcpFlagsInvalid12BaseOffset, 80)
