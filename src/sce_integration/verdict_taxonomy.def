// Single source of truth for the TC8 conformance verdict taxonomy + role
// policy. See docs/verdict_policy.md for the rationale (ISO/IEC 9646 / TTCN-3).
//
// X-macro form:
//   TC8_VERDICT_CLASS(EnumName, "wire-name", exit_code)
//   TC8_VERDICT_ROLE("role-name", ClassEnumName)
//
// Consumed directly (zero-cost, no parsing) by src/sce_integration/verdict.h
// for the C++ enum + name/exit mappings (roles are a no-op there — the runtime
// reads the class from donedata; roles are an audit-time concern). Also parsed
// by tools/gen_verdict_taxonomy.py, which GENERATES the Python (audit), Bash
// (smoke gate), and Rust (orchestrator) mirrors plus the docs/verdict_policy.md
// role table — so the taxonomy + policy exist in one place and every consumer
// derives.
//
// Gate disposition is DERIVED from the exit code, not stated separately:
//   0 = success (pass) | 1 = gate-red (fail) | anything else = non-conclusion.

TC8_VERDICT_CLASS(Pass,         "pass",         0)
TC8_VERDICT_CLASS(Fail,         "fail",         1)
TC8_VERDICT_CLASS(Inconclusive, "inconclusive", 2)
TC8_VERDICT_CLASS(Error,        "error",        3)
TC8_VERDICT_CLASS(Running,      "running",      1)

// Two roles share the `fail` class but carry distinct meaning.
// `observed_violation` is an IUT conformance violation — the DUT did the
// prohibited thing or omitted the required one. `fault_injection_inert` is a
// `_neg` self-validation landing on its conformant-DUT branch: the injected
// firmware fault did NOT change the observable behaviour, so the negative
// caught nothing. That is gate-red (a fault-wiring / test-suite regression)
// but NOT a DUT defect — see docs/verdict_policy.md Section 6.1.
TC8_VERDICT_ROLE("conformant",            Pass)
TC8_VERDICT_ROLE("conformant_absence",    Pass)
TC8_VERDICT_ROLE("observed_violation",    Fail)
TC8_VERDICT_ROLE("fault_injection_inert", Fail)
TC8_VERDICT_ROLE("precondition_unmet",    Inconclusive)
TC8_VERDICT_ROLE("property_unobserved",   Inconclusive)
TC8_VERDICT_ROLE("test_system_fault",     Error)
