#!/usr/bin/env bash
# pre-commit — Mnemosyne gate (validate-workspace + validate-code-refs via
# mnemosyne-gate.sh) followed by the verdict donedata SSOT gate. Versioned in
# .githooks/; activate once per clone:
#     git config core.hooksPath .githooks   (or ./scripts/install-hooks.sh)
set -euo pipefail
HERE="$(dirname "$0")"

"$HERE/mnemosyne-gate.sh" pre-commit

# Verdict taxonomy generated mirrors (python/bash/doc) must match the single
# source src/sce_integration/verdict_taxonomy.def (also #included by verdict.h).
if ! python3 "$HERE/../tools/gen_verdict_taxonomy.py" --check >/dev/null; then
    echo "pre-commit: verdict taxonomy generated files are STALE — run:" >&2
    echo "    python3 tools/gen_verdict_taxonomy.py" >&2
    python3 "$HERE/../tools/gen_verdict_taxonomy.py" --check >&2 || true
    exit 1
fi

# Wire-constant manifest generated mirrors (wire.gen.{rs,sh}) must match the
# single source tools/wire.def, and the C++ stimulus headers must still agree
# with it (--check cross-verifies both freshness and C++ drift).
if ! python3 "$HERE/../tools/gen_wire_manifest.py" --check >/dev/null; then
    echo "pre-commit: wire manifest STALE or C++ drift — run:" >&2
    echo "    python3 tools/gen_wire_manifest.py" >&2
    python3 "$HERE/../tools/gen_wire_manifest.py" --check >&2 || true
    exit 1
fi

# timing_serial drift guard: every sub-second cadence case (*_within_us) must be
# classified for the smoke serial lane (timing_serial:true, or EXEMPT with a
# window-margin reason). Stops a new cadence case silently joining the contended
# --workers 4 lane where its window flakes.
if ! python3 "$HERE/../tools/timing_serial_audit.py" >/dev/null; then
    echo "pre-commit: timing_serial drift — details:" >&2
    python3 "$HERE/../tools/timing_serial_audit.py" >&2
    exit 1
fi

# Verdict SSOT invariant: every registered case carries a donedata verdict with
# a canonical conformance class (src/sce_integration/verdict.h). Fast,
# pure-Python; keeps the single source from rotting between CI runs.
if ! python3 "$HERE/../tools/verdict_drift_audit.py" --summary >/dev/null; then
    echo "pre-commit: verdict donedata SSOT gate FAILED — details:" >&2
    python3 "$HERE/../tools/verdict_drift_audit.py" >&2
    exit 1
fi

# Negative-coverage exhaustiveness: every positive case must carry a non-vacuity
# disposition (sound row / fault-injection _neg / registry / deferred). Blocks a
# new undisposed case or a stale ledger entry (tools/negative_coverage_undisposed.txt).
if ! python3 "$HERE/../tools/negative_coverage_audit.py" --check >/dev/null; then
    echo "pre-commit: negative-coverage ratchet FAILED — details:" >&2
    python3 "$HERE/../tools/negative_coverage_audit.py" --check >&2
    exit 1
fi

# Self-hosted runner exposure: a workflow job that is not provably on a
# GitHub-hosted runner may only be triggered by events needing repo WRITE access
# (push / workflow_dispatch / schedule). Stops a `pull_request` or issue_comment
# trigger from reaching the root netns host, which smoke-test.yml and
# lwip-sweep.yml previously only asked for in a comment. Pure-Python.
if ! python3 "$HERE/../tools/workflow_runner_audit.py" --check >/dev/null; then
    echo "pre-commit: self-hosted runner trigger gate FAILED — details:" >&2
    python3 "$HERE/../tools/workflow_runner_audit.py" --check >&2
    exit 1
fi
